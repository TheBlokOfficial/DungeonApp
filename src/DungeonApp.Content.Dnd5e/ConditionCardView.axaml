<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DungeonApp.Desktop.Entries.Controls"
             x:Class="DungeonApp.Content.Dnd5e.ConditionCardView">

    <!-- The condition card. The icon's square frame and the summary under the name are lent to the
         detail header (ConditionCardView.axaml.cs); the card itself is the condition's rules as a
         prose section "Opis", exactly as an item's description is (GearCardView.axaml): a line, then
         the section, DungeonSpacingLg apart. The rules' introduction opens the section and the named
         parts (the levels of a graded condition) follow as the section's items. -->
    <StackPanel x:Name="RulesBlock" Spacing="{DynamicResource DungeonSpacingLg}">
        <Separator />
        <controls:ProseSectionView x:Name="Rules" Title="Opis" />
    </StackPanel>
</UserControl>
