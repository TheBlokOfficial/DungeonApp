<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Content.Dnd5e.GearMetadataView">

    <!-- An item's metadata at the end of its title's line (lent to the detail header, see
         GearCardView), right-aligned: the weight with its icon in the muted color, as by a headline
         value's caption, and under it the worth, smaller and muted - neither may compete with the
         name. The first line keeps to the title's first line: it is one line of the title's own style
         tall (an empty, zero-wide line of display-xl, the header's title style) with its content
         centred, so the weight stands where it would alone however tall this block is. Without a
         weight the worth takes the first line. Numbers in interface type with tabular digits. -->
    <StackPanel HorizontalAlignment="Right">
        <Panel>
            <TextBlock Classes="display-xl" Text=" " Width="0" IsHitTestVisible="False" />
            <StackPanel x:Name="Weight"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource DungeonSpacingXs}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <dc:ForegroundIcon Width="{DynamicResource DungeonStatTileIconSize}"
                                   Height="{DynamicResource DungeonStatTileIconSize}"
                                   VerticalAlignment="Center"
                                   Source="{DynamicResource DungeonIconWeight}"
                                   Foreground="{DynamicResource DungeonTextMutedBrush}" />
                <SelectableTextBlock x:Name="WeightText"
                                     Classes="body"
                                     FontFeatures="tnum"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource DungeonTextRegularBrush}" />
            </StackPanel>
            <SelectableTextBlock x:Name="FirstLineWorthText"
                                 Classes="caption muted"
                                 FontFeatures="tnum"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center" />
        </Panel>
        <SelectableTextBlock x:Name="WorthText"
                             Classes="caption muted"
                             FontFeatures="tnum"
                             HorizontalAlignment="Right" />
    </StackPanel>
</UserControl>
