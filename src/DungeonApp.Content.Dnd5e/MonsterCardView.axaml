<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DungeonApp.Desktop.Entries.Controls"
             x:Class="DungeonApp.Content.Dnd5e.MonsterCardView">

    <!-- The designed statblock on one geometric grid. Three vertical lines carry everything: the
         card's left edge, the portrait's right edge, and the title column's start (portrait plus
         DungeonDetailColumnGap). The portrait (three ability cells wide, 3:4) and the KP / PZ /
         Szybkość tiles are lent to the detail header (MonsterCardView.axaml.cs); the card itself,
         top to bottom:
         - two ability tables, SIŁ/ZRĘ/KON under the portrait and INT/MDR/CHA on the title line;
         - pairs, one row per filled field, their values on the title line; wyzwanie as a badge;
         - the rules sections in statblock order, each shown only when filled, always open;
         - the description as a small italic footer, only when filled.
         Size, type and alignment are not on this card - they are this content type's tags, shown
         once in the detail header. Spacing between controls is set here, on the host, never carried
         by a control itself. -->
    <StackPanel>
        <!-- ===== abilities ===== -->
        <Grid ColumnDefinitions="Auto,Auto"
              ColumnSpacing="{DynamicResource DungeonDetailColumnGap}"
              HorizontalAlignment="Left">
            <controls:AbilityTableView x:Name="PhysicalAbilities" />
            <controls:AbilityTableView x:Name="MentalAbilities" Grid.Column="1" />
        </Grid>

        <Separator Classes="section" />

        <!-- ===== pairs ===== -->
        <controls:TraitListView x:Name="Traits" />

        <Separator Classes="section" />

        <!-- ===== rules sections ===== -->
        <StackPanel x:Name="Sections" Spacing="{DynamicResource DungeonSpacingXxl}">
            <controls:ProseSectionView x:Name="SpecialAbilitiesSection" Title="Cechy szczególne"
                                       Icon="{DynamicResource DungeonIconSparkles}" />
            <controls:ProseSectionView x:Name="ActionsSection" Title="Akcje"
                                       Icon="{DynamicResource DungeonIconSwords}" />
            <controls:ProseSectionView x:Name="SpellcastingSection" Title="Rzucanie czarów"
                                       Icon="{DynamicResource DungeonIconWand}" />
            <controls:ProseSectionView x:Name="BonusActionsSection" Title="Akcje dodatkowe"
                                       Icon="{DynamicResource DungeonIconZap}" />
            <controls:ProseSectionView x:Name="ReactionsSection" Title="Reakcje"
                                       Icon="{DynamicResource DungeonIconUndo}" />
            <controls:ProseSectionView x:Name="LegendaryActionsSection" Title="Akcje legendarne"
                                       Icon="{DynamicResource DungeonIconCrown}" />
        </StackPanel>

        <!-- ===== footer: the monster's flavor, not its rules ===== -->
        <StackPanel x:Name="Footer">
            <Separator Classes="section" />
            <SelectableTextBlock x:Name="DescriptionText"
                                 Classes="display-note muted"
                                 TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
