<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DungeonApp.Desktop.Entries.Controls"
             x:Class="DungeonApp.Content.Dnd5e.MonsterCardView">

    <!-- The designed statblock layout: a KP/PZ/Szybkość stat-strip, six abilities in a bordered
         grid, skills-and-senses as plain rows, wyzwanie as a chip, then cechy szczególne / akcje
         under bar-accented section heads, and an italic description. Size/Type/Alignment are not on
         this card - they are this content type's own tags, already shown once in the detail header,
         and the card does not repeat what the header shows.
         Spacing between controls is set once, here, on the host - never carried by a control
         itself. -->
    <UserControl.Resources>
        <!-- Dimensions with no equivalent frame token: stat-strip padding and divider, the section
             head bar, the challenge chip - named once here. -->
        <!-- The first stat has no left padding; the rest are padded 18 on both sides. -->
        <Thickness x:Key="MonsterStatPaddingFirst">0,0,18,0</Thickness>
        <Thickness x:Key="MonsterStatPadding">18,0,18,0</Thickness>
        <x:Double x:Key="MonsterSectionBarWidth">3</x:Double>
        <x:Double x:Key="MonsterSectionBarHeight">14</x:Double>
        <CornerRadius x:Key="MonsterSectionBarCornerRadius">2</CornerRadius>
        <Thickness x:Key="MonsterChallengeChipPadding">9,1</Thickness>
        <CornerRadius x:Key="MonsterChallengeChipCornerRadius">6</CornerRadius>
        <!-- Section heads and the description share one size. -->
        <x:Double x:Key="MonsterSectionHeadFontSize">16</x:Double>

    </UserControl.Resources>

    <StackPanel Spacing="{DynamicResource DungeonSpacingLg}">

        <!-- ===== stat-strip: KP / PZ / Szybkość ===== -->
        <StackPanel Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingXs}" Margin="{StaticResource MonsterStatPaddingFirst}">
                <TextBlock Classes="muted" Text="KP" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center">
                    <Run x:Name="AcValueRun" FontWeight="SemiBold" />
                    <Run x:Name="AcNoteRun" Foreground="{DynamicResource DungeonTextMutedBrush}" />
                </TextBlock>
            </StackPanel>
            <Border BorderBrush="{DynamicResource DungeonBorderBrush}" BorderThickness="1,0,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingXs}" Margin="{StaticResource MonsterStatPadding}">
                <TextBlock Classes="muted" Text="PZ" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center">
                    <Run x:Name="HpValueRun" FontWeight="SemiBold" />
                    <Run x:Name="HpNoteRun" Foreground="{DynamicResource DungeonTextMutedBrush}" />
                </TextBlock>
            </StackPanel>
            <Border BorderBrush="{DynamicResource DungeonBorderBrush}" BorderThickness="1,0,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingXs}" Margin="{StaticResource MonsterStatPadding}">
                <TextBlock Classes="muted" Text="Szybkość" VerticalAlignment="Center" />
                <TextBlock x:Name="SpeedValueText" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <Border BorderBrush="{DynamicResource DungeonBorderBrush}" BorderThickness="0,0,0,1" />

        <!-- ===== Cechy: sześć wartości w ramkach z modyfikatorami ===== -->
        <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
            <TextBlock Classes="eyebrow" Text="Cechy" />
            <controls:AbilityGridView x:Name="Abilities" />
        </StackPanel>

        <Border BorderBrush="{DynamicResource DungeonBorderBrush}" BorderThickness="0,0,0,1" />

        <!-- ===== Właściwości: umiejętności / zmysły / języki, wyzwanie jako chip ===== -->
        <StackPanel Spacing="{DynamicResource DungeonSpacingXs}">
            <controls:TraitListView x:Name="SkillsAndSenses" />
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Classes="muted" Text="Wyzwanie" VerticalAlignment="Center" />
                <Border Grid.Column="1" HorizontalAlignment="Left" Margin="{DynamicResource DungeonPaddingMd}"
                        Background="{DynamicResource DungeonAccentDimBrush}"
                        CornerRadius="{StaticResource MonsterChallengeChipCornerRadius}"
                        Padding="{StaticResource MonsterChallengeChipPadding}">
                    <TextBlock x:Name="ChallengeText" Foreground="{DynamicResource DungeonAccentBrush}" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </StackPanel>

        <!-- ===== Cechy szczególne (jeśli rekord je niesie) ===== -->
        <StackPanel x:Name="SpecialAbilitiesSection" Spacing="{DynamicResource DungeonSpacingXs}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingSm}">
                <Border Width="{StaticResource MonsterSectionBarWidth}" Height="{StaticResource MonsterSectionBarHeight}"
                        CornerRadius="{StaticResource MonsterSectionBarCornerRadius}"
                        Background="{DynamicResource DungeonAccentBrush}" />
                <TextBlock Text="Cechy szczególne" FontFamily="{DynamicResource DungeonDisplayFont}" FontWeight="Medium" FontSize="{StaticResource MonsterSectionHeadFontSize}" />
            </StackPanel>
            <controls:ProseBlockView x:Name="SpecialAbilitiesBlock" />
        </StackPanel>

        <!-- ===== Akcje (Actions jest polem wymaganym rekordu) ===== -->
        <StackPanel Spacing="{DynamicResource DungeonSpacingXs}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingSm}">
                <!-- Not Danger: its meaning in Tokens.axaml (something is broken, or an action
                     deletes or cannot be undone) does not fit "these are a monster's attacks", so
                     this bar uses the same accent as "Cechy szczególne". -->
                <Border Width="{StaticResource MonsterSectionBarWidth}" Height="{StaticResource MonsterSectionBarHeight}"
                        CornerRadius="{StaticResource MonsterSectionBarCornerRadius}"
                        Background="{DynamicResource DungeonAccentBrush}" />
                <TextBlock Text="Akcje" FontFamily="{DynamicResource DungeonDisplayFont}" FontWeight="Medium" FontSize="{StaticResource MonsterSectionHeadFontSize}" />
            </StackPanel>
            <controls:ProseBlockView x:Name="ActionsBlock" />
        </StackPanel>

        <!-- ===== Opis: kursywą, z linią nad blokiem ===== -->
        <StackPanel x:Name="DescriptionSection" Spacing="{DynamicResource DungeonSpacingXs}">
            <Border BorderBrush="{DynamicResource DungeonBorderBrush}" BorderThickness="0,0,0,1" />
            <controls:ProseBlockView x:Name="DescriptionBlock"
                                      FontStyle="Italic"
                                      FontFamily="{DynamicResource DungeonDisplayFont}"
                                      FontSize="{StaticResource MonsterSectionHeadFontSize}"
                                      Foreground="{DynamicResource DungeonTextRegularBrush}" />
        </StackPanel>
    </StackPanel>
</UserControl>
