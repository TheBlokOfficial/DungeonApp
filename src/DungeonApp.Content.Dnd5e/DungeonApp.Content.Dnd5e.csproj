<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
  </ItemGroup>

  <!--
    Paczki dostarczane z tym systemem (docs/architecture.md, "Gdzie mieszka stan"): zwykłe paczki
    w formacie paczek MG, kopiowane do <wyjście>\dnd5e\packs\ - tam, gdzie wskazuje
    SystemDirectories.BundledPacks(AppContext.BaseDirectory, Dnd5eSystem.IdValue). Katalog "dnd5e"
    musi być równy Dnd5eSystem.IdValue; pilnuje tego test w DungeonApp.Content.Dnd5e.Tests.
  -->
  <ItemGroup>
    <None Remove="Packs\**" />
    <None Include="Packs\**\*" Link="dnd5e\packs\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DungeonApp.Core\DungeonApp.Core.csproj" />
    <ProjectReference Include="..\DungeonApp.Desktop\DungeonApp.Desktop.csproj" />
    <ProjectReference Include="..\DungeonApp.Library.Workspace\DungeonApp.Library.Workspace.csproj" />
    <ProjectReference Include="..\DungeonApp.Library.Entries\DungeonApp.Library.Entries.csproj" />
    <ProjectReference Include="..\DungeonApp.Library.Entries.Desktop\DungeonApp.Library.Entries.Desktop.csproj" />
  </ItemGroup>

</Project>
