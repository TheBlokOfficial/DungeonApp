<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- Własna referencja, nie przechodnia przez Desktop: generator kodu Toolkitu nie przechodzi
         na projekty zależne. -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!--
    Paczki dostarczane z tym systemem: zwykłe paczki w formacie paczek MG, kopiowane do
    <wyjście>\dnd5e\packs\ - tam, gdzie wskazuje
    SystemDirectories.BundledPacks(AppContext.BaseDirectory, Dnd5eSystem.IdValue). Katalog "dnd5e"
    musi być równy Dnd5eSystem.IdValue; pilnuje tego test w DungeonApp.Content.Dnd5e.Tests.
  -->
  <ItemGroup>
    <None Remove="Packs\**" />
    <None Include="Packs\**\*" Link="dnd5e\packs\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DungeonApp.Core\DungeonApp.Core.csproj" />
    <ProjectReference Include="..\DungeonApp.Desktop\DungeonApp.Desktop.csproj" />
  </ItemGroup>

</Project>
