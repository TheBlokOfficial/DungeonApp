<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- Direct reference, not transitive through Desktop: the Toolkit's code generator does not
         propagate to dependent projects. -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!--
    Packs bundled with this system: regular packs in the GM's pack format, copied to
    <output>\dnd5e\packs\ - the location returned by
    SystemDirectories.BundledPacks(AppContext.BaseDirectory, Dnd5eSystem.IdValue). The "dnd5e"
    directory must match Dnd5eSystem.IdValue; a test in DungeonApp.Content.Dnd5e.Tests checks this.
  -->
  <ItemGroup>
    <None Remove="Packs\**" />
    <None Include="Packs\**\*" Link="dnd5e\packs\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DungeonApp.Core\DungeonApp.Core.csproj" />
    <ProjectReference Include="..\DungeonApp.Desktop\DungeonApp.Desktop.csproj" />
  </ItemGroup>

</Project>
