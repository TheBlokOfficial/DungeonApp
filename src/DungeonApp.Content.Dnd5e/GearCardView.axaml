<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DungeonApp.Desktop.Entries.Controls"
             x:Class="DungeonApp.Content.Dnd5e.GearCardView">

    <!-- The designed gear card: its properties as an untitled trait list, then a description block. Spacing
         between them belongs to this host, never to a control. -->
    <StackPanel Spacing="{DynamicResource DungeonSpacingLg}">
        <controls:TraitListView x:Name="Properties" />
        <controls:ProseBlockView x:Name="DescriptionBlock" Title="Opis" />
    </StackPanel>
</UserControl>
