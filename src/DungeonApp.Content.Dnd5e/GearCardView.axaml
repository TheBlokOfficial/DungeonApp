<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DungeonApp.Desktop.Entries.Controls"
             x:Class="DungeonApp.Content.Dnd5e.GearCardView">

    <!-- The designed item card, on the monster card's grid: the card's left edge, the picture's right
         edge, and the title column's start. The square picture, the weight (end of the title's line),
         the rarity (end of the tags' row - category and subtype) and the Wartość / Dostrojenie pairs
         are lent to the detail header (GearCardView.axaml.cs); the card itself, top to bottom:
         - the item's rules values as pairs, their values on the title line, in three groups parted by
           a gap - weapon, armor, charges - each shown only when one of its fields is filled;
         - the description as card prose, only when filled.
         Spacing between controls is set here, on the host, never carried by a control itself. -->
    <StackPanel>
        <!-- ===== pairs ===== -->
        <StackPanel x:Name="Groups" Spacing="{DynamicResource DungeonSpacingLg}">
            <controls:TraitListView x:Name="WeaponTraits" />
            <controls:TraitListView x:Name="ArmorTraits" />
            <controls:TraitListView x:Name="ChargeTraits" />
        </StackPanel>

        <!-- ===== description: the item's rules as well as its flavor, so card prose (the
             monster's entry text), not a footer ===== -->
        <StackPanel x:Name="DescriptionBlock">
            <Separator Classes="section" />
            <SelectableTextBlock x:Name="DescriptionText"
                                 Classes="body secondary"
                                 TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
