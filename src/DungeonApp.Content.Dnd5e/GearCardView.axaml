<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DungeonApp.Desktop.Entries.Controls"
             x:Class="DungeonApp.Content.Dnd5e.GearCardView">

    <!-- The designed gear card: a square picture and the properties as an untitled trait list are
         lent to the detail header (GearCardView.axaml.cs) - beside the title and under it, on the
         same grid as the monster card; the card itself is the description block. -->
    <controls:ProseBlockView x:Name="DescriptionBlock" Title="Opis" />
</UserControl>
