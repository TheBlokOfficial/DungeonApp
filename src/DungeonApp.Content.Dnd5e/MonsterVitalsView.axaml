<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Content.Dnd5e.MonsterVitalsView">

    <!-- A monster's headline values - KP, PZ, Szybkość - as three tiles of equal width in one row,
         spaced like the card's columns. Lent to the detail header, under the tags (see
         MonsterCardView). -->
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource DungeonDetailColumnGap}">
        <dc:StatTile x:Name="ArmorClassTile" Label="KP" Icon="{DynamicResource DungeonIconShield}" />
        <dc:StatTile x:Name="HitPointsTile" Grid.Column="1" Label="PZ" Icon="{DynamicResource DungeonIconHeart}" />
        <dc:StatTile x:Name="SpeedTile" Grid.Column="2" Label="Szybkość" Icon="{DynamicResource DungeonIconFootprints}" />
    </Grid>
</UserControl>
