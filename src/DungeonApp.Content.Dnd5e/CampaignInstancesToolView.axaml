<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dnd="using:DungeonApp.Content.Dnd5e"
             xmlns:controls="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Content.Dnd5e.CampaignInstancesToolView"
             x:DataType="dnd:CampaignInstancesToolViewModel">

    <Grid Margin="{DynamicResource DungeonPaddingMd}"
          RowDefinitions="*,Auto"
          RowSpacing="{DynamicResource DungeonSpacingMd}">

        <Grid RowDefinitions="Auto,*"
              RowSpacing="{DynamicResource DungeonSpacingXs}"
              MinHeight="0">
            <TextBlock Classes="eyebrow" Text="INSTANCJE W TEJ KAMPANII" />

            <!-- The list scrolls itself (its own ScrollViewer, one scroll bar) - no outer scroll area. -->
            <ListBox Grid.Row="1"
                     IsVisible="{Binding HasInstances}"
                     ItemsSource="{Binding Instances}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="dnd:InstanceRowViewModel">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource DungeonSpacingXs}">
                                <StackPanel Spacing="{DynamicResource DungeonSpacingXs}">
                                    <TextBlock Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{DynamicResource DungeonWarningBrush}"
                                               IsVisible="{Binding HasMessage}"
                                               Text="{Binding Message}"
                                               TextWrapping="Wrap" />

                                    <!-- Deliberately plain: existing tokens, no new control, no hardcoded
                                         numbers - the author redesigns this row later and should not have
                                         to undo anything invented along the way. -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="{DynamicResource DungeonSpacingXs}"
                                                IsVisible="{Binding CanEditHitPoints}">
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DungeonTextMutedBrush}"
                                                   Text="PW:" />
                                        <NumericUpDown Minimum="0"
                                                       Value="{Binding CurrentHp}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DungeonTextMutedBrush}"
                                                   Text="{Binding MaxHp, StringFormat='z {0}'}" />
                                        <Button Command="{Binding SaveHitPointsCommand}"
                                                Content="Zapisz" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Usuń stoi przy każdym wierszu: cichy ikonowy, nazwa w podpowiedzi. -->
                                <Button Grid.Column="1"
                                        Classes="subtle icon"
                                        VerticalAlignment="Top"
                                        Command="{Binding RemoveCommand}"
                                        ToolTip.Tip="Usuń">
                                    <controls:ForegroundIcon Width="{DynamicResource DungeonActionIconSize}"
                                                             Height="{DynamicResource DungeonActionIconSize}"
                                                             Source="{StaticResource DungeonIconTrash}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            <controls:EmptyState Grid.Row="1"
                                 IsVisible="{Binding !HasInstances}"
                                 Message="Ta kampania nie ma jeszcze żadnych instancji."
                                 Hint="Wybierz wpis poniżej i dodaj go do świata." />
        </Grid>

        <Grid Grid.Row="1"
              RowDefinitions="Auto,Auto,Auto"
              RowSpacing="{DynamicResource DungeonSpacingXs}">
            <TextBlock Classes="eyebrow" Text="DODAJ DO ŚWIATA" />
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="{DynamicResource DungeonSpacingXs}">
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding AddableEntries}"
                          PlaceholderText="Wybierz wpis…"
                          SelectedItem="{Binding SelectedToAdd, Mode=TwoWay}" />
                <Button Grid.Column="1"
                        Classes="primary"
                        Command="{Binding AddCommand}"
                        Content="Dodaj" />
            </Grid>
            <TextBlock Grid.Row="2"
                       Foreground="{DynamicResource DungeonWarningBrush}"
                       IsVisible="{Binding HasMessage}"
                       Text="{Binding Message}"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
