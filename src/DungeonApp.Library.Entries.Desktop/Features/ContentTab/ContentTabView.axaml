<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ct="using:DungeonApp.Library.Entries.Desktop.Features.ContentTab"
             xmlns:conv="using:DungeonApp.Library.Entries.Desktop.Converters"
             x:Class="DungeonApp.Library.Entries.Desktop.Features.ContentTab.ContentTabView"
             x:DataType="ct:ContentTabViewModel">

    <!-- Dimensions, colors and typography below come from docs/images/mockup_rejestr.html, not the
         screenshot (krok 10, zlecenie 2 brief). Every value with no equivalent token in
         DungeonApp.Desktop/Themes/Tokens.axaml is named once, here, rather than written into the
         layout - see the local resources just below; all of them are listed in the zlecenie report. -->
    <UserControl.Resources>
        <conv:DimBrushConverter x:Key="DimBrush" />
        <conv:UpperCaseConverter x:Key="UpperCase" />

        <!-- Master/detail column widths (mockup: .list-panel { flex: 0 0 320px }, .detail-inner { max-width: 720px }). -->
        <x:Double x:Key="ContentListColumnWidth">320</x:Double>
        <x:Double x:Key="ContentDetailMaxWidth">720</x:Double>

        <!-- krok 10, brief A3: the full-width divider's own top-only margin - DungeonSpacingLg (16)
             as a Thickness; DungeonSpacingLg itself is a Double (Spacing/Width/Height scale, per
             Tokens.axaml's own two-parallel-sets remark), not assignable to Margin directly. -->
        <Thickness x:Key="ContentTabDividerMargin">0,16,0,0</Thickness>

        <!-- Typography with no matching frame token (mockup: .title-row h1, h1.entry-name, .filter-chip / .sort-btn). -->
        <x:Double x:Key="ContentTabTitleFontSize">26</x:Double>
        <x:Double x:Key="ContentDetailNameFontSize">34</x:Double>
        <x:Double x:Key="ContentChipFontSize">11.5</x:Double>

        <!-- Paddings with no matching frame token (mockup: .entry, .list-scroll, .detail-inner, .group-label, .filter-chip, .entry-badge.pill, .tag). -->
        <Thickness x:Key="ContentRowPadding">9,8</Thickness>
        <Thickness x:Key="ContentListScrollPadding">10,8,10,24</Thickness>
        <Thickness x:Key="ContentDetailInnerPadding">40,30,40,70</Thickness>
        <Thickness x:Key="ContentSectionHeaderPadding">8,12,8,5</Thickness>
        <Thickness x:Key="ContentChipPadding">9,6</Thickness>
        <Thickness x:Key="ContentBadgePillPadding">7,2</Thickness>
        <Thickness x:Key="ContentTagPadding">10,3</Thickness>

        <!-- Pill shape shared by a colored badge and a detail tag (mockup: border-radius: 999px). -->
        <CornerRadius x:Key="ContentPillCornerRadius">999</CornerRadius>

        <!-- krok 10, brief A4: the dropdown chevron shared by every filter chip and the sort button
             (mockup: .filter-chip svg is 8px, .sort-btn svg is 9px - unified to one size here rather
             than carrying two near-identical literals for a difference this small). Search icon size
             matches the mockup's own .search svg (13px). -->
        <x:Double x:Key="ContentChevronIconSize">9</x:Double>
        <x:Double x:Key="ContentSearchIconSize">13</x:Double>

        <!-- Selected-row look: two SEPARATE elements, matching mockup's .entry.selected (dim
             background) and .entry.selected::before (an accent stripe) - inset 5px top/bottom,
             width 2.5px, radius 2px. DungeonAccentDimColor in Tokens.axaml equals DungeonAccentColor
             today (not dimmed), so it is not used here - this brush carries the mockup's own dim
             value instead; the token gap is reported separately, and Tokens.axaml itself is
             untouched.
             krok 10, brief A5: the previous session's own attempt (ec09015) placed the stripe OUTSIDE
             the row via a negative left margin (-10, later found to be -6 too), matching the
             mockup's own ".sidebar-item.active::before{ left:-12px }" positioning. Measured against
             the real, rendered pixels (Selected_rows_stripe_renders_a_visible_pixel_at_its_own_center,
             DungeonApp.Desktop.RenderingTests\ContentTabRenderingTests.cs): ANY negative offset here
             renders invisible - clipped at exactly the row's own left edge regardless of corner
             radius, of Padding vs. Margin on the list's own ItemsControl, of ClipToBounds forced
             false on every ancestor control type between the stripe and the ScrollViewer (Panel,
             StackPanel, ItemsPresenter, ContentPresenter, ScrollContentPresenter tried individually
             and all together) - none of it moved the clip edge, which stayed pinned to the row's own
             bounds. The mechanism was not identified within this step's budget - see the report.
             Given "musi być widoczna" is the actual requirement, not the exact offset, the stripe
             sits INSET at the row's own left edge instead (Margin left 0, not negative) - visible
             plainly, at the cost of the mockup's own "separate element with a gap" look, which this
             deviation is reported against. -->
        <SolidColorBrush x:Key="ContentSelectedRowBrush" Color="{DynamicResource DungeonAccentColor}" Opacity="0.16" />
        <Thickness x:Key="ContentRowSelectionStripeMargin">0,5,0,5</Thickness>
        <x:Double x:Key="ContentRowSelectionStripeWidth">2.5</x:Double>
        <CornerRadius x:Key="ContentRowSelectionStripeCornerRadius">2</CornerRadius>

        <!-- One row template shared by every entry row AND a rejected pack's own selectable header
             (docs/architecture.md, "Zakładki treści": "Odrzucona paczka... wybieralny jak wiersz") -
             both are the same ContentRowViewModel shape, so this is the one place either is drawn. -->
        <DataTemplate x:Key="ContentRowTemplate" x:DataType="ct:ContentRowViewModel">
            <Panel ClipToBounds="False">
                <Border Classes="content-row-background" Classes.selected="{Binding IsSelected}">
                    <Button Classes="content-row-button" Command="{Binding SelectCommand}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                       Classes="row-name"
                                       IsVisible="{Binding !IsBroken}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DungeonTextRegularBrush}" />
                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                       Classes="row-name"
                                       IsVisible="{Binding IsBroken}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DungeonDangerTextBrush}" />

                            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding BadgeText}"
                                       IsVisible="{Binding HasPlainBadge}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    IsVisible="{Binding HasColoredBadge}"
                                    CornerRadius="{StaticResource ContentPillCornerRadius}"
                                    Padding="{StaticResource ContentBadgePillPadding}"
                                    Background="{Binding BadgeBrush, Converter={StaticResource DimBrush}}">
                                <TextBlock Text="{Binding BadgeText}"
                                           Foreground="{Binding BadgeBrush}"
                                           FontSize="{StaticResource ContentChipFontSize}" />
                            </Border>
                        </Grid>
                    </Button>
                </Border>
                <Border Classes="content-row-stripe" IsVisible="{Binding IsSelected}" />
            </Panel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.content-row-background">
            <Setter Property="CornerRadius" Value="{DynamicResource DungeonNavigationCornerRadius}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.content-row-background:pointerover:not(.selected)">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowHoverBrush}" />
        </Style>
        <Style Selector="Border.content-row-background.selected">
            <Setter Property="Background" Value="{StaticResource ContentSelectedRowBrush}" />
        </Style>
        <Style Selector="Border.content-row-stripe">
            <Setter Property="Width" Value="{StaticResource ContentRowSelectionStripeWidth}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="{StaticResource ContentRowSelectionStripeMargin}" />
            <Setter Property="CornerRadius" Value="{StaticResource ContentRowSelectionStripeCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource DungeonAccentBrush}" />
        </Style>
        <!-- krok 10, brief A5: the selected row's own name draws bolder - mockup's ".entry.selected
             .entry-title{ font-weight:600 }". The badge is untouched: the mockup leaves its color
             alone too, and the brief only asks for the row bold, not a badge recolor. -->
        <Style Selector="Border.content-row-background.selected TextBlock.row-name">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- krok 10, brief A4: the search field's own outer chrome - what TextBox's app-wide style
             (BuiltInControls.axaml) already draws, moved out here so the magnifier icon can share
             the same border instead of sitting outside it. -->
        <Style Selector="Border.content-search">
            <Setter Property="Height" Value="{DynamicResource DungeonControlHeight}" />
            <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector="TextBox.search-input">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.search-input /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.search-input:pointerover /template/ Border#PART_BorderElement,
                         TextBox.search-input:focus /template/ Border#PART_BorderElement,
                         TextBox.search-input:focus:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.content-row-button">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="Padding" Value="{StaticResource ContentRowPadding}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.content-chip">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="Padding" Value="{StaticResource ContentChipPadding}" />
            <Setter Property="FontSize" Value="{StaticResource ContentChipFontSize}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
        </Style>
        <Style Selector="Button.content-chip.active">
            <Setter Property="Background" Value="{StaticResource ContentSelectedRowBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonAccentBrush}" />
        </Style>

        <!-- krok 10, brief A2: list/detail scrollbar thumb per the mockup's own
             .list-scroll::-webkit-scrollbar-thumb / .detail-panel::-webkit-scrollbar-thumb
             (background: the mockup's own border-strong token) - scoped to this view only, not the app-wide
             ScrollBar style (BuiltInControls.axaml), which paints the thumb in the accent color
             instead. Width is left at the app-wide default: the mockup's own 6px/7px split has no
             matching Avalonia ScrollBar property found within this step's budget (see the report). -->
        <Style Selector="ScrollBar">
            <Setter Property="Foreground" Value="{DynamicResource DungeonBorderStrongBrush}" />
        </Style>

        <!-- krok 10, brief A11: a filter chip's dropdown - bordered like the search box, its rows in
             the list rows' own font, the selected option on the dim-accent background
             (ContentSelectedRowBrush - see its own remarks on the DungeonAccentDimColor token gap). -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource DungeonPaddingXs}" />
        </Style>
        <Style Selector="FlyoutPresenter ListBoxItem">
            <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource DungeonNavigationCornerRadius}" />
        </Style>
        <Style Selector="FlyoutPresenter ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ContentSelectedRowBrush}" />
        </Style>
        <Style Selector="FlyoutPresenter ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowHoverBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Detail column templates - one per shape ContentDetailViewModel can be (docs/architecture.md,
         "Niezmiennik interfejsu": the view knows both compiled shapes; only a value ever comes from
         data). DataType drives which template an untyped ContentControl picks; x:DataType alongside
         it gives every binding inside compiled type-checking, the same double attribute
         AppShellView.axaml's own UserControl.DataTemplates already uses. -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="ct:ValidContentDetailViewModel" x:DataType="ct:ValidContentDetailViewModel">
            <StackPanel Spacing="{DynamicResource DungeonSpacingLg}">
                <!-- krok 10, brief A8: "Okruszki w nagłówku szczegółu rozdzielone „›"." Two runs, not
                     one ItemsControl per segment: the trail (every breadcrumb but the last, already
                     joined with "›") stays muted, and the current entry's own name - the last segment
                     - draws less muted, matching the mockup's ".crumb-path .current" - with one more
                     "›" between the two when there is a trail at all. -->
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingXs}">
                    <TextBlock Classes="muted" Text="{Binding BreadcrumbTrailText}" IsVisible="{Binding HasBreadcrumbTrail}" />
                    <TextBlock Classes="muted" Text="›" IsVisible="{Binding HasBreadcrumbTrail}" />
                    <TextBlock Text="{Binding BreadcrumbCurrent}"
                               FontSize="{DynamicResource DungeonHelperFontSize}"
                               Foreground="{DynamicResource DungeonTextRegularBrush}" />
                </StackPanel>

                <StackPanel Spacing="{DynamicResource DungeonSpacingXs}">
                    <TextBlock Text="{Binding Category}"
                               IsVisible="{Binding HasCategory}"
                               FontSize="{DynamicResource DungeonHelperFontSize}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DungeonAccentBrush}" />
                    <TextBlock Text="{Binding Name}"
                               FontFamily="{DynamicResource DungeonDisplayFont}"
                               FontSize="{StaticResource ContentDetailNameFontSize}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DungeonTextPrimaryBrush}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border CornerRadius="{StaticResource ContentPillCornerRadius}"
                                    Padding="{StaticResource ContentTagPadding}"
                                    Margin="0,0,6,6"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource DungeonBorderStrongBrush}">
                                <TextBlock Text="{Binding}"
                                           FontSize="{StaticResource ContentChipFontSize}"
                                           Foreground="{DynamicResource DungeonTextRegularBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ContentControl Content="{Binding Card}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="ct:BrokenContentDetailViewModel" x:DataType="ct:BrokenContentDetailViewModel">
            <StackPanel Spacing="{DynamicResource DungeonSpacingMd}">
                <TextBlock Text="{Binding Name}"
                           FontFamily="{DynamicResource DungeonDisplayFont}"
                           FontSize="{StaticResource ContentDetailNameFontSize}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource DungeonDangerTextBrush}" />
                <SelectableTextBlock Text="{Binding Reason}"
                                      TextWrapping="Wrap"
                                      Foreground="{DynamicResource DungeonTextRegularBrush}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid Background="{DynamicResource DungeonBackstageBrush}" RowDefinitions="Auto,Auto,*" MinHeight="0">

        <!-- ===== Nagłówek zakładki ===== -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource DungeonPaddingXxl}" Spacing="{DynamicResource DungeonSpacingXs}">
            <TextBlock Classes="muted" Text="Biblioteka" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingMd}" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Title}"
                           FontFamily="{DynamicResource DungeonDisplayFont}"
                           FontSize="{StaticResource ContentTabTitleFontSize}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource DungeonTextPrimaryBrush}" />
                <TextBlock Classes="muted" Text="{Binding CountText}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
            </StackPanel>
        </StackPanel>

        <!-- krok 10, brief A3: "Linia pod nagłówkiem zakładki na całą szerokość obszaru treści, nie
             tylko pod listą" - today's only line was #PART_ListColumn's own top border, spanning
             just that column's 320px. This one sits in its own row, above both the list and the
             detail column, and its own Grid.Row="1" already spans the whole width by construction -
             no ColumnSpan needed, since the list/detail Grid only starts on the row below.
             DungeonSpacingLg (16) matches the mockup's own ".registry-body{ margin-top: 16px }". -->
        <Border Grid.Row="1"
                Margin="{StaticResource ContentTabDividerMargin}"
                BorderBrush="{DynamicResource DungeonBorderBrush}"
                BorderThickness="0,0,0,1" />

        <!-- ===== Ciało: lista + szczegół ===== -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" MinHeight="0">

            <!-- ===== Kolumna listy - stała szerokość, nigdy się nie kurczy. ===== -->
            <Border x:Name="PART_ListColumn"
                    Grid.Column="0"
                    Width="{StaticResource ContentListColumnWidth}"
                    MinWidth="{StaticResource ContentListColumnWidth}"
                    BorderBrush="{DynamicResource DungeonBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*" MinHeight="0">

                    <StackPanel Grid.Row="0" Margin="{DynamicResource DungeonPaddingLg}" Spacing="{DynamicResource DungeonSpacingMd}">
                        <!-- krok 10, brief A4: "Lupa w polu wyszukiwania" - the TextBox's own chrome
                             (border/background/corner radius, BuiltInControls.axaml) is disabled on
                             this one instance via the "search-input" class below, so the icon and the
                             input share one outer border instead of the input drawing its own. -->
                        <Border Classes="content-search">
                            <Grid ColumnDefinitions="Auto,*">
                                <Image Grid.Column="0"
                                       Width="{StaticResource ContentSearchIconSize}"
                                       Height="{StaticResource ContentSearchIconSize}"
                                       Margin="0,0,8,0"
                                       Source="{StaticResource DungeonIconSearch}" />
                                <TextBox Grid.Column="1" Classes="search-input"
                                         Text="{Binding Search, Mode=TwoWay}"
                                         PlaceholderText="Szukaj po nazwie…" />
                            </Grid>
                        </Border>

                        <WrapPanel>
                            <Button Classes="content-chip" Classes.active="{Binding CategoryFilter.IsActive}"
                                    IsVisible="{Binding CategoryFilter.IsAvailable}"
                                    Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingXs}">
                                    <TextBlock Text="{Binding CategoryFilter.ChipText}" />
                                    <Image Width="{StaticResource ContentChevronIconSize}" Height="{StaticResource ContentChevronIconSize}"
                                           Source="{StaticResource DungeonIconChevronDown}" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <ListBox ItemsSource="{Binding CategoryFilter.FlyoutItems}"
                                                 SelectedItem="{Binding CategoryFilter.SelectedDisplay, Mode=TwoWay}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <ItemsControl ItemsSource="{Binding ValueFilters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ct:ContentFilterChipViewModel">
                                        <Button Classes="content-chip" Classes.active="{Binding IsActive}"
                                                IsVisible="{Binding IsAvailable}"
                                                Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingXs}">
                                                <TextBlock Text="{Binding ChipText}" />
                                                <Image Width="{StaticResource ContentChevronIconSize}" Height="{StaticResource ContentChevronIconSize}"
                                                       Source="{StaticResource DungeonIconChevronDown}" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <ListBox ItemsSource="{Binding FlyoutItems}"
                                                             SelectedItem="{Binding SelectedDisplay, Mode=TwoWay}" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Classes="content-chip" Classes.active="{Binding SourceFilter.IsActive}"
                                    IsVisible="{Binding SourceFilter.IsAvailable}"
                                    Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingXs}">
                                    <TextBlock Text="{Binding SourceFilter.ChipText}" />
                                    <Image Width="{StaticResource ContentChevronIconSize}" Height="{StaticResource ContentChevronIconSize}"
                                           Source="{StaticResource DungeonIconChevronDown}" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <ListBox ItemsSource="{Binding SourceFilter.FlyoutItems}"
                                                 SelectedItem="{Binding SourceFilter.SelectedDisplay, Mode=TwoWay}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </WrapPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <Button Grid.Column="0" Classes="link" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingXs}">
                                    <TextBlock Text="{Binding SelectedSort, StringFormat='Sortuj: {0}'}" />
                                    <Image Width="{StaticResource ContentChevronIconSize}" Height="{StaticResource ContentChevronIconSize}"
                                           Source="{StaticResource DungeonIconChevronDown}" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <ListBox ItemsSource="{Binding SortOptions}"
                                                 SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button Grid.Column="1" Classes="link" HorizontalAlignment="Right"
                                    Command="{Binding ClearFiltersCommand}"
                                    Content="Wyczyść filtry" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource DungeonBorderBrush}" BorderThickness="0,0,0,1" />

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Sections}" Padding="{StaticResource ContentListScrollPadding}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ct:ContentSectionViewModel">
                                    <StackPanel Spacing="{DynamicResource DungeonSpacingXs}">

                                        <!-- Nagłówek zwykłej paczki: etykieta, nie wiersz. -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="{DynamicResource DungeonSpacingXs}"
                                                    Margin="{StaticResource ContentSectionHeaderPadding}"
                                                    IsVisible="{Binding !IsRejectedPack}">
                                            <!-- krok 10, brief A6: "Nagłówki sekcji po paczce wersalikami" -
                                                 a screen-header style (the architect's own settled
                                                 call), applied only here at render time; the pack's
                                                 own Header string is untouched everywhere else. -->
                                            <TextBlock Classes="eyebrow" Text="{Binding Header, Converter={StaticResource UpperCase}}" />
                                            <TextBlock Classes="eyebrow" Text="{Binding Count, StringFormat={}{0}}" />
                                        </StackPanel>

                                        <!-- Nagłówek odrzuconej paczki: wybieralny jak wiersz, kolor niebezpieczeństwa - the same row template every entry row uses. -->
                                        <ContentControl IsVisible="{Binding IsRejectedPack}"
                                                         Content="{Binding HeaderRow}"
                                                         ContentTemplate="{StaticResource ContentRowTemplate}" />

                                        <!-- Wiersze wpisów. -->
                                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ContentRowTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="{DynamicResource DungeonSpacingXs}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== Kolumna szczegółu - największa szerokość z mockupu, wyrównana do lewej. ===== -->
            <!-- The ScrollViewer fills the whole column, so its scrollbar stands at the window's right
                 edge like the mockup's .detail-panel; the content inside is capped at the mockup's
                 .detail-inner max-width and anchored left. The cap sits on a Grid column, not on
                 the Border: a MaxWidth-capped element left at Stretch is centered in its wider slot,
                 which is what put the detail far from the list, and HorizontalAlignment="Left" would
                 shrink it to its content. A capped star column fills up to the cap and leaves the rest
                 empty on the right. When a vertical scrollbar shows at the narrowest width, the cap
                 shrinks by its width - nothing else moves. -->
            <ScrollViewer x:Name="PART_DetailColumn"
                          Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource ContentDetailMaxWidth}" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PART_DetailInner">
                    <StackPanel Spacing="{DynamicResource DungeonSpacingLg}" Margin="{StaticResource ContentDetailInnerPadding}">
                        <TextBlock IsVisible="{Binding ShowSelectionPrompt}"
                                   Foreground="{DynamicResource DungeonTextMutedBrush}"
                                   Text="Wybierz wpis z listy po lewej, aby zobaczyć kartę." />

                        <ContentControl Content="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                    </StackPanel>
                </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
