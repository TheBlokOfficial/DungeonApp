<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ct="using:DungeonApp.Library.Entries.Desktop.Features.ContentTab"
             xmlns:conv="using:DungeonApp.Library.Entries.Desktop.Converters"
             xmlns:ctl="using:DungeonApp.Library.Entries.Desktop.Controls"
             xmlns:dc="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Library.Entries.Desktop.Features.ContentTab.ContentTabView"
             x:DataType="ct:ContentTabViewModel">

    <!-- Szkielet zakładki treści (krok 10, brief 3a): nagłówek zakładki na całą szerokość, pod linią
         panel listy o stałej szerokości i obszar szczegółu z klockiem EntryDetailView. Wymiary ze
         skali motywu, pismo z ról galerii (Typography.axaml). -->
    <UserControl.Resources>
        <conv:DimBrushConverter x:Key="DimBrush" />
        <conv:UpperCaseConverter x:Key="UpperCase" />

        <!-- Szerokość panelu listy (brief 3a). -->
        <GridLength x:Key="ContentListColumnWidth">320</GridLength>

        <!-- Nagłówek zakładki: 20 u góry, 24 po bokach, 16 nad linią. -->
        <Thickness x:Key="ContentTabHeaderMargin">24,20,24,16</Thickness>

        <!-- Obszar szczegółu: 32 u góry, z lewej i u dołu; z prawej strefa paska przewijania
             (DungeonScrollBarZone) ustawiona na tym samym elemencie jako Padding. -->
        <Thickness x:Key="ContentDetailMargin">32,32,0,32</Thickness>

        <!-- Nagłówek sekcji: z lewej tam, gdzie zaczyna się tekst wiersza (pas kreski
             DungeonListRowStripeGutter 10 + wcięcie wiersza DungeonPaddingMdHorizontal 12); 12 nad
             nagłówkiem (4 nad pierwszym), 6 pod. -->
        <Thickness x:Key="ContentSectionHeaderMargin">22,12,16,6</Thickness>
        <Thickness x:Key="ContentFirstSectionHeaderMargin">22,4,16,6</Thickness>

        <!-- Odznaka koloru systemu: wysokość DungeonSpacingXl, wcięcie poziome DungeonSpacingXs. -->
        <Thickness x:Key="ContentBadgePadding">6,0</Thickness>
        <CornerRadius x:Key="ContentPillCornerRadius">999</CornerRadius>

        <DataTemplate x:Key="ContentRowTemplate" x:DataType="ct:ContentRowViewModel">
            <dc:ListRow ShowsSelectionStripe="True"
                        IsSelected="{Binding IsSelected}"
                        Command="{Binding SelectCommand}"
                        ToolTip.Tip="{Binding Name}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource DungeonSpacingSm}">
                    <TextBlock Grid.Column="0" Classes="body row-name"
                               Text="{Binding Name}"
                               IsVisible="{Binding !IsBroken}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource DungeonTextRegularBrush}" />
                    <TextBlock Grid.Column="0" Classes="body row-name"
                               Text="{Binding Name}"
                               IsVisible="{Binding IsBroken}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource DungeonDangerTextBrush}" />

                    <!-- Odznaka bez koloru (wyzwanie): zwykły tekst krojem liczb, przygaszony. -->
                    <TextBlock Grid.Column="1" Classes="mono muted"
                               Text="{Binding BadgeText}"
                               IsVisible="{Binding HasPlainBadge}"
                               VerticalAlignment="Center" />
                    <!-- Odznaka w kolorze systemu (rzadkość): tekst w kolorze, tło to samo przygaszone. -->
                    <Border Grid.Column="1"
                            IsVisible="{Binding HasColoredBadge}"
                            Height="{DynamicResource DungeonSpacingXl}"
                            VerticalAlignment="Center"
                            CornerRadius="{StaticResource ContentPillCornerRadius}"
                            Padding="{StaticResource ContentBadgePadding}"
                            Background="{Binding BadgeBrush, Converter={StaticResource DimBrush}}">
                        <TextBlock Classes="label"
                                   Text="{Binding BadgeText}"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding BadgeBrush}" />
                    </Border>
                    <!-- Rzecz zepsuta: w miejscu odznaki ostrzeżenie kolorem treści niewczytanej. -->
                    <dc:ForegroundIcon Grid.Column="1"
                                       IsVisible="{Binding IsBroken}"
                                       Width="{DynamicResource DungeonActionIconSize}"
                                       Height="{DynamicResource DungeonActionIconSize}"
                                       VerticalAlignment="Center"
                                       Source="{DynamicResource DungeonIconWarningTriangle}"
                                       Foreground="{DynamicResource DungeonDangerTextBrush}" />
                </Grid>
            </dc:ListRow>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Wysokość wiersza ustawia lista, nie zawartość: stała biblioteki DungeonListRowHeight (32). -->
        <Style Selector="ItemsControl.content-rows dc|ListRow">
            <Setter Property="Height" Value="{DynamicResource DungeonListRowHeight}" />
        </Style>
        <Style Selector="dc|ListRow:selected TextBlock.row-name">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource DungeonBackstageBrush}" RowDefinitions="Auto,Auto,*" MinHeight="0">

        <!-- ===== Nagłówek zakładki: nazwa i licznik na jednej linii bazowej (jeden TextBlock). ===== -->
        <TextBlock Grid.Row="0"
                   Margin="{StaticResource ContentTabHeaderMargin}"
                   Classes="display-lg"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource DungeonTextPrimaryBrush}">
            <Run Text="{Binding Title}" />
            <Run Text="  "
                 FontFamily="{DynamicResource DungeonMonoFont}"
                 FontSize="{DynamicResource DungeonHelperFontSize}" />
            <Run Text="{Binding CountText}"
                 FontFamily="{DynamicResource DungeonMonoFont}"
                 FontSize="{DynamicResource DungeonHelperFontSize}"
                 FontWeight="Normal"
                 Foreground="{DynamicResource DungeonTextMutedBrush}" />
        </TextBlock>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource DungeonBorderBrush}"
                BorderThickness="0,0,0,1" />

        <!-- ===== Ciało: panel listy (stała szerokość) + obszar szczegółu. ===== -->
        <Grid Grid.Row="2" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource ContentListColumnWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Panel listy ===== -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource DungeonBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*" MinHeight="0">

                    <StackPanel Grid.Row="0" Margin="{DynamicResource DungeonPaddingLg}" Spacing="{DynamicResource DungeonSpacingSm}">
                        <dc:IconField Classes="search">
                            <TextBox Text="{Binding Search, Mode=TwoWay}"
                                     PlaceholderText="Szukaj po nazwie…" />
                        </dc:IconField>

                        <WrapPanel ItemSpacing="{DynamicResource DungeonSpacingXs}"
                                   LineSpacing="{DynamicResource DungeonSpacingXs}">
                            <Button Theme="{StaticResource DungeonChipOpener}" Classes.active="{Binding CategoryFilter.IsActive}"
                                    IsVisible="{Binding CategoryFilter.IsAvailable}">
                                <TextBlock Text="{Binding CategoryFilter.ChipText}" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="list-host">
                                        <ListBox ItemsSource="{Binding CategoryFilter.FlyoutItems}"
                                                 SelectedItem="{Binding CategoryFilter.SelectedDisplay, Mode=TwoWay}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <ItemsControl ItemsSource="{Binding ValueFilters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemSpacing="{DynamicResource DungeonSpacingXs}"
                                                   LineSpacing="{DynamicResource DungeonSpacingXs}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ct:ContentFilterChipViewModel">
                                        <Button Theme="{StaticResource DungeonChipOpener}" Classes.active="{Binding IsActive}"
                                                IsVisible="{Binding IsAvailable}">
                                            <TextBlock Text="{Binding ChipText}" />
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="list-host">
                                                    <ListBox ItemsSource="{Binding FlyoutItems}"
                                                             SelectedItem="{Binding SelectedDisplay, Mode=TwoWay}" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Theme="{StaticResource DungeonChipOpener}" Classes.active="{Binding SourceFilter.IsActive}"
                                    IsVisible="{Binding SourceFilter.IsAvailable}">
                                <TextBlock Text="{Binding SourceFilter.ChipText}" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="list-host">
                                        <ListBox ItemsSource="{Binding SourceFilter.FlyoutItems}"
                                                 SelectedItem="{Binding SourceFilter.SelectedDisplay, Mode=TwoWay}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </WrapPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <dc:SortPicker Grid.Column="0"
                                           Options="{Binding SortOptions}"
                                           SelectedOption="{Binding SelectedSort, Mode=TwoWay}"
                                           CanReverse="False" />
                            <Button Grid.Column="1" Classes="link" HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Command="{Binding ClearFiltersCommand}"
                                    Content="Wyczyść filtry" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource DungeonBorderBrush}" BorderThickness="0,0,0,1" />

                    <!-- Jedna warstwa przewijania: ScrollViewer nad ItemsControl (bez własnego przewijania).
                         Strefa paska należy do wiersza (motyw ListRow), a tło wiersza sięga pod pasek. -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,24">
                            <!-- Pusty stan: żadna paczka nie ma wpisów tego typu. Ścieżki katalogu paczek
                                 zakładka jeszcze nie zna (brief 3a - zgłoszone w raporcie). -->
                            <dc:EmptyState IsVisible="{Binding HasNoEntries}"
                                           Margin="{DynamicResource DungeonPaddingLg}"
                                           Message="{Binding EmptyText}"
                                           Hint="Paczki treści leżą w katalogu paczek aplikacji." />

                            <!-- Pusty stan: nic nie pasuje (wzór: galeria, Kompozycje). -->
                            <StackPanel IsVisible="{Binding HasNoMatches}"
                                        Margin="{DynamicResource DungeonPaddingLg}"
                                        Spacing="{DynamicResource DungeonSpacingSm}">
                                <dc:EmptyState Message="Nic nie pasuje do wyszukiwania i filtrów." />
                                <Button Classes="link" HorizontalAlignment="Center"
                                        Command="{Binding ClearFiltersCommand}"
                                        Content="Wyczyść filtry" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ct:ContentSectionViewModel">
                                        <StackPanel>
                                            <!-- Nagłówek zwykłej paczki: nazwa i liczba wpisów sekcji. -->
                                            <Panel IsVisible="{Binding !IsRejectedPack}">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="{DynamicResource DungeonSpacingXs}"
                                                            Margin="{StaticResource ContentSectionHeaderMargin}"
                                                            IsVisible="{Binding !IsFirst}">
                                                    <TextBlock Classes="overline-sm muted" VerticalAlignment="Center"
                                                               Text="{Binding Header, Converter={StaticResource UpperCase}}" />
                                                    <TextBlock Classes="mono muted" VerticalAlignment="Center"
                                                               Text="{Binding Count, StringFormat={}{0}}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="{DynamicResource DungeonSpacingXs}"
                                                            Margin="{StaticResource ContentFirstSectionHeaderMargin}"
                                                            IsVisible="{Binding IsFirst}">
                                                    <TextBlock Classes="overline-sm muted" VerticalAlignment="Center"
                                                               Text="{Binding Header, Converter={StaticResource UpperCase}}" />
                                                    <TextBlock Classes="mono muted" VerticalAlignment="Center"
                                                               Text="{Binding Count, StringFormat={}{0}}" />
                                                </StackPanel>
                                            </Panel>

                                            <!-- Nagłówek odrzuconej paczki: kolor treści niewczytanej i ostrzeżenie. -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{DynamicResource DungeonSpacingXs}"
                                                        Margin="{StaticResource ContentSectionHeaderMargin}"
                                                        IsVisible="{Binding IsRejectedPack}">
                                                <dc:ForegroundIcon Width="{DynamicResource DungeonActionIconSize}"
                                                                   Height="{DynamicResource DungeonActionIconSize}"
                                                                   VerticalAlignment="Center"
                                                                   Source="{DynamicResource DungeonIconWarningTriangle}"
                                                                   Foreground="{DynamicResource DungeonDangerTextBrush}" />
                                                <TextBlock Classes="overline-sm" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource DungeonDangerTextBrush}"
                                                           Text="{Binding Header, Converter={StaticResource UpperCase}}" />
                                            </StackPanel>

                                            <ItemsControl Classes="content-rows"
                                                          ItemsSource="{Binding Rows}"
                                                          ItemTemplate="{StaticResource ContentRowTemplate}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== Obszar szczegółu: jedyna warstwa przewijania po tej stronie. Klocek 560 stoi przy
                 liście (wyrównany do lewej); szerszy ekran daje pusty pas z prawej. ===== -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                <Border Margin="{StaticResource ContentDetailMargin}"
                        Padding="{DynamicResource DungeonScrollBarZone}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <Panel>
                        <TextBlock Classes="body muted"
                                   IsVisible="{Binding ShowSelectionPrompt}"
                                   Text="Wybierz wpis z listy." />
                        <!-- Rama szczegółu należy do hosta, nie do klocka (brief runda 3a): tło, linia
                             i narożnik karty ramy (surface-card, jak karta w galerii Kompozycje),
                             wcięcie 24 ze wszystkich stron. Szerokość z klocka 560 + 2 x 24 (+ linia),
                             wysokość z treści; stoi też przy rzeczy zepsutej. -->
                        <Border Classes="surface-card"
                                Padding="{DynamicResource DungeonPaddingXxl}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsVisible="{Binding HasDetail}">
                            <ctl:EntryDetailView DataContext="{Binding Detail}" />
                        </Border>
                    </Panel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
