<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:DungeonApp.Desktop.Shell"
        x:Class="DungeonApp.Desktop.MainWindow"
        x:DataType="shell:AppShellViewModel"
        Width="1280"
        Height="800"
        MinWidth="{DynamicResource DungeonMinimumWindowWidth}"
        MinHeight="{DynamicResource DungeonMinimumWindowHeight}"
        Background="{DynamicResource DungeonFrameBrush}"
        UseLayoutRounding="True"
        Title="DungeonApp">

    <Panel>
        <shell:AppShellView />

        <!--
            Full-window startup curtain: covers topbar, sidebar and workspace alike, not just the
            workspace cell. Układ portowany z zaakceptowanego mockupu (wariant A): oś pionowa,
            wszystko wyśrodkowane - marka, nazwa, pasek postępu, tekst kroku.

            IsHitTestVisible drops the instant AppShellViewModel.IsReady flips; the fade itself is a
            transition on Opacity and is not waited on.
        -->
        <Border Name="StartupCurtain"
                Classes.ready="{Binding IsReady}"
                IsHitTestVisible="{Binding IsStarting}"
                Background="{DynamicResource DungeonBackstageBrush}">
            <Border.Styles>
                <Style Selector="Border#StartupCurtain">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="Border#StartupCurtain.ready">
                    <Setter Property="Opacity" Value="0" />
                </Style>
            </Border.Styles>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="{DynamicResource DungeonSpacingLg}">
                <Border Width="{DynamicResource DungeonBrandMarkLargeFrameSize}"
                        Height="{DynamicResource DungeonBrandMarkLargeFrameSize}"
                        HorizontalAlignment="Center"
                        BorderBrush="{DynamicResource DungeonAccentBrush}"
                        BorderThickness="1">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource DungeonDisplayFont}"
                               FontSize="{DynamicResource DungeonBrandMarkLargeFontSize}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DungeonAccentBrightBrush}"
                               Text="D" />
                </Border>

                <TextBlock HorizontalAlignment="Center"
                           FontFamily="{DynamicResource DungeonDisplayFont}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                           Text="DungeonApp" />

                <ProgressBar Width="{DynamicResource DungeonLoadingProgressBarWidth}"
                             Height="{DynamicResource DungeonLoadingProgressBarHeight}"
                             HorizontalAlignment="Center"
                             Minimum="0"
                             Maximum="{Binding TotalSteps}"
                             Value="{Binding CompletedSteps}" />

                <TextBlock HorizontalAlignment="Center"
                           Foreground="{DynamicResource DungeonTextRegularBrush}"
                           Text="{Binding StartupMessage}" />
            </StackPanel>
        </Border>
    </Panel>
</Window>
