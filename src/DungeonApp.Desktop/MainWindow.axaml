<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="using:DungeonApp.Desktop.Shell"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="DungeonApp.Desktop.MainWindow"
        x:DataType="shell:AppShellViewModel"
        Width="1280"
        Height="800"
        MinWidth="{DynamicResource DungeonMinimumWindowWidth}"
        MinHeight="{DynamicResource DungeonMinimumWindowHeight}"
        Background="{DynamicResource DungeonBackgroundBrush}"
        UseLayoutRounding="True"
        Title="DungeonApp">
    <shell:AppShellView />
</Window>
