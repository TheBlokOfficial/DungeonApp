<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:DungeonApp.Desktop.Shell"
        x:Class="DungeonApp.Desktop.MainWindow"
        Width="1280"
        Height="800"
        MinWidth="{DynamicResource DungeonMinimumWindowWidth}"
        MinHeight="{DynamicResource DungeonMinimumWindowHeight}"
        Background="{DynamicResource DungeonBackgroundBrush}"
        UseLayoutRounding="True"
        Title="DungeonApp">

    <shell:AppShellView />
</Window>