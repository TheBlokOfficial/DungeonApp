<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DungeonApp.Desktop.Features.CampaignLibrary"
             mc:Ignorable="d"
             d:DesignWidth="420"
             d:DesignHeight="300"
             x:Class="DungeonApp.Desktop.Features.CampaignLibrary.CampaignDetailView"
             x:DataType="vm:CampaignLibraryViewModel">
    <Border IsVisible="{Binding HasCampaigns}"
            Padding="16"
            VerticalAlignment="Top"
            MinHeight="248"
            Background="{DynamicResource DungeonSurfaceBrush}"
            BorderBrush="{DynamicResource DungeonBorderBrush}"
            BorderThickness="1">
        <Grid RowDefinitions="Auto,16,1,16,Auto,*,Auto">
            <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                <Border Width="46"
                        Height="46"
                        BorderBrush="{DynamicResource DungeonBorderStrongBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource DungeonSurfaceHeaderBrush}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource DungeonDisplayFont}"
                               FontSize="{DynamicResource DungeonDetailInitialFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DungeonAccentBrightBrush}"
                               Text="{Binding SelectedCampaign.Initials}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock FontFamily="{DynamicResource DungeonDisplayFont}"
                               FontSize="{DynamicResource DungeonDetailTitleFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding SelectedCampaign.Name}" />
                    <TextBlock Classes="muted" Text="{Binding SelectedCampaign.Metadata}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource DungeonBorderBrush}" />

            <StackPanel Grid.Row="4" Spacing="6">
                <TextBlock Classes="eyebrow" Text="AKTYWNE MODUŁY" />
                <TextBlock Foreground="{DynamicResource DungeonTextRegularBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding SelectedCampaign.ModuleSummary}" />
            </StackPanel>

            <Button Grid.Row="6"
                    HorizontalAlignment="Left"
                    Command="{Binding OpenCampaignCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image Width="{DynamicResource DungeonActionIconSize}"
                           Height="{DynamicResource DungeonActionIconSize}"
                           Source="{StaticResource DungeonIconFolderOpen}" />
                    <TextBlock VerticalAlignment="Center" Text="Otwórz workspace" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
