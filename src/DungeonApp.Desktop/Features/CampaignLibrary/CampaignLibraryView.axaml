<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DungeonApp.Desktop.Features.CampaignLibrary"
             mc:Ignorable="d"
             d:DesignWidth="1064"
             d:DesignHeight="728"
             x:Class="DungeonApp.Desktop.Features.CampaignLibrary.CampaignLibraryView"
             x:DataType="vm:CampaignLibraryViewModel">
    <UserControl.Resources>
        <SolidColorBrush x:Key="DungeonWorkspaceGridLineBrush"
                         Color="{DynamicResource DungeonBorderColor}"
                         Opacity="0.12" />
        <Pen x:Key="DungeonWorkspaceGridPen"
             Brush="{StaticResource DungeonWorkspaceGridLineBrush}"
             Thickness="1" />
        <StreamGeometry x:Key="DungeonWorkspaceGridGeometry">M 0,0 L 32,0 M 0,0 L 0,32</StreamGeometry>
        <DrawingBrush x:Key="DungeonWorkspaceGridPatternBrush"
                      TileMode="Tile"
                      SourceRect="0,0,32,32"
                      DestinationRect="0,0,32,32">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="{StaticResource DungeonWorkspaceGridGeometry}"
                                 Pen="{StaticResource DungeonWorkspaceGridPen}" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Grid.content-rail">
            <Setter Property="MaxWidth" Value="960" />
        </Style>
        <ContainerQuery Name="CampaignLibrary" Query="min-width:960">
            <Style Selector="Grid.content-rail">
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </ContainerQuery>
        <ContainerQuery Name="CampaignLibrary" Query="min-width:1360">
            <Style Selector="Grid#StandardLayout">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="Grid#WideLayout">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <Grid Background="{DynamicResource DungeonBackgroundBrush}"
          RowDefinitions="Auto,*"
          Container.Name="CampaignLibrary"
          Container.Sizing="Width">
        <Border Grid.RowSpan="2"
                Background="{StaticResource DungeonWorkspaceGridPatternBrush}"
                IsHitTestVisible="False" />
        <Border Background="Transparent"
                BorderBrush="{DynamicResource DungeonBorderBrush}"
                BorderThickness="0,0,0,1"
                Height="{DynamicResource DungeonWorkspaceHeaderHeight}">
            <Grid Classes="content-rail" Margin="16,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock Classes="eyebrow" Text="BIBLIOTEKA" />
                    <TextBlock Classes="workspace-title" Text="Kampanie" />
                </StackPanel>

                <Button Grid.Column="1"
                        MinWidth="200"
                        VerticalAlignment="Center"
                        Command="{Binding OpenCampaignCommand}"
                        Content="Otwórz wybraną kampanię" />

                <Button Grid.Column="2"
                        Classes="primary"
                        VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <Border Width="320"
                                    Padding="16"
                                    Background="{DynamicResource DungeonSurfaceHeaderBrush}"
                                    BorderBrush="{DynamicResource DungeonBorderStrongBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                                                   Text="Nowa kampania" />
                                        <TextBlock Classes="muted" Text="Szkic zostanie zapisany lokalnie." />
                                    </StackPanel>
                                    <TextBox Text="{Binding NewCampaignName}" PlaceholderText="Nazwa kampanii" />
                                    <CheckBox IsChecked="{Binding IsClockEnabled}" Content="Włącz zegar świata" />
                                    <Button Classes="primary"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding CreateCampaignCommand}"
                                            Content="Utwórz kampanię" />
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="{DynamicResource DungeonActionIconSize}"
                               Height="{DynamicResource DungeonActionIconSize}"
                               Source="{StaticResource DungeonIconPlus}" />
                        <TextBlock VerticalAlignment="Center" Text="Nowa kampania" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid x:Name="StandardLayout" Classes="content-rail" RowDefinitions="38,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource DungeonTextMutedBrush}"
                               Text="Lokalna biblioteka światów i przygód" />
                    <Button Grid.Column="1"
                            Classes="icon"
                            VerticalAlignment="Center"
                            Command="{Binding LoadCampaignsCommand}"
                            ToolTip.Tip="Odśwież bibliotekę">
                        <Image Width="{DynamicResource DungeonActionIconSize}"
                               Height="{DynamicResource DungeonActionIconSize}"
                               Source="{StaticResource DungeonIconRefresh}" />
                    </Button>
                </Grid>
                <vm:CampaignListView Grid.Row="1" />
            </Grid>

            <Grid x:Name="WideLayout"
                  IsVisible="False"
                  RowDefinitions="38,Auto"
                  RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource DungeonCampaignMasterWidth}" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource DungeonTextMutedBrush}"
                               Text="Lokalna biblioteka światów i przygód" />
                    <Button Grid.Column="1"
                            Classes="icon"
                            VerticalAlignment="Center"
                            Command="{Binding LoadCampaignsCommand}"
                            ToolTip.Tip="Odśwież bibliotekę">
                        <Image Width="{DynamicResource DungeonActionIconSize}"
                               Height="{DynamicResource DungeonActionIconSize}"
                               Source="{StaticResource DungeonIconRefresh}" />
                    </Button>
                </Grid>
                <TextBlock Grid.Column="2"
                           Margin="0,0,8,0"
                           Classes="eyebrow"
                           VerticalAlignment="Center"
                           Text="SZCZEGÓŁY KAMPANII" />
                <vm:CampaignListView Grid.Row="1" Grid.Column="0" />
                <vm:CampaignDetailView Grid.Row="1" Grid.Column="2" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
