<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:library="using:DungeonApp.Desktop.Features.CampaignLibrary"
             xmlns:controls="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Desktop.Features.CampaignLibrary.CampaignLibraryView"
             x:DataType="library:CampaignLibraryViewModel">

    <UserControl.Styles>
        <!-- A shelf row. A minimum rather than a fixed height on purpose: the list must stay
             scannable and must not re-flow for its own sake, but an unavailable row is allowed to
             grow by exactly one line for its reason - see Border.campaign-row.unavailable below. -->
        <Style Selector="Border.campaign-row">
            <Setter Property="MinHeight" Value="{DynamicResource DungeonCampaignRowHeight}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector="Border.campaign-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowHoverBrush}" />
        </Style>
        <!-- A destructive action owns its hover state. Keep the record at rest while its trash
             control is hovered, so it never looks like opening and deleting are one action. -->
        <Style Selector="Border.campaign-row.delete-hover:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowBrush}" />
        </Style>
        <!-- An unavailable campaign: greyed by reusing the muted text token everywhere the
             available row uses the primary one, never a new brush or an opacity literal. -->
        <Style Selector="Border.campaign-row.unavailable TextBlock.campaign-name">
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        </Style>
        <Style Selector="Button.campaign-open">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.campaign-delete">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
            <Setter Property="ToolTip.Tip" Value="Usuń kampanię" />
        </Style>
        <Style Selector="Button.campaign-delete:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- The persistent backstage surface is painted by AppShellView. This view contributes only
         its content, so switching static screens never crossfades a full-size opaque background. -->
    <!-- The host fills the shell but pins its bounded child at the top-left. This avoids the
         centring side effect of MaxWidth/MaxHeight while preserving a finite list viewport. -->
    <!-- At the supported minimum window (1280×720), this host fits the whole static library
         structure: heading, creation form, shelf frame and a stable list viewport. Larger windows
         add backstage space rather than stretching the shelf. -->
    <Grid Background="{DynamicResource DungeonBackstageBrush}">
    <!-- The vignette has a fixed canvas rather than percentage-based visibility. Resizing the
         window therefore reveals or clips its right side without recolouring the whole surface. -->
    <Border Width="3200"
            HorizontalAlignment="Left"
            Background="{DynamicResource DungeonBackstageWideBrush}"
            IsHitTestVisible="False" />
    <controls:AnchoredContentHost MaxContentWidth="760" MaxContentHeight="614">
        <Grid Background="Transparent"
              MinHeight="0"
              Margin="28,20,28,24">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">

            <StackPanel Spacing="{DynamicResource DungeonSpacingXs}">
                <TextBlock Classes="muted" Text="Kampanie" />
                <TextBlock Classes="workspace-title" Text="Biblioteka kampanii" />
                <TextBlock Classes="muted"
                           Text="Otwórz istniejącą kampanię albo utwórz nową." />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,20,0,0"
                    Background="{DynamicResource DungeonBackstageCardBrush}"
                    BorderBrush="{DynamicResource DungeonBorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource DungeonCardCornerRadius}"
                    ClipToBounds="True"
                    Padding="14,12">
                <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                    <TextBlock Classes="eyebrow" Text="NOWA KAMPANIA" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource DungeonSpacingSm}">
                        <Grid>
                            <TextBox Padding="36,0,12,0"
                                     PlaceholderText="Nazwa nowej kampanii"
                                     Text="{Binding NewCampaignName, Mode=TwoWay}"
                                     Height="{DynamicResource DungeonControlHeight}"
                                     VerticalContentAlignment="Center">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
                            </TextBox.KeyBindings>
                            </TextBox>
                            <Image Width="16"
                                   Height="16"
                                   Margin="12,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Source="{StaticResource DungeonIconPencil}" />
                        </Grid>
                        <Button Grid.Column="1"
                                Classes="primary"
                                Content="+  Utwórz"
                                Command="{Binding CreateCommand}"
                                Height="{DynamicResource DungeonControlHeight}"
                                Padding="20,0" />
                    </Grid>
                    <TextBlock
                               FontSize="{DynamicResource DungeonHelperFontSize}"
                               Foreground="{DynamicResource DungeonDangerBrush}"
                               IsVisible="{Binding HasNameError}"
                               Text="{Binding NameError}" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2"
                       Margin="2,24,0,8"
                       Classes="eyebrow"
                       IsVisible="{Binding HasCampaigns}"
                       Text="ZAPISANE KAMPANIE" />

            <!-- List records are independent documents. Spacing replaces the continuous grid of
                 table rules, while this remains the page's only scrolling region. -->
            <Panel Grid.Row="3" MinHeight="0">
                <ScrollViewer Classes="campaign-list"
                              Height="{DynamicResource DungeonCampaignListViewportHeight}"
                              VerticalAlignment="Top"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              AllowAutoHide="True"
                              IsVisible="{Binding HasCampaigns}">
                    <ItemsControl ItemsSource="{Binding Campaigns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="library:CampaignRowViewModel">
                                <Border Classes="campaign-row" Classes.unavailable="{Binding !IsAvailable}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,28,16" ColumnSpacing="{DynamicResource DungeonSpacingSm}">
                                        <!-- A sibling, full-row button avoids nesting a destructive
                                             button inside an open button. The visual content is made
                                             click-through, so only the delete control intercepts it.
                                             Disabled together with OpenCommand's own canExecute - an
                                             unavailable campaign refuses to open at the operation
                                             level too, not only through this disabled button. -->
                                        <Button Grid.ColumnSpan="5"
                                                Classes="campaign-open"
                                                Command="{Binding OpenCommand}" />
                                        <Grid Grid.ColumnSpan="3"
                                              ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="{DynamicResource DungeonSpacingSm}"
                                              IsHitTestVisible="False">
                                            <Border Width="28"
                                                    Height="28"
                                                    CornerRadius="{DynamicResource DungeonControlCornerRadius}"
                                                    Background="{DynamicResource DungeonBackstageBrush}"
                                                    BorderBrush="{DynamicResource DungeonBorderBrush}"
                                                    BorderThickness="1">
                                                <Image Width="16"
                                                       Height="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Source="{StaticResource DungeonIconCampaignRecord}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Classes="campaign-name"
                                                           FontFamily="{DynamicResource DungeonDisplayFont}"
                                                           FontSize="{DynamicResource DungeonCampaignNameFontSize}"
                                                           Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="{DynamicResource DungeonHelperFontSize}"
                                                           Foreground="{DynamicResource DungeonTextMutedBrush}"
                                                           IsVisible="{Binding !IsAvailable}"
                                                           Text="{Binding UnavailabilityReason}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource DungeonHelperFontSize}"
                                                       Foreground="{DynamicResource DungeonTextMutedBrush}"
                                                       Text="{Binding CreatedAt}" />
                                        </Grid>
                                        <Button Grid.Column="3"
                                                Classes="campaign-delete"
                                                Command="{Binding DeleteCommand}"
                                                PointerEntered="OnDeletePointerEntered"
                                                PointerExited="OnDeletePointerExited">
                                            <Image Width="16"
                                                   Height="16"
                                                   Source="{StaticResource DungeonIconTrash}" />
                                        </Button>
                                        <Image Grid.Column="4"
                                               Width="16"
                                               Height="16"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Source="{StaticResource DungeonIconChevronRight}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- A calm, horizontally centred hint: it belongs to the creation flow, not to
                     an imaginary first row. The Auto row keeps it immediately below the creator. -->
                <TextBlock Margin="20,20,20,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource DungeonTextMutedBrush}"
                           IsVisible="{Binding IsEmpty}"
                           Text="Nie ma jeszcze żadnej kampanii. Nazwij pierwszą powyżej."
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Panel>
            </Grid>

        </Grid>
    </controls:AnchoredContentHost>
    </Grid>
</UserControl>
