<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:library="using:DungeonApp.Desktop.Features.CampaignLibrary"
             xmlns:controls="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Desktop.Features.CampaignLibrary.CampaignLibraryView"
             x:DataType="library:CampaignLibraryViewModel">

    <UserControl.Styles>
        <!-- A shelf row. Fixed height on purpose: the list must stay scannable and must not
             re-flow because one campaign has a longer name than the rest. -->
        <Style Selector="Button.campaign-row">
            <Setter Property="Height" Value="{DynamicResource DungeonCampaignRowHeight}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.campaign-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowHoverBrush}" />
        </Style>
        <Style Selector="Button.campaign-delete">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <!-- The persistent backstage surface is painted by AppShellView. This view contributes only
         its content, so switching static screens never crossfades a full-size opaque background. -->
    <!-- The host fills the shell but pins its bounded child at the top-left. This avoids the
         centring side effect of MaxWidth/MaxHeight while preserving a finite list viewport. -->
    <!-- At the supported minimum window (1280×720), this host fits the whole static library
         structure: heading, creation form, shelf frame and a stable list viewport. Larger windows
         add backstage space rather than stretching the shelf. -->
    <controls:AnchoredContentHost MaxContentWidth="680" MaxContentHeight="614">
        <Grid Background="Transparent"
              MinHeight="0"
              Margin="28,20,28,24">
            <Grid RowDefinitions="Auto,Auto,Auto,*">

            <StackPanel Spacing="6">
                <TextBlock Classes="muted" Text="Kampanie" />
                <TextBlock Classes="workspace-title" Text="Biblioteka kampanii" />
                <TextBlock Classes="muted"
                           Text="Otwórz istniejącą kampanię albo utwórz nową." />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,20,0,0"
                    Background="{DynamicResource DungeonBackstageCardBrush}"
                    BorderBrush="{DynamicResource DungeonBorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource DungeonCardCornerRadius}"
                    ClipToBounds="True"
                    Padding="14,12">
                <StackPanel Spacing="8">
                    <TextBlock Classes="eyebrow" Text="NOWA KAMPANIA" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Grid>
                            <TextBox Padding="36,0,12,0"
                                     PlaceholderText="Nazwa nowej kampanii"
                                     Text="{Binding NewCampaignName, Mode=TwoWay}"
                                     Height="{DynamicResource DungeonControlHeight}"
                                     VerticalContentAlignment="Center">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
                            </TextBox.KeyBindings>
                            </TextBox>
                            <Image Width="16"
                                   Height="16"
                                   Margin="12,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Source="{StaticResource DungeonIconPencil}" />
                        </Grid>
                        <Button Grid.Column="1"
                                Classes="primary"
                                Content="+  Utwórz"
                                Command="{Binding CreateCommand}"
                                Height="{DynamicResource DungeonControlHeight}"
                                Padding="20,0" />
                    </Grid>
                    <TextBlock
                               FontSize="{DynamicResource DungeonHelperFontSize}"
                               Foreground="{DynamicResource DungeonDangerBrush}"
                               IsVisible="{Binding HasNameError}"
                               Text="{Binding NameError}" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2"
                       Margin="2,24,0,8"
                       Classes="eyebrow"
                       IsVisible="{Binding HasCampaigns}"
                       Text="ZAPISANE KAMPANIE" />

            <!-- List records are independent documents. Spacing replaces the continuous grid of
                 table rules, while this remains the page's only scrolling region. -->
            <Panel Grid.Row="3" MinHeight="0">
                <ScrollViewer Classes="campaign-list"
                              Height="{DynamicResource DungeonCampaignListViewportHeight}"
                              VerticalAlignment="Top"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              AllowAutoHide="True"
                              IsVisible="{Binding HasCampaigns}">
                    <ItemsControl ItemsSource="{Binding Campaigns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="library:CampaignRowViewModel">
                                <Button Classes="campaign-row" Command="{Binding OpenCommand}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                                        <Border Width="28"
                                                Height="28"
                                                CornerRadius="{DynamicResource DungeonControlCornerRadius}"
                                                Background="{DynamicResource DungeonBackstageBrush}"
                                                BorderBrush="{DynamicResource DungeonBorderBrush}"
                                                BorderThickness="1">
                                            <Image Width="16"
                                                   Height="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Source="{StaticResource DungeonIconCampaignRecord}" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource DungeonDisplayFont}"
                                                   FontSize="{DynamicResource DungeonCampaignNameFontSize}"
                                                   Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource DungeonHelperFontSize}"
                                                   Foreground="{DynamicResource DungeonTextMutedBrush}"
                                                   Text="{Binding CreatedAt}" />
                                        <Button Grid.Column="3"
                                                Classes="campaign-delete"
                                                Command="{Binding DeleteCommand}">
                                            <Image Width="16"
                                                   Height="16"
                                                   Source="{StaticResource DungeonIconTrash}" />
                                        </Button>
                                        <Image Grid.Column="4"
                                               Width="16"
                                               Height="16"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center"
                                               Source="{StaticResource DungeonIconChevronRight}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- The empty state occupies the exact place of the first record. It does not
                     reserve a list viewport or use vertical centring, because there is no list
                     to scroll yet. -->
                <Border Height="{DynamicResource DungeonCampaignRowHeight}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource DungeonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource DungeonControlCornerRadius}"
                        IsVisible="{Binding IsEmpty}">
                    <TextBlock Margin="20,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource DungeonTextMutedBrush}"
                               Text="Nie ma jeszcze żadnej kampanii. Nazwij pierwszą powyżej."
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>
            </Panel>
            </Grid>

            <!-- Status is a transient toast, deliberately layered above the page rather than
                 inserted below its content. This keeps an empty-library hint from acquiring a
                 competing second label after an action. -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    MaxWidth="320"
                    Margin="0,2,0,0"
                    Padding="12,8"
                    Background="{DynamicResource DungeonBackstageCardBrush}"
                    BorderBrush="{DynamicResource DungeonBorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource DungeonControlCornerRadius}"
                    IsVisible="{Binding HasStatus}"
                    ZIndex="1">
                <TextBlock FontSize="{DynamicResource DungeonHelperFontSize}"
                           Foreground="{DynamicResource DungeonTextRegularBrush}"
                           Text="{Binding Status}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>
    </controls:AnchoredContentHost>
</UserControl>
