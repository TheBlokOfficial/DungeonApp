<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:library="using:DungeonApp.Desktop.Features.CampaignLibrary"
             x:Class="DungeonApp.Desktop.Features.CampaignLibrary.CampaignLibraryView"
             x:DataType="library:CampaignLibraryViewModel">

    <UserControl.Styles>
        <!-- A shelf row. Fixed height on purpose: the list must stay scannable and must not
             re-flow because one campaign has a longer name than the rest. -->
        <Style Selector="Button.campaign-row">
            <Setter Property="Height" Value="{DynamicResource DungeonCampaignRowHeight}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource DungeonCornerRadius}" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="Button.campaign-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowHoverBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- The persistent backstage surface is painted by AppShellView. This view contributes only
         its content, so switching static screens never crossfades a full-size opaque background. -->
    <Border Background="Transparent">
        <Grid Width="784"
              Margin="32,56,32,32"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              RowDefinitions="Auto,Auto"
              RowSpacing="10">

            <!-- The top bar already names the route. A small context label is enough here and
                 avoids turning this static backstage screen into a centred welcome modal. -->
            <TextBlock Classes="eyebrow" Text="BIBLIOTEKA" />

            <Border Grid.Row="1"
                    Background="{DynamicResource DungeonBackstageCardBrush}"
                    BorderBrush="{DynamicResource DungeonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource DungeonCornerRadius}"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <Border Padding="20,18,20,14"
                            BorderBrush="{DynamicResource DungeonBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="eyebrow" Text="NOWA KAMPANIA" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox PlaceholderText="Nazwa nowej kampanii"
                                         Text="{Binding NewCampaignName, Mode=TwoWay}"
                                         Height="{DynamicResource DungeonControlHeight}"
                                         VerticalContentAlignment="Center">
                                    <TextBox.KeyBindings>
                                        <!-- Enter commits, the way it would in a dialog. -->
                                        <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="1"
                                        Classes="primary"
                                        Content="Utwórz"
                                        Command="{Binding CreateCommand}"
                                        Height="{DynamicResource DungeonControlHeight}"
                                        Padding="20,0" />
                            </Grid>

                            <!-- Reserved slot: validation appears and disappears without moving the form. -->
                            <TextBlock MinHeight="16"
                                       FontSize="{DynamicResource DungeonHelperFontSize}"
                                       Foreground="{DynamicResource DungeonDangerBrush}"
                                       Text="{Binding NameError}" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto">
                        <TextBlock Margin="20,8,20,6"
                                   Classes="eyebrow"
                                   Text="ZAPISANE KAMPANIE" />

                        <Panel Grid.Row="1"
                               Margin="0,0,0,12"
                               MinHeight="{DynamicResource DungeonCampaignRowHeight}"
                               MaxHeight="{DynamicResource DungeonCampaignListMaxHeight}">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="{DynamicResource DungeonCampaignListMaxHeight}"
                                          IsVisible="{Binding HasCampaigns}">
                                <ItemsControl ItemsSource="{Binding Campaigns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="library:CampaignRowViewModel">
                                            <Button Classes="campaign-row" Command="{Binding OpenCommand}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontFamily="{DynamicResource DungeonDisplayFont}"
                                                               FontSize="{DynamicResource DungeonBaseFontSize}"
                                                               Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               FontSize="{DynamicResource DungeonHelperFontSize}"
                                                               Foreground="{DynamicResource DungeonTextMutedBrush}"
                                                               Text="{Binding CreatedAt}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Loading and empty occupy the same first-row floor as real data. -->
                            <TextBlock Margin="20,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DungeonTextMutedBrush}"
                                       IsVisible="{Binding IsEmpty}"
                                       Text="Nie ma jeszcze żadnej kampanii. Nazwij pierwszą powyżej."
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Panel>
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="20,0,20,14"
                            IsVisible="{Binding HasStatus}">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="{DynamicResource DungeonHelperFontSize}"
                                   Foreground="{DynamicResource DungeonTextMutedBrush}"
                                   Text="{Binding Status}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
