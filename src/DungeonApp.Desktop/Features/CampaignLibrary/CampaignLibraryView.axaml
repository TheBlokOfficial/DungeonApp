<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:library="using:DungeonApp.Desktop.Features.CampaignLibrary"
             xmlns:controls="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Desktop.Features.CampaignLibrary.CampaignLibraryView"
             x:DataType="library:CampaignLibraryViewModel">

    <UserControl.Styles>
        <!-- A shelf row. A minimum rather than a fixed height so the row can accommodate content,
             but the row's layout is identical whether the campaign is available or not - an
             unavailable row carries no reason line, so it never grows past this minimum. -->
        <Style Selector="Border.campaign-row">
            <Setter Property="MinHeight" Value="{DynamicResource DungeonCampaignRowHeight}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <!-- The trash band belongs to the row: the record stays highlighted while the pointer is
             over it. -->
        <Style Selector="Border.campaign-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowHoverBrush}" />
        </Style>
        <!-- An unavailable row sits one step back from an available one: the backstage workspace's
             own background (DungeonBackstageBrush) rather than the raised row background every other
             row stands on - reused for its documented role (the recessed surface a row sits on top
             of), not picked for being darker. Border unchanged. -->
        <Style Selector="Border.campaign-row.unavailable">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageBrush}" />
        </Style>
        <!-- An unavailable row has nothing of its own to react to a hover - the trash control is
             the only interactive thing left in it, and it shows its own hover. Stays
             at its own (recessed) rest color instead of the available row's rest color. -->
        <Style Selector="Border.campaign-row.unavailable:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageBrush}" />
        </Style>
        <!-- Name, date and arrow dim the same way any disabled control in this theme does - the
             Button ControlTheme's own disabled style (Themes/Controls/Button.axaml) and this one
             share DungeonDisabledOpacity (Themes/Tokens.axaml), the only disabled-state opacity this
             theme defines.
             One selector per concrete type, not a shared "Control.campaign-dim:disabled" base-type
             selector: the base-type form compiled and matched the class and the pseudo-class alike
             (confirmed by inspecting the StackPanel's own Classes at runtime) but its Setter never
             actually took effect - listing StackPanel/TextBlock/Image explicitly is what makes the
             Opacity setter apply. -->
        <Style Selector="StackPanel.campaign-dim:disabled, TextBlock.campaign-dim:disabled, Image.campaign-dim:disabled">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
        <!-- Open row (ListRow, no selection or stripe) fills the record: height from the record
             (DungeonCampaignRowHeight), not the shell list row - list style, not content. -->
        <Style Selector="ScrollViewer.campaign-list controls|ListRow">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <!-- The trash band (DungeonRowAction) spans the record's full height: out through the
             record's 1 px border vertically. Its right edge stays at its own column - the record's
             arrow follows it, so the theme's margin out to the row's end does not apply here. -->
        <Style Selector="Button.campaign-delete">
            <Setter Property="Margin" Value="0,-1" />
        </Style>
    </UserControl.Styles>

    <!-- The persistent backstage surface is painted by AppShellView. This view contributes only
         its content, so switching static screens never crossfades a full-size opaque background. -->
    <!-- The host fills the shell but pins its bounded child at the top-left. This avoids the
         centring side effect of MaxWidth/MaxHeight while preserving a finite list viewport. -->
    <!-- At the supported minimum window (1280×720), this host fits the whole static library
         structure: heading, creation form, shelf frame and a stable list viewport. Larger windows
         add backstage space rather than stretching the shelf. -->
    <Grid Background="{DynamicResource DungeonBackstageBrush}">
    <!-- The vignette has a fixed canvas rather than percentage-based visibility. Resizing the
         window therefore reveals or clips its right side without recolouring the whole surface. -->
    <Border Width="3200"
            HorizontalAlignment="Left"
            Background="{DynamicResource DungeonBackstageWideBrush}"
            IsHitTestVisible="False" />
    <controls:AnchoredContentHost MaxContentWidth="760" MaxContentHeight="614">
        <Grid Background="Transparent"
              MinHeight="0"
              Margin="28,20,28,24">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">

            <StackPanel Spacing="{DynamicResource DungeonSpacingXs}">
                <TextBlock Classes="muted" Text="Kampanie" />
                <TextBlock Classes="workspace-title" Text="Biblioteka kampanii" />
                <TextBlock Classes="muted"
                           Text="Otwórz istniejącą kampanię albo utwórz nową." />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,20,0,0"
                    Background="{DynamicResource DungeonBackstageCardBrush}"
                    BorderBrush="{DynamicResource DungeonBorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource DungeonCardCornerRadius}"
                    ClipToBounds="True"
                    Padding="14,12">
                <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                    <TextBlock Classes="eyebrow" Text="NOWA KAMPANIA" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource DungeonSpacingSm}">
                        <controls:IconField Icon="{StaticResource DungeonIconPencil}">
                            <TextBox PlaceholderText="Nazwa nowej kampanii"
                                     Text="{Binding NewCampaignName, Mode=TwoWay}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </controls:IconField>
                        <Button Grid.Column="1"
                                Classes="primary"
                                Content="+  Utwórz"
                                Command="{Binding CreateCommand}" />
                    </Grid>
                    <TextBlock
                               FontSize="{DynamicResource DungeonHelperFontSize}"
                               Foreground="{DynamicResource DungeonDangerTextBrush}"
                               IsVisible="{Binding HasNameError}"
                               Text="{Binding NameError}" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2"
                       Margin="2,24,0,8"
                       Classes="eyebrow"
                       IsVisible="{Binding HasCampaigns}"
                       Text="ZAPISANE KAMPANIE" />

            <!-- List records are independent documents. Spacing replaces the continuous grid of
                 table rules, while this remains the page's only scrolling region. -->
            <Panel Grid.Row="3" MinHeight="0">
                <ScrollViewer Classes="campaign-list"
                              Height="{DynamicResource DungeonCampaignListViewportHeight}"
                              VerticalAlignment="Top"
                              HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding HasCampaigns}">
                    <ItemsControl ItemsSource="{Binding Campaigns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="library:CampaignRowViewModel">
                                <Border Classes="campaign-row" Classes.unavailable="{Binding !IsAvailable}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource DungeonSpacingSm}">
                                        <!-- A sibling, full-row button avoids nesting a destructive
                                             button inside an open button. The visual content is made
                                             click-through, so only the delete control intercepts it.
                                             IsEnabled mirrors OpenCommand's own canExecute explicitly,
                                             rather than relying only on the command wiring - an
                                             unavailable campaign refuses to open at the operation
                                             level too, not only through this disabled button. -->
                                        <controls:ListRow Grid.ColumnSpan="5"
                                                          Command="{Binding OpenCommand}"
                                                          IsEnabled="{Binding IsAvailable}" />
                                        <Grid Grid.ColumnSpan="3"
                                              ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="{DynamicResource DungeonSpacingSm}"
                                              IsHitTestVisible="False">
                                            <Border Width="28"
                                                    Height="28"
                                                    CornerRadius="{DynamicResource DungeonControlCornerRadius}"
                                                    Background="{DynamicResource DungeonBackstageBrush}"
                                                    BorderBrush="{DynamicResource DungeonBorderBrush}"
                                                    BorderThickness="1">
                                                <Panel>
                                                    <!-- Available: the record emblem.
                                                         Unavailable: a warning triangle in place of it -
                                                         the row's only icon distinction. -->
                                                    <Image Width="16"
                                                           Height="16"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding IsAvailable}"
                                                           Source="{StaticResource DungeonIconCampaignRecord}" />
                                                    <Image Width="16"
                                                           Height="16"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !IsAvailable}"
                                                           Source="{StaticResource DungeonIconWarningTriangle}" />
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Classes="campaign-dim"
                                                        IsEnabled="{Binding IsAvailable}">
                                                <TextBlock Classes="campaign-name"
                                                           FontFamily="{DynamicResource DungeonDisplayFont}"
                                                           FontSize="{DynamicResource DungeonCampaignNameFontSize}"
                                                           Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Classes="campaign-dim"
                                                       IsEnabled="{Binding IsAvailable}"
                                                       FontSize="{DynamicResource DungeonHelperFontSize}"
                                                       Foreground="{DynamicResource DungeonTextMutedBrush}"
                                                       Text="{Binding CreatedAt}" />
                                        </Grid>
                                        <Button Grid.Column="3"
                                                Classes="campaign-delete"
                                                Theme="{StaticResource DungeonRowAction}"
                                                Command="{Binding DeleteCommand}">
                                            <controls:ForegroundIcon Width="16"
                                                                     Height="16"
                                                                     Source="{StaticResource DungeonIconTrash}" />
                                        </Button>
                                        <!-- The record reaches under the scroll bar; its content
                                             ends before the bar's zone (DungeonScrollBarZone after
                                             the arrow), so the open target still spans the record. -->
                                        <Image Grid.Column="4"
                                               Width="16"
                                               Height="16"
                                               Margin="{DynamicResource DungeonScrollBarZone}"
                                               VerticalAlignment="Center"
                                               Classes="campaign-dim"
                                               IsEnabled="{Binding IsAvailable}"
                                               IsHitTestVisible="False"
                                               Source="{StaticResource DungeonIconChevronRight}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty library: shell message at the top of the list area, just below the form. -->
                <controls:EmptyState IsVisible="{Binding IsEmpty}"
                                     Message="Nie ma jeszcze żadnej kampanii."
                                     Hint="Nazwij pierwszą w polu powyżej i utwórz ją." />
            </Panel>
            </Grid>

        </Grid>
    </controls:AnchoredContentHost>
    </Grid>
</UserControl>
