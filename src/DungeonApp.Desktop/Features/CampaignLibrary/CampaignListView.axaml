<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DungeonApp.Desktop.Features.CampaignLibrary"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="320"
             x:Class="DungeonApp.Desktop.Features.CampaignLibrary.CampaignListView"
             x:DataType="vm:CampaignLibraryViewModel">
    <Grid>
        <ListBox ItemsSource="{Binding Campaigns}"
                 SelectedItem="{Binding SelectedCampaign}"
                 IsVisible="{Binding HasCampaigns}"
                 MaxHeight="{DynamicResource DungeonCampaignListMaxHeight}"
                 VerticalAlignment="Top"
                 Background="{DynamicResource DungeonSurfaceBrush}"
                 BorderBrush="{DynamicResource DungeonBorderBrush}"
                 BorderThickness="1">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Height" Value="{DynamicResource DungeonCampaignRowHeight}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="CornerRadius" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="Stretch"
                                                  VerticalContentAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>
                <Style Selector="ListBoxItem:pointerover">
                    <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHoverBrush}" />
                </Style>
                <Style Selector="ListBoxItem:selected">
                    <Setter Property="Background" Value="{DynamicResource DungeonSurfaceActiveBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DungeonAccentBrush}" />
                </Style>
                <Style Selector="ListBoxItem:selected:pointerover">
                    <Setter Property="Background" Value="{DynamicResource DungeonSurfaceActiveBrush}" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CampaignListItemViewModel">
                    <Grid Height="{DynamicResource DungeonCampaignRowHeight}"
                          Margin="14,0"
                          ColumnDefinitions="40,*,160,88"
                          ColumnSpacing="14">
                        <Border Width="38"
                                Height="38"
                                VerticalAlignment="Center"
                                BorderBrush="{DynamicResource DungeonBorderStrongBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource DungeonSurfaceHeaderBrush}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource DungeonDisplayFont}"
                                       FontSize="{DynamicResource DungeonCampaignInitialFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DungeonAccentBrightBrush}"
                                       Text="{Binding Initials}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Name}" />
                            <TextBlock Classes="muted"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Metadata}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Classes="eyebrow" Text="MODUŁY" />
                            <TextBlock Classes="muted"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding ModuleSummary}"
                                       Text="{Binding ModuleSummary}" />
                        </StackPanel>

                        <TextBlock Grid.Column="3"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource DungeonEyebrowFontSize}"
                                   Foreground="{DynamicResource DungeonSuccessBrush}"
                                   Text="{Binding StatusLabel}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border IsVisible="{Binding IsEmpty}"
                Height="180"
                VerticalAlignment="Top"
                Background="{DynamicResource DungeonSurfaceBrush}"
                BorderBrush="{DynamicResource DungeonBorderBrush}"
                BorderThickness="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <Border Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        BorderBrush="{DynamicResource DungeonBorderStrongBrush}"
                        BorderThickness="1">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource DungeonDisplayFont}"
                               FontSize="{DynamicResource DungeonEmptyMarkFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DungeonAccentBrush}"
                               Text="D" />
                </Border>
                <TextBlock HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                           Text="Biblioteka jest pusta" />
                <TextBlock Classes="muted"
                           HorizontalAlignment="Center"
                           Text="Utwórz pierwszą kampanię, aby rozpocząć budowę świata." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
