<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:party="using:DungeonApp.Desktop.Features.CampaignWorkspace.Panels.Party"
             x:Class="DungeonApp.Desktop.Features.CampaignWorkspace.Panels.Party.PartyPanelView"
             x:DataType="party:PartyPanelViewModel">

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <TextBlock Classes="eyebrow" Text="PRZY STOLE" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
            <TextBox PlaceholderText="Gracz"
                     Text="{Binding PlayerName, Mode=TwoWay}"
                     Height="{DynamicResource DungeonControlHeight}"
                     VerticalContentAlignment="Center" />
            <!-- Optional on purpose: a player can take a seat before deciding who they play. -->
            <TextBox Grid.Column="1"
                     PlaceholderText="Postać"
                     Text="{Binding CharacterName, Mode=TwoWay}"
                     Height="{DynamicResource DungeonControlHeight}"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="2"
                    Padding="14,0"
                    Height="{DynamicResource DungeonControlHeight}"
                    Content="Posadź"
                    Command="{Binding SeatCommand}" />
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource DungeonBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource DungeonCornerRadius}">
            <Panel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Participants}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="party:ParticipantViewModel">
                                <!-- Fixed row height: the roster must stay scannable however long a
                                     name is, the same as the schedule beside it. -->
                                <Grid Height="{DynamicResource DungeonNavigationRowHeight}"
                                      Margin="12,0"
                                      ColumnDefinitions="*,Auto,Auto,Auto"
                                      ColumnSpacing="10">
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                                                   Text="{Binding PlayerName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="{DynamicResource DungeonHelperFontSize}"
                                                   Foreground="{DynamicResource DungeonTextMutedBrush}"
                                                   Text="{Binding CharacterName}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Absence is the exception, so only it is coloured. -->
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource DungeonHelperFontSize}"
                                               Foreground="{DynamicResource DungeonTextMutedBrush}"
                                               IsVisible="{Binding !IsPresent}"
                                               Text="{Binding PresenceLabel}" />

                                    <Button Grid.Column="2"
                                            Padding="10,0"
                                            Height="{DynamicResource DungeonControlHeight}"
                                            Content="Obecność"
                                            Command="{Binding TogglePresence}" />
                                    <Button Grid.Column="3"
                                            Padding="10,0"
                                            Height="{DynamicResource DungeonControlHeight}"
                                            Content="Usuń"
                                            Command="{Binding Remove}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Same cell: the empty state cannot resize the frame around it. -->
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource DungeonHelperFontSize}"
                           Foreground="{DynamicResource DungeonTextMutedBrush}"
                           IsVisible="{Binding IsEmpty}"
                           Text="Nikt jeszcze nie usiadł przy stole." />
            </Panel>
        </Border>

        <!-- Reserved slot: a refusal appears and clears without moving the list above it. -->
        <TextBlock Grid.Row="3"
                   MinHeight="16"
                   FontSize="{DynamicResource DungeonHelperFontSize}"
                   Foreground="{DynamicResource DungeonWarningBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding Message}" />
    </Grid>
</UserControl>
