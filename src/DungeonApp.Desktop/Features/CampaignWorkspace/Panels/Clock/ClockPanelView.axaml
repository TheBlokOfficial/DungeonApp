<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:clock="using:DungeonApp.Desktop.Features.CampaignWorkspace.Panels.Clock"
             xmlns:panels="using:DungeonApp.Desktop.Features.CampaignWorkspace.Panels"
             x:Class="DungeonApp.Desktop.Features.CampaignWorkspace.Panels.Clock.ClockPanelView"
             x:DataType="clock:ClockPanelViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" Spacing="10">
            <TextBlock Classes="eyebrow" Text="OD POCZĄTKU KAMPANII" />

            <!-- Tabular figures: the reading changes constantly and must not shuffle sideways. -->
            <TextBlock FontFamily="{DynamicResource DungeonDisplayFont}"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                       Text="{Binding Elapsed}" />

            <TextBox PlaceholderText="Powód przesunięcia"
                     Text="{Binding Reason, Mode=TwoWay}"
                     Height="{DynamicResource DungeonControlHeight}"
                     VerticalContentAlignment="Center" />

            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="panels:PanelActionViewModel">
                        <Button Margin="0,0,6,6"
                                Padding="14,0"
                                Height="{DynamicResource DungeonControlHeight}"
                                Content="{Binding Label}"
                                Command="{Binding Command}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Reserved slot: a refusal appears and clears without moving the buttons above it. -->
            <TextBlock MinHeight="16"
                       FontSize="{DynamicResource DungeonHelperFontSize}"
                       Foreground="{DynamicResource DungeonWarningBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding Message}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
