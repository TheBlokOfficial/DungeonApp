<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:demo="using:DungeonApp.Desktop.Features.CampaignWorkspace.Panels.Demo"
             x:Class="DungeonApp.Desktop.Features.CampaignWorkspace.Panels.Demo.DemoPanelView"
             x:DataType="demo:DemoPanelViewModel">

    <!-- Deliberately inert. The panel host is what this increment verifies; real content arrives
         with the domain. Scrolls inside its own viewport so a small panel never pushes its frame. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" Spacing="8">
            <TextBlock Classes="eyebrow" Text="ATRAPA" />
            <TextBlock FontFamily="{DynamicResource DungeonDisplayFont}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                       Text="{Binding Heading}" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding Body}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
