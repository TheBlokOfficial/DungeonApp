<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:DungeonApp.Desktop.Features.CampaignWorkspace.Panels"
             x:Class="DungeonApp.Desktop.Features.CampaignWorkspace.Panels.CounterPanelView"
             x:DataType="panels:CounterPanelViewModel">
    <Grid Margin="{DynamicResource DungeonPaddingMd}"
          RowDefinitions="*,Auto"
          RowSpacing="{DynamicResource DungeonSpacingMd}">
        <Border Background="{DynamicResource DungeonSurfaceHeaderBrush}"
                BorderBrush="{DynamicResource DungeonBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource DungeonCornerRadius}"
                Padding="{DynamicResource DungeonPaddingSm}">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="{DynamicResource DungeonSpacingXs}">
                <TextBlock FontSize="{DynamicResource DungeonEyebrowFontSize}"
                           Foreground="{DynamicResource DungeonTextMutedBrush}"
                           Text="BIEŻĄCA WARTOŚĆ" />
                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource DungeonDisplayFont}"
                           FontSize="{DynamicResource DungeonWorkspaceTitleFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                           IsVisible="{Binding HasReadableValue}"
                           Text="{Binding Count}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              RowDefinitions="Auto,Auto"
              RowSpacing="{DynamicResource DungeonSpacingSm}">
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="{DynamicResource DungeonSpacingSm}">
                <Button Command="{Binding DecrementCommand}"
                        Content="−1"
                        ToolTip.Tip="Zmniejsz o 1" />
                <Button Grid.Column="1"
                        Classes="primary"
                        Command="{Binding IncrementCommand}"
                        Content="+1"
                        ToolTip.Tip="Zwiększ o 1" />
            </Grid>
            <TextBlock Grid.Row="1"
                       Foreground="{DynamicResource DungeonWarningBrush}"
                       IsVisible="{Binding HasMessage}"
                       Text="{Binding Message}"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
