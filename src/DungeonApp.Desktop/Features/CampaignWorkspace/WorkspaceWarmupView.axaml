<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:surface="using:DungeonApp.Desktop.Controls.Workspace"
             xmlns:workspace="using:DungeonApp.Desktop.Features.CampaignWorkspace"
             xmlns:shellWorkspace="using:DungeonApp.Desktop.Shell.Workspace"
             xmlns:party="using:DungeonApp.Desktop.Features.CampaignWorkspace.Panels.Party"
             xmlns:clock="using:DungeonApp.Desktop.Features.CampaignWorkspace.Panels.Clock"
             xmlns:dice="using:DungeonApp.Desktop.Features.CampaignWorkspace.Panels.Dice"
             xmlns:scheduler="using:DungeonApp.Desktop.Features.CampaignWorkspace.Panels.Scheduler"
             xmlns:history="using:DungeonApp.Desktop.Features.CampaignWorkspace.Panels.History"
             x:Class="DungeonApp.Desktop.Features.CampaignWorkspace.WorkspaceWarmupView"
             IsHitTestVisible="False">

    <!--
        Attached only during the startup gate. These are real production controls, not a duplicate
        mock-up: applying them once warms compiled XAML, control themes, dynamic resources, panel
        chrome and their first layout before navigation is enabled. No business command or campaign
        data is involved, and the complete tree is discarded after its Loaded frame.
    -->
    <Grid>
        <workspace:CampaignWorkspaceView />
        <shellWorkspace:WorkspacePlaceholderView />

        <Canvas Width="1032" Height="724">
            <surface:PanelWindow Width="480" Height="260">
                <party:PartyPanelView />
            </surface:PanelWindow>
            <surface:PanelWindow Canvas.Left="488" Width="360" Height="260">
                <clock:ClockPanelView />
            </surface:PanelWindow>
            <surface:PanelWindow Canvas.Top="268" Width="480" Height="320">
                <history:HistoryPanelView />
            </surface:PanelWindow>
            <surface:PanelWindow Canvas.Left="488" Canvas.Top="268" Width="360" Height="320">
                <scheduler:SchedulerPanelView />
            </surface:PanelWindow>
            <surface:PanelWindow Canvas.Top="596" Width="480" Height="128">
                <dice:DicePanelView />
            </surface:PanelWindow>
        </Canvas>
    </Grid>
</UserControl>
