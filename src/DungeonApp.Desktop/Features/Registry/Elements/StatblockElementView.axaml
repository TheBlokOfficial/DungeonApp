<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:elements="using:DungeonApp.Desktop.Features.Registry.Elements"
             x:Class="DungeonApp.Desktop.Features.Registry.Elements.StatblockElementView"
             x:DataType="elements:StatblockElementViewModel">

    <!-- No Margin on this root, ever: spacing between card elements belongs to the host that lays
         them out (RegistryView), not to the element itself. See the content architecture doc. -->
    <!-- The shared size scope starts here, at one element, and deliberately not higher: the label
         column is shared by the rows of THIS statblock, so a long label widens its own block and
         leaves the neighbouring one alone. Without a scope every row measures its own Auto column
         and the values come out ragged - six three-letter labels only look like a column by
         accident. -->
    <StackPanel Grid.IsSharedSizeScope="True" Spacing="{DynamicResource DungeonSpacingXs}">
        <TextBlock Classes="eyebrow" IsVisible="{Binding HasTitle}" Text="{Binding Title}" />
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="{DynamicResource DungeonSpacingXs}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="elements:StatblockRowViewModel">
                    <Grid ColumnSpacing="{DynamicResource DungeonSpacingSm}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="StatblockLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Classes="muted" Text="{Binding Label}" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="{DynamicResource DungeonSpacingXs}">
                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted"
                                       IsVisible="{Binding HasSecondary}"
                                       Text="{Binding SecondaryDisplay}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
