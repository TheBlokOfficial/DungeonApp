 <Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window, UserControl">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
    </Style>

    <Style Selector="TextBlock.workspace-title">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonDisplayFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonWorkspaceTitleFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="{DynamicResource DungeonEyebrowFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.7" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="{DynamicResource DungeonHelperFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Height" Value="{DynamicResource DungeonControlHeight}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHeaderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource DungeonSurfaceActiveBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderStrongBrush}" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource DungeonAccentActionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonOnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource DungeonAccentColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonAccentBrightBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled">
        <!-- Dedicated colors keep the CTA identity without fading its label and antialiasing. -->
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DungeonPrimaryDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled:pointerover">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DungeonPrimaryDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
    </Style>
    <Style Selector="Button:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonAccentBrush}" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Height" Value="{DynamicResource DungeonControlHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
    </Style>
    <!-- Fluent paints input states on its inner template border. Override that exact contract so
         hover/focus never replace the calm background or thicken the frame. -->
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputHoverBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputFocusBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox:focus:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputFocusBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{DynamicResource DungeonInputPlaceholderBrush}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{DynamicResource DungeonInputPlaceholderBrush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{DynamicResource DungeonInputPlaceholderBrush}" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHeaderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
    </Style>

    <!--
        Scrollowanie: jeden pionowy scrollbar, bez przycisków krokowych. Fluent domyślnie
        animuje widoczność scrollbarów i dodaje przyciski LineUp/LineDown; dla aplikacji
        desktopowej pasek ma być stałym elementem layoutu i służyć wyłącznie do przeciągania
        uchwytu oraz przewijania kółkiem.
    -->
    <Style Selector="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="Background" Value="{DynamicResource DungeonBackstageBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton,
                    ScrollBar /template/ RepeatButton#PART_LineDownButton,
                    ScrollBar /template/ RepeatButton#PART_LineLeftButton,
                    ScrollBar /template/ RepeatButton#PART_LineRightButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!--
        Fluent's default ProgressBar carries system blue (track and indicator both come from the
        control's Background/Foreground, which the base theme maps onto the template's track and
        indicator borders) and a rounded corner baked into the same CornerRadius property. Neither
        appears anywhere else in the app's palette, so both are overridden here. Corners are square
        outright (no token: this is an absence of rounding, not a value from the radius scale).
        The base theme already resolves MinHeight to 4, matching DungeonLoadingProgressBarHeight,
        so no override is needed there.
    -->
    <Style Selector="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonAccentBrightBrush}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
</Styles>
