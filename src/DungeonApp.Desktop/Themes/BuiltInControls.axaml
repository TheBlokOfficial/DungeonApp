 <Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DungeonApp.Desktop.Controls">
    <Style Selector="Window, UserControl">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.workspace-title">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonDisplayFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonWorkspaceTitleFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="{DynamicResource DungeonEyebrowFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.7" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- Ikona w polu tekstowym (ołówek, lupa): rozmiar ikony akcji. Mieszka tu, a nie w motywie pola
         (DungeonControls.axaml), bo ControlTheme nie dopuszcza selektora potomka. -->
    <Style Selector="TextBox controls|ForegroundIcon">
        <Setter Property="Width" Value="{DynamicResource DungeonActionIconSize}" />
        <Setter Property="Height" Value="{DynamicResource DungeonActionIconSize}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="{DynamicResource DungeonHelperFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
    </Style>

    <!--
        Kontrolka w linii tekstu (np. odnośnik w zdaniu, Button.link.inline): domyślnie Avalonia
        stawia jej dolną krawędź na linii bazowej zdania, więc tekst w środku - wysoki na całą linię
        z jego własnym zejściem - stoi wyżej o to zejście. Dolna krawędź na dolnej krawędzi tekstu
        kładzie linię bazową treści na linii bazowej zdania, a podkreślenie tuż pod literami.
    -->
    <Style Selector="InlineUIContainer">
        <Setter Property="BaselineAlignment" Value="TextBottom" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHeaderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
    </Style>

    <!--
        Scrollowanie: jeden pionowy scrollbar, bez przycisków krokowych. Fluent domyślnie
        animuje widoczność scrollbarów i dodaje przyciski LineUp/LineDown; dla aplikacji
        desktopowej pasek ma być stałym elementem layoutu i służyć wyłącznie do przeciągania
        uchwytu oraz przewijania kółkiem.
    -->
    <Style Selector="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="Background" Value="{DynamicResource DungeonBackstageBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton,
                    ScrollBar /template/ RepeatButton#PART_LineDownButton,
                    ScrollBar /template/ RepeatButton#PART_LineLeftButton,
                    ScrollBar /template/ RepeatButton#PART_LineRightButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!--
        Fluent's default ProgressBar carries system blue (track and indicator both come from the
        control's Background/Foreground, which the base theme maps onto the template's track and
        indicator borders) and a rounded corner baked into the same CornerRadius property. Neither
        appears anywhere else in the app's palette, so both are overridden here. Corners are square
        outright (no token: this is an absence of rounding, not a value from the radius scale).
        The base theme already resolves MinHeight to 4, matching DungeonLoadingProgressBarHeight,
        so no override is needed there.
    -->
    <Style Selector="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonAccentBrightBrush}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
</Styles>
