 <Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DungeonApp.Desktop.Controls">
    <Style Selector="Window, UserControl">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.workspace-title">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonDisplayFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonWorkspaceTitleFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="{DynamicResource DungeonEyebrowFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.7" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- Ikona w polu tekstowym (ołówek, lupa): rozmiar ikony akcji. Mieszka tu, a nie w motywie pola
         (DungeonControls.axaml), bo ControlTheme nie dopuszcza selektora potomka. -->
    <Style Selector="TextBox controls|ForegroundIcon">
        <Setter Property="Width" Value="{DynamicResource DungeonActionIconSize}" />
        <Setter Property="Height" Value="{DynamicResource DungeonActionIconSize}" />
    </Style>

    <!-- Wiersz listy z kolumnami (controls:ListRow z Grid jako treścią, np. nazwa wpisu i odznaka):
         każda kolumna wyśrodkowana w pionie niezależnie. Siatka wiersza ma wysokość najwyższej
         kolumny, a rozciągnięty TextBlock rysuje tekst u góry swojego pola - bez tego wyższa odznaka
         w sąsiedniej kolumnie przesuwała tytuł w górę. Mieszka tu, a nie w motywie wiersza
         (DungeonControls.axaml), bo ControlTheme nie dopuszcza selektora potomka.
         Korzeń szablonu wiersza (Grid PART_Root) też jest logicznym dzieckiem wiersza - wyłączony
         z selektora, bo pas kreski i tło PART_Highlight mają się rozciągać na wysokość wiersza. -->
    <Style Selector="controls|ListRow > Grid:not(#PART_Root) > :is(Control)">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Lista w okienku .list-host: wcięcie okienka (DungeonFlyoutPadding) niesie lista wewnątrz
         przewijanej treści - okienko .list-host nie ma własnego (motyw FlyoutPresenter), więc pasek
         listy stoi przy krawędzi okienka jak w każdym innym okienku. -->
    <Style Selector="FlyoutPresenter.list-host > ListBox">
        <Setter Property="Padding" Value="{DynamicResource DungeonFlyoutPadding}" />
    </Style>
    <!-- Wiersz listy w okienku wysuwanym (lista w .list-host, wiersze DropDownPicker): stoi o wcięcie
         okienka od krawędzi obszaru przewijania, więc strefa paska w wierszu to reszta pasa
         (DungeonScrollBarZoneInFlyout). ComboBoxItem ma to we własnym motywie. -->
    <Style Selector="FlyoutPresenter ListBoxItem /template/ Border#PART_Highlight">
        <Setter Property="Padding" Value="{DynamicResource DungeonScrollBarZoneInFlyout}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="{DynamicResource DungeonHelperFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
    </Style>

    <!--
        Kontrolka w linii tekstu (np. odnośnik w zdaniu, Button.link.inline): domyślnie Avalonia
        stawia jej dolną krawędź na linii bazowej zdania, więc tekst w środku - wysoki na całą linię
        z jego własnym zejściem - stoi wyżej o to zejście. Dolna krawędź na dolnej krawędzi tekstu
        kładzie linię bazową treści na linii bazowej zdania, a podkreślenie tuż pod literami.
    -->
    <Style Selector="InlineUIContainer">
        <Setter Property="BaselineAlignment" Value="TextBottom" />
    </Style>

    <!-- Separator w menu (MenuFlyout, ContextMenu, podmenu): linia 1 px na pełną szerokość wnętrza
         menu, odstęp 4 nad i pod. Mieszka tu, a nie w motywie menu (DungeonControls.axaml), bo
         ControlTheme nie dopuszcza selektora potomka. -->
    <Style Selector="MenuFlyoutPresenter > Separator, ContextMenu > Separator, MenuItem > Separator">
        <Setter Property="Margin" Value="{DynamicResource DungeonMenuSeparatorMargin}" />
    </Style>

</Styles>
