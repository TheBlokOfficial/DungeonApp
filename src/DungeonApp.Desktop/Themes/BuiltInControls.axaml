 <Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DungeonApp.Desktop.Controls"
        xmlns:themes="using:DungeonApp.Desktop.Themes">
    <Style Selector="Window, UserControl">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.workspace-title">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonDisplayFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonWorkspaceTitleFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="{DynamicResource DungeonEyebrowFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.7" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- Ikona w polu tekstowym (ołówek, lupa): rozmiar ikony akcji. Mieszka tu, a nie w motywie pola
         (DungeonControls.axaml), bo ControlTheme nie dopuszcza selektora potomka. -->
    <Style Selector="TextBox controls|ForegroundIcon">
        <Setter Property="Width" Value="{DynamicResource DungeonActionIconSize}" />
        <Setter Property="Height" Value="{DynamicResource DungeonActionIconSize}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="{DynamicResource DungeonHelperFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
    </Style>

    <!--
        Kontrolka w linii tekstu (np. odnośnik w zdaniu, Button.link.inline): domyślnie Avalonia
        stawia jej dolną krawędź na linii bazowej zdania, więc tekst w środku - wysoki na całą linię
        z jego własnym zejściem - stoi wyżej o to zejście. Dolna krawędź na dolnej krawędzi tekstu
        kładzie linię bazową treści na linii bazowej zdania, a podkreślenie tuż pod literami.
    -->
    <Style Selector="InlineUIContainer">
        <Setter Property="BaselineAlignment" Value="TextBottom" />
    </Style>

    <!-- Separator w menu (MenuFlyout, ContextMenu, podmenu): linia 1 px na pełną szerokość wnętrza
         menu, odstęp 4 nad i pod. Mieszka tu, a nie w motywie menu (DungeonControls.axaml), bo
         ControlTheme nie dopuszcza selektora potomka. -->
    <Style Selector="MenuFlyoutPresenter > Separator, ContextMenu > Separator, MenuItem > Separator">
        <Setter Property="Margin" Value="{DynamicResource DungeonMenuSeparatorMargin}" />
    </Style>

    <!--
        Akcja w wierszu listy (motyw DungeonRowAction, DungeonControls.axaml). Mieszka tu, a nie
        w motywie akcji, bo ControlTheme nie dopuszcza selektora potomka.
        Pas akcji na pełnej wysokości wiersza i do jego krawędzi: w ListBoxItem wychodzi przez odstęp
        podświetlenia (DungeonListRowHighlightInset) i prawe wcięcie wiersza (DungeonListRowActionMargin);
        w wierszu z klasą list-row (Border z krawędzią 1 px) - przez krawędź w pionie. Wiersz zostaje
        wysoki jak był: ujemny margines zdejmuje z wymiaru akcji dokładnie to, o co wychodzi.
        Widoczność: tylko pod myszą nad wierszem i na wybranym wierszu; miejsce zarezerwowane zawsze
        (przezroczystość, nie zwijanie). Wyłączona akcja - przezroczystość wyłączenia.
    -->
    <Style Selector="ListBoxItem Button[(themes|RowActionHover.IsEnabled)=True]">
        <Setter Property="Margin" Value="{DynamicResource DungeonListRowActionMargin}" />
        <Setter Property="Height" Value="{DynamicResource DungeonListRowHeight}" />
    </Style>
    <Style Selector=".list-row Button[(themes|RowActionHover.IsEnabled)=True]">
        <Setter Property="Margin" Value="0,-1" />
    </Style>
    <Style Selector="ListBoxItem Button[(themes|RowActionHover.IsEnabled)=True],
                     .list-row Button[(themes|RowActionHover.IsEnabled)=True]">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button[(themes|RowActionHover.IsEnabled)=True],
                     ListBoxItem:selected Button[(themes|RowActionHover.IsEnabled)=True],
                     .list-row:pointerover Button[(themes|RowActionHover.IsEnabled)=True]">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button[(themes|RowActionHover.IsEnabled)=True]:disabled,
                     ListBoxItem:selected Button[(themes|RowActionHover.IsEnabled)=True]:disabled,
                     .list-row:pointerover Button[(themes|RowActionHover.IsEnabled)=True]:disabled">
        <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
    </Style>
</Styles>
