 <Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DungeonApp.Desktop.Controls">
    <!-- Window font and text colour come from its own theme (Controls/Window.axaml). -->
    <Style Selector="UserControl">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.workspace-title">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonDisplayFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonWorkspaceTitleFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow, SelectableTextBlock.eyebrow">
        <Setter Property="FontSize" Value="{DynamicResource DungeonEyebrowFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.7" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- Text box in an icon field (controls:IconField): the icon field frame supplies border,
         background, height and dimming, so the inner text box has no border or background, fills the
         frame at full inner height, does not dim again (Opacity 1 even when disabled), and text
         starts just after the icon gap (DungeonInputTextAfterIconMargin). Defined here rather than
         in the icon field theme (Controls/IconField.axaml), because ControlTheme does not allow
         descendant selectors. -->
    <Style Selector="controls|IconField > TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{DynamicResource DungeonInputTextAfterIconMargin}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- List row with columns (controls:ListRow with Grid content, e.g. entry name and badge):
         each column vertically centred independently. Row grid is as high as the tallest
         column, while a stretched TextBlock draws text at its top - otherwise a taller badge
         in the neighbouring column shifts the title upwards. Defined here rather than in the row theme
         (Controls/ListRow.axaml), because ControlTheme does not allow descendant selectors.
         Row template root (Grid PART_Root) is also a logical child of the row - excluded
         from the selector because stripe gutter and PART_Highlight background must stretch to row height. -->
    <Style Selector="controls|ListRow > Grid:not(#PART_Root) > :is(Control)">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- List in a .list-host flyout: the list carries flyout padding (DungeonFlyoutPadding) inside
         scrollable content - .list-host has none of its own (FlyoutPresenter theme), so the list
         scrollbar sits at the flyout edge as in every other flyout. -->
    <Style Selector="FlyoutPresenter.list-host > ListBox">
        <Setter Property="Padding" Value="{DynamicResource DungeonFlyoutPadding}" />
    </Style>
    <!-- List row in a flyout (.list-host list, DropDownPicker rows): inset by flyout padding
         from the scroll area's edge, so the row's scrollbar zone is the remaining strip
         (DungeonScrollBarZoneInFlyout). ComboBoxItem sets this in its own theme. -->
    <Style Selector="FlyoutPresenter ListBoxItem /template/ Border#PART_Highlight">
        <Setter Property="Padding" Value="{DynamicResource DungeonScrollBarZoneInFlyout}" />
    </Style>
    <!-- Popup whose content fits without scrolling (.no-bar-zone set on opening
         by Themes/PopupOpenLayout.cs and retained until closing): rows reserve no scrollbar
         zone - content ends as far from the right edge as it starts from the left. Class is set
         on the popup surface and, for ComboBox and submenus, also on the control whose logical
         children are the rows. -->
    <Style Selector="FlyoutPresenter.no-bar-zone ListBoxItem /template/ Border#PART_Highlight,
                     ComboBox.no-bar-zone > ComboBoxItem /template/ Border#PART_Highlight">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="FlyoutPresenter.no-bar-zone Panel#SearchRow">
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="MenuFlyoutPresenter.no-bar-zone > MenuItem /template/ Grid#ItemContent,
                     ContextMenu.no-bar-zone > MenuItem /template/ Grid#ItemContent,
                     MenuItem.no-bar-zone > MenuItem /template/ Grid#ItemContent">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
        <Setter Property="FontSize" Value="{DynamicResource DungeonHelperFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
    </Style>

    <!--
        Inline control (e.g. sentence link, Button.link.inline): Avalonia defaults
        its bottom edge to the sentence baseline, so inner text - occupying a full line
        with its own descent - sits higher by that descent. Aligning bottom edges with the text bottom
        puts the content baseline on the sentence baseline and the underline just below the letters.
    -->
    <Style Selector="InlineUIContainer">
        <Setter Property="BaselineAlignment" Value="TextBottom" />
    </Style>

    <!-- Menu separator (MenuFlyout, ContextMenu, submenu): 1 px line across the menu's full inner
         width, gap 4 above and below. Defined here rather than in the menu theme (Controls/Menus.axaml), because
         ControlTheme does not allow descendant selectors. -->
    <Style Selector="MenuFlyoutPresenter > Separator, ContextMenu > Separator, MenuItem > Separator">
        <Setter Property="Margin" Value="{DynamicResource DungeonMenuSeparatorMargin}" />
    </Style>

</Styles>
