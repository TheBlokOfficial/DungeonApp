<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Frame text styles (docs/tasks.md, punkt 3 "Fundament interfejsu"): the mockup's roles
        (docs/images/mockup_rejestr.html) on seven sizes - 34, 26, 20, 15, 13, 12, 11
        (docs/decisions.md, "Siedem stopni pisma"); the display face starts at 20. Typeface, size,
        weight, letter spacing and line height only - never a color: the color stays with the context,
        the color class "secondary" (at the end of this file) and the existing "muted" class.
        Only the multi-line styles (body, display-prose) set a line height - a tighter one clips
        descenders; it is the CSS multiplier times the size, in pixels. Letter spacing is CSS em times
        the size, in pixels. Included after BuiltInControls.axaml, so a size set here wins over
        "muted"'s own. The overline classes do not uppercase - Avalonia has no style-level text
        transform; their text is written in capitals.
    -->

    <!-- DISPLAY =========================================================== -->
    <Style Selector="TextBlock.display-xl">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonDisplayFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.display-lg">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonDisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.display-md">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonDisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.display-prose">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonDisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="LineHeight" Value="32" />
    </Style>

    <!-- TEKST ============================================================= -->
    <Style Selector="TextBlock.body">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="20.15" />
    </Style>
    <Style Selector="TextBlock.body-strong">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.label-strong">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.36" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.overline">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <Style Selector="TextBlock.overline-sm">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.44" />
    </Style>

    <!-- LICZBY ============================================================ -->
    <Style Selector="TextBlock.mono-value">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonMonoFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonMonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.mono-xs">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonMonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- KOLOR ============================================================= -->
    <!-- Color only - never typeface or size, so it combines with any style above. The default text
         color (BuiltInControls.axaml) is DungeonTextPrimaryBrush; "secondary" is the second role. -->
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
    </Style>
</Styles>
