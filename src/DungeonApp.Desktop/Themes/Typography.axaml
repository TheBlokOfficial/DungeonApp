<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Frame text styles: every text role on seven sizes only - 34, 26, 20, 15, 13, 12, 11; the
        display face starts at 20, save for its italic note (display-note, 15). Typeface, size,
        weight, letter spacing and line height only -
        never a color: the color stays with the context, the color class "secondary" (at the end of
        this file) and the existing "muted" class.
        Only the multi-line styles (body, display-prose) set a line height - a tighter one clips
        descenders; it is a multiplier times the size, in pixels. Letter spacing is em times the
        size, in pixels. Included after BuiltInControls.axaml, so a size set here wins over
        "muted"'s own. The overline classes do not uppercase - Avalonia has no style-level text
        transform; their text is written in capitals.
        A "TextBlock" selector does not reach a SelectableTextBlock (a type selector matches the
        exact type), so every role selectable text takes names it as well - a card's text is all
        selectable, labels and numbers included.
    -->

    <!-- DISPLAY =========================================================== -->
    <Style Selector="TextBlock.display-xl, SelectableTextBlock.display-xl">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonDisplayFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.display-lg">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonDisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.display-md, SelectableTextBlock.display-md">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonDisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.display-prose, SelectableTextBlock.display-prose">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonDisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="LineHeight" Value="32" />
    </Style>
    <!-- Dopisek krojem ozdobnym: krótki tekst nastroju pod treścią (opis potwora pod jego regułami).
         Jedyny styl kroju ozdobnego poniżej 20 - kursywa i stopka, więc 15 wystarcza, a mniejszy
         stopień oddziela go od prozy reguł nad nim. -->
    <Style Selector="TextBlock.display-note, SelectableTextBlock.display-note">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonDisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <!-- TEKST ============================================================= -->
    <Style Selector="TextBlock.body, SelectableTextBlock.body">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="20.15" />
    </Style>
    <Style Selector="TextBlock.body-strong, SelectableTextBlock.body-strong">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label, SelectableTextBlock.label">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.label-strong">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.36" />
    </Style>
    <Style Selector="TextBlock.caption, SelectableTextBlock.caption">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.overline">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <Style Selector="TextBlock.overline-sm">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.44" />
    </Style>

    <!-- LICZBY ============================================================ -->
    <!-- stat-value i stat-value-lg: ta sama liczba w dwóch stopniach - wartość w komórce tabeli
         i wartość nagłówkowa (bez ramki, więc to ona prowadzi oko - stopień 26). Pismo interfejsu, nie krój o stałej szerokości: wartość z jednostką
         („7,5 m”) czyta się jak tekst, a cyfry tabelaryczne (tnum) i tak trzymają kolumny liczb
         równo. Jeden krój i grubość, żeby równoważne liczby wyglądały jednakowo. -->
    <Style Selector="TextBlock.stat-value, SelectableTextBlock.stat-value">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontFeatures" Value="tnum" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.stat-value-lg, SelectableTextBlock.stat-value-lg">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontFeatures" Value="tnum" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.mono-value">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonMonoFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonMonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.mono-xs">
        <Setter Property="FontFamily" Value="{DynamicResource DungeonMonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- KOLOR ============================================================= -->
    <!-- Color only - never typeface or size, so it combines with any style above. The default text
         color (BuiltInControls.axaml) is DungeonTextPrimaryBrush; "secondary" is the second role. -->
    <Style Selector="TextBlock.secondary, SelectableTextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
    </Style>

    <!--
        Tekst do zaznaczenia (SelectableTextBlock): dłuższa treść kart i komunikaty błędów. Kursor
        tekstowy, zaznaczenie kolorem DungeonTextSelectionBrush - tym samym co w polach tekstowych;
        Ctrl+C kopiuje (zachowanie kontrolki). Kliknięcie obok zdejmuje z niego fokus, a z nim
        zaznaczenie - rama, Themes/EditFocusRelease.cs.
    -->
    <Style Selector="SelectableTextBlock">
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="SelectionBrush" Value="{DynamicResource DungeonTextSelectionBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource DungeonTextPrimaryBrush}" />
    </Style>

    <!--
        Zakreślenie: styl tekstu na fragmencie (Run albo Span w TextBlocku), jak pogrubienie - tło
        przylega do liter i płynie z tekstem; bez wcięcia i zaokrąglenia (pojemnik z wcięciem to
        odznaka). Odmiany po znaczeniu:
          .highlight    - wyróżnione: wartość ważna w zdaniu, która zostaje tekstem (DungeonHighlightBrush);
          .search-match - trafienie wyszukiwania: fragment pasujący do szukanego (DungeonSearchMatchBrush).
    -->
    <Style Selector="Run.highlight, Span.highlight">
        <Setter Property="Background" Value="{DynamicResource DungeonHighlightBrush}" />
    </Style>

    <!--
        Wyróżnienie autora (Run.emphasis, controls:EmphasisMarkup): fragment, który autor treści
        oznaczył **…** - premia do trafienia, rzut obrażeń, ST. Pogrubienie (SemiBold) w kolorze tekstu
        podstawowego, także w zdaniu tekstem drugorzędnym - oko ląduje na liczbie, nie na tle.
    -->
    <Style Selector="Run.emphasis">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
    </Style>
    <Style Selector="Run.search-match, Span.search-match">
        <Setter Property="Background" Value="{DynamicResource DungeonSearchMatchBrush}" />
    </Style>
</Styles>
