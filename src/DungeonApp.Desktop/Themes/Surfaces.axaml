<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Shell surfaces: Border classes using only tokens from Themes/Tokens.axaml. Each colour's
        meaning is documented there, above the colour.
        Class sets background, border, radius and padding - never size: the surrounding layout
        sets surface size, and overflowing content trims or wraps inside.
    -->

    <!-- Card: object distinct from the background, read as a whole. -->
    <Style Selector="Border.surface-card">
        <Setter Property="Background" Value="{DynamicResource DungeonBackstageCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonCardCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonPaddingLg}" />
    </Style>

    <!-- Bordered section: group on its underlying surface - no background of its own. -->
    <Style Selector="Border.surface-section">
        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonPaddingMd}" />
    </Style>

    <!-- Shell panel: permanent content surroundings. No border - the surrounding layout draws
         the line between panel and content, because only it knows which side contains content. -->
    <Style Selector="Border.surface-panel">
        <Setter Property="Background" Value="{DynamicResource DungeonFrameBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
</Styles>
