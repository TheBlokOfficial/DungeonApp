    <ResourceDictionary xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <!-- COLOURS ============================================================ -->
        <!-- Background: deepest level, beneath everything else. -->
        <Color x:Key="DungeonBackgroundColor">#151412</Color>
        <!-- Surface: level above the background. -->
        <Color x:Key="DungeonSurfaceColor">#1B1917</Color>
        <!-- SurfaceHeader: level above the background (surface header). -->
        <Color x:Key="DungeonSurfaceHeaderColor">#1B1917</Color>
        <!--
            Application depth hierarchy. These semantic roles intentionally remain separate from the
            generic surface tokens even where their current color values match. The outer frame,
            backstage workspace and live campaign desk may evolve independently without making a
            header or panel change color as a side effect.
        -->
        <!-- BACKGROUNDS AND WORKSPACE -->
        <!-- Frame: permanent content surroundings (sidebar, top bar). -->
        <Color x:Key="DungeonFrameColor">#1B1917</Color>
        <!-- FrameHover: shell hover - this shell element responds to the pointer. -->
        <Color x:Key="DungeonFrameHoverColor">#282522</Color>
        <!-- Backstage: content background outside a campaign (library, shelf, gallery). -->
        <Color x:Key="DungeonBackstageColor">#151412</Color>
        <!-- BackstageEdge: content background outside a campaign, at the far edge of a wide view
             (end of the BackstageWide gradient). -->
        <Color x:Key="DungeonBackstageEdgeColor">#100F0E</Color>
        <!-- BackstageCard: card - object distinct from the background, read as a whole. -->
        <Color x:Key="DungeonBackstageCardColor">#1F1D1A</Color>
        <!-- BackstageRow: row - item that can be selected. -->
        <Color x:Key="DungeonBackstageRowColor">#221F1C</Color>
        <!-- BackstageRowHover: hover - this responds to the pointer. -->
        <Color x:Key="DungeonBackstageRowHoverColor">#282522</Color>
        <!-- Desk: content background of an open campaign. -->
        <Color x:Key="DungeonDeskColor">#151412</Color>
        <!-- SurfaceActive: active - currently selected or pressed. -->
        <Color x:Key="DungeonSurfaceActiveColor">#282522</Color>
        <!-- SurfaceHover: hover - this responds to the pointer. -->
        <Color x:Key="DungeonSurfaceHoverColor">#221F1C</Color>
        <!-- HoverOverlay: hover on a subtle control (.subtle button) - white at
             8 % opacity (#14FFFFFF), with alpha: lightens the underlying surface, so hover is visible on any
             surface, including a hovered list row (BackstageRowHover). On backstage (#151412)
             gives about #272522 - same as opaque SurfaceActive. -->
        <Color x:Key="DungeonHoverOverlayColor">#14FFFFFF</Color>
        <!-- Border: line - separates, does not highlight; surface edge and separator. -->
        <Color x:Key="DungeonBorderColor">#302C28</Color>
        <!-- BorderStrong: prominent border - edge intended to draw the eye: hovered control,
             active window, shell edge. -->
        <Color x:Key="DungeonBorderStrongColor">#413C36</Color>
        <!-- TEXT -->
        <!-- TextPrimary: primary text - content and the default for everything. -->
        <Color x:Key="DungeonTextPrimaryColor">#E8E4DA</Color>
        <!-- TextRegular: secondary text - description, supplementary content. -->
        <Color x:Key="DungeonTextRegularColor">#B4B2AC</Color>
        <!-- TextMuted: muted text - caption, label, metadata. -->
        <Color x:Key="DungeonTextMutedColor">#8A8983</Color>
        <Color x:Key="DungeonAccentColor">#B8843B</Color>
        <!-- AccentBright: prominent accent - Accent hue, more vivid rather than lighter: saturation
             +13 points, lightness +2 (HSL 35°, 65%, 50% versus 35°, 51%, 48%). Brand mark on the startup
             screen and progress bar; hovered buttons do not use it (they have a halo, DungeonAccentHoverHaloShadow). -->
        <Color x:Key="DungeonAccentBrightColor">#D28D2D</Color>
        <!-- AccentDim: dim accent - background under selected elements (list row, active filter) or
             accent content (challenge badge). Accent #B8843B at 16 % opacity
             (#29B8843B): stored with alpha rather than composited against a background, because it overlays different
             surfaces (backstage, card, filter popup) and must look like the same
             dim colour on each, without seams. Primary text over it on backstage (about #2F2619)
             about 12:1. Not for lines or glyphs - too weak for those; use Accent there. -->
        <Color x:Key="DungeonAccentDimColor">#29B8843B</Color>
        <!-- AccentEdge: border of active elements on dim accent (checked chip, active filter,
             selected dropdown chip) - Accent #B8843B at 40 % opacity (#66B8843B), with alpha
             for the same reason as AccentDim. Clearly lighter than AccentDim fill (16 %), but
             quiet: full Accent beside dim fill would look like translucent gold
             on grey. Border only - not text or glyphs. -->
        <Color x:Key="DungeonAccentEdgeColor">#66B8843B</Color>
        <Color x:Key="DungeonOnAccentColor">#241A0C</Color>
        <!-- AccentTextHover: hovered accent text - inline link under the pointer.
             Same hue as Accent, 10 points lighter (HSL 35°, 51%, 58% versus 48%): colour alone
             indicates hover, because an inline link's underline is permanent. Text only - no background
             and not a replacement for resting Accent. -->
        <Color x:Key="DungeonAccentTextHoverColor">#CB9D5D</Color>
        <!-- Success: the operation succeeded. -->
        <Color x:Key="DungeonSuccessColor">#84A98B</Color>
        <!-- Warning: needs attention, but works. -->
        <Color x:Key="DungeonWarningColor">#D6B84F</Color>
        <!-- Danger: something is broken, the action deletes or is irreversible. -->
        <Color x:Key="DungeonDangerColor">#9C4530</Color>
        <!-- Danger (text): same meaning as Danger (something is broken, action deletes or
             is irreversible), variant readable as text and a standalone glyph without background (trash in a hovered
             row);
             Danger remains for backgrounds. -->
        <Color x:Key="DungeonDangerTextColor">#D46E54</Color>
        <!-- Dim state colours: background under short state-coloured content (badge, tag). Like
             AccentDim - state colour at 16 % opacity (alpha 0x29), stored with alpha,
             so it looks like the same dim colour on cards, rows and backstage. Not for lines
             or text. Danger uses Danger (background colour), not DangerText. -->
        <Color x:Key="DungeonSuccessDimColor">#2984A98B</Color>
        <Color x:Key="DungeonWarningDimColor">#29D6B84F</Color>
        <Color x:Key="DungeonDangerDimColor">#299C4530</Color>
        <!-- Text on dim backgrounds (badge, tag, checked chip): Accent and DangerText over their own
             dim backgrounds yield only 4.05:1 and 4.40:1 on a card - below 4.5:1 for size 12 text.
             Same hue, lighter (HSL +8 / +4 lightness points): 5.1:1 and 5.0:1 on a card, 5.0:1
             and 4.9:1 on a row. For text on AccentDim / DangerDim, not replacements for Accent and DangerText. -->
        <Color x:Key="DungeonAccentOnDimColor">#C89854</Color>
        <Color x:Key="DungeonDangerOnDimColor">#D87C64</Color>
        <!-- NeutralDim: neutral value container background (neutral badge) - white at
             about 8 % opacity (alpha 0x14), stored with alpha like *Dim colours: works on any surface,
             letting it through and only lightening it - not a dark hole on a selected
             row (AccentDim). Secondary text (TextRegular) on it: 7.1:1 on background, 6.3:1 on a card, 6.1:1 on a
             row, 5.7:1 on a hovered row, 4.9:1 on a selected row. -->
        <Color x:Key="DungeonNeutralDimColor">#14FFFFFF</Color>
        <!-- TableHeader: card table header row - neutrally lighter than the card
             (BackstageCard #1F1D1A), more distinctly than a row (#221F1C); no accent. Secondary text
             on it about 7.4:1. -->
        <Color x:Key="DungeonTableHeaderColor">#262320</Color>
        <!-- Numeric direction: quiet cell background for a number that adds (PositiveSubtle, green)
             or subtracts (NegativeSubtle, red) - ability modifier in a table. The system, not the shell,
             determines which sign means "adds". Not a state (neither success nor failure), so not from Success
             or Danger: dim state colours on a dark card read as grey-green
             and brown. Clearly saturated green #2FBF5B and red #EE3B3B, both at alpha 0x3D
             (24 %), with alpha like *Dim colours: hues read as green and red while the backgrounds
             stay quiet and equally prominent. Primary text on them on a card about 8.6:1
             and 10:1. Cell background only - not text or lines. -->
        <Color x:Key="DungeonPositiveSubtleColor">#3D2FBF5B</Color>
        <Color x:Key="DungeonNegativeSubtleColor">#3DEE3B3B</Color>
        <!-- LIVE PART: what the GM changes on an entity's card at the table. -->
        <!-- EditableHover: a value that reads as text and becomes a field on a click, under the
             pointer - a light oval behind it, one colour, no border. At rest the value is plain text, so
             this is the first sign that it takes a click - hence lighter than HoverOverlay. -->
        <Color x:Key="DungeonEditableHoverColor">#1FFFFFFF</Color>
        <!-- EditableFocusBorder: the same value turned into a field - the outline around it while it
             is being edited, and the keyboard focus that reaches it with Tab. -->
        <Color x:Key="DungeonEditableFocusBorderColor">#8A8983</Color>
        <!-- Uncommitted: the blot behind a value that differs from the entity's last commit -
             decoration, not a state colour; never the digits' colour or a cell's background. -->
        <Color x:Key="DungeonUncommittedColor">#664A7FC1</Color>
        <!-- Tracked value gauge: TrackFill - what is left of a tracked value (hit points): its own
             red, not Danger, because a wounded foe is the story at the table, not a fault.
             TrackOver - the part above the maximum, a lighter shade of the same red, more of it
             rather than a warning. TrackRoom - the empty rest up to the maximum. -->
        <Color x:Key="DungeonTrackFillColor">#B23A32</Color>
        <Color x:Key="DungeonTrackOverColor">#E07A6E</Color>
        <Color x:Key="DungeonTrackRoomColor">#14FFFFFF</Color>
        <!-- Against the base: the digits of a value with a base (one the system lists, such as a
             speed or the maximum of a tracked value) when its effects put it above (AboveBase, green) or below (BelowBase,
             red) the entry's value. Text only - the modifier cell keeps its PositiveSubtle /
             NegativeSubtle background, which speaks of the modifier's sign, not of the base. -->
        <Color x:Key="DungeonAboveBaseColor">#6FD48A</Color>
        <Color x:Key="DungeonBelowBaseColor">#EE7A6A</Color>

        <!-- BRUSHES ============================================================= -->
        <SolidColorBrush x:Key="DungeonBackgroundBrush" Color="{DynamicResource DungeonBackgroundColor}" />
        <SolidColorBrush x:Key="DungeonSurfaceBrush" Color="{DynamicResource DungeonSurfaceColor}" />
        <SolidColorBrush x:Key="DungeonSurfaceHeaderBrush" Color="{DynamicResource DungeonSurfaceHeaderColor}" />
        <SolidColorBrush x:Key="DungeonFrameBrush" Color="{DynamicResource DungeonFrameColor}" />
        <SolidColorBrush x:Key="DungeonFrameHoverBrush" Color="{DynamicResource DungeonFrameHoverColor}" />
        <SolidColorBrush x:Key="DungeonBackstageBrush" Color="{DynamicResource DungeonBackstageColor}" />
        <!-- BackstageWide: content background outside a campaign (library, shelf, gallery), in wide
             views. -->
        <!-- Used only by wide, static backstage views. The first half stays calm so the gradient
             does not read as decoration behind the actual content. -->
        <LinearGradientBrush x:Key="DungeonBackstageWideBrush"
                             StartPoint="0,0"
                             EndPoint="2400,1000">
            <GradientStop Offset="0" Color="{DynamicResource DungeonBackstageColor}" />
            <GradientStop Offset="0.42" Color="{DynamicResource DungeonBackstageColor}" />
            <GradientStop Offset="0.74" Color="#12110F" />
            <GradientStop Offset="1" Color="{DynamicResource DungeonBackstageEdgeColor}" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DungeonBackstageCardBrush" Color="{DynamicResource DungeonBackstageCardColor}" />
        <SolidColorBrush x:Key="DungeonBackstageRowBrush" Color="{DynamicResource DungeonBackstageRowColor}" />
        <SolidColorBrush x:Key="DungeonBackstageRowHoverBrush" Color="{DynamicResource DungeonBackstageRowHoverColor}" />
        <SolidColorBrush x:Key="DungeonDeskBrush" Color="{DynamicResource DungeonDeskColor}" />
        <SolidColorBrush x:Key="DungeonSurfaceActiveBrush" Color="{DynamicResource DungeonSurfaceActiveColor}" />
        <SolidColorBrush x:Key="DungeonHoverOverlayBrush" Color="{DynamicResource DungeonHoverOverlayColor}" />
        <SolidColorBrush x:Key="DungeonSurfaceHoverBrush" Color="{DynamicResource DungeonSurfaceHoverColor}" />
        <SolidColorBrush x:Key="DungeonBorderBrush" Color="{DynamicResource DungeonBorderColor}" />
        <SolidColorBrush x:Key="DungeonBorderStrongBrush" Color="{DynamicResource DungeonBorderStrongColor}" />
        <SolidColorBrush x:Key="DungeonTextPrimaryBrush" Color="{DynamicResource DungeonTextPrimaryColor}" />
        <SolidColorBrush x:Key="DungeonTextRegularBrush" Color="{DynamicResource DungeonTextRegularColor}" />
        <SolidColorBrush x:Key="DungeonTextMutedBrush" Color="{DynamicResource DungeonTextMutedColor}" />
        <SolidColorBrush x:Key="DungeonAccentBrush" Color="{DynamicResource DungeonAccentColor}" />
        <SolidColorBrush x:Key="DungeonAccentBrightBrush" Color="{DynamicResource DungeonAccentBrightColor}" />
        <SolidColorBrush x:Key="DungeonAccentDimBrush" Color="{DynamicResource DungeonAccentDimColor}" />
        <SolidColorBrush x:Key="DungeonAccentEdgeBrush" Color="{DynamicResource DungeonAccentEdgeColor}" />
        <SolidColorBrush x:Key="DungeonOnAccentBrush" Color="{DynamicResource DungeonOnAccentColor}" />
        <SolidColorBrush x:Key="DungeonAccentTextHoverBrush" Color="{DynamicResource DungeonAccentTextHoverColor}" />
        <SolidColorBrush x:Key="DungeonSuccessBrush" Color="{DynamicResource DungeonSuccessColor}" />
        <SolidColorBrush x:Key="DungeonWarningBrush" Color="{DynamicResource DungeonWarningColor}" />
        <SolidColorBrush x:Key="DungeonDangerBrush" Color="{DynamicResource DungeonDangerColor}" />
        <SolidColorBrush x:Key="DungeonDangerTextBrush" Color="{DynamicResource DungeonDangerTextColor}" />
        <SolidColorBrush x:Key="DungeonSuccessDimBrush" Color="{DynamicResource DungeonSuccessDimColor}" />
        <SolidColorBrush x:Key="DungeonWarningDimBrush" Color="{DynamicResource DungeonWarningDimColor}" />
        <SolidColorBrush x:Key="DungeonDangerDimBrush" Color="{DynamicResource DungeonDangerDimColor}" />
        <SolidColorBrush x:Key="DungeonTableHeaderBrush" Color="{DynamicResource DungeonTableHeaderColor}" />
        <SolidColorBrush x:Key="DungeonPositiveSubtleBrush" Color="{DynamicResource DungeonPositiveSubtleColor}" />
        <SolidColorBrush x:Key="DungeonNegativeSubtleBrush" Color="{DynamicResource DungeonNegativeSubtleColor}" />
        <SolidColorBrush x:Key="DungeonAccentOnDimBrush" Color="{DynamicResource DungeonAccentOnDimColor}" />
        <SolidColorBrush x:Key="DungeonDangerOnDimBrush" Color="{DynamicResource DungeonDangerOnDimColor}" />
        <SolidColorBrush x:Key="DungeonNeutralDimBrush" Color="{DynamicResource DungeonNeutralDimColor}" />
        <SolidColorBrush x:Key="DungeonEditableHoverBrush" Color="{DynamicResource DungeonEditableHoverColor}" />
        <SolidColorBrush x:Key="DungeonEditableFocusBorderBrush" Color="{DynamicResource DungeonEditableFocusBorderColor}" />
        <SolidColorBrush x:Key="DungeonUncommittedBrush" Color="{DynamicResource DungeonUncommittedColor}" />
        <SolidColorBrush x:Key="DungeonTrackFillBrush" Color="{DynamicResource DungeonTrackFillColor}" />
        <SolidColorBrush x:Key="DungeonTrackOverBrush" Color="{DynamicResource DungeonTrackOverColor}" />
        <SolidColorBrush x:Key="DungeonTrackRoomBrush" Color="{DynamicResource DungeonTrackRoomColor}" />
        <SolidColorBrush x:Key="DungeonAboveBaseBrush" Color="{DynamicResource DungeonAboveBaseColor}" />
        <SolidColorBrush x:Key="DungeonBelowBaseBrush" Color="{DynamicResource DungeonBelowBaseColor}" />

        <!-- HOVER HALOS ================================================ -->
        <!-- 3 px band outside the border, no offset or blur, matching the control radius
             (background Border BoxShadow, format "offset-x offset-y blur spread colour").
             Colour stays in the same token because shadow is a value type and cannot accept
             a colour resource from a separate key. -->
        <!-- AccentHoverHalo: hover accent - halo for an Accent-filled button: Accent #B8843B
             at 35 % opacity. Fill does not change on hover. -->
        <BoxShadows x:Key="DungeonAccentHoverHaloShadow">0 0 0 3 #59B8843B</BoxShadows>
        <!-- DangerHoverHalo: hover danger - halo for a Danger-filled button:
             Danger #9C4530 at 45 % opacity. Fill does not change on hover. -->
        <BoxShadows x:Key="DungeonDangerHoverHaloShadow">0 0 0 3 #739C4530</BoxShadows>

        <!-- MOTION ============================================================= -->
        <!-- MotionDuration: duration of each shell animation - something moves, rotates or appears
             (toggle knob, dropdown arrow); at most 150 ms, always easing out
             (CubicEaseOut). State changes immediately, animation only catches up. Disabled system
             animations remove transitions entirely (Themes/ReducedMotion.axaml). -->
        <x:TimeSpan x:Key="DungeonMotionDuration">0:0:0.15</x:TimeSpan>
        <!-- PopupOpen: flyout and dropdown opening (Themes/PopupOpenMotion.cs) -
             surface fades in and slides by Offset from the opener's side.
             Shorter than MotionDuration (120 versus 150 ms): the user waits for opening
             with the cursor over the rows, and the offset is small - longer motion would feel like
             a delay. Closing without motion. -->
        <x:TimeSpan x:Key="DungeonPopupOpenDuration">0:0:0.12</x:TimeSpan>
        <x:Double x:Key="DungeonPopupOpenOffset">4</x:Double>
        <!-- ProgressSweep: one cycle of the indeterminate progress segment (Controls/ProgressSweep.cs)
             - continuous loop with easing in and out; not a state transition, so the
             MotionDuration limit does not apply. System animations disabled: no motion. -->
        <x:TimeSpan x:Key="DungeonProgressSweepDuration">0:0:1.6</x:TimeSpan>
        <!-- NotificationOpenOffset: distance a notification toast slides from the window's right edge
             (over DungeonPopupOpenDuration) - more than a popup, because a toast appears by itself, not under
             the cursor, and motion should draw the eye to the window corner. -->
        <x:Double x:Key="DungeonNotificationOpenOffset">12</x:Double>
        <!-- NotificationDismissDelay: time before a notification toast dismisses itself - theme constant for
             the variant, not an invocation parameter. Information 5 s (one sentence to read),
             warning 8 s (longer, because it may need a response). Errors do not auto-dismiss. Pointer over a toast
             pauses dismissal. -->
        <x:TimeSpan x:Key="DungeonNotificationInformationDismissDelay">0:0:5</x:TimeSpan>
        <x:TimeSpan x:Key="DungeonNotificationWarningDismissDelay">0:0:8</x:TimeSpan>

        <!-- SHADOWS =========================================================== -->
        <!-- FlyoutShadow: flyout and dropdown - subtle downward shadow separates them from content
             beneath (black at 40 % opacity, offset 2 px, blur 8 px). Drawn
             only within the popup window, measured to the flyout. -->
        <BoxShadows x:Key="DungeonFlyoutShadow">0 2 8 0 #66000000</BoxShadows>

        <!-- SCRIM ========================================================== -->
        <!-- Scrim: overlay over the window while asking a question (confirmation dialog) - rest of the window is
             unavailable until the question is answered. Black at 55 % opacity: underlying content
             stays recognisable (shows what the question concerns), but clearly recedes. -->
        <SolidColorBrush x:Key="DungeonScrimBrush" Color="#8C000000" />

        <!-- OPACITY ================================================= -->
        <!-- The one disabled-state opacity this theme defines - shared by every ":disabled" style
             that dims rather than recolors, so a second view never has to invent its own number. -->
        <x:Double x:Key="DungeonDisabledOpacity">0.48</x:Double>

        <!-- CONTROL AND PANEL BRUSHES ========================================= -->
        <!-- InputBackground: typing field - input goes here; recessed background (backstage background) distinguishes
             the field from a button and the card it sits on. -->
        <SolidColorBrush x:Key="DungeonInputBackgroundBrush" Color="{DynamicResource DungeonBackstageColor}" />
        <!-- InputBorder: resting field border - boundary of the typing area, quiet like a line. -->
        <SolidColorBrush x:Key="DungeonInputBorderBrush" Color="{DynamicResource DungeonBorderColor}" />
        <!-- InputHoverBorder: hovered field - clicking here starts editing. Same border remains
             throughout editing, even when the pointer leaves: caret indicates typing, not accent. -->
        <SolidColorBrush x:Key="DungeonInputHoverBorderBrush" Color="{DynamicResource DungeonBorderStrongColor}" />
        <!-- InputPlaceholder: placeholder - hint about what to enter; field is empty. -->
        <SolidColorBrush x:Key="DungeonInputPlaceholderBrush" Color="{DynamicResource DungeonTextMutedColor}" />
        <!-- TextSelection: selected text - this fragment is selected (copying, replacement).
             Muted steel blue #2E4C68 (HSL 209°, 38 %, 29 %) - dark-editor selection
             convention, dimmed to suit the warm palette; no accent, because text selection is not a selected
             item. Opaque colour looks identical in fields and cards; primary text #E8E4DA
             on it 7.04:1. Hue far from neutral Highlight (#4A443D, warm grey)
             and sage SearchMatch (#84A98B at 35 %, about #3C483C on a field background). Same token
             in text fields and SelectableTextBlock. -->
        <SolidColorBrush x:Key="DungeonTextSelectionBrush" Color="#2E4C68" />
        <!-- Highlight: emphasized text background - value is important in a sentence but remains text
             (challenge "1/2" on a card). Neutral and light, no accent: nothing is selected.
             Opaque #4A443D looks identical on every surface; primary text on it
             7.57:1. -->
        <SolidColorBrush x:Key="DungeonHighlightBrush" Color="#4A443D" />
        <!-- SearchMatch: search hit background - this fragment matches the
             query. Sage green (#84A98B, Success hue) at 35 % opacity (#5984A98B):
             hue far from blue selection and grey highlight. Primary text on it
             7.57:1 on field background (#151412). -->
        <SolidColorBrush x:Key="DungeonSearchMatchBrush" Color="#5984A98B" />
        <!-- ScrollThumb: scrollbar thumb - more content than visible; drag. Strong border
             colour (BorderStrong #413C36): visible, but does not demand attention. -->
        <SolidColorBrush x:Key="DungeonScrollThumbBrush" Color="{DynamicResource DungeonBorderStrongColor}" />
        <!-- ScrollThumbHover: hovered (and dragged) thumb - responds to the pointer. About
             10 lightness points brighter than rest (#5E5750, HSL 30°, 8 %, 34 %), still neutral,
             no accent. -->
        <SolidColorBrush x:Key="DungeonScrollThumbHoverBrush" Color="#5E5750" />
        <!-- SliderThumb: slider thumb - value is here; drag or click the track. Secondary text
             colour (TextRegular #B4B2AC): neutral, no accent - track before the thumb
             carries accent; muted to leave room for lightening on hover. -->
        <SolidColorBrush x:Key="DungeonSliderThumbBrush" Color="{DynamicResource DungeonTextRegularColor}" />
        <!-- SliderThumbHover: hovered (and dragged) thumb - responds to the pointer. Primary text
             colour (TextPrimary #E8E4DA): clearly lighter than rest (lightness from about 70 %
             to about 91 %), unchanged size; immediate colour change, no motion. -->
        <SolidColorBrush x:Key="DungeonSliderThumbHoverBrush" Color="{DynamicResource DungeonTextPrimaryColor}" />

        <!--
            Panel chrome. Semantic aliases rather than direct use of the generic surface tokens, so a
            floating panel can diverge from other surfaces later without touching any view.
            A minimized panel is the same object in another state, so the deck cards share these.
        -->
        <!-- PanelWindowBackground: desk window - window background. -->
        <SolidColorBrush x:Key="DungeonPanelWindowBackgroundBrush" Color="{DynamicResource DungeonSurfaceColor}" />
        <!-- PanelWindowHeader: desk window - window header. -->
        <SolidColorBrush x:Key="DungeonPanelWindowHeaderBrush" Color="{DynamicResource DungeonSurfaceHeaderColor}" />
        <!-- PanelWindowBorder: desk window - window border. -->
        <SolidColorBrush x:Key="DungeonPanelWindowBorderBrush" Color="{DynamicResource DungeonBorderColor}" />
        <!--
            The active panel changes only this brush. A stronger neutral border keeps focus legible
            without making ordinary window selection look like a warning or validation state. Changing
            BorderThickness instead would resize the panel every time focus moved.
        -->
        <!-- PanelWindowActiveBorder: desk window - active window border. -->
        <SolidColorBrush x:Key="DungeonPanelWindowActiveBorderBrush" Color="{DynamicResource DungeonBorderStrongColor}" />
        <!-- Named so nobody helpfully makes the resize gutters visible: they are hit targets only.
             It must stay Transparent rather than null, because null is not hit-testable. -->
        <SolidColorBrush x:Key="DungeonPanelResizeGripBrush" Color="Transparent" />

        <!-- FrameOverlay: a frame element laid over the desk windows (the leaf, later the hotbar) -
        background, corner radius and shadow. Darker than the window background (#1B1917) and the
        desk (#151412), with a deeper shadow and a larger radius than a window, so it reads as
        sitting above every window. -->
        <SolidColorBrush x:Key="DungeonFrameOverlayBackgroundBrush" Color="#0E0D0C" />
        <CornerRadius x:Key="DungeonFrameOverlayCornerRadius">14</CornerRadius>
        <BoxShadows x:Key="DungeonFrameOverlayShadow">0 6 18 0 #B3000000</BoxShadows>

        <!-- TYPOGRAPHY ========================================================= -->
        <FontFamily x:Key="DungeonUiFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        <FontFamily x:Key="DungeonDisplayFont">avares://DungeonApp.Desktop/Assets/Fonts/CormorantGaramond#Cormorant Garamond</FontFamily>
        <!-- Fixed-width figures for numbers. Regular, Medium and SemiBold files. -->
        <FontFamily x:Key="DungeonMonoFont">avares://DungeonApp.Desktop/Assets/Fonts/IBMPlexMono#IBM Plex Mono</FontFamily>

        <CornerRadius x:Key="DungeonWindowCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="DungeonCardCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="DungeonControlCornerRadius">5</CornerRadius>
        <CornerRadius x:Key="DungeonNavigationCornerRadius">4</CornerRadius>
        <!-- Compatibility alias for campaign controls not yet split into card/control variants. -->
        <CornerRadius x:Key="DungeonCornerRadius">5</CornerRadius>

        <!-- SPACING AND RADII ============================================= -->
        <!--
            Spacing scale expressed as literals recurring in views.
            Two parallel sets: Double for Spacing/Width/Height and Thickness for Margin/Padding.
        -->
        <x:Double x:Key="DungeonSpacingXs">6</x:Double>
        <x:Double x:Key="DungeonSpacingSm">8</x:Double>
        <x:Double x:Key="DungeonSpacingMd">12</x:Double>
        <x:Double x:Key="DungeonSpacingLg">16</x:Double>
        <x:Double x:Key="DungeonSpacingXl">20</x:Double>
        <x:Double x:Key="DungeonSpacingXxl">24</x:Double>
        <x:Double x:Key="DungeonSpacingXxxl">32</x:Double>

        <Thickness x:Key="DungeonPaddingXs">6</Thickness>
        <Thickness x:Key="DungeonPaddingSm">8</Thickness>
        <Thickness x:Key="DungeonPaddingMd">12</Thickness>
        <Thickness x:Key="DungeonPaddingLg">16</Thickness>
        <Thickness x:Key="DungeonPaddingXxl">24</Thickness>
        <!-- Top and bottom only - equals DungeonSpacingLg (.section separator spacing). -->
        <Thickness x:Key="DungeonPaddingLgVertical">0,16,0,16</Thickness>
        <!-- Sides only - equals DungeonSpacingMd (single-line field text padding). -->
        <Thickness x:Key="DungeonPaddingMdHorizontal">12,0,12,0</Thickness>
        <!-- Text padding in a field with a leading icon (controls:IconField - pencil, magnifier): right
             only, DungeonSpacingMd - icon in the frame carries left spacing (DungeonPaddingMdHorizontal
             on both sides), so the text box starts just after it. -->
        <Thickness x:Key="DungeonInputTextAfterIconMargin">0,0,12,0</Thickness>
        <!-- DungeonSpacingMd at sides, DungeonSpacingSm above and below (multiline field text padding). -->
        <Thickness x:Key="DungeonPaddingMdHorizontalSmVertical">12,8,12,8</Thickness>
        <!-- Multiline text padding on the scrollable content: DungeonPaddingMdHorizontalSmVertical
             (12, 8, 12, 8) with right padding increased by the scrollbar zone (DungeonScrollBarZone, 16) - text
             wraps before the bar, while the bar sits at the field edge. -->
        <Thickness x:Key="DungeonMultilineInputContentPadding">12,8,28,8</Thickness>
        <!-- Multiline field: three lines of 13 px text (about 17 px each) + padding 8 + 8 + borders. -->
        <x:Double x:Key="DungeonMultilineInputMinHeight">70</x:Double>
        <!-- Numeric field: room for several monospaced digits and arrows; independent of the value. -->
        <x:Double x:Key="DungeonNumericInputWidth">96</x:Double>
        <!-- Scrollbar: overlay above content (takes no space); thumb sits at
             the bar's outer edge. On hover the thumb widens within the bar towards content -
             bar thickness and thumb-edge gap stay unchanged, so nothing jumps. -->
        <x:Double x:Key="DungeonScrollBarSize">10</x:Double>
        <!-- Equal gap from the scroll-area edge and both scrollbar ends, matching
             DungeonSpacingXs (6): bar does not touch rounded list or popup corners (radius 6)
             or appear to protrude from them. No inset on the side away from the edge (bar has
             fixed thickness and sits by the edge). -->
        <Thickness x:Key="DungeonScrollBarInset">6</Thickness>
        <!-- Scrollbar zone: bar thickness and edge gap (10 + 6 = 16) - scrollable container content
             ends this much earlier on the vertical scrollbar side, so the bar does not
             cover text; row backgrounds extend beneath it. Measured from the scroll-area edge:
             a row at that edge adds the full zone (inner row padding), while container
             padding on the scrollbar side is within the zone - the row then adds only the remainder (below,
             DungeonScrollBarZoneInFlyout; lists with their own padding override this resource). Right only:
             horizontal scrollbar is Disabled in every shell list and field. -->
        <Thickness x:Key="DungeonScrollBarZone">0,0,16,0</Thickness>
        <!-- Scrollbar strip is measured from the scroll-area edge, not the row edge: container
             padding on the scrollbar side is within the strip, so the row adds only the remainder. A flyout row
             (menu, submenu, ComboBox, DropDownPicker, .list-host list) is inset
             by flyout padding (DungeonFlyoutPadding, 4) from the scroll-area edge - adds
             16 - 4 = 12. Text then ends 16 + row padding from the edge, as in a list without
             padding. A popup whose content fits without scrolling has no zone (.no-bar-zone
             from Themes/PopupOpenLayout.cs, fixed on opening). -->
        <Thickness x:Key="DungeonScrollBarZoneInFlyout">0,0,12,0</Thickness>
        <x:Double x:Key="DungeonScrollThumbSize">6</x:Double>
        <x:Double x:Key="DungeonScrollThumbHoverSize">8</x:Double>
        <!-- Shortest thumb for very long content - still large enough to grab. -->
        <x:Double x:Key="DungeonScrollThumbMinLength">24</x:Double>
        <!-- Fully rounded thumb (pill) at any width. -->
        <CornerRadius x:Key="DungeonScrollThumbCornerRadius">999</CornerRadius>

        <!-- Checkbox, radio button, toggle, slider - marker dimensions. Entire control has
             minimum height DungeonControlHeight (aligned with a field and button). -->
        <!-- Checkbox marker (square) and radio button (circle): side 16 - clearly smaller than
             a text line with spacing, but large enough for a readable checkmark. -->
        <x:Double x:Key="DungeonChoiceMarkSize">16</x:Double>
        <!-- Checkbox square radius: smaller than controls (5), because the square is small - 3 for
             side 16 is about 1/5 of the side; still reads as a square rather than a circle. -->
        <CornerRadius x:Key="DungeonCheckBoxCornerRadius">3</CornerRadius>
        <!-- Radio button circle: half DungeonChoiceMarkSize - fully rounded. -->
        <CornerRadius x:Key="DungeonRadioButtonCornerRadius">8</CornerRadius>
        <!-- Selected radio button dot: diameter. -->
        <x:Double x:Key="DungeonRadioDotSize">6</x:Double>
        <!-- Checkmark and indeterminate-line stroke thickness - same number as shell icon pen
             (DungeonIconPen), drawn in the 16 px marker's pixels, rounded caps and joins. -->
        <x:Double x:Key="DungeonChoiceGlyphThickness">1.75</x:Double>
        <!-- Label beside a marker (checkbox, radio button, toggle): left gap from
             marker DungeonSpacingSm; above and below (36 - 13 px text line, about 16) / 2 = 10 - first
             line centred on control height, like the marker; longer labels wrap
             downwards, marker stays with the first line. -->
        <Thickness x:Key="DungeonChoiceLabelPadding">8,10,0,10</Thickness>
        <!-- Toggle track: 36 x 18, fully rounded; knob 12, 3 px from the track edge in both
             positions. Track width is twice the knob slot (18) - as in the Fluent template
             (40 x 20, knob slot 20), from which the control calculates knob position. -->
        <x:Double x:Key="DungeonToggleTrackWidth">36</x:Double>
        <x:Double x:Key="DungeonToggleTrackHeight">18</x:Double>
        <CornerRadius x:Key="DungeonToggleTrackCornerRadius">9</CornerRadius>
        <x:Double x:Key="DungeonToggleKnobSize">12</x:Double>
        <!-- Slider track: thickness 4, fully rounded at both ends (radius 2). Track consists of two
             parts meeting beneath the thumb: before it (only start rounded) and after it
             (only end rounded) - straight join beneath the thumb leaves no visible
             gap or notch beside it. -->
        <x:Double x:Key="DungeonSliderTrackThickness">4</x:Double>
        <CornerRadius x:Key="DungeonSliderTrackStartCornerRadius">2,0,0,2</CornerRadius>
        <CornerRadius x:Key="DungeonSliderTrackEndCornerRadius">0,2,2,0</CornerRadius>
        <!-- Slider thumb: circle of diameter 14, radius half of that. -->
        <x:Double x:Key="DungeonSliderThumbSize">14</x:Double>
        <CornerRadius x:Key="DungeonSliderThumbCornerRadius">7</CornerRadius>

        <!-- SHELL AND PANEL DIMENSIONS ========================================== -->
        <!-- Loading progress bar (startup curtain): width. -->
        <x:Double x:Key="DungeonLoadingProgressBarWidth">192</x:Double>
        <!-- ProgressBar: thin bar matching slider track thickness, fully rounded at
             both ends (radius half the thickness) - consistent with the slider track. -->
        <x:Double x:Key="DungeonProgressBarThickness">4</x:Double>
        <CornerRadius x:Key="DungeonProgressBarCornerRadius">2</CornerRadius>
        <!-- Confirmation dialog: maximum card width (narrower in a small window, with
             DungeonSpacingXxl from window edges). -->
        <x:Double x:Key="DungeonConfirmationDialogMaxWidth">400</x:Double>
        <!-- Palette: maximum card width and maximum height of its result list (longer lists scroll). -->
        <x:Double x:Key="DungeonPaletteMaxWidth">520</x:Double>
        <x:Double x:Key="DungeonPaletteListMaxHeight">320</x:Double>
        <!-- Notification toast: fixed width - longer content wraps rather than expanding the toast. -->
        <x:Double x:Key="DungeonNotificationWidth">340</x:Double>

        <!-- Fixed UI dimensions. -->
        <x:Double x:Key="DungeonBaseFontSize">13</x:Double>
        <x:Double x:Key="DungeonHelperFontSize">12</x:Double>
        <x:Double x:Key="DungeonEyebrowFontSize">10</x:Double>
        <x:Double x:Key="DungeonStatusFontSize">12</x:Double>
        <x:Double x:Key="DungeonWorkspaceTitleFontSize">22</x:Double>
        <x:Double x:Key="DungeonCampaignNameFontSize">15</x:Double>
        <x:Double x:Key="DungeonBrandNameFontSize">16</x:Double>
        <x:Double x:Key="DungeonBrandMarkFontSize">16</x:Double>
        <x:Double x:Key="DungeonBrandMarkLargeFrameSize">96</x:Double>
        <x:Double x:Key="DungeonBrandMarkLargeFontSize">64</x:Double>
        <!-- Shared by the top bar's own height and the sidebar header's (GlobalSidebarView.axaml),
             so their bottom borders always draw as one continuous line - a plain Double, not a
             GridLength, since both usages are a Height, never a column/row size. -->
        <x:Double x:Key="DungeonTopBarHeight">52</x:Double>
        <GridLength x:Key="DungeonSidebarWidth">224</GridLength>
        <GridLength x:Key="DungeonStatusBarHeight">24</GridLength>
        <x:Double x:Key="DungeonControlHeight">36</x:Double>
        <!-- Minimum text field width (TextBox; in an icon field - text area, so
             total adds icon and clear-button strips to this value). WinUI convention
             (TextControlThemeMinWidth). Container assigns actual width: stretched field or
             layout-defined width, never measured to entered text. -->
        <x:Double x:Key="DungeonInputMinWidth">64</x:Double>
        <!-- List row (ListBoxItem): denser than a control (36) - many items stacked
             vertically, each row carrying one line of 13 px text. -->
        <x:Double x:Key="DungeonListRowHeight">32</x:Double>
        <!-- World catalog row (tree on the desk): lower than a list row (24 versus 32), because the
             tree is dense and its text is helper size (12). Each level of depth indents by 16 (the
             chevron's width), so a folder's name and its entities' names stand on the same line. -->
        <x:Double x:Key="DungeonWorldRowHeight">24</x:Double>
        <!-- ListRowIconSize - an entry's own icon before its name in a list row: about as tall as the
             row's line of 13 px text (20), so it reads as part of the line, not as a picture. -->
        <x:Double x:Key="DungeonListRowIconSize">18</x:Double>
        <!-- List-row highlight (hover, selected; ListBoxItem, ComboBoxItem, DropDownPicker
             rows) is inset 1 px at top and bottom: adjacent highlights
             have a 2 px gap rather than touching rounded corners; row still occupies
             DungeonListRowHeight. -->
        <Thickness x:Key="DungeonListRowHighlightInset">0,1</Thickness>
        <!-- List-row action (trash, DungeonRowAction): full-height strip up to the end of
             row content - extends through highlight gap (1 at top and bottom) and right row
             padding (DungeonPaddingMdHorizontal, 12); leaves the scrollbar zone (DungeonScrollBarZone)
             free - strip ends before it. -->
        <Thickness x:Key="DungeonListRowActionMargin">0,-1,-12,-1</Thickness>
        <!-- Row highlight radius: clearly smaller than popup radius (3 versus 6), so
             highlight reads as one field in a popup, not a box inside a box. -->
        <CornerRadius x:Key="DungeonListRowHighlightCornerRadius">3</CornerRadius>
        <!-- List-row selection stripe (ListRow with ShowsSelectionStripe): accent colour, thickness 3,
             rounded. In the row's left gutter (row background starts after
             the gutter), at its left edge - distance from the background edge equals gutter width. The list
             supplies gutter width and vertical stripe insets (list-level resources); values here
             are for the content list (gutter 10, stripe inset 5 above and below). -->
        <x:Double x:Key="DungeonListRowStripeWidth">3</x:Double>
        <CornerRadius x:Key="DungeonListRowStripeCornerRadius">1.5</CornerRadius>
        <x:Double x:Key="DungeonListRowStripeGutter">10</x:Double>
        <Thickness x:Key="DungeonListRowStripeInset">0,5</Thickness>
        <!-- Badge (value) and tag (word): shared height 22 - fits a size 12 line with 3-4 px breathing room
             and centres in a list row (32) and size 13 text line. Badge is a rectangle with small
             radius 4 (like navigation), tag - pill (half height). Badge padding 8,
             tag padding 10: a pill needs more space to keep text away from its curve. -->
        <x:Double x:Key="DungeonBadgeHeight">22</x:Double>
        <CornerRadius x:Key="DungeonBadgeCornerRadius">4</CornerRadius>
        <Thickness x:Key="DungeonBadgePadding">8,0</Thickness>
        <CornerRadius x:Key="DungeonTagCornerRadius">11</CornerRadius>
        <Thickness x:Key="DungeonTagPadding">10,0</Thickness>
        <!-- Filter chip: compact control in a filter row - shorter than a button (36), horizontal
             padding 10, radius matching controls (DungeonControlCornerRadius). -->
        <x:Double x:Key="DungeonChipHeight">28</x:Double>
        <Thickness x:Key="DungeonChipPadding">10,0</Thickness>
        <!-- Card table: cell minimum height 28, padding 10 at sides and 6 above and below. -->
        <x:Double x:Key="DungeonTableCellMinHeight">28</x:Double>
        <Thickness x:Key="DungeonTableCellPadding">10,6</Thickness>
        <!-- Entry detail grid: everything aligns to three vertical lines - left
             edge, right edge of the header image and start of the title column.
             DetailPictureWidth - header image width (square item image, 3:4
             portrait). Column beside the image must fit a single-line name (42), gap (6), tags
             (up to 25), two gaps above the header value (12) and the value with note (60) - up to
             145 total; 150 is the smallest round width above that.
             AbilityCellSize - side of a square ability-table cell. Three cells equal image width
             (3 x 50 = DetailPictureWidth): left table ends at the image's right edge, right table
             starts at the title-column line - changing either token requires changing the other.
             DetailColumnGap - gap between image and title column, also between card
             columns (two ability tables). -->
        <x:Double x:Key="DungeonDetailPictureWidth">150</x:Double>
        <x:Double x:Key="DungeonAbilityCellSize">50</x:Double>
        <x:Double x:Key="DungeonDetailColumnGap">16</x:Double>
        <!-- Header value (controls:StatTile): caption icon 12 px - smaller than an action
             icon (16), because it sits in an 11 px caption. -->
        <x:Double x:Key="DungeonStatTileIconSize">12</x:Double>
        <!-- Tracked value gauge (controls:TrackGauge): 10 px thick - a bar, not a hairline, so a few
             points of difference show. -->
        <x:Double x:Key="DungeonTrackGaugeThickness">10</x:Double>
        <!-- Section heading (controls:SectionHeading): accent bar 3 x 18. -->
        <x:Double x:Key="DungeonSectionHeadingBarWidth">3</x:Double>
        <x:Double x:Key="DungeonSectionHeadingBarHeight">18</x:Double>
        <!-- Flyout and dropdown: surface radius (6, like a card) and inner
             padding (4 - less than DungeonPaddingXs, keeping row highlight near
             the popup edge, without a frame inside a frame). Buttons and fields retain
             DungeonControlCornerRadius. -->
        <CornerRadius x:Key="DungeonFlyoutCornerRadius">6</CornerRadius>
        <Thickness x:Key="DungeonFlyoutPadding">4</Thickness>
        <!-- Flyout and dropdown: maximum height - ten list rows
             (10 x 32) with popup padding (2 x 4) and border (2 x 1); longer content scrolls
             inside. -->
        <x:Double x:Key="DungeonFlyoutMaxHeight">330</x:Double>
        <!-- Flyout and dropdown gap from the opener:
             transparent margin above and below the popup surface (FlyoutPresenter theme), so
             works equally when opening downwards and when limited space flips it above
             the element; also leaves vertical room for shadow. Equals DungeonSpacingXs - smallest
             scale value. Horizontal zero aligns the popup's left edge with the opener's left
             edge. -->
        <Thickness x:Key="DungeonFlyoutMargin">0,6</Thickness>
        <!-- Tooltip (ToolTip): padding 8 horizontally (DungeonSpacingSm) and 4 vertically - one line
             of size 12 gives about 24 height; maximum width 320 (about 50 size-12 characters), longer
             text wraps - tooltip never trims. -->
        <Thickness x:Key="DungeonToolTipPadding">8,4</Thickness>
        <x:Double x:Key="DungeonToolTipMaxWidth">320</x:Double>
        <!-- Menu (MenuFlyout, ContextMenu and submenu): minimum width 160, maximum 320;
             width from the longest item, longer labels trim with an ellipsis. -->
        <x:Double x:Key="DungeonMenuMinWidth">160</x:Double>
        <x:Double x:Key="DungeonMenuMaxWidth">320</x:Double>
        <!-- Submenu top row aligns with the parent item: shifted up by menu
             surface padding (DungeonFlyoutPadding, 4) and border (1). -->
        <x:Double x:Key="DungeonSubmenuVerticalOffset">-5</x:Double>
        <!-- Submenu sits beside its parent menu, not on it: parent item ends before
             the menu's right edge by its padding (DungeonFlyoutPadding, 4) and border (1), beyond the edge
             is the popup-opener gap (DungeonFlyoutMargin, 6) - total 4 + 1 + 6. -->
        <x:Double x:Key="DungeonSubmenuHorizontalOffset">11</x:Double>
        <!-- Gap between shortcut column and menu-item label (DungeonSpacingXxl). -->
        <Thickness x:Key="DungeonMenuGestureMargin">24,0,0,0</Thickness>
        <!-- Gap from icon column to label and label to submenu arrow (DungeonSpacingSm). -->
        <Thickness x:Key="DungeonMenuIconMargin">0,0,8,0</Thickness>
        <Thickness x:Key="DungeonMenuChevronMargin">8,0,0,0</Thickness>
        <!-- Menu separator: gap 4 above and below the line. -->
        <Thickness x:Key="DungeonMenuSeparatorMargin">0,4</Thickness>
        <!-- Breadcrumbs (controls:Breadcrumbs): inter-segment arrow 8 px - smaller than an action
             icon (16), because it sits in 12 px text and only separates. DungeonSpacingXs
             on both sides of the arrow. -->
        <x:Double x:Key="DungeonBreadcrumbSeparatorSize">8</x:Double>
        <!-- Tab (TabItem, TabStripItem): height 32 - like a list row (8 px + 13 px line
             + 8 px gives about 32). Horizontal padding 12 (DungeonSpacingMd). -->
        <x:Double x:Key="DungeonTabHeight">32</x:Double>
        <Thickness x:Key="DungeonTabPadding">12,0</Thickness>
        <!-- Maximum tab width: about 30 size-13 characters. Longer names trim
             with an ellipsis and show full text in a tooltip. -->
        <x:Double x:Key="DungeonTabMaxWidth">240</x:Double>
        <!-- Tab strip spacing (horizontal and between wrapped lines) uses the
             scale: DungeonSpacingXs. -->
        <!-- Segmented control (ListBox with DungeonSegmentedControl theme): container has field height
             and border (DungeonControlHeight, Input*), segments inset 3 px from
             the edge with radius 3 - smaller than the container (5), so a selected segment reads
             as an area within the field, not a second field. -->
        <Thickness x:Key="DungeonSegmentedInset">3</Thickness>
        <CornerRadius x:Key="DungeonSegmentCornerRadius">3</CornerRadius>
        <!-- Expander: header at list-row height (32); arrow 16 px
             (DungeonActionIconSize), DungeonSpacingSm from label. Content inset by arrow
             width and gap (12 + 16 + 8 = 36) to align with the header label rather than
             the arrow. -->
        <x:Double x:Key="DungeonExpanderHeaderHeight">32</x:Double>
        <Thickness x:Key="DungeonExpanderContentPadding">36,8,12,8</Thickness>
        <x:Double x:Key="DungeonCampaignRowHeight">40</x:Double>
        <x:Double x:Key="DungeonCampaignListViewportHeight">258</x:Double>
        <x:Double x:Key="DungeonActionIconSize">16</x:Double>
        <!-- Image frame (controls:ImageFrame): placeholder icon - large because it sits
             alone at the centre of an empty frame and identifies what is missing. -->
        <x:Double x:Key="DungeonImageFrameIconSize">48</x:Double>
        <!-- InlineIconButton: icon button in a text row (direction button after the sort
             link) - square 24: icon 16 with a 4-wide band for hover background and a hit area larger
             than the icon itself. Overhang reduces layout height to icon height (24 - 2 x 4 = 16),
             avoiding a taller text row; hover background protrudes 4 above and below the row. -->
        <x:Double x:Key="DungeonInlineIconButtonSize">24</x:Double>
        <Thickness x:Key="DungeonInlineIconButtonOverhang">0,-4</Thickness>
        <!-- The smallest supported desktop workspace still shows its complete chrome, the campaign
             form and a usable list viewport. Data beyond that viewport scrolls inside the shelf. -->
        <x:Double x:Key="DungeonMinimumWindowWidth">1280</x:Double>
        <x:Double x:Key="DungeonMinimumWindowHeight">720</x:Double>
        <x:Double x:Key="DungeonPanelHeaderHeight">36</x:Double>
        <x:Double x:Key="DungeonPanelHeaderActionSize">36</x:Double>
        <x:Double x:Key="DungeonPanelTitleFontSize">13</x:Double>
        <x:Double x:Key="DungeonPanelResizeBorderThickness">6</x:Double>
        <x:Double x:Key="DungeonPanelResizeCornerSize">12</x:Double>
        <x:Double x:Key="DungeonDeckCardSize">44</x:Double>
        <x:Double x:Key="DungeonPanelMinWidth">240</x:Double>
        <x:Double x:Key="DungeonPanelMinHeight">152</x:Double>
        <x:Double x:Key="DungeonWorkspaceEdgeMargin">0</x:Double>
        <x:Double x:Key="DungeonPanelGap">12</x:Double>
        <Thickness x:Key="DungeonDeckEdgeInsetThickness">12</Thickness>

        <!-- TEXT STRINGS ============================================================= -->
        <x:String x:Key="DungeonStringMinimizeToolTip">Zminimalizuj</x:String>
        <x:String x:Key="DungeonStringMaximizeToolTip">Maksymalizuj</x:String>
        <x:String x:Key="DungeonStringMaximizedTitleToolTip">Dwuklik albo Esc — przywróć</x:String>
        <x:String x:Key="DungeonStringCloseCampaignToolTip">Zamknij kampanię</x:String>
        <x:String x:Key="DungeonStringUndoToolTip">Cofnij (Ctrl+Z)</x:String>
        <x:String x:Key="DungeonStringRedoToolTip">Ponów (Ctrl+Y)</x:String>
        <x:String x:Key="DungeonStringCommandsToolTip">Polecenia (Ctrl+K)</x:String>
    </ResourceDictionary>
