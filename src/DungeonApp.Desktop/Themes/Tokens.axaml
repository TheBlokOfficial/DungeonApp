    <ResourceDictionary xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <!-- KOLORY ============================================================ -->
        <!-- Background: tło - najgłębszy poziom, pod całą resztą. -->
        <Color x:Key="DungeonBackgroundColor">#151412</Color>
        <!-- Surface: powierzchnia - poziom nad tłem. -->
        <Color x:Key="DungeonSurfaceColor">#1B1917</Color>
        <!-- SurfaceHeader: powierzchnia - poziom nad tłem (nagłówek powierzchni). -->
        <Color x:Key="DungeonSurfaceHeaderColor">#1B1917</Color>
        <!--
            Application depth hierarchy. These semantic roles intentionally remain separate from the
            generic surface tokens even where their current color values match. The outer frame,
            backstage workspace and live campaign desk may evolve independently without making a
            header or panel change color as a side effect.
        -->
        <!-- TŁA I OBSZAR ROBOCZY -->
        <!-- Frame: rama - stałe otoczenie treści (pasek boczny, pasek górny). -->
        <Color x:Key="DungeonFrameColor">#1B1917</Color>
        <!-- FrameHover: najechanie na ramie - ten element ramy reaguje na mysz. -->
        <Color x:Key="DungeonFrameHoverColor">#282522</Color>
        <!-- Backstage: zaplecze - tło treści poza kampanią (biblioteka, półka, galeria). -->
        <Color x:Key="DungeonBackstageColor">#151412</Color>
        <!-- BackstageEdge: zaplecze - tło treści poza kampanią, przy dalekiej krawędzi szerokiego widoku
             (koniec gradientu BackstageWide). -->
        <Color x:Key="DungeonBackstageEdgeColor">#100F0E</Color>
        <!-- BackstageCard: karta - rzecz wyodrębniona z tła, czytana jako całość. -->
        <Color x:Key="DungeonBackstageCardColor">#1F1D1A</Color>
        <!-- BackstageRow: wiersz - pozycja, którą można wskazać. -->
        <Color x:Key="DungeonBackstageRowColor">#221F1C</Color>
        <!-- BackstageRowHover: najechanie - to reaguje na mysz. -->
        <Color x:Key="DungeonBackstageRowHoverColor">#282522</Color>
        <!-- Desk: biurko - tło treści otwartej kampanii. -->
        <Color x:Key="DungeonDeskColor">#151412</Color>
        <!-- SurfaceActive: aktywne - wybrane albo wciśnięte teraz. -->
        <Color x:Key="DungeonSurfaceActiveColor">#282522</Color>
        <!-- SurfaceHover: najechanie - to reaguje na mysz. -->
        <Color x:Key="DungeonSurfaceHoverColor">#221F1C</Color>
        <!-- HoverOverlay: najechanie na cichej kontrolce (przycisk .subtle) - biały o nieprzezroczystości
             8 % (#14FFFFFF), z kanałem alfa: rozjaśnia to, na czym leży, więc najechanie widać na każdej
             powierzchni, także na wierszu listy pod myszą (BackstageRowHover). Na zapleczu (#151412)
             daje ok. #272522 - tyle co kryjący SurfaceActive, którego używał wcześniej. -->
        <Color x:Key="DungeonHoverOverlayColor">#14FFFFFF</Color>
        <!-- Border: linia - dzieli, nie wyróżnia; krawędź powierzchni i separator. -->
        <Color x:Key="DungeonBorderColor">#302C28</Color>
        <!-- BorderStrong: obramowanie wyraźne - krawędź, na którą ma paść wzrok: kontrolka pod myszą,
             aktywne okno, krawędź ramy. -->
        <Color x:Key="DungeonBorderStrongColor">#413C36</Color>
        <!-- TEKST -->
        <!-- TextPrimary: tekst podstawowy - treść i wszystko domyślnie. -->
        <Color x:Key="DungeonTextPrimaryColor">#E8E4DA</Color>
        <!-- TextRegular: tekst drugorzędny - opis, uzupełnienie. -->
        <Color x:Key="DungeonTextRegularColor">#B4B2AC</Color>
        <!-- TextMuted: tekst przygaszony - podpis, etykieta, metadane. -->
        <Color x:Key="DungeonTextMutedColor">#8A8983</Color>
        <Color x:Key="DungeonAccentColor">#B8843B</Color>
        <!-- AccentBright: akcent wyróżniony - odcień Accent, bardziej jaskrawy, nie jaśniejszy: nasycenie
             +13 punktów, jasność +2 (HSL 35°, 65%, 50% wobec 35°, 51%, 48%). Znak marki na ekranie
             startowym i pasek postępu; przycisk pod myszą go nie używa (ma otoczkę, DungeonAccentHoverHaloShadow). -->
        <Color x:Key="DungeonAccentBrightColor">#D28D2D</Color>
        <!-- AccentDim: przygaszony akcent - tło pod tym, co wybrane (wiersz listy, aktywny filtr) albo
             pod treścią w akcencie (odznaka wyzwania). Accent #B8843B o nieprzezroczystości 16 %
             (#29B8843B): zapisany z kanałem alfa, a nie przeliczony na tło, bo leży na różnych
             powierzchniach (zaplecze, karta, okienko filtra) i ma na każdej wyglądać jak ta sama
             przygaszona barwa, bez szwu. Tekst podstawowy na nim na tle zaplecza (ok. #2F2619)
             ok. 12:1. Nie do linii ani rysunku - na to jest za słaby; tam idzie Accent. -->
        <Color x:Key="DungeonAccentDimColor">#29B8843B</Color>
        <!-- AccentEdge: krawędź tego, co aktywne na przygaszonym akcencie (włączony chip, aktywny filtr,
             chip-lista z wyborem) - Accent #B8843B o nieprzezroczystości 40 % (#66B8843B), z kanałem alfa
             z tego samego powodu co AccentDim. Wyraźnie jaśniejsza od wypełnienia AccentDim (16 %), ale
             nie krzyczy: pełny Accent przy przygaszonym wypełnieniu robił z niego półprzezroczyste złoto
             na szarym. Tylko krawędź - nie tekst ani rysunek. -->
        <Color x:Key="DungeonAccentEdgeColor">#66B8843B</Color>
        <Color x:Key="DungeonOnAccentColor">#241A0C</Color>
        <!-- AccentTextHover: akcent jako tekst pod myszą - odnośnik w zdaniu, na który wskazuje mysz.
             Ten sam odcień co Accent, jaśniejszy o 10 punktów (HSL 35°, 51%, 58% wobec 48%): najechanie
             widać po samym kolorze, bo podkreślenie odnośnika w zdaniu jest stałe. Tylko tekst - nie tło
             i nie zamiast Accent w spoczynku. -->
        <Color x:Key="DungeonAccentTextHoverColor">#CB9D5D</Color>
        <!-- Sukces: udało się. -->
        <Color x:Key="DungeonSuccessColor">#84A98B</Color>
        <!-- Ostrzeżenie: wymaga uwagi, ale działa. -->
        <Color x:Key="DungeonWarningColor">#D6B84F</Color>
        <!-- Niebezpieczeństwo: coś jest zepsute, akcja usuwa albo jest nieodwracalna. -->
        <Color x:Key="DungeonDangerColor">#9C4530</Color>
        <!-- Niebezpieczeństwo (tekst): to samo znaczenie co Danger (coś jest zepsute, akcja usuwa albo
             jest nieodwracalna), odmiana czytelna jako tekst i sam rysunek bez tła (kosz w wierszu pod
             myszą);
             Danger zostaje dla teł. -->
        <Color x:Key="DungeonDangerTextColor">#D46E54</Color>
        <!-- Przygaszone kolory stanów: tło pod krótką treścią w kolorze stanu (odznaka, tag). Jak
             AccentDim - kolor stanu o nieprzezroczystości 16 % (alfa 0x29), zapisany z kanałem alfa,
             żeby na karcie, wierszu i zapleczu wyglądał jak ta sama przygaszona barwa. Nie do linii
             ani tekstu. Niebezpieczeństwo z Danger (barwa teł), nie z DangerText. -->
        <Color x:Key="DungeonSuccessDimColor">#2984A98B</Color>
        <Color x:Key="DungeonWarningDimColor">#29D6B84F</Color>
        <Color x:Key="DungeonDangerDimColor">#299C4530</Color>
        <!-- Tekst na przygaszonym tle (odznaka, tag, włączony chip): Accent i DangerText na własnym
             przygaszonym tle mają na karcie tylko 4,05:1 i 4,40:1 - poniżej 4,5:1 dla tekstu 12.
             Ten sam odcień, jaśniejszy (HSL +8 / +4 punkty jasności): 5,1:1 i 5,0:1 na karcie, 5,0:1
             i 4,9:1 na wierszu. Do tekstu na AccentDim / DangerDim, nie zamiast Accent i DangerText. -->
        <Color x:Key="DungeonAccentOnDimColor">#C89854</Color>
        <Color x:Key="DungeonDangerOnDimColor">#D87C64</Color>
        <!-- NeutralDim: neutralne tło pojemnika wartości (odznaka neutralna) - biały o nieprzezroczystości
             ok. 8 % (alfa 0x14), zapisany z kanałem alfa jak kolory *Dim: działa na każdej powierzchni,
             bo ją przepuszcza i tylko rozjaśnia - na wybranym wierszu (AccentDim) nie jest ciemną
             dziurą. Tekst drugorzędny (TextRegular) na nim: 7,1:1 na tle, 6,3:1 na karcie, 6,1:1 na
             wierszu, 5,7:1 na wierszu pod myszą, 4,9:1 na wybranym wierszu. -->
        <Color x:Key="DungeonNeutralDimColor">#14FFFFFF</Color>
        <!-- TableHeader: wiersz nagłówka tabeli w karcie - neutralnie jaśniejszy od karty
             (BackstageCard #1F1D1A), wyraźniej niż wiersz (#221F1C); nie akcent. Tekst drugorzędny
             na nim ok. 7,4:1. -->
        <Color x:Key="DungeonTableHeaderColor">#262320</Color>

        <!-- PĘDZLE ============================================================= -->
        <SolidColorBrush x:Key="DungeonBackgroundBrush" Color="{DynamicResource DungeonBackgroundColor}" />
        <SolidColorBrush x:Key="DungeonSurfaceBrush" Color="{DynamicResource DungeonSurfaceColor}" />
        <SolidColorBrush x:Key="DungeonSurfaceHeaderBrush" Color="{DynamicResource DungeonSurfaceHeaderColor}" />
        <SolidColorBrush x:Key="DungeonFrameBrush" Color="{DynamicResource DungeonFrameColor}" />
        <SolidColorBrush x:Key="DungeonFrameHoverBrush" Color="{DynamicResource DungeonFrameHoverColor}" />
        <SolidColorBrush x:Key="DungeonBackstageBrush" Color="{DynamicResource DungeonBackstageColor}" />
        <!-- BackstageWide: zaplecze - tło treści poza kampanią (biblioteka, półka, galeria), w szerokich
             widokach. -->
        <!-- Used only by wide, static backstage views. The first half stays calm so the gradient
             does not read as decoration behind the actual content. -->
        <LinearGradientBrush x:Key="DungeonBackstageWideBrush"
                             StartPoint="0,0"
                             EndPoint="2400,1000">
            <GradientStop Offset="0" Color="{DynamicResource DungeonBackstageColor}" />
            <GradientStop Offset="0.42" Color="{DynamicResource DungeonBackstageColor}" />
            <GradientStop Offset="0.74" Color="#12110F" />
            <GradientStop Offset="1" Color="{DynamicResource DungeonBackstageEdgeColor}" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DungeonBackstageCardBrush" Color="{DynamicResource DungeonBackstageCardColor}" />
        <SolidColorBrush x:Key="DungeonBackstageRowBrush" Color="{DynamicResource DungeonBackstageRowColor}" />
        <SolidColorBrush x:Key="DungeonBackstageRowHoverBrush" Color="{DynamicResource DungeonBackstageRowHoverColor}" />
        <SolidColorBrush x:Key="DungeonDeskBrush" Color="{DynamicResource DungeonDeskColor}" />
        <SolidColorBrush x:Key="DungeonSurfaceActiveBrush" Color="{DynamicResource DungeonSurfaceActiveColor}" />
        <SolidColorBrush x:Key="DungeonHoverOverlayBrush" Color="{DynamicResource DungeonHoverOverlayColor}" />
        <SolidColorBrush x:Key="DungeonSurfaceHoverBrush" Color="{DynamicResource DungeonSurfaceHoverColor}" />
        <SolidColorBrush x:Key="DungeonBorderBrush" Color="{DynamicResource DungeonBorderColor}" />
        <SolidColorBrush x:Key="DungeonBorderStrongBrush" Color="{DynamicResource DungeonBorderStrongColor}" />
        <SolidColorBrush x:Key="DungeonTextPrimaryBrush" Color="{DynamicResource DungeonTextPrimaryColor}" />
        <SolidColorBrush x:Key="DungeonTextRegularBrush" Color="{DynamicResource DungeonTextRegularColor}" />
        <SolidColorBrush x:Key="DungeonTextMutedBrush" Color="{DynamicResource DungeonTextMutedColor}" />
        <SolidColorBrush x:Key="DungeonAccentBrush" Color="{DynamicResource DungeonAccentColor}" />
        <SolidColorBrush x:Key="DungeonAccentBrightBrush" Color="{DynamicResource DungeonAccentBrightColor}" />
        <SolidColorBrush x:Key="DungeonAccentDimBrush" Color="{DynamicResource DungeonAccentDimColor}" />
        <SolidColorBrush x:Key="DungeonAccentEdgeBrush" Color="{DynamicResource DungeonAccentEdgeColor}" />
        <SolidColorBrush x:Key="DungeonOnAccentBrush" Color="{DynamicResource DungeonOnAccentColor}" />
        <SolidColorBrush x:Key="DungeonAccentTextHoverBrush" Color="{DynamicResource DungeonAccentTextHoverColor}" />
        <SolidColorBrush x:Key="DungeonSuccessBrush" Color="{DynamicResource DungeonSuccessColor}" />
        <SolidColorBrush x:Key="DungeonWarningBrush" Color="{DynamicResource DungeonWarningColor}" />
        <SolidColorBrush x:Key="DungeonDangerBrush" Color="{DynamicResource DungeonDangerColor}" />
        <SolidColorBrush x:Key="DungeonDangerTextBrush" Color="{DynamicResource DungeonDangerTextColor}" />
        <SolidColorBrush x:Key="DungeonSuccessDimBrush" Color="{DynamicResource DungeonSuccessDimColor}" />
        <SolidColorBrush x:Key="DungeonWarningDimBrush" Color="{DynamicResource DungeonWarningDimColor}" />
        <SolidColorBrush x:Key="DungeonDangerDimBrush" Color="{DynamicResource DungeonDangerDimColor}" />
        <SolidColorBrush x:Key="DungeonTableHeaderBrush" Color="{DynamicResource DungeonTableHeaderColor}" />
        <SolidColorBrush x:Key="DungeonAccentOnDimBrush" Color="{DynamicResource DungeonAccentOnDimColor}" />
        <SolidColorBrush x:Key="DungeonDangerOnDimBrush" Color="{DynamicResource DungeonDangerOnDimColor}" />
        <SolidColorBrush x:Key="DungeonNeutralDimBrush" Color="{DynamicResource DungeonNeutralDimColor}" />

        <!-- OTOCZKI NAJECHANIA ================================================ -->
        <!-- Pas 3 px na zewnątrz krawędzi, bez przesunięcia i rozmycia, w zaokrągleniu kontrolki
             (BoxShadow Border tła, zapis "przesunięcie-x przesunięcie-y rozmycie rozciągnięcie kolor").
             Kolor stoi w tym samym tokenie, bo cień jest typem wartościowym i nie przyjmuje zasobu
             koloru z osobnego klucza. -->
        <!-- AccentHoverHalo: akcent pod myszą - otoczka przycisku wypełnionego Accent: Accent #B8843B
             o nieprzezroczystości 35 %. Wypełnienie pod myszą się nie zmienia. -->
        <BoxShadows x:Key="DungeonAccentHoverHaloShadow">0 0 0 3 #59B8843B</BoxShadows>
        <!-- DangerHoverHalo: niebezpieczeństwo pod myszą - otoczka przycisku wypełnionego Danger:
             Danger #9C4530 o nieprzezroczystości 45 %. Wypełnienie pod myszą się nie zmienia. -->
        <BoxShadows x:Key="DungeonDangerHoverHaloShadow">0 0 0 3 #739C4530</BoxShadows>

        <!-- RUCH ============================================================= -->
        <!-- MotionDuration: czas każdej animacji ramy - coś się przemieszcza, obraca albo pojawia
             (gałka przełącznika, strzałka listy rozwijanej); najwyżej 150 ms, zawsze z wyhamowaniem
             (CubicEaseOut). Stan zmienia się od razu, animacja tylko go dogania. Wyłączone animacje
             w systemie zdejmuje przejścia w całości (Themes/ReducedMotion.axaml). -->
        <x:TimeSpan x:Key="DungeonMotionDuration">0:0:0.15</x:TimeSpan>
        <!-- PopupOpen: otwarcie okienka wysuwanego i rozwiniętej listy (Themes/PopupOpenMotion.cs) -
             powierzchnia wyłania się z przezroczystości i dosuwa o Offset od strony otwierającego.
             Krócej niż MotionDuration (120 wobec 150 ms): to otwarcie, na które użytkownik czeka
             z kursorem nad wierszami, a przesunięcie jest drobne - dłuższy ruch czytałby się jako
             opóźnienie. Zamknięcie bez ruchu. -->
        <x:TimeSpan x:Key="DungeonPopupOpenDuration">0:0:0.12</x:TimeSpan>
        <x:Double x:Key="DungeonPopupOpenOffset">4</x:Double>
        <!-- ProgressSweep: jeden obieg odcinka nieokreślonego wskaźnika postępu (Controls/ProgressSweep.cs)
             - ruch ciągły w pętli, z przyspieszeniem i wyhamowaniem; nie przejście stanu, więc limit
             MotionDuration go nie dotyczy. Wyłączone animacje w systemie: bez ruchu. -->
        <x:TimeSpan x:Key="DungeonProgressSweepDuration">0:0:1.6</x:TimeSpan>
        <!-- NotificationOpenOffset: dymek powiadomienia dosuwa się o tyle od prawej krawędzi okna
             (w DungeonPopupOpenDuration) - więcej niż okienko, bo dymek pojawia się sam, nie pod
             kursorem, i ruch ma przyciągnąć wzrok do rogu okna. -->
        <x:Double x:Key="DungeonNotificationOpenOffset">12</x:Double>
        <!-- NotificationDismissDelay: po tylu dymek powiadomienia znika sam - stała motywu dla
             odmiany, nie parametr wywołania. Informacja 5 s (jedno zdanie do przeczytania),
             ostrzeżenie 8 s (dłużej, bo może wymagać reakcji). Błąd nie znika sam. Mysz nad dymkiem
             wstrzymuje znikanie. -->
        <x:TimeSpan x:Key="DungeonNotificationInformationDismissDelay">0:0:5</x:TimeSpan>
        <x:TimeSpan x:Key="DungeonNotificationWarningDismissDelay">0:0:8</x:TimeSpan>

        <!-- CIENIE =========================================================== -->
        <!-- FlyoutShadow: okienko wysuwane i rozwinięta lista - lekki cień w dół oddziela je od treści
             pod spodem (czerń o nieprzezroczystości 40 %, przesunięcie 2 px, rozmycie 8 px). Rysuje
             się tylko w obrębie okna wyskakującego, które mierzy się do okienka. -->
        <BoxShadows x:Key="DungeonFlyoutShadow">0 2 8 0 #66000000</BoxShadows>

        <!-- ZASŁONA ========================================================== -->
        <!-- Scrim: zasłona nad oknem, gdy trwa pytanie (okno potwierdzenia) - reszta okna jest
             niedostępna, dopóki pytanie trwa. Czerń o nieprzezroczystości 55 %: treść pod spodem
             zostaje rozpoznawalna (widać, czego pytanie dotyczy), ale wyraźnie odsunięta. -->
        <SolidColorBrush x:Key="DungeonScrimBrush" Color="#8C000000" />

        <!-- NIEPRZEZROCZYSTOŚĆ ================================================= -->
        <!-- The one disabled-state opacity this theme defines - shared by every ":disabled" style
             that dims rather than recolors, so a second view never has to invent its own number. -->
        <x:Double x:Key="DungeonDisabledOpacity">0.48</x:Double>

        <!-- PĘDZLE KONTROLEK I PANELI ========================================= -->
        <!-- InputBackground: pole do pisania - tu się wpisuje; tło wgłębione (tło zaplecza) odróżnia
             pole od przycisku i od karty, na której stoi. -->
        <SolidColorBrush x:Key="DungeonInputBackgroundBrush" Color="{DynamicResource DungeonBackstageColor}" />
        <!-- InputBorder: krawędź pola w spoczynku - granica miejsca do pisania, spokojna jak linia. -->
        <SolidColorBrush x:Key="DungeonInputBorderBrush" Color="{DynamicResource DungeonBorderColor}" />
        <!-- InputHoverBorder: pole pod myszą - kliknięcie tu zacznie edycję. Ta sama krawędź trzyma się
             przez całą edycję, także gdy mysz zjedzie z pola: pisanie pokazuje karetka, nie akcent. -->
        <SolidColorBrush x:Key="DungeonInputHoverBorderBrush" Color="{DynamicResource DungeonBorderStrongColor}" />
        <!-- InputPlaceholder: tekst zastępczy - podpowiedź, co wpisać; pole jest puste. -->
        <SolidColorBrush x:Key="DungeonInputPlaceholderBrush" Color="{DynamicResource DungeonTextMutedColor}" />
        <!-- TextSelection: zaznaczony tekst - ten fragment jest wybrany (kopiowanie, zastąpienie).
             Stonowany stalowy niebieski #2E4C68 (HSL 209°, 38 %, 29 %) - konwencja zaznaczenia ciemnych
             edytorów, przygaszona do ciepłej palety; nie akcent, bo zaznaczenie to nie "wybrana
             pozycja". Pełny kolor, więc wygląda tak samo w polu i na karcie; tekst podstawowy #E8E4DA
             na nim 7,04:1. Odcieniem daleko od neutralnego Highlight (#4A443D, ciepła szarość)
             i szałwiowego SearchMatch (#84A98B na 35 %, na tle pola ok. #3C483C). Ten sam token
             w polach tekstowych i w SelectableTextBlock. -->
        <SolidColorBrush x:Key="DungeonTextSelectionBrush" Color="#2E4C68" />
        <!-- Highlight: zakreślenie wyróżnione - ta wartość jest ważna w zdaniu, ale zostaje tekstem
             (wyzwanie "1/2" na karcie). Neutralne i jasne, nie akcent: nic tu nie jest wybrane.
             Pełny kolor #4A443D, więc wygląda tak samo na każdej powierzchni; tekst podstawowy na nim
             7,57:1. -->
        <SolidColorBrush x:Key="DungeonHighlightBrush" Color="#4A443D" />
        <!-- SearchMatch: zakreślenie trafienia wyszukiwania - ten fragment pasuje do tego, czego
             szukasz. Szałwiowa zieleń (#84A98B, odcień Success) o nieprzezroczystości 35 % (#5984A98B):
             odcieniem daleko od niebieskiego zaznaczenia i od szarości wyróżnienia. Tekst podstawowy na
             niej 7,57:1 na tle pola (#151412). -->
        <SolidColorBrush x:Key="DungeonSearchMatchBrush" Color="#5984A98B" />
        <!-- ScrollThumb: uchwyt przewijania - tu jest więcej treści, niż widać; przeciągnij. Kolor mocnej
             krawędzi (BorderStrong #413C36): widoczny, ale nie woła o uwagę. -->
        <SolidColorBrush x:Key="DungeonScrollThumbBrush" Color="{DynamicResource DungeonBorderStrongColor}" />
        <!-- ScrollThumbHover: uchwyt pod myszą (i przeciągany) - to reaguje na mysz. Jaśniejszy od
             spoczynku o ok. 10 punktów jasności (#5E5750, HSL 30°, 8 %, 34 %), wciąż neutralny,
             nie akcent. -->
        <SolidColorBrush x:Key="DungeonScrollThumbHoverBrush" Color="#5E5750" />
        <!-- SliderThumb: uchwyt suwaka - tu jest wartość; przeciągnij albo kliknij w tor. Kolor tekstu
             drugorzędnego (TextRegular #B4B2AC): neutralny, nie akcent - akcent niesie część toru
             przed uchwytem; przygaszony, żeby pod myszą było dokąd jaśnieć. -->
        <SolidColorBrush x:Key="DungeonSliderThumbBrush" Color="{DynamicResource DungeonTextRegularColor}" />
        <!-- SliderThumbHover: uchwyt pod myszą (i przeciągany) - to reaguje na mysz. Kolor tekstu
             podstawowego (TextPrimary #E8E4DA): wyraźne rozjaśnienie wobec spoczynku (jasność z ok. 70 %
             do ok. 91 %), bez zmiany rozmiaru; zmiana koloru od razu, bez ruchu. -->
        <SolidColorBrush x:Key="DungeonSliderThumbHoverBrush" Color="{DynamicResource DungeonTextPrimaryColor}" />

        <!--
            Panel chrome. Semantic aliases rather than direct use of the generic surface tokens, so a
            floating panel can diverge from other surfaces later without touching any view.
            A minimized panel is the same object in another state, so the deck cards share these.
        -->
        <!-- PanelWindowBackground: okno biurka - tło okna. -->
        <SolidColorBrush x:Key="DungeonPanelWindowBackgroundBrush" Color="{DynamicResource DungeonSurfaceColor}" />
        <!-- PanelWindowHeader: okno biurka - nagłówek okna. -->
        <SolidColorBrush x:Key="DungeonPanelWindowHeaderBrush" Color="{DynamicResource DungeonSurfaceHeaderColor}" />
        <!-- PanelWindowBorder: okno biurka - krawędź okna. -->
        <SolidColorBrush x:Key="DungeonPanelWindowBorderBrush" Color="{DynamicResource DungeonBorderColor}" />
        <!--
            The active panel changes only this brush. A stronger neutral border keeps focus legible
            without making ordinary window selection look like a warning or validation state. Changing
            BorderThickness instead would resize the panel every time focus moved.
        -->
        <!-- PanelWindowActiveBorder: okno biurka - krawędź aktywnego okna. -->
        <SolidColorBrush x:Key="DungeonPanelWindowActiveBorderBrush" Color="{DynamicResource DungeonBorderStrongColor}" />
        <!-- Named so nobody helpfully makes the resize gutters visible: they are hit targets only.
             It must stay Transparent rather than null, because null is not hit-testable. -->
        <SolidColorBrush x:Key="DungeonPanelResizeGripBrush" Color="Transparent" />

        <!-- TYPOGRAFIA ========================================================= -->
        <FontFamily x:Key="DungeonUiFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        <FontFamily x:Key="DungeonDisplayFont">avares://DungeonApp.Desktop/Assets/Fonts/CormorantGaramond#Cormorant Garamond</FontFamily>
        <!-- Fixed-width figures for numbers (the mockup's font-mono). Regular, Medium and SemiBold files. -->
        <FontFamily x:Key="DungeonMonoFont">avares://DungeonApp.Desktop/Assets/Fonts/IBMPlexMono#IBM Plex Mono</FontFamily>

        <CornerRadius x:Key="DungeonWindowCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="DungeonCardCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="DungeonControlCornerRadius">5</CornerRadius>
        <CornerRadius x:Key="DungeonNavigationCornerRadius">4</CornerRadius>
        <!-- Compatibility alias for campaign controls not yet split into card/control variants. -->
        <CornerRadius x:Key="DungeonCornerRadius">5</CornerRadius>

        <!-- ODSTĘPY I ZAOKRĄGLENIA ============================================= -->
        <!--
            Skala odstępów, wyrażona jako literały powtarzające się w widokach.
            Dwa równoległe zestawy: Double dla Spacing/Width/Height oraz Thickness dla Margin/Padding.
        -->
        <x:Double x:Key="DungeonSpacingXs">6</x:Double>
        <x:Double x:Key="DungeonSpacingSm">8</x:Double>
        <x:Double x:Key="DungeonSpacingMd">12</x:Double>
        <x:Double x:Key="DungeonSpacingLg">16</x:Double>
        <x:Double x:Key="DungeonSpacingXl">20</x:Double>
        <x:Double x:Key="DungeonSpacingXxl">24</x:Double>
        <x:Double x:Key="DungeonSpacingXxxl">32</x:Double>

        <Thickness x:Key="DungeonPaddingXs">6</Thickness>
        <Thickness x:Key="DungeonPaddingSm">8</Thickness>
        <Thickness x:Key="DungeonPaddingMd">12</Thickness>
        <Thickness x:Key="DungeonPaddingLg">16</Thickness>
        <Thickness x:Key="DungeonPaddingXl">20</Thickness>
        <Thickness x:Key="DungeonPaddingXxl">24</Thickness>
        <Thickness x:Key="DungeonPaddingXxxl">32</Thickness>
        <!-- Tylko nad i pod - wartość równa DungeonSpacingLg (odstęp separatora .section). -->
        <Thickness x:Key="DungeonPaddingLgVertical">0,16,0,16</Thickness>
        <!-- Tylko z boków - wartość równa DungeonSpacingMd (wcięcie tekstu w polu jednowierszowym). -->
        <Thickness x:Key="DungeonPaddingMdHorizontal">12,0,12,0</Thickness>
        <!-- Wcięcie tekstu w polu z ikoną na początku (controls:IconField - ołówek, lupa): tylko
             z prawej, DungeonSpacingMd - lewy odstęp niesie ikona w ramce (DungeonPaddingMdHorizontal
             po obu jej stronach), więc pole tekstowe zaczyna się tuż za nią. -->
        <Thickness x:Key="DungeonInputTextAfterIconMargin">0,0,12,0</Thickness>
        <!-- Z boków DungeonSpacingMd, nad i pod DungeonSpacingSm (wcięcie tekstu w polu wielowierszowym). -->
        <Thickness x:Key="DungeonPaddingMdHorizontalSmVertical">12,8,12,8</Thickness>
        <!-- Wcięcie tekstu w polu wielowierszowym po stronie treści przewijanej: DungeonPaddingMdHorizontalSmVertical
             (12, 8, 12, 8) z prawym wcięciem większym o strefę paska (DungeonScrollBarZone, 16) - tekst
             zawija się przed paskiem, a pasek stoi przy krawędzi pola. -->
        <Thickness x:Key="DungeonMultilineInputContentPadding">12,8,28,8</Thickness>
        <!-- Pole wielowierszowe: trzy linie tekstu 13 px (ok. 17 px każda) + wcięcia 8 + 8 + krawędzie. -->
        <x:Double x:Key="DungeonMultilineInputMinHeight">70</x:Double>
        <!-- Pole liczbowe: miejsce na kilka cyfr krojem o stałej szerokości i strzałki; nie zależy od wartości. -->
        <x:Double x:Key="DungeonNumericInputWidth">96</x:Double>
        <!-- Pasek przewijania: nakładka nad treścią (nie zabiera jej miejsca); uchwyt stoi przy
             zewnętrznej krawędzi paska. Pod myszą uchwyt się poszerza w obrębie paska w stronę treści -
             pasek nie zmienia grubości, odstęp uchwytu od krawędzi też nie, więc nic nie skacze. -->
        <x:Double x:Key="DungeonScrollBarSize">10</x:Double>
        <!-- Odstęp paska od krawędzi obszaru przewijania i od obu jego końców - jednakowy, równy
             DungeonSpacingXs (6): pasek nie dotyka zaokrąglonych rogów listy ani okienka (promień 6)
             i nie wygląda, jakby z nich wyjeżdżał. Po stronie odwrotnej od krawędzi nie działa (pasek
             ma stałą grubość i stoi przy krawędzi). -->
        <Thickness x:Key="DungeonScrollBarInset">6</Thickness>
        <!-- Strefa paska: grubość paska i jego odstęp od krawędzi (10 + 6 = 16) - o tyle treść
             przewijanego pojemnika kończy się wcześniej po stronie pionowego paska, żeby pasek nie
             stanął na napisie; tło wierszy sięga pod pasek. Liczona od krawędzi obszaru przewijania:
             wiersz stojący przy tej krawędzi dokłada całą strefę (wcięcie wewnątrz wiersza), a wcięcie
             pojemnika po stronie paska leży w strefie - wiersz dokłada wtedy tylko resztę (niżej
             DungeonScrollBarZoneInFlyout; lista z własnym wcięciem nadpisuje ten zasób). Tylko po prawej:
             poziomy pasek jest w ramie wyłączony (Disabled) w każdej liście i polu. -->
        <Thickness x:Key="DungeonScrollBarZone">0,0,16,0</Thickness>
        <!-- Pas paska liczy się od krawędzi obszaru przewijania, nie od krawędzi wiersza: wcięcie
             pojemnika po stronie paska leży w pasie, więc wiersz dokłada tylko resztę. Wiersz w okienku
             wysuwanym (menu, podmenu, ComboBox, DropDownPicker, lista w okienku .list-host) stoi
             o wcięcie okienka (DungeonFlyoutPadding, 4) od krawędzi obszaru przewijania - dokłada
             16 - 4 = 12. Tekst kończy się wtedy 16 + wcięcie wiersza od krawędzi, jak w liście bez
             wcięcia. Okienko, którego treść mieści się bez przewijania, strefy nie ma (klasa .no-bar-zone
             z Themes/PopupOpenLayout.cs, ustalana przy otwarciu). -->
        <Thickness x:Key="DungeonScrollBarZoneInFlyout">0,0,12,0</Thickness>
        <x:Double x:Key="DungeonScrollThumbSize">6</x:Double>
        <x:Double x:Key="DungeonScrollThumbHoverSize">8</x:Double>
        <!-- Najkrótszy uchwyt przy bardzo długiej treści - wciąż do chwycenia myszą. -->
        <x:Double x:Key="DungeonScrollThumbMinLength">24</x:Double>
        <!-- Uchwyt zaokrąglony w pełni (pigułka) przy każdej szerokości. -->
        <CornerRadius x:Key="DungeonScrollThumbCornerRadius">999</CornerRadius>

        <!-- Pole wyboru, przycisk opcji, przełącznik, suwak - wymiary znaczników. Cała kontrolka ma
             wysokość najmniej DungeonControlHeight (stoi w jednym rzędzie z polem i przyciskiem). -->
        <!-- Znacznik pola wyboru (kwadrat) i przycisku opcji (koło): bok 16 - wyraźnie mniejszy od
             linii tekstu z odstępami, a na tyle duży, że ptaszek w nim się czyta. -->
        <x:Double x:Key="DungeonChoiceMarkSize">16</x:Double>
        <!-- Zaokrąglenie kwadratu pola wyboru: mniejsze niż kontrolki (5), bo kwadrat jest mały - 3 na
             bok 16 to ok. 1/5 boku; kwadrat wciąż czyta się jako kwadrat, nie jako koło. -->
        <CornerRadius x:Key="DungeonCheckBoxCornerRadius">3</CornerRadius>
        <!-- Koło przycisku opcji: połowa DungeonChoiceMarkSize - pełne zaokrąglenie. -->
        <CornerRadius x:Key="DungeonRadioButtonCornerRadius">8</CornerRadius>
        <!-- Kropka zaznaczonego przycisku opcji: średnica. -->
        <x:Double x:Key="DungeonRadioDotSize">6</x:Double>
        <!-- Grubość kreski ptaszka i kreski stanu pośredniego - ta sama liczba co pióro ikon ramy
             (DungeonIconPen), rysowana w pikselach znacznika 16 px, zaokrąglone końce i złącza. -->
        <x:Double x:Key="DungeonChoiceGlyphThickness">1.75</x:Double>
        <!-- Etykieta obok znacznika (pole wyboru, przycisk opcji, przełącznik): z lewej odstęp od
             znacznika DungeonSpacingSm; nad i pod (36 - linia tekstu 13 px, ok. 16) / 2 = 10 - pierwsza
             linia stoi na środku wysokości kontrolki, tam gdzie znacznik, a dłuższa etykieta zawija
             się w dół, znacznik zostaje przy pierwszej linii. -->
        <Thickness x:Key="DungeonChoiceLabelPadding">8,10,0,10</Thickness>
        <!-- Tor przełącznika: 36 x 18, zaokrąglony w pełni; gałka 12, 3 px od krawędzi toru w obu
             położeniach. Szerokość toru to dwa razy pole gałki (18) - tak jak w szablonie Fluenta
             (40 x 20, pole gałki 20), z którego kontrolka liczy położenie gałki. -->
        <x:Double x:Key="DungeonToggleTrackWidth">36</x:Double>
        <x:Double x:Key="DungeonToggleTrackHeight">18</x:Double>
        <CornerRadius x:Key="DungeonToggleTrackCornerRadius">9</CornerRadius>
        <x:Double x:Key="DungeonToggleKnobSize">12</x:Double>
        <!-- Tor suwaka: grubość 4, zaokrąglony w pełni na obu końcach toru (promień 2). Tor to dwie
             części stykające się pod uchwytem: przed uchwytem (zaokrąglony tylko początek) i za nim
             (zaokrąglony tylko koniec) - styk pod uchwytem jest prosty, więc przy uchwycie nie
             widać przerwy ani wcięcia. -->
        <x:Double x:Key="DungeonSliderTrackThickness">4</x:Double>
        <CornerRadius x:Key="DungeonSliderTrackStartCornerRadius">2,0,0,2</CornerRadius>
        <CornerRadius x:Key="DungeonSliderTrackEndCornerRadius">0,2,2,0</CornerRadius>
        <!-- Uchwyt suwaka: koło o średnicy 14, zaokrąglenie połowa. -->
        <x:Double x:Key="DungeonSliderThumbSize">14</x:Double>
        <CornerRadius x:Key="DungeonSliderThumbCornerRadius">7</CornerRadius>

        <!-- WYMIARY POWŁOKI I PANELI ========================================== -->
        <!-- Pasek postępu ładowania (kurtyna startowa): szerokość. -->
        <x:Double x:Key="DungeonLoadingProgressBarWidth">192</x:Double>
        <!-- Wskaźnik postępu (ProgressBar): cienki pasek grubości toru suwaka, zaokrąglony w pełni na
             obu końcach (promień połowa grubości) - spójnie z torem suwaka. -->
        <x:Double x:Key="DungeonProgressBarThickness">4</x:Double>
        <CornerRadius x:Key="DungeonProgressBarCornerRadius">2</CornerRadius>
        <!-- Okno potwierdzenia: karta najwyżej tak szeroka (w wąskim oknie węższa, z odstępem
             DungeonSpacingXxl od krawędzi okna). -->
        <x:Double x:Key="DungeonConfirmationDialogMaxWidth">400</x:Double>
        <!-- Dymek powiadomienia: stała szerokość - dłuższa treść zawija się, nie rozpycha dymku. -->
        <x:Double x:Key="DungeonNotificationWidth">340</x:Double>

        <!-- Stałe wymiary interfejsu. -->
        <x:Double x:Key="DungeonBaseFontSize">13</x:Double>
        <x:Double x:Key="DungeonNavigationFontSize">13</x:Double>
        <x:Double x:Key="DungeonHelperFontSize">12</x:Double>
        <x:Double x:Key="DungeonEyebrowFontSize">10</x:Double>
        <x:Double x:Key="DungeonStatusFontSize">12</x:Double>
        <x:Double x:Key="DungeonWorkspaceTitleFontSize">22</x:Double>
        <x:Double x:Key="DungeonCampaignNameFontSize">15</x:Double>
        <x:Double x:Key="DungeonBrandNameFontSize">16</x:Double>
        <x:Double x:Key="DungeonBrandMarkFontSize">16</x:Double>
        <x:Double x:Key="DungeonBrandMarkLargeFrameSize">96</x:Double>
        <x:Double x:Key="DungeonBrandMarkLargeFontSize">64</x:Double>
        <!-- Shared by the top bar's own height and the sidebar header's (GlobalSidebarView.axaml),
             so their bottom borders always draw as one continuous line - a plain Double, not a
             GridLength, since both usages are a Height, never a column/row size. -->
        <x:Double x:Key="DungeonTopBarHeight">52</x:Double>
        <GridLength x:Key="DungeonSidebarWidth">224</GridLength>
        <GridLength x:Key="DungeonStatusBarHeight">24</GridLength>
        <x:Double x:Key="DungeonWorkspaceHeaderHeight">68</x:Double>
        <x:Double x:Key="DungeonControlHeight">36</x:Double>
        <x:Double x:Key="DungeonNavigationRowHeight">38</x:Double>
        <!-- Wiersz listy (ListBoxItem): gęściej niż kontrolka (36) - lista to wiele pozycji jedna pod
             drugą, a wiersz niesie jedną linię tekstu 13 px. -->
        <x:Double x:Key="DungeonListRowHeight">32</x:Double>
        <!-- Podświetlenie wiersza listy (najechanie, wybrany; ListBoxItem, ComboBoxItem, wiersze
             DropDownPicker) jest o 1 px węższe z góry i z dołu niż wiersz: sąsiednie podświetlenia
             dzieli 2 px odstępu zamiast stykania się zaokrąglonymi rogami; wiersz dalej zajmuje
             DungeonListRowHeight. -->
        <Thickness x:Key="DungeonListRowHighlightInset">0,1</Thickness>
        <!-- Akcja w wierszu listy (kosz, DungeonRowAction): pas na pełnej wysokości wiersza i do końca
             jego treści - wychodzi przez odstęp podświetlenia (1 z góry i z dołu) i prawe wcięcie
             wiersza (DungeonPaddingMdHorizontal, 12); strefy paska przewijania (DungeonScrollBarZone)
             nie zajmuje - pas kończy się przed nią. -->
        <Thickness x:Key="DungeonListRowActionMargin">0,-1,-12,-1</Thickness>
        <!-- Zaokrąglenie podświetlenia wiersza: wyraźnie drobniejsze niż okienka (3 wobec 6), żeby
             podświetlenie czytało się jako jedno pole w okienku, nie pudełko w pudełku. -->
        <CornerRadius x:Key="DungeonListRowHighlightCornerRadius">3</CornerRadius>
        <!-- Kreska zaznaczenia wiersza listy (ListRow z ShowsSelectionStripe): kolor akcentu, grubość 3,
             zaokrąglona. Stoi w pasie wcięcia po lewej stronie wiersza (tło wiersza zaczyna się za
             pasem), przy lewej krawędzi pasa - odstęp od krawędzi tła to szerokość pasa. Szerokość pasa
             i wcięcia pionowe kreski podaje układający listę (zasoby na poziomie listy); tu wartości
             listy treści (mockup .entry.selected::before: left -10, top/bottom 5). -->
        <x:Double x:Key="DungeonListRowStripeWidth">3</x:Double>
        <CornerRadius x:Key="DungeonListRowStripeCornerRadius">1.5</CornerRadius>
        <x:Double x:Key="DungeonListRowStripeGutter">10</x:Double>
        <Thickness x:Key="DungeonListRowStripeInset">0,5</Thickness>
        <!-- Odznaka (wartość) i tag (słowo): jedna wysokość 22 - mieści linię tekstu 12 z oddechem 3-4 px
             i stoi na środku wiersza listy (32) i linii tekstu 13. Odznaka to prostokąt o drobnym
             zaokrągleniu 4 (jak nawigacja), tag - pigułka (połowa wysokości). Wcięcie odznaki 8,
             tagu 10: pigułka potrzebuje więcej miejsca, żeby tekst nie dotykał łuku. -->
        <x:Double x:Key="DungeonBadgeHeight">22</x:Double>
        <CornerRadius x:Key="DungeonBadgeCornerRadius">4</CornerRadius>
        <Thickness x:Key="DungeonBadgePadding">8,0</Thickness>
        <CornerRadius x:Key="DungeonTagCornerRadius">11</CornerRadius>
        <Thickness x:Key="DungeonTagPadding">10,0</Thickness>
        <!-- Chip filtra: zwarta kontrolka w rzędzie filtrów - niższa od przycisku (36), wcięcie
             poziome 10, zaokrąglenie jak kontrolki (DungeonControlCornerRadius). -->
        <x:Double x:Key="DungeonChipHeight">28</x:Double>
        <Thickness x:Key="DungeonChipPadding">10,0</Thickness>
        <!-- Tabela w karcie: komórka najmniej 28 wysokości, wcięcie 10 z boków i 6 nad i pod. -->
        <x:Double x:Key="DungeonTableCellMinHeight">28</x:Double>
        <Thickness x:Key="DungeonTableCellPadding">10,6</Thickness>
        <!-- Okienko wysuwane i rozwinięta lista: zaokrąglenie powierzchni (6, jak karta) i wewnętrzne
             wcięcie (4 - mniej niż DungeonPaddingXs, żeby podświetlenie wiersza leżało blisko
             krawędzi okienka, bez "ramki w ramce"). Przyciski i pola dalej mają
             DungeonControlCornerRadius. -->
        <CornerRadius x:Key="DungeonFlyoutCornerRadius">6</CornerRadius>
        <Thickness x:Key="DungeonFlyoutPadding">4</Thickness>
        <!-- Okienko wysuwane i rozwinięta lista rozwijana: najwyższa wysokość - dziesięć wierszy listy
             (10 x 32) z wcięciem okienka (2 x 4) i krawędzią (2 x 1); dłuższa treść przewija się
             w środku. -->
        <x:Double x:Key="DungeonFlyoutMaxHeight">330</x:Double>
        <!-- Odstęp okienka wysuwanego i rozwiniętej listy od elementu, który je otworzył:
             przezroczysty margines nad i pod powierzchnią okienka (motyw FlyoutPresenter), więc
             działa tak samo, gdy okienko wysuwa się w dół, jak gdy brak miejsca odwraca je nad
             element; daje też miejsce na cień w pionie. Wartość równa DungeonSpacingXs - najmniejszy
             stopień skali. W poziomie zero, żeby lewa krawędź okienka stała równo z lewą krawędzią
             elementu. -->
        <Thickness x:Key="DungeonFlyoutMargin">0,6</Thickness>
        <!-- Podpowiedź (ToolTip): wcięcie 8 w poziomie (DungeonSpacingSm) i 4 w pionie - jedna linia
             pisma 12 daje ok. 24 wysokości; najwyższa szerokość 320 (ok. 50 znaków pisma 12), dłuższy
             tekst zawija się - podpowiedź nigdy nie przycina. -->
        <Thickness x:Key="DungeonToolTipPadding">8,4</Thickness>
        <x:Double x:Key="DungeonToolTipMaxWidth">320</x:Double>
        <!-- Menu (MenuFlyout, ContextMenu i podmenu): najmniejsza szerokość 160, najwyższa 320;
             szerokość z najdłuższej pozycji, dłuższy napis przycina się wielokropkiem. -->
        <x:Double x:Key="DungeonMenuMinWidth">160</x:Double>
        <x:Double x:Key="DungeonMenuMaxWidth">320</x:Double>
        <!-- Podmenu stoi górnym wierszem na wysokości pozycji-rodzica: przesunięte w górę o wcięcie
             powierzchni menu (DungeonFlyoutPadding, 4) i jej krawędź (1). -->
        <x:Double x:Key="DungeonSubmenuVerticalOffset">-5</x:Double>
        <!-- Podmenu stoi obok menu, z którego wyszło, nie na nim: pozycja-rodzic kończy się przed
             prawą krawędzią menu o jego wcięcie (DungeonFlyoutPadding, 4) i krawędź (1), a za krawędzią
             jest odstęp okienka od otwierającego (DungeonFlyoutMargin, 6) - razem 4 + 1 + 6. -->
        <x:Double x:Key="DungeonSubmenuHorizontalOffset">11</x:Double>
        <!-- Odstęp kolumny skrótu klawiszowego od napisu pozycji menu (DungeonSpacingXxl). -->
        <Thickness x:Key="DungeonMenuGestureMargin">24,0,0,0</Thickness>
        <!-- Odstęp kolumny ikony od napisu i strzałki podmenu od napisu (DungeonSpacingSm). -->
        <Thickness x:Key="DungeonMenuIconMargin">0,0,8,0</Thickness>
        <Thickness x:Key="DungeonMenuChevronMargin">8,0,0,0</Thickness>
        <!-- Separator w menu: odstęp 4 nad i pod linią. -->
        <Thickness x:Key="DungeonMenuSeparatorMargin">0,4</Thickness>
        <!-- Okruszki (controls:Breadcrumbs): strzałka między odcinkami 8 px (mockup rejestru,
             .crumb-path svg) - mniejsza niż ikona akcji (16), bo stoi w tekście 12 px i tylko
             rozdziela. Odstęp po obu stronach strzałki DungeonSpacingXs. -->
        <x:Double x:Key="DungeonBreadcrumbSeparatorSize">8</x:Double>
        <!-- Zakładka (TabItem, TabStripItem): wysokość 32 - jak wiersz listy; mockup rejestru
             (.type-tab: 8 px + linia 13 px + 8 px) daje ok. 32. Wcięcie poziome 12 (DungeonSpacingMd). -->
        <x:Double x:Key="DungeonTabHeight">32</x:Double>
        <Thickness x:Key="DungeonTabPadding">12,0</Thickness>
        <!-- Najwyższa szerokość zakładki: ok. 30 znaków pisma 13. Dłuższa nazwa przycina się
             wielokropkiem i pokazuje pełną w podpowiedzi. -->
        <x:Double x:Key="DungeonTabMaxWidth">240</x:Double>
        <!-- Odstęp między zakładkami w pasku (w poziomie i między liniami po zawinięciu) idzie ze
             skali: DungeonSpacingXs. Mockup rejestru ma 3 px (.type-tabs gap) - poza skalą. -->
        <!-- Przełącznik segmentowy (ListBox z motywem DungeonSegmentedControl): pojemnik ma wysokość
             i krawędź pola (DungeonControlHeight, Input*), segmenty leżą w nim z wcięciem 3 px od
             krawędzi i zaokrągleniem 3 - mniejszym niż pojemnik (5), żeby wybrany segment czytał się
             jako pole w polu, nie drugie pole. -->
        <Thickness x:Key="DungeonSegmentedInset">3</Thickness>
        <CornerRadius x:Key="DungeonSegmentCornerRadius">3</CornerRadius>
        <!-- Sekcja rozwijana (Expander): nagłówek wysokości wiersza listy (32); strzałka 16 px
             (DungeonActionIconSize) z odstępem DungeonSpacingSm do napisu. Treść wcięta o szerokość
             strzałki i odstęp (12 + 16 + 8 = 36), żeby stała równo z napisem nagłówka, nie ze
             strzałką. -->
        <x:Double x:Key="DungeonExpanderHeaderHeight">32</x:Double>
        <Thickness x:Key="DungeonExpanderContentPadding">36,8,12,8</Thickness>
        <x:Double x:Key="DungeonCampaignRowHeight">40</x:Double>
        <x:Double x:Key="DungeonCampaignListMaxHeight">336</x:Double>
        <x:Double x:Key="DungeonCampaignListViewportHeight">258</x:Double>
        <x:Double x:Key="DungeonActionIconSize">16</x:Double>
        <!-- InlineIconButton: przycisk ikony stojący w rzędzie tekstu (przycisk kierunku za odnośnikiem
             sortowania) - kwadrat 24: ikona 16 z pasem 4 na tło najechania i obszar trafienia większy
             od samej ikony. Overhang ściąga jego wysokość w układzie do wysokości ikony (24 - 2 x 4 = 16),
             żeby nie podwyższał rzędu tekstu; tło najechania wystaje po 4 nad i pod rząd. -->
        <x:Double x:Key="DungeonInlineIconButtonSize">24</x:Double>
        <Thickness x:Key="DungeonInlineIconButtonOverhang">0,-4</Thickness>
        <!-- The smallest supported desktop workspace still shows its complete chrome, the campaign
             form and a usable list viewport. Data beyond that viewport scrolls inside the shelf. -->
        <x:Double x:Key="DungeonMinimumWindowWidth">1280</x:Double>
        <x:Double x:Key="DungeonMinimumWindowHeight">720</x:Double>
        <x:Double x:Key="DungeonPanelHeaderHeight">36</x:Double>
        <x:Double x:Key="DungeonPanelHeaderActionSize">36</x:Double>
        <x:Double x:Key="DungeonPanelTitleFontSize">13</x:Double>
        <x:Double x:Key="DungeonPanelResizeBorderThickness">6</x:Double>
        <x:Double x:Key="DungeonPanelResizeCornerSize">12</x:Double>
        <x:Double x:Key="DungeonDeckCardSize">44</x:Double>
        <x:Double x:Key="DungeonPanelMinWidth">240</x:Double>
        <x:Double x:Key="DungeonPanelMinHeight">152</x:Double>
        <x:Double x:Key="DungeonWorkspaceEdgeMargin">0</x:Double>
        <x:Double x:Key="DungeonPanelGap">12</x:Double>
        <x:Double x:Key="DungeonDeckCardSpacing">12</x:Double>
        <Thickness x:Key="DungeonDeckEdgeInsetThickness">12</Thickness>

        <!-- TEKSTY ============================================================= -->
        <x:String x:Key="DungeonStringMinimizeToolTip">Zminimalizuj</x:String>
        <x:String x:Key="DungeonStringMaximizeToolTip">Maksymalizuj</x:String>
        <x:String x:Key="DungeonStringRestoreToolTip">Przywróć</x:String>
    </ResourceDictionary>
