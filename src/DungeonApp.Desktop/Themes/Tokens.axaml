    <ResourceDictionary xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <!-- KOLORY ============================================================ -->
        <!-- Background: tło - najgłębszy poziom, pod całą resztą. -->
        <Color x:Key="DungeonBackgroundColor">#151412</Color>
        <!-- Surface: powierzchnia - poziom nad tłem. -->
        <Color x:Key="DungeonSurfaceColor">#1B1917</Color>
        <!-- SurfaceHeader: powierzchnia - poziom nad tłem (nagłówek powierzchni). -->
        <Color x:Key="DungeonSurfaceHeaderColor">#1B1917</Color>
        <!--
            Application depth hierarchy. These semantic roles intentionally remain separate from the
            generic surface tokens even where their current color values match. The outer frame,
            backstage workspace and live campaign desk may evolve independently without making a
            header or panel change color as a side effect.
        -->
        <!-- TŁA I OBSZAR ROBOCZY -->
        <!-- Frame: rama - stałe otoczenie treści (pasek boczny, pasek górny). -->
        <Color x:Key="DungeonFrameColor">#1B1917</Color>
        <!-- FrameHover: najechanie na ramie - ten element ramy reaguje na mysz. -->
        <Color x:Key="DungeonFrameHoverColor">#282522</Color>
        <!-- Backstage: zaplecze - tło treści poza kampanią (biblioteka, półka, galeria). -->
        <Color x:Key="DungeonBackstageColor">#151412</Color>
        <!-- BackstageEdge: zaplecze - tło treści poza kampanią, przy dalekiej krawędzi szerokiego widoku
             (koniec gradientu BackstageWide). -->
        <Color x:Key="DungeonBackstageEdgeColor">#100F0E</Color>
        <!-- BackstageCard: karta - rzecz wyodrębniona z tła, czytana jako całość. -->
        <Color x:Key="DungeonBackstageCardColor">#1F1D1A</Color>
        <!-- BackstageRow: wiersz - pozycja, którą można wskazać. -->
        <Color x:Key="DungeonBackstageRowColor">#221F1C</Color>
        <!-- BackstageRowHover: najechanie - to reaguje na mysz. -->
        <Color x:Key="DungeonBackstageRowHoverColor">#282522</Color>
        <!-- Desk: biurko - tło treści otwartej kampanii. -->
        <Color x:Key="DungeonDeskColor">#151412</Color>
        <!-- SurfaceActive: aktywne - wybrane albo wciśnięte teraz. -->
        <Color x:Key="DungeonSurfaceActiveColor">#282522</Color>
        <!-- SurfaceHover: najechanie - to reaguje na mysz. -->
        <Color x:Key="DungeonSurfaceHoverColor">#221F1C</Color>
        <!-- Border: linia - dzieli, nie wyróżnia; krawędź powierzchni i separator. -->
        <Color x:Key="DungeonBorderColor">#302C28</Color>
        <!-- BorderStrong: obramowanie wyraźne - krawędź, na którą ma paść wzrok: kontrolka pod myszą,
             aktywne okno, krawędź ramy. -->
        <Color x:Key="DungeonBorderStrongColor">#413C36</Color>
        <!-- TEKST -->
        <!-- TextPrimary: tekst podstawowy - treść i wszystko domyślnie. -->
        <Color x:Key="DungeonTextPrimaryColor">#E8E4DA</Color>
        <!-- TextRegular: tekst drugorzędny - opis, uzupełnienie. -->
        <Color x:Key="DungeonTextRegularColor">#9B9A95</Color>
        <!-- TextMuted: tekst przygaszony - podpis, etykieta, metadane. -->
        <Color x:Key="DungeonTextMutedColor">#8A8983</Color>
        <Color x:Key="DungeonAccentColor">#B8843B</Color>
        <Color x:Key="DungeonAccentBrightColor">#B8843B</Color>
        <Color x:Key="DungeonAccentActionColor">#B8843B</Color>
        <Color x:Key="DungeonAccentDimColor">#B8843B</Color>
        <Color x:Key="DungeonOnAccentColor">#241A0C</Color>
        <Color x:Key="DungeonPrimaryDisabledColor">#302C28</Color>
        <!-- Sukces: udało się. -->
        <Color x:Key="DungeonSuccessColor">#84A98B</Color>
        <!-- Ostrzeżenie: wymaga uwagi, ale działa. -->
        <Color x:Key="DungeonWarningColor">#CF9B55</Color>
        <!-- Niebezpieczeństwo: coś jest zepsute albo akcja jest nieodwracalna. -->
        <Color x:Key="DungeonDangerColor">#9C4530</Color>

        <!-- PĘDZLE ============================================================= -->
        <SolidColorBrush x:Key="DungeonBackgroundBrush" Color="{DynamicResource DungeonBackgroundColor}" />
        <SolidColorBrush x:Key="DungeonSurfaceBrush" Color="{DynamicResource DungeonSurfaceColor}" />
        <SolidColorBrush x:Key="DungeonSurfaceHeaderBrush" Color="{DynamicResource DungeonSurfaceHeaderColor}" />
        <SolidColorBrush x:Key="DungeonFrameBrush" Color="{DynamicResource DungeonFrameColor}" />
        <SolidColorBrush x:Key="DungeonFrameHoverBrush" Color="{DynamicResource DungeonFrameHoverColor}" />
        <SolidColorBrush x:Key="DungeonBackstageBrush" Color="{DynamicResource DungeonBackstageColor}" />
        <!-- BackstageWide: zaplecze - tło treści poza kampanią (biblioteka, półka, galeria), w szerokich
             widokach. -->
        <!-- Used only by wide, static backstage views. The first half stays calm so the gradient
             does not read as decoration behind the actual content. -->
        <LinearGradientBrush x:Key="DungeonBackstageWideBrush"
                             StartPoint="0,0"
                             EndPoint="2400,1000">
            <GradientStop Offset="0" Color="{DynamicResource DungeonBackstageColor}" />
            <GradientStop Offset="0.42" Color="{DynamicResource DungeonBackstageColor}" />
            <GradientStop Offset="0.74" Color="#12110F" />
            <GradientStop Offset="1" Color="{DynamicResource DungeonBackstageEdgeColor}" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DungeonBackstageCardBrush" Color="{DynamicResource DungeonBackstageCardColor}" />
        <SolidColorBrush x:Key="DungeonBackstageRowBrush" Color="{DynamicResource DungeonBackstageRowColor}" />
        <SolidColorBrush x:Key="DungeonBackstageRowHoverBrush" Color="{DynamicResource DungeonBackstageRowHoverColor}" />
        <SolidColorBrush x:Key="DungeonDeskBrush" Color="{DynamicResource DungeonDeskColor}" />
        <SolidColorBrush x:Key="DungeonSurfaceActiveBrush" Color="{DynamicResource DungeonSurfaceActiveColor}" />
        <SolidColorBrush x:Key="DungeonSurfaceHoverBrush" Color="{DynamicResource DungeonSurfaceHoverColor}" />
        <SolidColorBrush x:Key="DungeonBorderBrush" Color="{DynamicResource DungeonBorderColor}" />
        <SolidColorBrush x:Key="DungeonBorderStrongBrush" Color="{DynamicResource DungeonBorderStrongColor}" />
        <SolidColorBrush x:Key="DungeonTextPrimaryBrush" Color="{DynamicResource DungeonTextPrimaryColor}" />
        <SolidColorBrush x:Key="DungeonTextRegularBrush" Color="{DynamicResource DungeonTextRegularColor}" />
        <SolidColorBrush x:Key="DungeonTextMutedBrush" Color="{DynamicResource DungeonTextMutedColor}" />
        <SolidColorBrush x:Key="DungeonAccentBrush" Color="{DynamicResource DungeonAccentColor}" />
        <SolidColorBrush x:Key="DungeonAccentBrightBrush" Color="{DynamicResource DungeonAccentBrightColor}" />
        <SolidColorBrush x:Key="DungeonAccentActionBrush" Color="{DynamicResource DungeonAccentActionColor}" />
        <SolidColorBrush x:Key="DungeonAccentDimBrush" Color="{DynamicResource DungeonAccentDimColor}" />
        <SolidColorBrush x:Key="DungeonOnAccentBrush" Color="{DynamicResource DungeonOnAccentColor}" />
        <SolidColorBrush x:Key="DungeonPrimaryDisabledBrush" Color="{DynamicResource DungeonPrimaryDisabledColor}" />
        <SolidColorBrush x:Key="DungeonSuccessBrush" Color="{DynamicResource DungeonSuccessColor}" />
        <SolidColorBrush x:Key="DungeonWarningBrush" Color="{DynamicResource DungeonWarningColor}" />
        <SolidColorBrush x:Key="DungeonDangerBrush" Color="{DynamicResource DungeonDangerColor}" />

        <!-- NIEPRZEZROCZYSTOŚĆ ================================================= -->
        <!-- The one disabled-state opacity this theme defines - shared by every ":disabled" style
             that dims rather than recolors, so a second view never has to invent its own number. -->
        <x:Double x:Key="DungeonDisabledOpacity">0.48</x:Double>

        <!-- PĘDZLE KONTROLEK I PANELI ========================================= -->
        <SolidColorBrush x:Key="DungeonInputBackgroundBrush" Color="{DynamicResource DungeonBackstageColor}" />
        <SolidColorBrush x:Key="DungeonInputBorderBrush" Color="{DynamicResource DungeonBorderColor}" />
        <SolidColorBrush x:Key="DungeonInputHoverBorderBrush" Color="{DynamicResource DungeonBorderStrongColor}" />
        <SolidColorBrush x:Key="DungeonInputFocusBorderBrush" Color="{DynamicResource DungeonBorderStrongColor}" />
        <SolidColorBrush x:Key="DungeonInputPlaceholderBrush" Color="{DynamicResource DungeonTextMutedColor}" />

        <!--
            Panel chrome. Semantic aliases rather than direct use of the generic surface tokens, so a
            floating panel can diverge from other surfaces later without touching any view.
            A minimized panel is the same object in another state, so the deck cards share these.
        -->
        <!-- PanelWindowBackground: okno biurka - tło okna. -->
        <SolidColorBrush x:Key="DungeonPanelWindowBackgroundBrush" Color="{DynamicResource DungeonSurfaceColor}" />
        <!-- PanelWindowHeader: okno biurka - nagłówek okna. -->
        <SolidColorBrush x:Key="DungeonPanelWindowHeaderBrush" Color="{DynamicResource DungeonSurfaceHeaderColor}" />
        <!-- PanelWindowBorder: okno biurka - krawędź okna. -->
        <SolidColorBrush x:Key="DungeonPanelWindowBorderBrush" Color="{DynamicResource DungeonBorderColor}" />
        <!--
            The active panel changes only this brush. A stronger neutral border keeps focus legible
            without making ordinary window selection look like a warning or validation state. Changing
            BorderThickness instead would resize the panel every time focus moved.
        -->
        <!-- PanelWindowActiveBorder: okno biurka - krawędź aktywnego okna. -->
        <SolidColorBrush x:Key="DungeonPanelWindowActiveBorderBrush" Color="{DynamicResource DungeonBorderStrongColor}" />
        <!-- Named so nobody helpfully makes the resize gutters visible: they are hit targets only.
             It must stay Transparent rather than null, because null is not hit-testable. -->
        <SolidColorBrush x:Key="DungeonPanelResizeGripBrush" Color="Transparent" />

        <!-- TYPOGRAFIA ========================================================= -->
        <FontFamily x:Key="DungeonUiFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        <FontFamily x:Key="DungeonDisplayFont">avares://DungeonApp.Desktop/Assets/Fonts/CormorantGaramond#Cormorant Garamond</FontFamily>
        <!-- Fixed-width figures for numbers (the mockup's font-mono). Regular, Medium and SemiBold files. -->
        <FontFamily x:Key="DungeonMonoFont">avares://DungeonApp.Desktop/Assets/Fonts/IBMPlexMono#IBM Plex Mono</FontFamily>

        <CornerRadius x:Key="DungeonWindowCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="DungeonCardCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="DungeonControlCornerRadius">5</CornerRadius>
        <CornerRadius x:Key="DungeonNavigationCornerRadius">4</CornerRadius>
        <!-- Compatibility alias for campaign controls not yet split into card/control variants. -->
        <CornerRadius x:Key="DungeonCornerRadius">5</CornerRadius>

        <!-- ODSTĘPY I ZAOKRĄGLENIA ============================================= -->
        <!--
            Skala odstępów, wyrażona jako literały powtarzające się w widokach.
            Dwa równoległe zestawy: Double dla Spacing/Width/Height oraz Thickness dla Margin/Padding.
        -->
        <x:Double x:Key="DungeonSpacingXs">6</x:Double>
        <x:Double x:Key="DungeonSpacingSm">8</x:Double>
        <x:Double x:Key="DungeonSpacingMd">12</x:Double>
        <x:Double x:Key="DungeonSpacingLg">16</x:Double>
        <x:Double x:Key="DungeonSpacingXl">20</x:Double>
        <x:Double x:Key="DungeonSpacingXxl">24</x:Double>
        <x:Double x:Key="DungeonSpacingXxxl">32</x:Double>

        <Thickness x:Key="DungeonPaddingXs">6</Thickness>
        <Thickness x:Key="DungeonPaddingSm">8</Thickness>
        <Thickness x:Key="DungeonPaddingMd">12</Thickness>
        <Thickness x:Key="DungeonPaddingLg">16</Thickness>
        <Thickness x:Key="DungeonPaddingXl">20</Thickness>
        <Thickness x:Key="DungeonPaddingXxl">24</Thickness>
        <Thickness x:Key="DungeonPaddingXxxl">32</Thickness>

        <!-- WYMIARY POWŁOKI I PANELI ========================================== -->
        <!-- Pasek postępu ładowania. -->
        <x:Double x:Key="DungeonLoadingProgressBarWidth">192</x:Double>
        <x:Double x:Key="DungeonLoadingProgressBarHeight">4</x:Double>

        <!-- Stałe wymiary interfejsu. -->
        <x:Double x:Key="DungeonBaseFontSize">13</x:Double>
        <x:Double x:Key="DungeonNavigationFontSize">13</x:Double>
        <x:Double x:Key="DungeonHelperFontSize">12</x:Double>
        <x:Double x:Key="DungeonEyebrowFontSize">10</x:Double>
        <x:Double x:Key="DungeonStatusFontSize">12</x:Double>
        <x:Double x:Key="DungeonWorkspaceTitleFontSize">22</x:Double>
        <x:Double x:Key="DungeonCampaignNameFontSize">15</x:Double>
        <x:Double x:Key="DungeonBrandNameFontSize">16</x:Double>
        <x:Double x:Key="DungeonBrandMarkFontSize">16</x:Double>
        <x:Double x:Key="DungeonBrandMarkLargeFrameSize">96</x:Double>
        <x:Double x:Key="DungeonBrandMarkLargeFontSize">64</x:Double>
        <!-- Shared by the top bar's own height and the sidebar header's (GlobalSidebarView.axaml),
             so their bottom borders always draw as one continuous line - a plain Double, not a
             GridLength, since both usages are a Height, never a column/row size. -->
        <x:Double x:Key="DungeonTopBarHeight">52</x:Double>
        <GridLength x:Key="DungeonSidebarWidth">224</GridLength>
        <GridLength x:Key="DungeonStatusBarHeight">24</GridLength>
        <x:Double x:Key="DungeonWorkspaceHeaderHeight">68</x:Double>
        <x:Double x:Key="DungeonControlHeight">38</x:Double>
        <x:Double x:Key="DungeonNavigationRowHeight">38</x:Double>
        <x:Double x:Key="DungeonCampaignRowHeight">40</x:Double>
        <x:Double x:Key="DungeonCampaignListMaxHeight">336</x:Double>
        <x:Double x:Key="DungeonCampaignListViewportHeight">258</x:Double>
        <x:Double x:Key="DungeonActionIconSize">16</x:Double>
        <!-- The smallest supported desktop workspace still shows its complete chrome, the campaign
             form and a usable list viewport. Data beyond that viewport scrolls inside the shelf. -->
        <x:Double x:Key="DungeonMinimumWindowWidth">1280</x:Double>
        <x:Double x:Key="DungeonMinimumWindowHeight">720</x:Double>
        <x:Double x:Key="DungeonPanelHeaderHeight">36</x:Double>
        <x:Double x:Key="DungeonPanelHeaderActionSize">36</x:Double>
        <x:Double x:Key="DungeonPanelTitleFontSize">13</x:Double>
        <x:Double x:Key="DungeonPanelResizeBorderThickness">6</x:Double>
        <x:Double x:Key="DungeonPanelResizeCornerSize">12</x:Double>
        <x:Double x:Key="DungeonDeckCardSize">44</x:Double>
        <x:Double x:Key="DungeonPanelMinWidth">240</x:Double>
        <x:Double x:Key="DungeonPanelMinHeight">152</x:Double>
        <x:Double x:Key="DungeonWorkspaceEdgeMargin">0</x:Double>
        <x:Double x:Key="DungeonPanelGap">12</x:Double>
        <x:Double x:Key="DungeonDeckCardSpacing">12</x:Double>
        <Thickness x:Key="DungeonDeckEdgeInsetThickness">12</Thickness>

        <!-- TEKSTY ============================================================= -->
        <x:String x:Key="DungeonStringMinimizeToolTip">Zminimalizuj</x:String>
        <x:String x:Key="DungeonStringMaximizeToolTip">Maksymalizuj</x:String>
        <x:String x:Key="DungeonStringRestoreToolTip">Przywróć</x:String>
    </ResourceDictionary>
