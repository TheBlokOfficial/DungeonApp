<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Pen x:Key="DungeonIconPen" Brush="{DynamicResource DungeonTextMutedBrush}" Thickness="1.75" LineCap="Round" LineJoin="Round" />
    <Pen x:Key="DungeonIconPrimaryPen" Brush="{DynamicResource DungeonTextPrimaryBrush}" Thickness="1.75" LineCap="Round" LineJoin="Round" />
    <Pen x:Key="DungeonIconDangerPen" Brush="{DynamicResource DungeonDangerBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round" />
    <Pen x:Key="DungeonCampaignEmblemPen" Brush="{DynamicResource DungeonAccentBrush}" Thickness="1.75" LineCap="Round" LineJoin="Round" />

    <DrawingImage x:Key="DungeonIconSearch" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M21,21 L16.66,16.66" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M19,11 A8,8 0 1 1 3,11 A8,8 0 1 1 19,11" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <!-- Clear: x glyph, clear button in the search field. -->
    <DrawingImage x:Key="DungeonIconClear" Viewbox="0,0,24,24">
        <GeometryDrawing Geometry="M7,7 L17,17 M17,7 L7,17" Pen="{StaticResource DungeonIconPen}" />
    </DrawingImage>
    <DrawingImage x:Key="DungeonIconMenu" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M2,7 L22,7 M2,12 L22,12 M2,17 L22,17" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <DrawingImage x:Key="DungeonIconBookOpen" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M12,5 L12,21" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M20.001,19 A2,2 0 0 0 22,17 L22,5 A2,2 0 0 0 20.001,3 L16,3.002 A5,5 0 0 0 12,5 A5,5 0 0 0 8,3 L4,3 A2,2 0 0 0 2,5 L2,17 A2,2 0 0 0 3.999,19 L8,19 A5,5 0 0 1 12,21 A5,5 0 0 1 16,19 Z" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <DrawingImage x:Key="DungeonIconPencil" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M4,20 L8.4,19 L19,8.4 A2.1,2.1 0 0 0 16,5.4 L5.4,16 Z M14.7,6.7 L17.7,9.7" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <DrawingImage x:Key="DungeonIconChevronRight" Viewbox="0,0,24,24">
        <GeometryDrawing Geometry="M9,5 L16,12 L9,19" Pen="{StaticResource DungeonIconPen}" />
    </DrawingImage>
    <DrawingImage x:Key="DungeonIconTrash" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M4,7 L20,7 M9,7 L9,4 L15,4 L15,7 M6,7 L7,20 L17,20 L18,7 M10,11 L10,17 M14,11 L14,17" Pen="{StaticResource DungeonIconDangerPen}" />
        </DrawingGroup>
    </DrawingImage>
    <!-- Record emblem is intentionally distinct from the neutral navigation icon. -->
    <DrawingImage x:Key="DungeonIconCampaignRecord" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M12,5 L12,21" Pen="{StaticResource DungeonCampaignEmblemPen}" />
            <GeometryDrawing Geometry="M20.001,19 A2,2 0 0 0 22,17 L22,5 A2,2 0 0 0 20.001,3 L16,3.002 A5,5 0 0 0 12,5 A5,5 0 0 0 8,3 L4,3 A2,2 0 0 0 2,5 L2,17 A2,2 0 0 0 3.999,19 L8,19 A5,5 0 0 1 12,21 A5,5 0 0 1 16,19 Z" Pen="{StaticResource DungeonCampaignEmblemPen}" />
        </DrawingGroup>
    </DrawingImage>
    <DrawingImage x:Key="DungeonIconUsers" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M16,21 L16,19 A4,4 0 0 0 12,15 L6,15 A4,4 0 0 0 2,19 L2,21" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M16,3.128 A4,4 0 0 1 16,10.872" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M22,21 L22,19 A4,4 0 0 0 19,15.13" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M13,7 A4,4 0 1 1 5,7 A4,4 0 1 1 13,7" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <DrawingImage x:Key="DungeonIconSettings" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M9.671,4.136 A2.34,2.34 0 0 1 14.33,4.136 A2.34,2.34 0 0 0 17.649,6.051 A2.34,2.34 0 0 1 19.979,10.084 A2.34,2.34 0 0 0 19.979,13.915 A2.34,2.34 0 0 1 17.649,17.948 A2.34,2.34 0 0 0 14.33,19.863 A2.34,2.34 0 0 1 9.671,19.863 A2.34,2.34 0 0 0 6.351,17.948 A2.34,2.34 0 0 1 4.021,13.915 A2.34,2.34 0 0 0 4.021,10.084 A2.34,2.34 0 0 1 6.35,6.051 A2.34,2.34 0 0 0 9.671,4.136" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <!-- Lucide "layout-grid": four 7x7 squares with corner radius 1. -->
    <DrawingImage x:Key="DungeonIconGallery" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M4,3 L9,3 A1,1 0 0 1 10,4 L10,9 A1,1 0 0 1 9,10 L4,10 A1,1 0 0 1 3,9 L3,4 A1,1 0 0 1 4,3 Z" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M15,3 L20,3 A1,1 0 0 1 21,4 L21,9 A1,1 0 0 1 20,10 L15,10 A1,1 0 0 1 14,9 L14,4 A1,1 0 0 1 15,3 Z" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M15,14 L20,14 A1,1 0 0 1 21,15 L21,20 A1,1 0 0 1 20,21 L15,21 A1,1 0 0 1 14,20 L14,15 A1,1 0 0 1 15,14 Z" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M4,14 L9,14 A1,1 0 0 1 10,15 L10,20 A1,1 0 0 1 9,21 L4,21 A1,1 0 0 1 3,20 L3,15 A1,1 0 0 1 4,14 Z" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <DrawingImage x:Key="DungeonIconDatabase" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M21,5 A9,3 0 1 1 3,5 A9,3 0 1 1 21,5" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M3,5 L3,19 A9,3 0 0 0 21,19 L21,5" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M3,12 A9,3 0 0 0 21,12" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <DrawingImage x:Key="DungeonIconDockBottom" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M8,9 L12,13 L16,9" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M7,17 L17,17" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <DrawingImage x:Key="DungeonIconWindowMaximize" Viewbox="0,0,24,24">
        <GeometryDrawing Geometry="M5,5 L19,5 L19,19 L5,19 Z" Pen="{StaticResource DungeonIconPen}" />
    </DrawingImage>
    <DrawingImage x:Key="DungeonIconWindowRestore" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M9,5 L19,5 L19,15" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M5,9 L15,9 L15,19 L5,19 Z" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <!-- A closed campaign tab shows this in place of its own icon - same 24x24 viewbox and
         DungeonIconPen as every outline icon above, so a locked tab is visually just another member
         of this icon set, not a special case. -->
    <DrawingImage x:Key="DungeonIconLock" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M6,11 L18,11 L18,21 L6,21 Z" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M8,11 L8,7 A4,4 0 0 1 16,7 L16,11" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <!-- An unavailable campaign row shows this in place of its record emblem. Uses the danger pen,
         same as the trash icon, so both draw from the one red token this theme has. -->
    <DrawingImage x:Key="DungeonIconWarningTriangle" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M12,3 L22,20 L2,20 Z" Pen="{StaticResource DungeonIconDangerPen}" />
            <GeometryDrawing Geometry="M12,9 L12,15" Pen="{StaticResource DungeonIconDangerPen}" />
            <GeometryDrawing Geometry="M12,18 L12,18.1" Pen="{StaticResource DungeonIconDangerPen}" />
        </DrawingGroup>
    </DrawingImage>
    <!-- Information: circle with letter i - information notification variant. -->
    <DrawingImage x:Key="DungeonIconInfo" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M12,3 A9,9 0 1 1 11.99,3 Z" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M12,11 L12,16.5" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M12,7.5 L12,7.6" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <!-- Error: circle with exclamation mark - error notification variant. -->
    <DrawingImage x:Key="DungeonIconError" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M12,3 A9,9 0 1 1 11.99,3 Z" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M12,7.5 L12,13" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M12,16.4 L12,16.5" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <!-- The top bar's "Zmień system" action: an open doorway with an arrow leaving through it. -->
    <DrawingImage x:Key="DungeonIconExitDoor" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M14,4 L6,4 A2,2 0 0 0 4,6 L4,18 A2,2 0 0 0 6,20 L14,20" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M9,12 L20,12 M16,8 L20,12 L16,16" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <!-- Checkmark: checked menu item (MenuItem ToggleType CheckBox). -->
    <DrawingImage x:Key="DungeonIconCheck" Viewbox="0,0,24,24">
        <GeometryDrawing Geometry="M5,12.5 L10,17.5 L19,7" Pen="{StaticResource DungeonIconPen}" />
    </DrawingImage>
    <!-- Dot: menu item selected in a group (MenuItem ToggleType Radio) - small circle filled
         by a thick stroke. -->
    <DrawingImage x:Key="DungeonIconRadioDot" Viewbox="0,0,24,24">
        <GeometryDrawing Geometry="M12,9.5 A2.5,2.5 0 1 1 11.99,9.5 Z" Pen="{StaticResource DungeonIconPen}" />
    </DrawingImage>
    <!-- More: three horizontal dots ("⋯" menu button). -->
    <DrawingImage x:Key="DungeonIconMore" Viewbox="0,0,24,24">
        <GeometryDrawing Geometry="M5,11.2 L5,12.8 M12,11.2 L12,12.8 M19,11.2 L19,12.8" Pen="{StaticResource DungeonIconPrimaryPen}" />
    </DrawingImage>
    <!-- Sort direction: downward arrow (left) and three lines of decreasing length (right) -
         longest at top to shortest at bottom. Drawn this way means "malejąco"; "rosnąco" uses
         the same drawing flipped across the horizontal axis (SortPicker, vertical scale -1). -->
    <DrawingImage x:Key="DungeonIconSortDirection" Viewbox="0,0,24,24">
        <GeometryDrawing Geometry="M7,5 L7,19 M4,16 L7,19 L10,16 M13,7 L20,7 M13,12 L18,12 M13,17 L16,17" Pen="{StaticResource DungeonIconPen}" />
    </DrawingImage>
    <!-- Chevron pointing down - dropdown affordance for a filter chip and the sort button. Same pen
         and 24x24 viewbox as every other outline icon; only the direction differs from
         DungeonIconChevronRight above. -->
    <DrawingImage x:Key="DungeonIconChevronDown" Viewbox="0,0,24,24">
        <GeometryDrawing Geometry="M5,9 L12,16 L19,9" Pen="{StaticResource DungeonIconPen}" />
    </DrawingImage>
    <!-- Lucide "skull" (Assets/Icons/Lucide/skull.svg), its relative path commands written out as
         absolute ones like every icon here: the nose, the cranium with the jaw, two eye sockets. -->
    <DrawingImage x:Key="DungeonIconSkull" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M12.5,17 L12,16 L11.5,17 Z" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M15,22 A1,1 0 0 0 16,21 L16,20 A2,2 0 0 0 17.56,16.75 A8,8 0 1 0 6.44,16.75 A2,2 0 0 0 8,20 L8,21 A1,1 0 0 0 9,22 Z" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M16,12 A1,1 0 1 1 14,12 A1,1 0 1 1 16,12" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M10,12 A1,1 0 1 1 8,12 A1,1 0 1 1 10,12" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <!-- Lucide "backpack" (Assets/Icons/Lucide/backpack.svg): the body, its top and bottom seams,
         the front pocket and the carrying handle. -->
    <DrawingImage x:Key="DungeonIconBackpack" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M4,10 A4,4 0 0 1 8,6 L16,6 A4,4 0 0 1 20,10 L20,20 A2,2 0 0 1 18,22 L6,22 A2,2 0 0 1 4,20 Z" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M8,10 L16,10" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M8,18 L16,18" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M8,22 L8,16 A2,2 0 0 1 10,14 L14,14 A2,2 0 0 1 16,16 L16,22" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M9,6 L9,4 A2,2 0 0 1 11,2 L13,2 A2,2 0 0 1 15,4 L15,6" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>

    <!-- Card icons: the headline values (shield, heart, footprints, weight, sword, zap). Each is the Lucide icon of that
         name (Assets/Icons/Lucide/<name>.svg), relative path commands written out as absolute ones. -->
    <DrawingImage x:Key="DungeonIconShield" Viewbox="0,0,24,24">
        <GeometryDrawing Geometry="M20,13 C20,18 16.5,20.5 12.34,21.95 A1,1 0 0 1 11.67,21.94 C7.5,20.5 4,18 4,13 L4,6 A1,1 0 0 1 5,5 C7,5 9.5,3.8 11.24,2.28 A1.17,1.17 0 0 1 12.76,2.28 C14.51,3.81 17,5 19,5 A1,1 0 0 1 20,6 Z" Pen="{StaticResource DungeonIconPen}" />
    </DrawingImage>
    <DrawingImage x:Key="DungeonIconHeart" Viewbox="0,0,24,24">
        <GeometryDrawing Geometry="M19,14 C20.49,12.54 22,10.79 22,8.5 A5.5,5.5 0 0 0 16.5,3 C14.74,3 13.5,3.5 12,5 C10.5,3.5 9.26,3 7.5,3 A5.5,5.5 0 0 0 2,8.5 C2,10.8 3.5,12.55 5,14 L12,21 Z" Pen="{StaticResource DungeonIconPen}" />
    </DrawingImage>
    <DrawingImage x:Key="DungeonIconFootprints" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M4,16 L4,13.62 C4,11.5 2.97,10.5 3,8 C3.03,5.28 4.49,2 7.5,2 C9.37,2 10,3.8 10,5.5 C10,8.61 8,11.16 8,14.18 L8,16 A2,2 0 1 1 4,16 Z" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M20,20 L20,17.62 C20,15.5 21.03,14.5 21,12 C20.97,9.28 19.51,6 16.5,6 C14.63,6 14,7.8 14,9.5 C14,12.61 16,15.16 16,18.18 L16,20 A2,2 0 1 0 20,20 Z" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M16,17 L20,17 M4,13 L8,13" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <!-- Lucide "weight": the ring and the trapezoid body of a weight - stands by an item's weight. -->
    <DrawingImage x:Key="DungeonIconWeight" Viewbox="0,0,24,24">
        <DrawingGroup>
            <GeometryDrawing Geometry="M15,5 A3,3 0 1 1 9,5 A3,3 0 1 1 15,5" Pen="{StaticResource DungeonIconPen}" />
            <GeometryDrawing Geometry="M6.5,8 A2,2 0 0 0 4.595,9.46 L2.1,18.5 A2,2 0 0 0 4,21 L20,21 A2,2 0 0 0 21.925,18.46 L19.4,9.5 A2,2 0 0 0 17.48,8 Z" Pen="{StaticResource DungeonIconPen}" />
        </DrawingGroup>
    </DrawingImage>
    <!-- Lucide "sword": the blade and the crossguard - stands by a damage value. -->
    <DrawingImage x:Key="DungeonIconSword" Viewbox="0,0,24,24">
        <GeometryDrawing Geometry="M14.5,17.5 L3,6 L3,3 L6,3 L17.5,14.5 M13,19 L19,13 M16,16 L20,20 M19,21 L21,19" Pen="{StaticResource DungeonIconPen}" />
    </DrawingImage>
    <!-- Lucide "zap": a lightning bolt - stands by a count of charges. -->
    <DrawingImage x:Key="DungeonIconZap" Viewbox="0,0,24,24">
        <GeometryDrawing Geometry="M4,14 A1,1 0 0 1 3.22,12.37 L13.12,2.17 A0.5,0.5 0 0 1 13.98,2.63 L12.06,8.65 A1,1 0 0 0 13,10 L20,10 A1,1 0 0 1 20.78,11.63 L10.88,21.83 A0.5,0.5 0 0 1 10.02,21.37 L11.94,15.35 A1,1 0 0 0 11,14 Z" Pen="{StaticResource DungeonIconPen}" />
    </DrawingImage>
</ResourceDictionary>
