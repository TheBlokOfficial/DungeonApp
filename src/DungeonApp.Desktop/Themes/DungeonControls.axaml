<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls"
                    xmlns:workspace="using:DungeonApp.Desktop.Controls.Workspace">

    <!--
        Control themes for the project's own templated controls. This has to be a ResourceDictionary
        merged into Application.Resources - Themes/BuiltInControls.axaml has a <Styles> root and
        cannot hold a ControlTheme. A custom TemplatedControl inherits no implicit theme from
        FluentTheme, so without the two keyed by {x:Type ...} below, both controls would render as
        nothing at all.
    -->

    <controls:ResourceKeyToImageConverter x:Key="DungeonIconResourceConverter" />

    <!--
        DungeonApp owns the base button chrome instead of inheriting Fluent's pressed transform and
        pressed presenter palette. A button still has its behavioural :pressed pseudo-class, but it
        has no visual treatment: immediate :pointerover is the sole transient pointer feedback.
        Persistent states such as disabled, focus-visible, checked or selected remain separate
        semantic concerns.
    -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.48" />
        </Style>
    </ControlTheme>

    <!--
        Desk texture. The grid line means something now: it marks a surface things float on, so it
        belongs to the campaign desk and nowhere else. Static screens keep a flat background.
        WorkspaceGridBackground and the snap calculations both read WorkspaceGridSettings, so the
        visible cell and its snap subdivisions cannot drift apart.
    -->
    <SolidColorBrush x:Key="DungeonWorkspaceGridLineBrush"
                     Color="{DynamicResource DungeonBorderColor}"
                     Opacity="0.12" />

    <!-- Square, borderless icon button for the panel title bar. -->
    <ControlTheme x:Key="DungeonPanelHeaderActionTheme" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource DungeonPanelHeaderActionSize}" />
        <Setter Property="Height" Value="{DynamicResource DungeonPanelHeaderActionSize}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonCornerRadius}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHoverBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type workspace:WorkspaceSurface}" TargetType="workspace:WorkspaceSurface">
        <Setter Property="Background" Value="{DynamicResource DungeonDeskBrush}" />
        <!-- Canvas does not clip its children; without this a dragged panel paints over the
             sidebar and the status bar. -->
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <Canvas />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <!-- No padding or border: the presenter, rendered grid and gesture Canvas share
                     one coordinate space, including the zero-position surface edge. -->
                <!-- One native inset shadow produces a continuous rectangular falloff, including
                     corners. Border draws it above its background and below child content, so the
                     grid stays legible and panels touching an edge are never dimmed. -->
                <Border Background="{TemplateBinding Background}"
                        BoxShadow="inset 0 0 22 0 #50000000">
                    <Grid>
                        <workspace:WorkspaceGridBackground
                            GridLineBrush="{StaticResource DungeonWorkspaceGridLineBrush}"
                            IsHitTestVisible="False" />
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type workspace:PanelWindow}" TargetType="workspace:PanelWindow">
        <Setter Property="Background" Value="{DynamicResource DungeonPanelWindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonPanelWindowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonCornerRadius}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransformOrigin" Value="50%,100%" />
        <Setter Property="RenderTransform" Value="scale(1) translate(0px, 0px)" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity"
                                  Duration="0:0:0.16"
                                  Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="0:0:0.16"
                                               Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid RowDefinitions="Auto,*">
                            <Border Name="PART_TitleBar"
                                    Background="{DynamicResource DungeonPanelWindowHeaderBrush}"
                                    Height="{DynamicResource DungeonPanelHeaderHeight}">
                                <Grid>
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          Margin="8,0,1,1"
                                          ColumnSpacing="8">
                                        <Image Width="{DynamicResource DungeonActionIconSize}"
                                               Height="{DynamicResource DungeonActionIconSize}"
                                               VerticalAlignment="Center"
                                               Source="{TemplateBinding IconResourceKey, Converter={StaticResource DungeonIconResourceConverter}}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource DungeonPanelTitleFontSize}"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{TemplateBinding Title}"
                                                   Text="{TemplateBinding Title}" />
                                        <!-- Actions are rendered in a root overlay. Matching slots
                                             keep long titles from painting underneath them. -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    IsHitTestVisible="False">
                                            <Border Width="{DynamicResource DungeonPanelHeaderActionSize}" />
                                            <Border Width="{DynamicResource DungeonPanelHeaderActionSize}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <ContentPresenter Grid.Row="1"
                                              Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>

                    <!--
                        Resize gutters, overlaid on top of the chrome. Every grip needs an explicit
                        Transparent background: a null background is invisible to hit-testing, so
                        the grips would silently do nothing. The centre cell is left empty, so the
                        panel content underneath keeps receiving pointer input.
                    -->
                    <Grid Name="PART_ResizeGrid"
                          RowDefinitions="Auto,*,Auto"
                          ColumnDefinitions="Auto,*,Auto"
                          IsHitTestVisible="{TemplateBinding CanResize}">
                        <Border Name="PART_ResizeNW" Grid.Row="0" Grid.Column="0" ZIndex="1"
                                Width="{DynamicResource DungeonPanelResizeCornerSize}"
                                Height="{DynamicResource DungeonPanelResizeCornerSize}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                Cursor="TopLeftCorner" />
                        <Border Name="PART_ResizeN" Grid.Row="0" Grid.Column="1"
                                VerticalAlignment="Top"
                                Height="{DynamicResource DungeonPanelResizeBorderThickness}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                Cursor="TopSide" />
                        <Border Name="PART_ResizeNE" Grid.Row="0" Grid.Column="2" ZIndex="1"
                                Width="{DynamicResource DungeonPanelResizeCornerSize}"
                                Height="{DynamicResource DungeonPanelResizeCornerSize}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                Cursor="TopRightCorner" />
                        <Border Name="PART_ResizeW" Grid.Row="1" Grid.Column="0"
                                HorizontalAlignment="Left"
                                Width="{DynamicResource DungeonPanelResizeBorderThickness}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                Cursor="LeftSide" />
                        <Border Name="PART_ResizeE" Grid.Row="1" Grid.Column="2"
                                HorizontalAlignment="Right"
                                Width="{DynamicResource DungeonPanelResizeBorderThickness}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                Cursor="RightSide" />
                        <Border Name="PART_ResizeSW" Grid.Row="2" Grid.Column="0" ZIndex="1"
                                Width="{DynamicResource DungeonPanelResizeCornerSize}"
                                Height="{DynamicResource DungeonPanelResizeCornerSize}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                Cursor="BottomLeftCorner" />
                        <Border Name="PART_ResizeS" Grid.Row="2" Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Height="{DynamicResource DungeonPanelResizeBorderThickness}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                Cursor="BottomSide" />
                        <Border Name="PART_ResizeSE" Grid.Row="2" Grid.Column="2" ZIndex="1"
                                Width="{DynamicResource DungeonPanelResizeCornerSize}"
                                Height="{DynamicResource DungeonPanelResizeCornerSize}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                 Cursor="BottomRightCorner" />
                    </Grid>

                    <!-- Local dimensions intentionally outrank the broad application Button style.
                         The overlay keeps standard full-height window actions clickable above the
                         north-east resize grip. -->
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                        <Button Name="PART_MinimizeButton"
                                Width="{DynamicResource DungeonPanelHeaderActionSize}"
                                Height="{DynamicResource DungeonPanelHeaderActionSize}"
                                Theme="{StaticResource DungeonPanelHeaderActionTheme}"
                                IsVisible="{TemplateBinding CanMinimize}"
                                Command="{TemplateBinding MinimizeCommand}"
                                ToolTip.Tip="Zminimalizuj">
                            <Image Width="{DynamicResource DungeonActionIconSize}"
                                   Height="{DynamicResource DungeonActionIconSize}"
                                   Source="{StaticResource DungeonIconDockBottom}" />
                        </Button>
                        <Button Name="PART_MaximizeButton"
                                Width="{DynamicResource DungeonPanelHeaderActionSize}"
                                Height="{DynamicResource DungeonPanelHeaderActionSize}"
                                Theme="{StaticResource DungeonPanelHeaderActionTheme}"
                                Command="{TemplateBinding ToggleMaximizeCommand}"
                                ToolTip.Tip="Maksymalizuj">
                            <Grid>
                                <Image Name="PART_MaximizeIcon"
                                       Width="{DynamicResource DungeonActionIconSize}"
                                       Height="{DynamicResource DungeonActionIconSize}"
                                       Source="{StaticResource DungeonIconWindowMaximize}" />
                                <Image Name="PART_RestoreIcon"
                                       Width="{DynamicResource DungeonActionIconSize}"
                                       Height="{DynamicResource DungeonActionIconSize}"
                                       Source="{StaticResource DungeonIconWindowRestore}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Header divider is redrawn above the full-height action backgrounds. -->
                    <Border Height="{DynamicResource DungeonPanelHeaderHeight}"
                            VerticalAlignment="Top"
                            BorderBrush="{DynamicResource DungeonBorderBrush}"
                            BorderThickness="0,0,0,1"
                            IsHitTestVisible="False" />

                    <!-- Draw the frame last. Child backgrounds and hover states can never cover it,
                         while hit testing remains owned by the resize grid underneath. -->
                    <Border IsHitTestVisible="False"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <!-- Brush only. Thickening the border here would change the panel's size every time focus
             moved between panels. -->
        <Style Selector="^:active">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonPanelWindowActiveBorderBrush}" />
        </Style>

        <!-- Keep the minimized panel arranged for the short exit/entry transition, but remove it
             from hit testing immediately; its deck card is the only interactive representation. -->
        <Style Selector="^:minimized">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scale(0.98) translate(0px, 8px)" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="^:maximized /template/ Grid#PART_ResizeGrid">
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ Image#PART_RestoreIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:maximized /template/ Image#PART_MaximizeIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:maximized /template/ Image#PART_RestoreIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:maximized /template/ Button#PART_MaximizeButton">
            <Setter Property="ToolTip.Tip" Value="Przywróć" />
        </Style>

        <!-- During a gesture the content must not react to the pointer sweeping across it. -->
        <Style Selector="^:dragging /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^:resizing /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
