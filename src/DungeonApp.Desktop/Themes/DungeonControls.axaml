<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls"
                    xmlns:workspace="using:DungeonApp.Desktop.Controls.Workspace">

    <!--
        Control themes for the project's own templated controls. This has to be a ResourceDictionary
        merged into Application.Resources - Themes/BuiltInControls.axaml has a <Styles> root and
        cannot hold a ControlTheme. A custom TemplatedControl inherits no implicit theme from
        FluentTheme, so without the two keyed by {x:Type ...} below, both controls would render as
        nothing at all.
    -->

    <controls:ResourceKeyToImageConverter x:Key="DungeonIconResourceConverter" />

    <!--
        Desk texture. The grid line means something now: it marks a surface things float on, so it
        belongs to the campaign desk and nowhere else. Static screens keep a flat background.
        Moved here from WorkspacePlaceholderView, which no longer draws it.
        32 is a texture period, not a scale-profile metric.
    -->
    <SolidColorBrush x:Key="DungeonWorkspaceGridLineBrush"
                     Color="{DynamicResource DungeonBorderColor}"
                     Opacity="0.12" />
    <Pen x:Key="DungeonWorkspaceGridPen"
         Brush="{StaticResource DungeonWorkspaceGridLineBrush}"
         Thickness="1" />
    <StreamGeometry x:Key="DungeonWorkspaceGridGeometry">M 0,0 L 32,0 M 0,0 L 0,32</StreamGeometry>
    <DrawingBrush x:Key="DungeonWorkspaceGridPatternBrush"
                  TileMode="Tile"
                  SourceRect="0,0,32,32"
                  DestinationRect="0,0,32,32">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="{StaticResource DungeonWorkspaceGridGeometry}"
                             Pen="{StaticResource DungeonWorkspaceGridPen}" />
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Square, borderless icon button for the panel title bar. -->
    <ControlTheme x:Key="DungeonPanelHeaderActionTheme" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource DungeonPanelHeaderActionSize}" />
        <Setter Property="Height" Value="{DynamicResource DungeonPanelHeaderActionSize}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHoverBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type workspace:WorkspaceSurface}" TargetType="workspace:WorkspaceSurface">
        <Setter Property="Background" Value="{DynamicResource DungeonBackgroundBrush}" />
        <!-- Canvas does not clip its children; without this a dragged panel paints over the
             sidebar and the status bar. -->
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <Canvas />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <!-- No padding or border on purpose: the presenter's coordinate space stays
                     identical to the control's, so pointer positions sampled against the Canvas
                     need no translation. The 16 DIP workspace padding lives in the clamp math
                     instead (WorkspaceMetrics.Padding). -->
                <Grid>
                    <Border Background="{TemplateBinding Background}" />
                    <Border Background="{StaticResource DungeonWorkspaceGridPatternBrush}"
                            IsHitTestVisible="False" />
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type workspace:PanelWindow}" TargetType="workspace:PanelWindow">
        <Setter Property="Background" Value="{DynamicResource DungeonPanelWindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonPanelWindowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonCornerRadius}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid RowDefinitions="Auto,*">
                            <Border Name="PART_TitleBar"
                                    Background="{DynamicResource DungeonPanelWindowHeaderBrush}"
                                    BorderBrush="{DynamicResource DungeonBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Height="{DynamicResource DungeonPanelHeaderHeight}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,0,0,0" ColumnSpacing="8">
                                    <Image Width="{DynamicResource DungeonActionIconSize}"
                                           Height="{DynamicResource DungeonActionIconSize}"
                                           VerticalAlignment="Center"
                                           Source="{TemplateBinding IconResourceKey, Converter={StaticResource DungeonIconResourceConverter}}" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource DungeonPanelTitleFontSize}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{TemplateBinding Title}"
                                               Text="{TemplateBinding Title}" />
                                    <Button Grid.Column="2"
                                            Name="PART_MinimizeButton"
                                            Theme="{StaticResource DungeonPanelHeaderActionTheme}"
                                            IsVisible="{TemplateBinding CanMinimize}"
                                            Command="{TemplateBinding MinimizeCommand}"
                                            ToolTip.Tip="Minimalizuj">
                                        <Image Width="{DynamicResource DungeonActionIconSize}"
                                               Height="{DynamicResource DungeonActionIconSize}"
                                               Source="{StaticResource DungeonIconMinus}" />
                                    </Button>
                                    <Button Grid.Column="3"
                                            Name="PART_CloseButton"
                                            Theme="{StaticResource DungeonPanelHeaderActionTheme}"
                                            IsVisible="{TemplateBinding CanClose}"
                                            Command="{TemplateBinding CloseCommand}"
                                            ToolTip.Tip="Zamknij">
                                        <Image Width="{DynamicResource DungeonActionIconSize}"
                                               Height="{DynamicResource DungeonActionIconSize}"
                                               Source="{StaticResource DungeonIconX}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <ContentPresenter Grid.Row="1"
                                              Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>

                    <!--
                        Resize gutters, overlaid on top of the chrome. Every grip needs an explicit
                        Transparent background: a null background is invisible to hit-testing, so
                        the grips would silently do nothing. The centre cell is left empty, so the
                        panel content underneath keeps receiving pointer input.
                    -->
                    <Grid Name="PART_ResizeGrid"
                          RowDefinitions="Auto,*,Auto"
                          ColumnDefinitions="Auto,*,Auto"
                          IsHitTestVisible="{TemplateBinding CanResize}">
                        <Border Name="PART_ResizeNW" Grid.Row="0" Grid.Column="0" ZIndex="1"
                                Width="{DynamicResource DungeonPanelResizeCornerSize}"
                                Height="{DynamicResource DungeonPanelResizeCornerSize}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                Cursor="TopLeftCorner" />
                        <Border Name="PART_ResizeN" Grid.Row="0" Grid.Column="1"
                                VerticalAlignment="Top"
                                Height="{DynamicResource DungeonPanelResizeBorderThickness}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                Cursor="TopSide" />
                        <Border Name="PART_ResizeNE" Grid.Row="0" Grid.Column="2" ZIndex="1"
                                Width="{DynamicResource DungeonPanelResizeCornerSize}"
                                Height="{DynamicResource DungeonPanelResizeCornerSize}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                Cursor="TopRightCorner" />
                        <Border Name="PART_ResizeW" Grid.Row="1" Grid.Column="0"
                                HorizontalAlignment="Left"
                                Width="{DynamicResource DungeonPanelResizeBorderThickness}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                Cursor="LeftSide" />
                        <Border Name="PART_ResizeE" Grid.Row="1" Grid.Column="2"
                                HorizontalAlignment="Right"
                                Width="{DynamicResource DungeonPanelResizeBorderThickness}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                Cursor="RightSide" />
                        <Border Name="PART_ResizeSW" Grid.Row="2" Grid.Column="0" ZIndex="1"
                                Width="{DynamicResource DungeonPanelResizeCornerSize}"
                                Height="{DynamicResource DungeonPanelResizeCornerSize}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                Cursor="BottomLeftCorner" />
                        <Border Name="PART_ResizeS" Grid.Row="2" Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Height="{DynamicResource DungeonPanelResizeBorderThickness}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                Cursor="BottomSide" />
                        <Border Name="PART_ResizeSE" Grid.Row="2" Grid.Column="2" ZIndex="1"
                                Width="{DynamicResource DungeonPanelResizeCornerSize}"
                                Height="{DynamicResource DungeonPanelResizeCornerSize}"
                                Background="{DynamicResource DungeonPanelResizeGripBrush}"
                                Cursor="BottomRightCorner" />
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Setter>

        <!-- Brush only. Thickening the border here would change the panel's size every time focus
             moved between panels. -->
        <Style Selector="^:active">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonPanelWindowActiveBorderBrush}" />
        </Style>

        <!-- An invisible container is skipped by measure and arrange, so a minimized panel costs
             the Canvas nothing while its deck card stands in for it. -->
        <Style Selector="^:minimized">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:maximized /template/ Grid#PART_ResizeGrid">
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- During a gesture the content must not react to the pointer sweeping across it. -->
        <Style Selector="^:dragging /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^:resizing /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
