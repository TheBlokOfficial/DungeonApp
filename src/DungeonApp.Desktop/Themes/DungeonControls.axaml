<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The frame's control themes, one file per control in Themes/Controls - each with its item
        container and the private parts only it uses. There is no library default theme under them:
        a templated control with no theme here does not draw at all. Templates of built-in controls
        are cut down from Avalonia 12.0.5's Fluent theme (src/Avalonia.Themes.Fluent/Controls, MIT).
        MergeResourceInclude merges the files into this one dictionary at compile time, so
        StaticResource between files resolves as it would within one file. A new file goes on this
        list; ControlThemesBuildTests fails for a file in Themes/Controls that is not on it.
    -->
    <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/Menus.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/Window.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/PopupHosts.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/ItemsControl.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/TransitioningContentControl.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/PathIcon.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/TextContextFlyouts.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/SelectableTextBlock.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/Button.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/Tile.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/RowAction.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/TextBox.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/IconField.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/NoteField.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/NumericUpDown.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/ScrollViewer.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/ListBox.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/ListRow.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/EmptyState.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/ImageFrame.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/Breadcrumbs.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/Separator.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/CheckBoxAndRadioButton.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/ToggleSwitch.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/Slider.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/ProgressBar.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/ConfirmationDialog.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/Palette.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/NotificationToast.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/FlyoutPresenter.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/ToolTip.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/ComboBox.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/DropDownPicker.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/ChipPicker.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/Tabs.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/SegmentedControl.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/Expander.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/BadgeAndWordTag.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/Chip.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/ChipOpener.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/LinkOpener.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/SortPicker.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/Table.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/StatTile.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/TrackGauge.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/FramedIconRow.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/ChangeBlot.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/TrackedValueTile.axaml" />
        <MergeResourceInclude Source="avares://DungeonApp.Desktop/Themes/Controls/SectionHeading.axaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
