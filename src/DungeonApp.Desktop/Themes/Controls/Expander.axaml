<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Expandable section (Expander). Layout and names based on Fluent Expander.xaml
        (Avalonia 12.0.5, MIT): ExpanderHeader button (ToggleButton bound to IsExpanded),
        ExpanderContent area and PART_ContentPresenter. Only downward expansion
        (ExpandDirection Down) is supported - the template does not read ExpandDirection.
        Header (DungeonExpanderHeader theme): full-width section row, minimum height
        DungeonExpanderHeaderHeight, horizontal padding 12, DungeonCornerRadius, no
        border. Left arrow DungeonIconChevronDown (DungeonActionIconSize, header text
        colour): rotated right when closed, down when open - animated rotation like the ComboBox arrow
        (DungeonMotionDuration, easing out; entry in ReducedMotion.axaml). Arrow-label gap
        DungeonSpacingSm. Label: regular text, 13, SemiBold, single line with ellipsis.
        Arrow cursor, text cannot be selected, no focus appearance.
        Header states:
          resting   - no background;
          hover     - SurfaceHover background; pressed - same as hover;
          expanded  - no separate appearance, only the arrow changes;
          disabled  - entire section (header and content) DungeonDisabledOpacity once, no pointer response.
        Content: DungeonExpanderContentPadding (aligned with the header label). On expansion,
        appears like a popup - fading in, sliding from above (Themes/ExpanderContentMotion.cs);
        height is not animated, collapse is immediate, no ContentTransition.
    -->
    <ControlTheme x:Key="DungeonExpanderHeader" TargetType="ToggleButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{DynamicResource DungeonExpanderHeaderHeight}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonPaddingMdHorizontal}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource DungeonSpacingSm}">
                        <controls:ForegroundIcon Name="PART_Chevron"
                                                 Width="{DynamicResource DungeonActionIconSize}"
                                                 Height="{DynamicResource DungeonActionIconSize}"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False"
                                                 Foreground="{TemplateBinding Foreground}"
                                                 Source="{DynamicResource DungeonIconChevronDown}" />
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Left"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextBlock.TextTrimming="CharacterEllipsis"
                                          TextBlock.TextWrapping="NoWrap"
                                          RecognizesAccessKey="True" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover:not(.hover-suppressed), ^:pressed">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHoverBrush}" />
        </Style>
        <!-- Arrow: right when closed, down when open; animated rotation - state changes immediately,
             rotation catches up. -->
        <Style Selector="^ /template/ controls|ForegroundIcon#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="{StaticResource DungeonMotionDuration}"
                                                   Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:checked /template/ controls|ForegroundIcon#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Dims only an independently disabled header; a disabled section dims everything once. -->
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource DungeonExpanderContentPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ContentTransition" Value="{x:Null}" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel MinWidth="{TemplateBinding MinWidth}"
                           MaxWidth="{TemplateBinding MaxWidth}">
                    <ToggleButton Name="ExpanderHeader"
                                  DockPanel.Dock="Top"
                                  Theme="{StaticResource DungeonExpanderHeader}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
                    <Border Name="ExpanderContent"
                            IsVisible="{TemplateBinding IsExpanded}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </DockPanel>
            </ControlTemplate>
        </Setter>

        <!-- Disabled section dims everything - header and content - once. -->
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
