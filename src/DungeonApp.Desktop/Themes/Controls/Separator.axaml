<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Line (DungeonBorderBrush): separates, does not highlight. Separator has no states - no focus
        or pointer response, so it inherits the underlying cursor.
        Variants:
          default    - horizontal, 1 px, full width, no margin (line in a list, between groups);
          .section   - horizontal, DungeonSpacingLg above and below (between card sections);
          .vertical  - vertical, 1 px, full height, no margin.
        .section spacing is Margin from DungeonPaddingLgVertical (0,16,0,16 - equal to
        DungeonSpacingLg): 16 + 1 + 16.
    -->
    <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Background" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Line" Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>

        <Style Selector="^.section">
            <Setter Property="Margin" Value="{DynamicResource DungeonPaddingLgVertical}" />
        </Style>

        <Style Selector="^.vertical">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="Width" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
