<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls"
                    xmlns:themes="using:DungeonApp.Desktop.Themes">

    <!--
        Badge (controls:Badge) and tag (controls:WordTag): two non-interactive building blocks,
        distinguished by their content. A badge carries a value (number, challenge "1/2", "+3"):
        rectangle with DungeonBadgeCornerRadius, DungeonBadgePadding, numeric DungeonMonoFont,
        12 (DungeonHelperFontSize), SemiBold. A tag carries a word (category, type, rarity): pill
        with DungeonTagCornerRadius (half its height), DungeonTagPadding, UI font size 12,
        Medium. Both: DungeonBadgeHeight, vertically centred on the line (list row 32, text
        13), width from content or container; content does not wrap - long text is trimmed
        with an ellipsis and shown in full in a tooltip (Themes/TrimmedLabelToolTip.cs). The border is always
        1 px (transparent in borderless variants) - variants do not change dimensions.
        No interaction states: no mouse response or focus, arrow cursor, text cannot be
        selected. Disabled - DungeonDisabledOpacity, unless an ancestor already dims it.
        Semantic variants (classes, shared by both):
          (none)   - neutral: badge - NeutralDim background (translucent on any surface),
                     Border border, TextRegular text;
                     tag - no background, BorderStrong border, TextRegular text;
          .accent  - AccentDim background, AccentOnDim text, no border;
          .success - SuccessDim background, Success text, no border;
          .warning - WarningDim background, Warning text, no border;
          .danger  - DangerDim background, DangerOnDim text, no border;
          .custom  - colour supplied by the view (system scales, e.g. rarity): no border,
                     background and text set directly by the view - Background and Foreground from system tokens.
    -->
    <ControlTheme x:Key="{x:Type controls:Badge}" TargetType="controls:Badge">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{DynamicResource DungeonBadgeHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource DungeonBadgePadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonBadgeCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DungeonNeutralDimBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonMonoFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonHelperFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextBlock.TextTrimming="CharacterEllipsis"
                                      TextBlock.TextWrapping="NoWrap"
                                      themes:TrimmedLabelToolTip.IsEnabled="True" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.accent">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentDimBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonAccentOnDimBrush}" />
        </Style>
        <Style Selector="^.success">
            <Setter Property="Background" Value="{DynamicResource DungeonSuccessDimBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonSuccessBrush}" />
        </Style>
        <Style Selector="^.warning">
            <Setter Property="Background" Value="{DynamicResource DungeonWarningDimBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonWarningBrush}" />
        </Style>
        <Style Selector="^.danger">
            <Setter Property="Background" Value="{DynamicResource DungeonDangerDimBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonDangerOnDimBrush}" />
        </Style>
        <Style Selector="^.custom">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:WordTag}" TargetType="controls:WordTag">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{DynamicResource DungeonBadgeHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource DungeonTagPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonTagCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- Transparent, not null: the trimmed-text tooltip needs mouse hit testing. -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonHelperFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextBlock.TextTrimming="CharacterEllipsis"
                                      TextBlock.TextWrapping="NoWrap"
                                      themes:TrimmedLabelToolTip.IsEnabled="True" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.accent">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentDimBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonAccentOnDimBrush}" />
        </Style>
        <Style Selector="^.success">
            <Setter Property="Background" Value="{DynamicResource DungeonSuccessDimBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonSuccessBrush}" />
        </Style>
        <Style Selector="^.warning">
            <Setter Property="Background" Value="{DynamicResource DungeonWarningDimBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonWarningBrush}" />
        </Style>
        <Style Selector="^.danger">
            <Setter Property="Background" Value="{DynamicResource DungeonDangerDimBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonDangerOnDimBrush}" />
        </Style>
        <Style Selector="^.custom">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
