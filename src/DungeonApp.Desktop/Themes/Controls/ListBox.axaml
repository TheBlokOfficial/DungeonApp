<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="using:DungeonApp.Desktop.Themes">

    <!--
        List (ListBox) and list row (ListBoxItem). Templates based on Fluent ListBox.xaml
        and ListBoxItem.xaml (Avalonia 12.0.5, MIT): scroll area
        (PART_ScrollViewer - scrollbar from the shell ScrollViewer theme), item presenter
        (PART_ItemsPresenter) and row content presenter (PART_ContentPresenter).
        List uses its underlying surface: transparent background, no border or
        internal padding. No separate states; no focus appearance (empty FocusAdorner).
        Row: minimum height DungeonListRowHeight - a single text line or icon does not change
        it by a pixel; only rows with several controls in their template are taller (e.g.
        campaign world). Horizontal padding DungeonSpacingMd, increased on the right by the scrollbar
        zone (DungeonScrollBarZone) - row background extends under the bar, content does not; content vertically
        centred by default,
        text on one line trimmed with an ellipsis (row template can explicitly override this), UI text size
        and weight (Normal) in every state. Highlight radius
        DungeonNavigationCornerRadius, no border. Arrow cursor.
        States:
          resting           - transparent background;
          hover             - BackstageRowHover background, including over the row action (DungeonRowAction);
          selected          - AccentDim background, including hover and pressed - selected rows have no
                               hover (clicking changes nothing; style follows hover);
          pressed           - looks hovered (unselected);
          disabled          - DungeonDisabledOpacity like any disabled control, transparent
                               background, no pointer response.
        Row focus has no appearance (empty FocusAdorner).
    -->
    <ControlTheme x:Key="{x:Type ListBox}" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="False" />
        <Setter Property="ScrollViewer.IsScrollInertiaEnabled" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="border"
                        ClipToBounds="{TemplateBinding ClipToBounds}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ScrollViewer Name="PART_ScrollViewer"
                                  VerticalSnapPointsType="{TemplateBinding (ScrollViewer.VerticalSnapPointsType)}"
                                  HorizontalSnapPointsType="{TemplateBinding (ScrollViewer.HorizontalSnapPointsType)}"
                                  HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                  VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                  IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                                  IsScrollInertiaEnabled="{TemplateBinding (ScrollViewer.IsScrollInertiaEnabled)}"
                                  IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                                  BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        Margin="{TemplateBinding Padding}" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--
        Checkbox list (ListBox with Theme="{StaticResource DungeonCheckList}", usually
        SelectionMode="Multiple,Toggle", row CheckBox bound to the row's IsSelected): only the checkbox
        indicates row state - selected rows have no AccentDim background, hover matches regular
        rows. Multiple-selection DropDownPicker rows have the same appearance - both obtain it from the
        ListBoxItem theme via themes:CheckList.IsCheckList.
    -->
    <ControlTheme x:Key="DungeonCheckList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="themes:CheckList.IsCheckList" Value="True" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonListRowHighlightCornerRadius}" />
        <Setter Property="MinHeight" Value="{DynamicResource DungeonListRowHeight}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonPaddingMdHorizontal}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Highlight inset by DungeonListRowHighlightInset at top and bottom:
                     adjacent highlights have a gap, while the row still occupies DungeonListRowHeight.
                     The outer border's transparent background catches the pointer in the gap too - hover does not
                     disappear between rows. Highlight spans the full row width, including under
                     the scrollbar; content ends before the scrollbar zone (DungeonScrollBarZone
                     added to row padding). -->
                <Border Background="Transparent">
                    <Border Name="PART_Highlight"
                            Margin="{DynamicResource DungeonListRowHighlightInset}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          TextBlock.TextTrimming="CharacterEllipsis"
                                          TextBlock.TextWrapping="NoWrap" />
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Scrollbar zone set by style, not a template value: flyout rows (ComboBoxItem,
             rows in FlyoutPresenter - BuiltInControls.axaml) override it with DungeonScrollBarZoneInFlyout. -->
        <Style Selector="^ /template/ Border#PART_Highlight">
            <Setter Property="Padding" Value="{DynamicResource DungeonScrollBarZone}" />
        </Style>
        <Style Selector="^:pointerover, ^:pressed">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowHoverBrush}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentDimBrush}" />
        </Style>
        <!-- Checkbox list (themes:CheckList.IsCheckList - DungeonCheckList theme, multiple-selection
             DropDownPicker rows): checkbox indicates state, selected row looks unselected. -->
        <Style Selector="^[(themes|CheckList.IsCheckList)=True]:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^[(themes|CheckList.IsCheckList)=True]:selected:pointerover,
                       ^[(themes|CheckList.IsCheckList)=True]:selected:pressed">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowHoverBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
