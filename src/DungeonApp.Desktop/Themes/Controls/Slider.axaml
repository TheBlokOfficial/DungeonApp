<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Slider, horizontal only. Template based on Fluent Slider.xaml (Avalonia 12.0.5, MIT):
        PART_Track with PART_DecreaseButton and PART_IncreaseButton (RepeatButton)
        and Thumb; no ticks (TickBar), DataValidationErrors, value tooltip
        or vertical template. No vertical consumer: Orientation="Vertical" receives the same
        horizontal template.
        Minimum height DungeonControlHeight (aligned with fields and buttons), width
        from container. DungeonSliderTrackThickness track, vertically centred, rounded at both
        ends: before the thumb uses Foreground (Accent), after the thumb - Background
        (InputBorder, field border colour). Thumb: DungeonSliderThumbSize circle in SliderThumb -
        neutral, muted at rest (secondary text). No ticks or displayed value - the view
        displays the value. Clicking anywhere within the control height moves the thumb
        there - Avalonia Slider handles this (no IsMoveToPointEnabled switch as in WPF);
        track parts have a transparent background at full height, so every click hits.
        Arrow cursor, no focus appearance (empty FocusAdorner), no animation.
        States - no others:
          resting  - as above;
          hover    - SliderThumbHover thumb (regular text, clearly lighter), unchanged size; pointer over the whole
                     control, because clicking anywhere moves the thumb; track unchanged;
          dragging - same as hover, even when the pointer leaves the control;
          disabled - DungeonDisabledOpacity on the whole control, no pointer response; track before the thumb
                     loses accent - muted text (TextMuted), neutral, still distinguishable
                     from the rest of the track.
    -->
    <ControlTheme x:Key="DungeonSliderTrackPart" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Border Height="{DynamicResource DungeonSliderTrackThickness}"
                            VerticalAlignment="Center"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="DungeonSliderThumb" TargetType="Thumb">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Width" Value="{DynamicResource DungeonSliderThumbSize}" />
        <Setter Property="Height" Value="{DynamicResource DungeonSliderThumbSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonSliderThumbCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource DungeonSliderThumbBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
        <Setter Property="MinHeight" Value="{DynamicResource DungeonControlHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource DungeonInputBorderBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Track Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                           Orientation="Horizontal">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_DecreaseButton"
                                          Theme="{StaticResource DungeonSliderTrackPart}"
                                          Background="{TemplateBinding Foreground}"
                                          CornerRadius="{DynamicResource DungeonSliderTrackStartCornerRadius}" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_IncreaseButton"
                                          Theme="{StaticResource DungeonSliderTrackPart}"
                                          Background="{TemplateBinding Background}"
                                          CornerRadius="{DynamicResource DungeonSliderTrackEndCornerRadius}" />
                        </Track.IncreaseButton>
                        <Thumb Name="PART_Thumb" Theme="{StaticResource DungeonSliderThumb}" />
                    </Track>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Thumb#PART_Thumb,
                       ^ /template/ Thumb#PART_Thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource DungeonSliderThumbHoverBrush}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
