<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Dropdown styled as a filter chip (controls:DropDownPicker with
        Theme="{StaticResource DungeonChipPicker}"): a filter row with a choice list for each filter.
        Same template as DropDownPicker (DropDownPicker.axaml) (popup, rows, search, opening motion,
        arrow) - the theme only sets its closed appearance from chip resources (DungeonChip,
        DungeonChipOpener): DungeonChipHeight (28, explicit),
        DungeonControlCornerRadius, DungeonChipPadding, UI font 12 Medium, border
        always 1 px, arrow in text colour, DungeonSpacingXs before it.
        Closed content follows DropDownPicker rules for both single and multiple selection: nothing
        selected - filter name (PlaceholderText, in chip text colour); one - that value (in single
        selection, clicking the selected value again deselects it - AllowsDeselect); more
        (multiple) - first selected value in list order and neutral "+N" badge, tooltip "Nazwa:
        wszystkie wybrane". Content-sized width up to DungeonTabMaxWidth (240, as for a tab) - longer
        text is trimmed with an ellipsis and a full-text tooltip (the "+N" tooltip takes precedence); the badge
        is not trimmed.
        States (as in DungeonChipOpener):
          resting          - BackstageRow background, Border border, TextRegular text and arrow;
          hover            - BorderStrong border, TextPrimary text and arrow
                             (:pointerover:not(.hover-suppressed)); pressed - same as hover;
          open             - same as hover (:dropdownopen); clicking itself closed restores rest
                             until the pointer leaves (Themes/OpenerHoverRest.cs);
          selected (:has-selection) - AccentDim background, AccentEdge border, AccentOnDim text and arrow; hover,
                             pressed and open stay unchanged;
          disabled         - DungeonDisabledOpacity, resting appearance; with a selection, loses accent (SurfaceActive
                             background, Border border, TextRegular text).
        No visible focus indicator, arrow cursor.
    -->
    <ControlTheme x:Key="DungeonChipPicker"
                  TargetType="controls:DropDownPicker"
                  BasedOn="{StaticResource {x:Type controls:DropDownPicker}}">
        <!-- Filter: nothing selected = all, so clicking the selected value again (single selection)
             deselects it and closes the popup - the chip returns to the filter name. -->
        <Setter Property="AllowsDeselect" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Height" Value="{DynamicResource DungeonChipHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource DungeonChipPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource DungeonTextRegularBrush}" />
        <Setter Property="GlyphForeground" Value="{DynamicResource DungeonTextRegularBrush}" />
        <Setter Property="GlyphSpacing" Value="{DynamicResource DungeonSpacingXs}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonHelperFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="MaxWidth" Value="{DynamicResource DungeonTabMaxWidth}" />

        <Style Selector="^:pointerover:not(.hover-suppressed), ^:pressed, ^:dropdownopen">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderStrongBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
            <Setter Property="PlaceholderForeground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
            <Setter Property="GlyphForeground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        </Style>
        <!-- Selected: identical across pointer and open states - explicit, independent of style order. -->
        <Style Selector="^:has-selection, ^:has-selection:pointerover, ^:has-selection:pressed, ^:has-selection:dropdownopen">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentDimBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonAccentEdgeBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonAccentOnDimBrush}" />
            <Setter Property="PlaceholderForeground" Value="{DynamicResource DungeonAccentOnDimBrush}" />
            <Setter Property="GlyphForeground" Value="{DynamicResource DungeonAccentOnDimBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
            <Setter Property="PlaceholderForeground" Value="{DynamicResource DungeonTextRegularBrush}" />
            <Setter Property="GlyphForeground" Value="{DynamicResource DungeonTextRegularBrush}" />
        </Style>
        <Style Selector="^:has-selection:disabled">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceActiveBrush}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
