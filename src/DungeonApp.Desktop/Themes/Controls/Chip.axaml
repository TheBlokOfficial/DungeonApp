<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="using:DungeonApp.Desktop.Themes">

    <!--
        Chip: clickable filter toggle - ToggleButton with Theme="{StaticResource DungeonChip}"
        (IsChecked - filter enabled). Compact control in a filter row: DungeonChipHeight
        (28, explicit - shorter than a 36-high button), DungeonControlCornerRadius,
        DungeonChipPadding, UI font 12 (DungeonHelperFontSize), Medium. Optional icon
        before the label - as in a button: StackPanel with ForegroundIcon (DungeonActionIconSize, chip
        text colour) and TextBlock. Single-line text, trimmed with an ellipsis
        and tooltip when too long (Themes/TrimmedLabelToolTip.cs). The border is always 1 px and visible,
        lighter than the background (checked - full accent), so state changes do not change dimensions.
        States:
          resting           - BackstageRow background, Border border, TextRegular text;
          hover             - BorderStrong border, TextPrimary text; pressed - same as hover;
          checked (:checked) - AccentDim background, AccentEdge border, AccentOnDim text; hover and pressed
                               stay unchanged;
          disabled          - DungeonDisabledOpacity unless an ancestor dims it, resting appearance;
          checked disabled  - loses accent: SurfaceActive background, Border border, TextRegular text.
        No visible focus indicator (empty FocusAdorner), arrow cursor, no arrow or choice list.
    -->
    <ControlTheme x:Key="DungeonChip" TargetType="ToggleButton">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{DynamicResource DungeonChipHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource DungeonChipPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonHelperFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextBlock.TextTrimming="CharacterEllipsis"
                                      TextBlock.TextWrapping="NoWrap"
                                      RecognizesAccessKey="True"
                                      themes:TrimmedLabelToolTip.IsEnabled="True" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover:not(.hover-suppressed), ^:pressed">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderStrongBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        </Style>
        <!-- Checked: identical across pointer states - explicit, independent of style order. -->
        <Style Selector="^:checked, ^:checked:pointerover, ^:checked:pressed">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentDimBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonAccentEdgeBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonAccentOnDimBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
        </Style>
        <Style Selector="^:checked:disabled">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceActiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
