<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls"
                    xmlns:themes="using:DungeonApp.Desktop.Themes">

    <!--
        Card table (controls:Table - Grid, each item is a controls:TableCell).
        1 px outer border and horizontal row lines in Border colour; vertical column
        lines controlled by ShowColumnLines (off by default). Table sets each cell's border thickness
        from its position (Controls/Table.cs), so each line is drawn once. Square corners.
        Cell: minimum height DungeonTableCellMinHeight, DungeonTableCellPadding,
        content vertically centred, horizontal alignment per cell (HorizontalContentAlignment, left
        by default); regular text 13 in UI font, single line - long text trimmed with an
        ellipsis and tooltip (Themes/TrimmedLabelToolTip.cs). Unhighlighted background is
        transparent (card beneath); highlight - Background supplied by the view (system
        colours), fills the cell up to its lines.
        Cell classes:
          .header - header row: TableHeader background, TextRegular 12, SemiBold;
          .mono   - numbers in DungeonMonoFont.
        Non-interactive: no hover, selection or focus, arrow cursor, text cannot be
        selected. Disabled - DungeonDisabledOpacity once on the whole table (outermost disabled).
    -->
    <ControlTheme x:Key="{x:Type controls:Table}" TargetType="controls:Table">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Focusable" Value="False" />
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:TableCell}" TargetType="controls:TableCell">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{DynamicResource DungeonTableCellMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonTableCellPadding}" />
        <!-- Transparent, not null: the trimmed-text tooltip needs mouse hit testing. -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- InnerBorderEdge: a highlight never lies under the cell's own lines, so at a
                     fractional display scale an antialiased line does not blend into the highlight
                     and every line keeps the same color over highlighted and plain cells. -->
                <Border Background="{TemplateBinding Background}"
                        BackgroundSizing="InnerBorderEdge"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextBlock.TextTrimming="CharacterEllipsis"
                                      TextBlock.TextWrapping="NoWrap"
                                      themes:TrimmedLabelToolTip.IsEnabled="True" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.header">
            <Setter Property="Background" Value="{DynamicResource DungeonTableHeaderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource DungeonHelperFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="^.mono">
            <Setter Property="FontFamily" Value="{DynamicResource DungeonMonoFont}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
