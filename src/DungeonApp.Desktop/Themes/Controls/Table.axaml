<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls"
                    xmlns:themes="using:DungeonApp.Desktop.Themes">

    <!--
        Tabela w karcie (controls:Table - siatka Grid, każda pozycja to controls:TableCell).
        Obramowanie zewnętrzne 1 px i linie poziome między wierszami w kolorze Border; linie pionowe
        między kolumnami - ShowColumnLines (domyślnie bez). Grubość krawędzi każdej komórki ustala
        tabela z jej położenia (Controls/Table.cs), więc każda linia leży raz. Ostre narożniki.
        Komórka: wysokość najmniej DungeonTableCellMinHeight, wcięcie DungeonTableCellPadding,
        treść na środku w pionie, wyrównanie poziome per komórka (HorizontalContentAlignment, domyślnie
        z lewej); tekst podstawowy 13 pismem interfejsu, w jednej linii - zbyt długi przycina się
        wielokropkiem z podpowiedzią (Themes/TrimmedLabelToolTip.cs). Tło bez wyróżnienia
        przezroczyste (karta pod spodem); wyróżnienie - Background podany przez układającego (kolory
        systemu), wypełnia komórkę do linii.
        Klasy komórki:
          .header - wiersz nagłówka: tło TableHeader, tekst TextRegular 12, SemiBold;
          .mono   - liczby krojem DungeonMonoFont.
        Nieinteraktywna: bez najechania i zaznaczania, bez fokusu, kursor strzałka, tekst się nie
        zaznacza. Wyłączona - DungeonDisabledOpacity raz na całej tabeli (najwyższa wyłączona).
    -->
    <ControlTheme x:Key="{x:Type controls:Table}" TargetType="controls:Table">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Focusable" Value="False" />
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:TableCell}" TargetType="controls:TableCell">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{DynamicResource DungeonTableCellMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonTableCellPadding}" />
        <!-- Przezroczyste, nie puste: podpowiedź przyciętego napisu potrzebuje trafienia myszą. -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextBlock.TextTrimming="CharacterEllipsis"
                                      TextBlock.TextWrapping="NoWrap"
                                      themes:TrimmedLabelToolTip.IsEnabled="True" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.header">
            <Setter Property="Background" Value="{DynamicResource DungeonTableHeaderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource DungeonHelperFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="^.mono">
            <Setter Property="FontFamily" Value="{DynamicResource DungeonMonoFont}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
