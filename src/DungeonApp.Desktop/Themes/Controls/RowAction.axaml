<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        List-row action: Button with Theme="{StaticResource DungeonRowAction}" - e.g. trash at the end
        of a row. View supplies content (glyph, e.g. ForegroundIcon). Separate theme, not a button variant:
        does not inherit fixed button height (DungeonControlHeight).
        Hit area is the entire strip at the row end: DungeonListRowHeight-wide column
        (list-row square), full row height, transparent background for pointer hit testing.
        Dimensions for shell list rows (ListBoxItem, ListRow): minimum height DungeonListRowHeight
        (grows with taller records - VerticalAlignment Stretch), while
        DungeonListRowActionMargin extends the strip through the highlight gap and right row padding
        to the end of row content (before the scrollbar zone). Differently structured rows (custom
        Border in the view) override Margin through a view style.
        Glyph only, no background, border, radius or halo; no tooltip (the common
        symbol speaks for itself). Always visible.
        States:
          resting  - TextMuted glyph (like row date and arrow);
          hover    - DangerText glyph (semantic colour: action deletes), no background; pressed matches
                     hover. Action belongs to the row: the row beneath it stays highlighted;
          disabled - DungeonDisabledOpacity.
        No animation. No focus appearance, arrow cursor.
        Resting glyph contrast (TextMuted #8A8983, icon - 3:1 threshold): 4.8:1 on a card (resting
        ListBoxItem), 4.7:1 on a row (BackstageRow), 4.3:1 on a hovered row
        (BackstageRowHover), 3.8:1 on a selected row (AccentDim on a card, #382E1F).
    -->
    <ControlTheme x:Key="DungeonRowAction" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource DungeonListRowHeight}" />
        <Setter Property="Margin" Value="{DynamicResource DungeonListRowActionMargin}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="{DynamicResource DungeonListRowHeight}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover, ^:pressed">
            <Setter Property="Foreground" Value="{DynamicResource DungeonDangerTextBrush}" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
