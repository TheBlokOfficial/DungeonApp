<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Akcja w wierszu listy: Button z Theme="{StaticResource DungeonRowAction}" - np. kosz na końcu
        wiersza. Treść (rysunek, np. ForegroundIcon) daje widok. Osobny motyw, nie odmiana przycisku:
        nie dziedziczy stałej wysokości przycisku (DungeonControlHeight).
        Obszar trafienia to cały pas na końcu wiersza: kolumna szerokości DungeonListRowHeight
        (kwadrat wiersza listy), pełnej wysokości wiersza, tło przezroczyste do trafiania myszą.
        Wymiary dla wiersza listy ramy (ListBoxItem, ListRow): wysokość najmniej DungeonListRowHeight
        (w wyższym rekordzie pas rośnie z nim - VerticalAlignment Stretch), a margines
        DungeonListRowActionMargin wyprowadza pas przez odstęp podświetlenia i prawe wcięcie wiersza
        do końca treści wiersza (przed strefą paska przewijania). Wiersz o innej budowie (własny
        Border w widoku) nadpisuje Margin stylem widoku.
        Sam rysunek, bez tła, bez krawędzi, bez zaokrąglenia i bez otoczki; bez podpowiedzi (znak
        powszechny mówi sam). Widoczna zawsze.
        Stany:
          spoczynek   - rysunek TextMuted (jak data i strzałka w wierszu);
          najechanie  - rysunek DangerText (barwa znaczenia: akcja usuwa), bez tła; wciśnięcie jak
                        najechanie. Akcja należy do wiersza: wiersz pod nią zostaje podświetlony;
          wyłączenie  - DungeonDisabledOpacity.
        Bez animacji. Fokus bez wyglądu, kursor strzałka.
        Kontrast rysunku w spoczynku (TextMuted #8A8983, ikona - próg 3:1): 4,8:1 na karcie (wiersz
        ListBoxItem w spoczynku), 4,7:1 na wierszu (BackstageRow), 4,3:1 na wierszu pod myszą
        (BackstageRowHover), 3,8:1 na wybranym wierszu (AccentDim na karcie, #382E1F).
    -->
    <ControlTheme x:Key="DungeonRowAction" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource DungeonListRowHeight}" />
        <Setter Property="Margin" Value="{DynamicResource DungeonListRowActionMargin}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="{DynamicResource DungeonListRowHeight}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover, ^:pressed">
            <Setter Property="Foreground" Value="{DynamicResource DungeonDangerTextBrush}" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
