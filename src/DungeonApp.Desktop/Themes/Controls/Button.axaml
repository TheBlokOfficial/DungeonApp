<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="using:DungeonApp.Desktop.Themes">

    <!--
        Button: one theme, variants as classes. States: resting, hover (:pointerover),
        pressed (:pressed), disabled (:disabled - DungeonDisabledOpacity for every variant).
        Disabled opacity in this and all other shell themes uses :disabled, but only
        on the outermost disabled control (^:disabled:not(:disabled :disabled)) - this also dims
        command-disabled buttons (CanExecute false) whose IsEnabled stays true. Disabled-state
        colours use plain :disabled: a control inside a disabled container (tab, expander)
        dims once - through its container - but still loses its accent.
        A button filled with a semantic colour (.primary, .danger) keeps its fill on hover:
        it gains a halo - a 3 px band outside the border, without blur, matching the button radius
        (background Border BoxShadow, DungeonAccentHoverHaloShadow / DungeonDangerHoverHaloShadow).
        The halo extends beyond the button: a clipping parent needs a 3 px gap.
        Disabled buttons have no halo.
        Disabled filled buttons (.primary, .danger) are neutral: regular background, border and text
        - disabled carries neither "primary action" nor "destruction" meaning because it does nothing.
        Pressed has no separate appearance in any variant: every hover style also covers
        :pressed, so a pressed button looks exactly as on hover - including keyboard presses
        or when the pointer leaves a pressed button. A button with an open flyout (:flyout-open)
        also looks hovered in every variant - interaction continues while the flyout is open,
        even when the pointer is over the flyout. Clicking the button to close the flyout leaves it
        resting until the pointer leaves (.hover-suppressed, Themes/OpenerHoverRest.cs;
        same in ComboBox and DropDownPicker). Nothing dims or shrinks the content
        (RenderTransform and Transitions cleared).
        No separate focus appearance (empty FocusAdorner). Arrow cursor for every variant,
        including links - hover indicates clickability.
        Variants:
          (none)   - regular: SurfaceHeader background, Border border, TextPrimary text;
          .primary - primary: Accent background, OnAccent text, transparent border;
          .subtle  - subtle: no background, transparent border; hovered, pressed and with an open flyout
                     uses HoverOverlay (translucent light overlay - visible on any surface);
          .danger  - destructive: Danger background, TextPrimary text, transparent border;
          .link    - standalone link (command outside a sentence): no background or border, content-sized
                     height, TextRegular without underline; hover uses TextPrimary
                     and underline; its icon uses text colour (ForegroundIcon);
          .link.inline - link in a sentence (in TextBlock's InlineUIContainer): size and weight
                     of the surrounding TextBlock, Accent text, permanent underline - accent colour alone
                     next to light text does not give 3:1 contrast; hover uses AccentTextHover
                     (lighter accent), keeping the underline; the InlineUIContainer style in
                     BuiltInControls.axaml aligns it with the sentence baseline;
          .icon    - icon button, combines with other variants: DungeonControlHeight square, centred
                     content (DungeonActionIconSize icon sets its own size).
        Border is always 1 px (transparent in borderless variants), so changing variants or
        states does not change size. Theme or container sets height and width, not content:
        text is trimmed with an ellipsis.
        Style order matters: a variant and its states follow regular states to
        override them.
    -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{DynamicResource DungeonControlHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <!-- Avalonia buttons clip to their bounds by default, cutting the hover halo
             (background Border BoxShadow, 3 px outside) to a barely visible edge. Content still fits
             inside the button: ContentPresenter trims text with an ellipsis. -->
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextBlock.TextTrimming="CharacterEllipsis"
                                      TextBlock.TextWrapping="NoWrap"
                                      RecognizesAccessKey="True"
                                      themes:TrimmedLabelToolTip.IsEnabled="True" />
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Regular -->
        <Style Selector="^:pointerover:not(.hover-suppressed), ^:pressed, ^:flyout-open">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceActiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderStrongBrush}" />
        </Style>

        <!-- Primary -->
        <Style Selector="^.primary">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonOnAccentBrush}" />
        </Style>
        <!-- Hover fill and border explicitly match rest - independent of the variant
             style following regular states. -->
        <Style Selector="^.primary:pointerover:not(.hover-suppressed), ^.primary:pressed, ^.primary:flyout-open">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^.primary:not(:disabled):pointerover:not(.hover-suppressed) /template/ Border#PART_Background,
                       ^.primary:not(:disabled):pressed /template/ Border#PART_Background,
                       ^.primary:not(:disabled):flyout-open /template/ Border#PART_Background">
            <Setter Property="BoxShadow" Value="{DynamicResource DungeonAccentHoverHaloShadow}" />
        </Style>

        <!-- Subtle -->
        <Style Selector="^.subtle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^.subtle:pointerover:not(.hover-suppressed), ^.subtle:pressed, ^.subtle:flyout-open">
            <Setter Property="Background" Value="{DynamicResource DungeonHoverOverlayBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Destructive -->
        <Style Selector="^.danger">
            <Setter Property="Background" Value="{DynamicResource DungeonDangerBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <!-- Hover fill and border explicitly match rest - independent of the variant
             style following regular states. -->
        <Style Selector="^.danger:pointerover:not(.hover-suppressed), ^.danger:pressed, ^.danger:flyout-open">
            <Setter Property="Background" Value="{DynamicResource DungeonDangerBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^.danger:not(:disabled):pointerover:not(.hover-suppressed) /template/ Border#PART_Background,
                       ^.danger:not(:disabled):pressed /template/ Border#PART_Background,
                       ^.danger:not(:disabled):flyout-open /template/ Border#PART_Background">
            <Setter Property="BoxShadow" Value="{DynamicResource DungeonDangerHoverHaloShadow}" />
        </Style>

        <!-- Link: no border (even transparent), because it sits on a text line. -->
        <Style Selector="^.link">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
        </Style>
        <Style Selector="^.link:pointerover:not(.hover-suppressed), ^.link:pressed, ^.link:flyout-open">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        </Style>
        <!-- Content text inherits the underline through ContentPresenter. -->
        <Style Selector="^.link:pointerover:not(.hover-suppressed) /template/ ContentPresenter#PART_ContentPresenter,
                       ^.link:pressed /template/ ContentPresenter#PART_ContentPresenter,
                       ^.link:flyout-open /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>

        <!-- Inline link: size and weight come from the TextBlock containing its line; Accent colour
             and permanent underline. Hover (pressed, open flyout) lightens the colour
             (AccentTextHover) - the underline is constant, so colour alone indicates hover; dimensions unchanged. -->
        <Style Selector="^.link.inline">
            <Setter Property="Foreground" Value="{DynamicResource DungeonAccentBrush}" />
        </Style>
        <Style Selector="^.link.inline:pointerover:not(.hover-suppressed), ^.link.inline:pressed, ^.link.inline:flyout-open">
            <Setter Property="Foreground" Value="{DynamicResource DungeonAccentTextHoverBrush}" />
        </Style>
        <Style Selector="^.link.inline">
            <Setter Property="FontSize" Value="{Binding $parent[TextBlock].FontSize}" />
            <Setter Property="FontWeight" Value="{Binding $parent[TextBlock].FontWeight}" />
        </Style>
        <Style Selector="^.link.inline /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>

        <!-- Icon button -->
        <Style Selector="^.icon">
            <Setter Property="Width" Value="{DynamicResource DungeonControlHeight}" />
            <Setter Property="Height" Value="{DynamicResource DungeonControlHeight}" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Disabled primary and destructive buttons look like disabled regular buttons. -->
        <Style Selector="^.primary:disabled, ^.danger:disabled">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        </Style>

        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
