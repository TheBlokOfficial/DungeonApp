<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        CheckBox and RadioButton. Templates based on Fluent CheckBox.xaml
        and RadioButton.xaml (Avalonia 12.0.5, MIT): marker and label presenter
        (PART_ContentPresenter), with appearance and states defined by tokens.
        Layout: marker (DungeonChoiceMarkSize square or circle) on the left, label (Content) on
        the right with DungeonSpacingSm between them. Minimum height DungeonControlHeight aligns
        the control with fields and buttons; the marker is centred on the first label line
        (DungeonChoiceLabelPadding), long labels wrap downwards while the marker
        stays by the first line. Without a label, only the marker occupies the control height.
        The entire element including the label is clickable (transparent background, not null). Arrow cursor.
        Control properties style the marker: Background - fill, BorderBrush - border
        (always 1 px, so states do not shift layout), Foreground - label colour.
        States - no others:
          resting           - InputBackground fill, InputBorder border;
          hover             - (unchecked) InputHoverBorder border;
          checked           - Accent fill and border; OnAccent glyph: checkmark (checkbox),
                               DungeonRadioDotSize dot (radio button); hover stays
                               unchanged - no halo or colour change;
          indeterminate     - (IsThreeState) same as checked, glyph: horizontal line;
          pressed           - same as hover (checked - same as checked);
          disabled          - DungeonDisabledOpacity on the whole control, no pointer response; checked
                               loses accent like a disabled primary button: neutral marker (Input fill
                               and border), glyph in regular text colour.
        Checkmark and line are outlined, like shell icons: DungeonChoiceGlyphThickness stroke, rounded
        caps and joins. No separate focus appearance (empty FocusAdorner); no transition animations.
    -->
    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="MinHeight" Value="{DynamicResource DungeonControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonChoiceLabelPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonCheckBoxCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Name="PART_Root" Background="Transparent" ColumnDefinitions="Auto,*">
                    <Panel Height="{DynamicResource DungeonControlHeight}" VerticalAlignment="Top">
                        <Border Name="PART_Mark"
                                Width="{DynamicResource DungeonChoiceMarkSize}"
                                Height="{DynamicResource DungeonChoiceMarkSize}"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Panel>
                                <!-- Checkmark and line in the marker's 16 x 16 coordinates (1 px border
                                     subtracted: 14 x 14 drawing offset by -1). -->
                                <Path Name="PART_CheckGlyph"
                                      IsVisible="False"
                                      Data="M3.5,7.5 L6,10 L10.5,4.5"
                                      Stroke="{DynamicResource DungeonOnAccentBrush}"
                                      StrokeThickness="{DynamicResource DungeonChoiceGlyphThickness}"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                                <Path Name="PART_IndeterminateGlyph"
                                      IsVisible="False"
                                      Data="M3.5,7 L10.5,7"
                                      Stroke="{DynamicResource DungeonOnAccentBrush}"
                                      StrokeThickness="{DynamicResource DungeonChoiceGlyphThickness}"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                            </Panel>
                        </Border>
                    </Panel>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{TemplateBinding Foreground}"
                                      TextWrapping="Wrap"
                                      RecognizesAccessKey="True" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <!-- Without a label: marker only, no label spacing. -->
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter:empty">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="^:pointerover, ^:pressed">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputHoverBorderBrush}" />
        </Style>

        <!-- Checked and indeterminate - unchanged on hover (style follows the hover style). -->
        <Style Selector="^:checked, ^:indeterminate">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonAccentBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Path#PART_CheckGlyph">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:indeterminate /template/ Path#PART_IndeterminateGlyph">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Disabled: no accent - neutral marker, glyph in regular text colour. -->
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
        <Style Selector="^:disabled /template/ Path">
            <Setter Property="Stroke" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="MinHeight" Value="{DynamicResource DungeonControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonChoiceLabelPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonRadioButtonCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Name="PART_Root" Background="Transparent" ColumnDefinitions="Auto,*">
                    <Panel Height="{DynamicResource DungeonControlHeight}" VerticalAlignment="Top">
                        <Border Name="PART_Mark"
                                Width="{DynamicResource DungeonChoiceMarkSize}"
                                Height="{DynamicResource DungeonChoiceMarkSize}"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Ellipse Name="PART_Dot"
                                     IsVisible="False"
                                     Width="{DynamicResource DungeonRadioDotSize}"
                                     Height="{DynamicResource DungeonRadioDotSize}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource DungeonOnAccentBrush}" />
                        </Border>
                    </Panel>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{TemplateBinding Foreground}"
                                      TextWrapping="Wrap"
                                      RecognizesAccessKey="True" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter:empty">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="^:pointerover, ^:pressed">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputHoverBorderBrush}" />
        </Style>

        <Style Selector="^:checked">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonAccentBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#PART_Dot">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
        <Style Selector="^:disabled /template/ Ellipse#PART_Dot">
            <Setter Property="Fill" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
