<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Flyout (FlyoutPresenter - Flyout content). Template based on Fluent FlyoutPresenter.xaml
        (Avalonia 12.0.5, MIT): border, scroll area and content presenter
        (PART_ContentPresenter), with appearance defined by tokens.
        Field-like surface: InputBackground fill, 1 px InputBorder, DungeonFlyoutCornerRadius;
        DungeonFlyoutPadding inside keeps list rows away from
        the edges; subtle DungeonFlyoutShadow.
        Maximum height DungeonFlyoutMaxHeight - longer content scrolls
        inside with the shell scrollbar (ScrollViewer theme), shown only when needed. Content-sized width.
        No states: no focus or focus appearance. Animated opening, immediate closing
        (Themes/PopupOpenMotion.cs).
        Clicking outside or pressing Escape closes it through Flyout behaviour.
        Placement: below the opener, left-aligned - the usage site
        sets Flyout Placement="BottomEdgeAlignedLeft" (Flyout is not a control and has no theme);
        when there is no space below, the popup flips above the element. Gap from the element uses
        transparent DungeonFlyoutMargin above and below the surface (this theme's Margin), not
        VerticalOffset - the offset always moves down, so an upward popup would overlap
        the opener; the margin is symmetric and works in both directions.
    -->
    <ControlTheme x:Key="{x:Type FlyoutPresenter}" TargetType="FlyoutPresenter">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonFlyoutCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonFlyoutPadding}" />
        <Setter Property="Margin" Value="{DynamicResource DungeonFlyoutMargin}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MaxHeight" Value="{DynamicResource DungeonFlyoutMaxHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="LayoutRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource DungeonFlyoutShadow}"
                        ClipToBounds="True">
                    <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                  VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
        <!-- .list-host (Flyout FlyoutPresenterClasses="list-host"): content is a self-scrolling list
             - the flyout does not scroll, leaving a single scrollbar zone beside the list. The list
             receives a finite height (DungeonFlyoutMaxHeight). The flyout has no padding of its own -
             the list carries padding inside its scrollable content ("FlyoutPresenter.list-host > ListBox"
             style in BuiltInControls.axaml), so its scroll area reaches the flyout edge and the scrollbar
             sits as in every other flyout (DungeonScrollBarInset from the side, top and bottom). -->
        <Style Selector="^.list-host">
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
