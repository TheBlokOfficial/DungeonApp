<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ToggleSwitch. Template based on Fluent ToggleSwitch.xaml (Avalonia 12.0.5, MIT):
        parts used by the control to move the knob - PART_SwitchKnob (Canvas, knob slot) and
        PART_MovingKnobs (moving element, also dragged) - and label presenter
        (PART_ContentPresenter). No "On/Off" text (empty OnContent/OffContent, no
        presenters) or header above the track: label (Content) sits to the right of the track, like a
        checkbox - same layout, minimum height DungeonControlHeight, track centred
        on the first label line, long labels wrap downwards.
        Track DungeonToggleTrackWidth x DungeonToggleTrackHeight, fully rounded; knob
        DungeonToggleKnobSize in a knob slot (square with side equal to track height). The control places the
        knob slot at Canvas.Left = 0 or slot width, so the track is two slots wide - as in Fluent.
        Toggling: knob moves and track fill transitions to accent (and back) in the same
        motion - DungeonMotionDuration, easing out; track border and knob colour change
        immediately (border also indicates hover). State changes immediately, motion catches up.
        The entire element including the label is clickable,
        arrow cursor.
        Control properties style the track: Background - fill, BorderBrush - border
        (always 1 px); knob colour comes from the state style.
        States - no others:
          off (resting) - track: InputBackground fill, InputBorder; knob on the left,
                          TextMuted;
          hover         - (off) InputHoverBorder, TextRegular knob - lighter;
          on            - track: Accent fill and border; knob on the right, OnAccent; hover
                          unchanged - no halo or colour change;
          pressed       - looks hovered (on - same as on);
          disabled      - DungeonDisabledOpacity on everything, no pointer response; on
                          loses accent: neutral track, right-hand knob in regular
                          text colour.
        No separate focus appearance (empty FocusAdorner).
    -->
    <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="MinHeight" Value="{DynamicResource DungeonControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonChoiceLabelPadding}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <!-- Knob moves (knob slot Canvas.Left), DungeonMotionDuration with easing out. -->
        <Setter Property="KnobTransitions">
            <Transitions>
                <DoubleTransition Property="Canvas.Left"
                                  Duration="{StaticResource DungeonMotionDuration}"
                                  Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="OnContent" Value="{x:Null}" />
        <Setter Property="OffContent" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Name="PART_Root" Background="Transparent" ColumnDefinitions="Auto,*">
                    <Panel Height="{DynamicResource DungeonControlHeight}" VerticalAlignment="Top">
                        <Grid Width="{DynamicResource DungeonToggleTrackWidth}"
                              Height="{DynamicResource DungeonToggleTrackHeight}"
                              VerticalAlignment="Center">
                            <Border Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource DungeonToggleTrackCornerRadius}" />
                            <Canvas Name="PART_SwitchKnob"
                                    Width="{DynamicResource DungeonToggleTrackHeight}"
                                    Height="{DynamicResource DungeonToggleTrackHeight}"
                                    HorizontalAlignment="Left">
                                <Grid Name="PART_MovingKnobs"
                                      Width="{DynamicResource DungeonToggleTrackHeight}"
                                      Height="{DynamicResource DungeonToggleTrackHeight}">
                                    <Ellipse Name="PART_Knob"
                                             Width="{DynamicResource DungeonToggleKnobSize}"
                                             Height="{DynamicResource DungeonToggleKnobSize}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource DungeonTextMutedBrush}" />
                                </Grid>
                            </Canvas>
                        </Grid>
                    </Panel>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{TemplateBinding Foreground}"
                                      TextWrapping="Wrap"
                                      RecognizesAccessKey="True" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter:empty">
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Track fill transitions to accent in the same motion as the knob - part of the knob movement.
             Track border changes immediately: also indicates hover, which has no motion. -->
        <Style Selector="^ /template/ Border#PART_Track">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background"
                                     Duration="{StaticResource DungeonMotionDuration}"
                                     Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^:pointerover, ^:pressed">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputHoverBorderBrush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Ellipse#PART_Knob,
                       ^:pressed /template/ Ellipse#PART_Knob">
            <Setter Property="Fill" Value="{DynamicResource DungeonTextRegularBrush}" />
        </Style>

        <!-- On - unchanged on hover (styles follow hover). -->
        <Style Selector="^:checked">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonAccentBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#PART_Knob">
            <Setter Property="Fill" Value="{DynamicResource DungeonOnAccentBrush}" />
        </Style>

        <!-- Disabled control: no accent - neutral track; on-state knob in regular text
             colour, off-state knob as at rest. -->
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
        <Style Selector="^:disabled /template/ Ellipse#PART_Knob">
            <Setter Property="Fill" Value="{DynamicResource DungeonTextMutedBrush}" />
        </Style>
        <Style Selector="^:disabled:checked /template/ Ellipse#PART_Knob">
            <Setter Property="Fill" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
