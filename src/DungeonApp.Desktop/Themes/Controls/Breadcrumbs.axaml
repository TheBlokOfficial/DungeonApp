<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Breadcrumbs (controls:Breadcrumbs): single-line path of the displayed content, size
        DungeonHelperFontSize (12), UI font. Ancestors (all segments except the last) -
        muted text; last, current segment - secondary text.
        Right arrow DungeonIconChevronRight between segments, DungeonBreadcrumbSeparatorSize,
        muted text colour, DungeonSpacingXs on both sides.
        Limited space: current segment stays complete, ancestors trim with an ellipsis
        (short segments retain their full width, longer ones share the remainder equally); when even
        arrows do not fit beside the current segment, ancestors disappear before the current segment trims.
        No states: segments are not clickable (no navigation target), no focus,
        no pointer response (inherits the underlying cursor); text cannot be selected.
    -->
    <ControlTheme x:Key="{x:Type controls:Breadcrumbs}" TargetType="controls:Breadcrumbs">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        <Setter Property="CurrentForeground" Value="{DynamicResource DungeonTextRegularBrush}" />
        <Setter Property="SeparatorForeground" Value="{DynamicResource DungeonTextMutedBrush}" />
        <Setter Property="SeparatorIcon" Value="{DynamicResource DungeonIconChevronRight}" />
        <Setter Property="SeparatorSize" Value="{DynamicResource DungeonBreadcrumbSeparatorSize}" />
        <Setter Property="Spacing" Value="{DynamicResource DungeonSpacingXs}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonHelperFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <ControlTemplate>
                <controls:BreadcrumbsPanel Name="PART_Panel"
                                           Spacing="{TemplateBinding Spacing}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
