<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls"
                    xmlns:themes="using:DungeonApp.Desktop.Themes">

    <!--
        Tabs: strip with content (TabControl + TabItem) and strip alone (TabStrip + TabStripItem).
        Part names from Fluent TabControl.xaml, TabItem.xaml, TabStrip.xaml
        and TabStripItem.xaml (Avalonia 12.0.5, MIT): PART_ItemsPresenter,
        PART_SelectedContentHost (and PART_SelectedContentHost2 - second presenter used by the control
        for page transitions; hidden here, no transition), PART_LayoutRoot,
        PART_ContentPresenter. No selection stripe (PART_SelectedPipe) - background
        indicates the selected tab.
        Tab (TabItem and TabStripItem look identical - shared DungeonTabHeaderBase):
        DungeonTabHeight, DungeonTabPadding, DungeonCornerRadius, no
        border, UI font 13. Label-sized width up to DungeonTabMaxWidth; longer labels
        trim with an ellipsis and show full text in a tooltip (Themes/TrimmedLabelToolTip.cs).
        Width reserves bold text (controls:BoldTextReserve), so selection does not change
        tab width. Arrow cursor, text cannot be selected,
        no focus appearance (empty FocusAdorner), no transitions - selection changes colour immediately.
        States:
          resting   - no background, TextRegular text;
          hover     - SurfaceHover background, TextPrimary text;
          pressed   - same as hover;
          selected  - AccentDim background, AccentOnDim text, SemiBold; unchanged on hover (style
                      follows hover);
          disabled  - DungeonDisabledOpacity (only independently disabled tabs - disabled
                      strip or TabControl dims everything once), no background,
                      TextRegular text, no pointer response; selected disabled loses accent: neutral InputBackground
                      (like the marker of a disabled checked checkbox),
                      TextRegular text, SemiBold retained.
        Strip: left-aligned, wraps to a new line (WrapPanel), DungeonSpacingXs horizontally
        and between lines. No background or border.
        TabControl: strip at the top, selected tab content below with DungeonSpacingLg gap (no
        tabs - no strip or gap); content area has no background or border. Disabled TabControl
        dims everything once. Only top strip placement (TabStripPlacement
        Top) is supported - template does not read TabStripPlacement.
    -->
    <ControlTheme x:Key="DungeonTabHeaderBase" TargetType="ContentControl">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{DynamicResource DungeonTabHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource DungeonTabPadding}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="MaxWidth" Value="{DynamicResource DungeonTabMaxWidth}" />

        <Style Selector="^:pointerover:not(.hover-suppressed), ^:pressed">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentDimBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonAccentOnDimBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
        </Style>
        <Style Selector="^:disabled:selected">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceActiveBrush}" />
        </Style>
        <!-- Only independently disabled tabs (IsEnabled="False") dim themselves; tabs in a disabled strip
             are also :disabled, but the whole strip dims them once - no double dimming. -->
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type TabItem}"
                  TargetType="TabItem"
                  BasedOn="{StaticResource DungeonTabHeaderBase}">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_LayoutRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Panel HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <controls:BoldTextReserve Label="{TemplateBinding Header}" />
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          TextBlock.TextTrimming="CharacterEllipsis"
                                          TextBlock.TextWrapping="NoWrap"
                                          themes:TrimmedLabelToolTip.IsEnabled="True" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type TabStripItem}"
                  TargetType="TabStripItem"
                  BasedOn="{StaticResource DungeonTabHeaderBase}">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_LayoutRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Panel HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <controls:BoldTextReserve Label="{TemplateBinding Content}" />
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextBlock.TextTrimming="CharacterEllipsis"
                                          TextBlock.TextWrapping="NoWrap"
                                          themes:TrimmedLabelToolTip.IsEnabled="True" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type TabStrip}" TargetType="TabStrip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"
                           ItemSpacing="{DynamicResource DungeonSpacingXs}"
                           LineSpacing="{DynamicResource DungeonSpacingXs}" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="PageTransition" Value="{x:Null}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"
                           ItemSpacing="{DynamicResource DungeonSpacingXs}"
                           LineSpacing="{DynamicResource DungeonSpacingXs}" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <DockPanel>
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        DockPanel.Dock="Top"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                        <Panel Name="PART_TabStripSpacing"
                               DockPanel.Dock="Top"
                               Height="{DynamicResource DungeonSpacingLg}" />
                        <Panel>
                            <ContentPresenter Name="PART_SelectedContentHost2"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              IsVisible="False" />
                            <ContentPresenter Name="PART_SelectedContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Panel>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- With no tabs, the strip takes no space: the gap above content disappears too. -->
        <Style Selector="^:empty /template/ Panel#PART_TabStripSpacing">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Disabled TabControl dims everything - strip and content - once; tabs inside do not
             dim again (only the outermost disabled control dims). -->
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
