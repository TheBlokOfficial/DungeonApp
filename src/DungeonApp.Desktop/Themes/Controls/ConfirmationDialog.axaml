<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Confirmation dialog (controls:ConfirmationDialog) - invocation and behaviour in Controls/ConfirmationDialog.cs.
        DungeonScrimBrush covers the entire window (controls:WindowOverlay layer); clicking it
        does nothing. Centred card: flyout surface (DungeonBackstageCardBrush,
        1 px InputBorder, DungeonFlyoutShadow, DungeonFlyoutCornerRadius), maximum width
        DungeonConfirmationDialogMaxWidth, narrower in small windows - DungeonSpacingXxl from
        the edges; DungeonPaddingXxl padding. Title uses display-md (20, heading font - like a Windows
        dialog title), body uses secondary text (TextRegular) 13, both wrap;
        DungeonSpacingSm between title and body, DungeonSpacingXxl between body and buttons. Buttons in the bottom
        right, DungeonSpacingSm apart: "Anuluj" (regular) and action (.primary or - destructive
        - .danger). Tab cycles within the card (TabNavigation Cycle); initial focus on "Anuluj"; the
        control itself accepts focus (without an indicator), so it receives keys even after clicking
        the scrim. Opening: everything fades in, the card slides up by DungeonPopupOpenOffset
        from below (DungeonPopupOpenDuration, easing out); closing is immediate; system animations
        disabled - immediate opening. Arrow cursor.
    -->
    <ControlTheme x:Key="{x:Type controls:ConfirmationDialog}" TargetType="controls:ConfirmationDialog">
        <Setter Property="Background" Value="{DynamicResource DungeonScrimBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <Border Name="PART_Card"
                            MaxWidth="{DynamicResource DungeonConfirmationDialogMaxWidth}"
                            Margin="{DynamicResource DungeonPaddingXxl}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Padding="{DynamicResource DungeonPaddingXxl}"
                            Background="{DynamicResource DungeonBackstageCardBrush}"
                            BorderBrush="{DynamicResource DungeonInputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource DungeonFlyoutCornerRadius}"
                            BoxShadow="{DynamicResource DungeonFlyoutShadow}">
                        <StackPanel Spacing="{DynamicResource DungeonSpacingXxl}">
                            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                                <TextBlock Classes="display-md"
                                           Text="{TemplateBinding Title}"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="body secondary"
                                           Text="{TemplateBinding Message}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="{DynamicResource DungeonSpacingSm}">
                                <Button Name="PART_CancelButton" Content="Anuluj" />
                                <Button Name="PART_ConfirmButton" Content="{TemplateBinding ActionText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
