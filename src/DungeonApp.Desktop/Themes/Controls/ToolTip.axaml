<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Tooltip (ToolTip). Part name from Fluent ToolTip.xaml
        (Avalonia 12.0.5, MIT): PART_ContentPresenter. SurfaceHeader background, TextPrimary text,
        1 px BorderStrong, DungeonControlCornerRadius, DungeonFlyoutShadow; UI font
        12 (DungeonHelperFontSize), DungeonToolTipPadding. Maximum width
        DungeonToolTipMaxWidth - longer text wraps, tooltip never trims. Text cannot
        be selected. No animation: appears immediately after the library delay, at the pointer
        (default placement). Transparent DungeonFlyoutMargin leaves room for the shadow.
        No states - no pointer response.
    -->
    <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHeaderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonToolTipPadding}" />
        <Setter Property="Margin" Value="{DynamicResource DungeonFlyoutMargin}" />
        <Setter Property="MaxWidth" Value="{DynamicResource DungeonToolTipMaxWidth}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonHelperFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_LayoutRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource DungeonFlyoutShadow}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      TextBlock.TextWrapping="Wrap"
                                      TextBlock.TextTrimming="None" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
