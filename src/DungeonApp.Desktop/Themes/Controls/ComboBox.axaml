<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls"
                    xmlns:themes="using:DungeonApp.Desktop.Themes">

    <!--
        Single-selection dropdown (ComboBox) and its row (ComboBoxItem). Templates based
        on Fluent ComboBox.xaml and ComboBoxItem.xaml (Avalonia 12.0.5, MIT): popup
        (PART_Popup) and item presenter (PART_ItemsPresenter), without DataValidationErrors, editing
        field (IsEditable - shell dropdowns are not editable) or focus highlight.
        Closed appearance matches a text field: DungeonControlHeight, field background, 1 px border,
        radius and padding; selected item text vertically centred,
        single-line, trimmed with an ellipsis; without selection - PlaceholderText in field placeholder colour.
        Right-pointing chevron on the right (DungeonIconChevronDown rotated -90°, action icon size, muted
        text colour, 12 px from the edge like the search-field magnifier), glyph only without background.
        Layout determines width (stretches like a field), not content. Arrow cursor.
        States:
          resting  - InputBorder;
          hover    - InputHoverBorder (like a field);
          pressed  - same as hover;
          open     - same as hover, even without the pointer over the field (no accent, like a field being edited);
                     downward chevron (closed - right), animated rotation;
          disabled - DungeonDisabledOpacity.
        No focus appearance (empty FocusAdorner); no opening animation - only the chevron moves.
        Expanded list: flyout surface (same FlyoutPresenter theme - background,
        border, padding, shadow, DungeonFlyoutMaxHeight maximum height, internal scrolling),
        at least as wide as the field, below and left-aligned with it (above when there is no space
        below), gap from the FlyoutPresenter theme margin; the surface itself limits height
        (popup MaxHeight would clip the margin). Selection, clicking outside or Escape closes it
        (ComboBox behaviour).
        Row (ComboBoxItem) uses the list-row theme (BasedOn ListBoxItem): same height,
        padding, hover, selected = AccentDim without hover, disabled state.
    -->
    <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{DynamicResource DungeonControlHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource DungeonPaddingMdHorizontal}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource DungeonInputPlaceholderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MaxDropDownHeight" Value="{DynamicResource DungeonFlyoutMaxHeight}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto">
                    <Border Name="PART_BorderElement"
                            Grid.ColumnSpan="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                    <TextBlock Name="PART_Placeholder"
                               Grid.Column="0"
                               Margin="{TemplateBinding Padding}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                               Text="{TemplateBinding PlaceholderText}"
                               Foreground="{TemplateBinding PlaceholderForeground}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}" />
                    <ContentPresenter Name="PART_SelectionBox"
                                      Grid.Column="0"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextBlock.TextTrimming="CharacterEllipsis"
                                      TextBlock.TextWrapping="NoWrap" />
                    <controls:ForegroundIcon Name="PART_DropDownGlyph"
                                             Grid.Column="1"
                                             Width="{DynamicResource DungeonActionIconSize}"
                                             Height="{DynamicResource DungeonActionIconSize}"
                                             Margin="0,0,12,0"
                                             VerticalAlignment="Center"
                                             IsHitTestVisible="False"
                                             Foreground="{DynamicResource DungeonTextMutedBrush}"
                                             Source="{DynamicResource DungeonIconChevronDown}" />
                    <Popup Name="PART_Popup"
                           WindowManagerAddShadowHint="False"
                           IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                           PlacementTarget="PART_BorderElement"
                           Placement="BottomEdgeAlignedLeft"
                           IsLightDismissEnabled="True"
                           InheritsTransform="True">
                        <FlyoutPresenter Name="PART_DropDown"
                                         HorizontalAlignment="Stretch"
                                         MaxHeight="{TemplateBinding MaxDropDownHeight}">
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </FlyoutPresenter>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover:not(.hover-suppressed) /template/ Border#PART_BorderElement,
                       ^:pressed /template/ Border#PART_BorderElement,
                       ^:dropdownopen /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputHoverBorderBrush}" />
        </Style>
        <!-- Arrow: right when closed, down or up when open (towards the list); animated rotation (DungeonMotionDuration,
             easing out) - state changes immediately, rotation catches up. -->
        <Style Selector="^ /template/ controls|ForegroundIcon#PART_DropDownGlyph">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="{StaticResource DungeonMotionDuration}"
                                                   Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:dropdownopen /template/ controls|ForegroundIcon#PART_DropDownGlyph">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <!-- List opens upwards (no room below the field; .opens-up from Themes/PopupOpenMotion.cs):
             arrow points up - 90 degrees from right in the opposite direction to down. -->
        <Style Selector="^:dropdownopen.opens-up /template/ controls|ForegroundIcon#PART_DropDownGlyph">
            <Setter Property="RenderTransform" Value="rotate(-180deg)" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ComboBoxItem}"
                  TargetType="ComboBoxItem"
                  BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <!-- Popup row: scrollbar zone measured from the popup scroll area's edge. -->
        <Style Selector="^ /template/ Border#PART_Highlight">
            <Setter Property="Padding" Value="{DynamicResource DungeonScrollBarZoneInFlyout}" />
        </Style>
        <!-- Items longer than the popup (width fixed on opening - Themes/PopupOpenLayout.cs)
             are trimmed and show their full text in a tooltip. -->
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="themes:TrimmedLabelToolTip.IsEnabled" Value="True" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
