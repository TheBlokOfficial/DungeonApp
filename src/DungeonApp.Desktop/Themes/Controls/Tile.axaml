<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="using:DungeonApp.Desktop.Themes">

    <!--
        Tile: Button with Theme="{StaticResource DungeonTile}" - object button (e.g. minimised
        desk panel), rather than a labelled command. Separate theme, not a button variant: does not inherit
        regular button fixed height or padding. Dimensions supplied only by the view - theme sets
        no height, width or alignment; Padding 0, content centred on both axes
        and trimmed with an ellipsis. Card surface (BackstageCard background - object distinct from its surroundings,
        read as a whole; 1 px Border line), DungeonCornerRadius.
        TextPrimary text, UI font 13; tile icon uses text colour (ForegroundIcon).
        States:
          resting  - BackstageCard background, Border border;
          hover    - SurfaceHover background, BorderStrong border; pressed and open flyout
                     (:flyout-open) - same as hover;
          disabled - DungeonDisabledOpacity (disabled content colour), no pointer response.
        No transitions or transforms (Fluent scales pressed buttons - this theme does not). No focus
        appearance, arrow cursor.
    -->
    <ControlTheme x:Key="DungeonTile" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DungeonBackstageCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextBlock.TextTrimming="CharacterEllipsis"
                                      TextBlock.TextWrapping="NoWrap"
                                      RecognizesAccessKey="True"
                                      themes:TrimmedLabelToolTip.IsEnabled="True" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover:not(.hover-suppressed), ^:pressed, ^:flyout-open">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderStrongBrush}" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
