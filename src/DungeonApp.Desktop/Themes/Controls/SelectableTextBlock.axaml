<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Selectable text: context menu with copy when enabled. Cursor and selection colour
        come from the style in Typography.axaml.
    -->
    <ControlTheme x:Key="{x:Type SelectableTextBlock}" TargetType="SelectableTextBlock">
        <Style Selector="^[IsEnabled=True]">
            <Setter Property="ContextFlyout" Value="{StaticResource DungeonSelectableTextContextFlyout}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
