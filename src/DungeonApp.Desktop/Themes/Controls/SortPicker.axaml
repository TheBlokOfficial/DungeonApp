<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Sort control (controls:SortPicker): one row with "Sortuj: {pole}" link opener
        (DungeonLinkOpener with .link) and direction button immediately after, DungeonSpacingXs apart -
        unfilled icon button (.subtle: HoverOverlay background when hovered or pressed),
        DungeonInlineIconButtonSize square with DungeonIconSortDirection (DungeonActionIconSize, button
        text colour - TextRegular, TextPrimary on hover). Button does not increase row height: a
        negative vertical margin (DungeonInlineIconButtonOverhang) reduces its height to
        icon height, keeping the full hit area. Link, arrow and button centres lie on
        one line (VerticalAlignment Center). Button tooltip - direction ("Kierunek: A–Z").
        Field menu - shell-themed menu below the link. Disabled button (CanReverse=False) -
        DungeonDisabledOpacity; disabled whole control - DungeonDisabledOpacity once, on the control.
        No focus appearance, arrow cursor.
    -->
    <ControlTheme x:Key="{x:Type controls:SortPicker}" TargetType="controls:SortPicker">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingXs}">
                    <Button Name="PART_FieldButton"
                            Theme="{StaticResource DungeonLinkOpener}"
                            Classes="link"
                            VerticalAlignment="Center">
                        <TextBlock Text="{TemplateBinding FieldText}" />
                    </Button>
                    <Button Name="PART_DirectionButton"
                            Classes="subtle"
                            Width="{DynamicResource DungeonInlineIconButtonSize}"
                            Height="{DynamicResource DungeonInlineIconButtonSize}"
                            Margin="{DynamicResource DungeonInlineIconButtonOverhang}"
                            Padding="0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource DungeonTextRegularBrush}"
                            IsEnabled="{TemplateBinding CanReverse}"
                            ToolTip.Tip="{TemplateBinding DirectionToolTip}">
                        <controls:ForegroundIcon Name="PART_DirectionGlyph"
                                                 Width="{DynamicResource DungeonActionIconSize}"
                                                 Height="{DynamicResource DungeonActionIconSize}"
                                                 RenderTransformOrigin="50%,50%"
                                                 Foreground="{Binding $parent[Button].Foreground}"
                                                 Source="{DynamicResource DungeonIconSortDirection}" />
                    </Button>
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Button#PART_DirectionButton:pointerover:not(.hover-suppressed),
                         ^ /template/ Button#PART_DirectionButton:pressed">
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
