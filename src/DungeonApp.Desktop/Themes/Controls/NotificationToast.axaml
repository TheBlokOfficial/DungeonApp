<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Notification (controls:NotificationToast) - invocation and behaviour in Controls/NotificationToast.cs.
        Toast stack at the window's bottom right (controls:WindowOverlay: DungeonPaddingLg from the right edge and status
        bar, DungeonSpacingSm between toasts, newest at the bottom). Flyout-like surface
        (DungeonBackstageCardBrush, 1 px InputBorder, DungeonFlyoutShadow,
        DungeonFlyoutCornerRadius), fixed DungeonNotificationWidth, DungeonPaddingMd
        padding. Layout: variant icon (DungeonActionIconSize) | regular body text 13,
        wrapping, with action link below (standalone .link, only when labelled) |
        close cross - glyph only, like x in the search field (DungeonFieldGlyphButton: lightens
        on hover), no focus. Icon and cross align with the first body line.
        Variants:
          :information - "i" icon in secondary text colour (TextRegular) - information carries no
                         state, accent stays reserved for selected and primary elements;
          :warning     - triangle in DungeonWarningBrush;
          :error       - circle with exclamation mark in DungeonDangerTextBrush; body is selectable
                         (SelectableTextBlock - error message).
        Toast does not accept focus and has no hover states (pointer over it only pauses
        dismissal). Opening: fade in and slide by DungeonNotificationOpenOffset from
        the right (DungeonPopupOpenDuration, easing out); immediate dismissal; system animations
        disabled - immediate opening. Arrow cursor (error text - text cursor, SelectableTextBlock style).
    -->
    <ControlTheme x:Key="{x:Type controls:NotificationToast}" TargetType="controls:NotificationToast">
        <Setter Property="Width" Value="{DynamicResource DungeonNotificationWidth}" />
        <Setter Property="Background" Value="{DynamicResource DungeonBackstageCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonFlyoutCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonPaddingMd}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource DungeonFlyoutShadow}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource DungeonSpacingSm}">
                        <controls:ForegroundIcon Name="PART_Icon"
                                                 Grid.Column="0"
                                                 Width="{DynamicResource DungeonActionIconSize}"
                                                 Height="{DynamicResource DungeonActionIconSize}"
                                                 VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="{DynamicResource DungeonSpacingXs}">
                            <TextBlock Name="PART_Message"
                                       Text="{TemplateBinding Message}"
                                       TextWrapping="Wrap" />
                            <SelectableTextBlock Name="PART_SelectableMessage"
                                                 Text="{TemplateBinding Message}"
                                                 TextWrapping="Wrap" />
                            <Button Name="PART_ActionButton"
                                    Classes="link"
                                    HorizontalAlignment="Left"
                                    Content="{TemplateBinding ActionText}"
                                    IsVisible="{TemplateBinding ActionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <Button Name="PART_CloseButton"
                                Grid.Column="2"
                                Theme="{StaticResource DungeonFieldGlyphButton}"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                            <controls:ForegroundIcon Width="{DynamicResource DungeonActionIconSize}"
                                                     Height="{DynamicResource DungeonActionIconSize}"
                                                     Source="{DynamicResource DungeonIconClear}" />
                        </Button>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ controls|ForegroundIcon#PART_Icon">
            <Setter Property="Source" Value="{DynamicResource DungeonIconInfo}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
        </Style>
        <Style Selector="^ /template/ SelectableTextBlock#PART_SelectableMessage">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:warning /template/ controls|ForegroundIcon#PART_Icon">
            <Setter Property="Source" Value="{DynamicResource DungeonIconWarningTriangle}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonWarningBrush}" />
        </Style>
        <Style Selector="^:error /template/ controls|ForegroundIcon#PART_Icon">
            <Setter Property="Source" Value="{DynamicResource DungeonIconError}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonDangerTextBrush}" />
        </Style>
        <Style Selector="^:error /template/ TextBlock#PART_Message">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:error /template/ SelectableTextBlock#PART_SelectableMessage">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
