<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Numeric field (NumericUpDown): text-field appearance and states - resting, hover, editing
        (focus anywhere inside, :focus-within; hover border, no accent), disabled. Templates based on Fluent NumericUpDown.xaml
        and ButtonSpinner.xaml (Avalonia 12.0.5, MIT): ButtonSpinner (PART_Spinner - translates
        keyboard arrows and button presses into value changes) and inner PART_TextBox;
        no DataValidationErrors or side-by-side buttons. ButtonSpinner draws the border and background;
        the inner field has neither, so its own states are invisible.
        Value in a monospaced font (DungeonMonoFont), integer by default
        (FormatString "0", Increment 1). Up/down arrows on the right inside
        the field, stacked vertically, muted text colour, regular text colour
        on hover, glyphs only without background; do not accept or take focus from the field, do not
        select text, arrow cursor. Width from the theme
        (DungeonNumericInputWidth), not the value.
    -->
    <StreamGeometry x:Key="DungeonSpinnerIncreaseGeometry">M0,9 L10,0 20,9 19,10 10,2 1,10 z</StreamGeometry>

    <StreamGeometry x:Key="DungeonSpinnerDecreaseGeometry">M0,1 L10,10 20,1 19,0 10,8 1,0 z</StreamGeometry>

    <ControlTheme x:Key="DungeonSpinnerRepeatButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Content="{TemplateBinding Content}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover, ^:pressed">
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_BorderElement"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <DockPanel>
                        <Grid Name="PART_SpinnerPanel"
                              DockPanel.Dock="Right"
                              RowDefinitions="*,*"
                              IsVisible="{TemplateBinding ShowButtonSpinner}">
                            <RepeatButton Name="PART_IncreaseButton"
                                          Grid.Row="0"
                                          Theme="{StaticResource DungeonSpinnerRepeatButton}"
                                          VerticalAlignment="Stretch">
                                <PathIcon Width="8" Height="4" Data="{StaticResource DungeonSpinnerIncreaseGeometry}" />
                            </RepeatButton>
                            <RepeatButton Name="PART_DecreaseButton"
                                          Grid.Row="1"
                                          Theme="{StaticResource DungeonSpinnerRepeatButton}"
                                          VerticalAlignment="Stretch">
                                <PathIcon Width="8" Height="4" Data="{StaticResource DungeonSpinnerDecreaseGeometry}" />
                            </RepeatButton>
                        </Grid>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Padding="{TemplateBinding Padding}" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:left /template/ Grid#PART_SpinnerPanel">
            <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
        <Style Selector="^:pointerover, ^:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputHoverBorderBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type NumericUpDown}" TargetType="NumericUpDown">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="{DynamicResource DungeonNumericInputWidth}" />
        <Setter Property="Height" Value="{DynamicResource DungeonControlHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource DungeonPaddingMdHorizontal}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource DungeonInputPlaceholderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonMonoFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <!-- Integer by default: no fractional part ("27", not "27,0") and increment 1 without decimal
             places. Fields needing fractions set FormatString and Increment explicitly. -->
        <Setter Property="FormatString" Value="0" />
        <Setter Property="Increment" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <!-- Only the inner field accepts focus. Clicking an arrow (not focusable) gives
             focus to the nearest focusable ancestor; if that were NumericUpDown or
             ButtonSpinner, the numeric field would forward it to the inner field and select text.
             This way an arrow changes the value while leaving focus where it was. -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <ButtonSpinner Name="PART_Spinner"
                               Focusable="False"
                               IsTabStop="False"
                               AllowSpin="{TemplateBinding AllowSpin}"
                               ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"
                               ButtonSpinnerLocation="{TemplateBinding ButtonSpinnerLocation}">
                    <!-- MinWidth 0: numeric field width comes from its theme, not the minimum width
                         of a regular text field (DungeonInputMinWidth). -->
                    <TextBox Name="PART_TextBox"
                             Height="NaN"
                             MinWidth="0"
                             VerticalAlignment="Stretch"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="{TemplateBinding Padding}"
                             FontFamily="{TemplateBinding FontFamily}"
                             Foreground="{TemplateBinding Foreground}"
                             PlaceholderText="{TemplateBinding PlaceholderText}"
                             PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                             IsReadOnly="{TemplateBinding IsReadOnly}"
                             VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                             HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                             Text="{TemplateBinding Text}"
                             TextAlignment="{TemplateBinding TextAlignment}"
                             AcceptsReturn="False"
                             TextWrapping="NoWrap"
                             InnerLeftContent="{Binding InnerLeftContent, RelativeSource={RelativeSource TemplatedParent}}"
                             InnerRightContent="{Binding InnerRightContent, RelativeSource={RelativeSource TemplatedParent}}" />
                </ButtonSpinner>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
