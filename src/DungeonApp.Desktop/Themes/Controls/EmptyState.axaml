<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Empty list (controls:EmptyState): message in place of rows - regular text in the UI font
        and size - with an optional hint below explaining what to do (muted text,
        DungeonHelperFontSize), visible only when non-empty. Sits at the top of the list area (not in
        the middle of a tall list) with DungeonPaddingMd; no illustration or icon. Text wraps
        to the list width. No states: no focus or pointer response (inherits the underlying
        cursor); text cannot be selected.
    -->
    <ControlTheme x:Key="{x:Type controls:EmptyState}" TargetType="controls:EmptyState">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Padding" Value="{DynamicResource DungeonPaddingMd}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Margin="{TemplateBinding Padding}"
                            Spacing="{DynamicResource DungeonSpacingXs}">
                    <TextBlock Name="PART_Message"
                               Text="{TemplateBinding Message}"
                               Foreground="{TemplateBinding Foreground}"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="Normal"
                               TextWrapping="Wrap" />
                    <TextBlock Name="PART_Hint"
                               Text="{TemplateBinding Hint}"
                               Foreground="{DynamicResource DungeonTextMutedBrush}"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{DynamicResource DungeonHelperFontSize}"
                               FontWeight="Normal"
                               TextWrapping="Wrap"
                               IsVisible="{TemplateBinding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
