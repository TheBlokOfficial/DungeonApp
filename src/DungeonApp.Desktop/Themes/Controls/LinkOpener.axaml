<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls"
                    xmlns:themes="using:DungeonApp.Desktop.Themes">

    <!--
        Link opener: Button with a flyout (Flyout) and Theme="{StaticResource
        DungeonLinkOpener}" plus Classes="link" - standalone link ("Sortuj: nazwa") that
        opens a menu or list. Appearance and states from the Button theme's standalone link (.link:
        TextRegular without underline; hover, pressed and open use TextPrimary with underline;
        clicking itself closed restores rest until pointer re-entry - Themes/OpenerHoverRest.cs).
        Arrow after the label matches dropdowns: DungeonIconChevronDown, DungeonActionIconSize,
        in text colour, without underline, DungeonSpacingXs gap; right when closed, pointing
        towards the popup when open (down or up - .opens-up from Themes/PopupOpenMotion.cs),
        animated rotation (DungeonMotionDuration, easing out; disabled by ReducedMotion.axaml - the
        dropdown arrow rule covers every Button with PART_DropDownGlyph). Single-line text, trimmed
        with an ellipsis and tooltip when too long. No visible focus indicator, arrow cursor.
    -->
    <ControlTheme x:Key="DungeonLinkOpener" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource DungeonSpacingXs}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          VerticalAlignment="Center"
                                          TextBlock.TextTrimming="CharacterEllipsis"
                                          TextBlock.TextWrapping="NoWrap"
                                          RecognizesAccessKey="True"
                                          themes:TrimmedLabelToolTip.IsEnabled="True" />
                        <controls:ForegroundIcon Name="PART_DropDownGlyph"
                                                 Grid.Column="1"
                                                 Width="{DynamicResource DungeonActionIconSize}"
                                                 Height="{DynamicResource DungeonActionIconSize}"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False"
                                                 Foreground="{TemplateBinding Foreground}"
                                                 Source="{DynamicResource DungeonIconChevronDown}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ controls|ForegroundIcon#PART_DropDownGlyph">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="{StaticResource DungeonMotionDuration}"
                                                   Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:flyout-open /template/ controls|ForegroundIcon#PART_DropDownGlyph">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="^:flyout-open.opens-up /template/ controls|ForegroundIcon#PART_DropDownGlyph">
            <Setter Property="RenderTransform" Value="rotate(-180deg)" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
