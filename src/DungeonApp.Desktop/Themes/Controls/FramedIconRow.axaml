<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!-- The frame of the marker row: a button that is also the remove action. Same size and border
         thickness in every state; only colours change. -->
    <ControlTheme x:Key="DungeonFramedIconRowFrame" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource DungeonFramedIconSize}" />
        <Setter Property="Height" Value="{DynamicResource DungeonFramedIconSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DungeonFramedIconBorderThickness}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover, ^:focus-visible, ^:pressed">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonDangerTextBrush}" />
        </Style>
    </ControlTheme>

    <!--
        Marker row (controls:FramedIconRow): a condition or an effect on an entity card. From the left:
          frame  - DungeonFramedIconSize square, square corners, DungeonFramedIconBorderThickness
                   border in BorderStrong (like the window frame); the icon inside is muted;
                   a row without an icon shows the empty frame. The frame removes the row: under
                   the pointer or with keyboard focus its border turns DangerText (the action
                   deletes) and the icon is replaced by a DangerText trash; a click, Enter or
                   Space runs RemoveCommand. Size and border thickness never change;
          text   - title in body-strong, under it an optional muted caption (modifiers, turns and
                   a note). The text block is centred against the frame, so a row without the caption
                   is exactly as tall as one with it; a long title is trimmed with an ellipsis.
        Removed (:removed) - the frame is dimmed to DungeonRemovedRowOpacity and all text turns muted
        (opacity on the text itself renders it torn); the frame ignores the pointer and focus, so the
        row cannot be removed twice. No animation.
    -->
    <ControlTheme x:Key="{x:Type controls:FramedIconRow}" TargetType="controls:FramedIconRow">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource DungeonSpacingSm}" Background="Transparent">
                    <Button Name="PART_Frame"
                            Theme="{StaticResource DungeonFramedIconRowFrame}"
                            VerticalAlignment="Center"
                            Command="{TemplateBinding RemoveCommand}">
                        <Panel>
                            <controls:ForegroundIcon Name="PART_StateIcon"
                                                     Width="{DynamicResource DungeonActionIconSize}"
                                                     Height="{DynamicResource DungeonActionIconSize}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Source="{TemplateBinding Icon}"
                                                     Foreground="{DynamicResource DungeonTextMutedBrush}"
                                                     IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <controls:ForegroundIcon Name="PART_Trash"
                                                     Width="{DynamicResource DungeonActionIconSize}"
                                                     Height="{DynamicResource DungeonActionIconSize}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Source="{StaticResource DungeonIconTrash}"
                                                     Foreground="{DynamicResource DungeonDangerTextBrush}" />
                        </Panel>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Classes="body-strong"
                                   Text="{TemplateBinding Title}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption"
                                   Text="{TemplateBinding Detail}"
                                   Foreground="{DynamicResource DungeonTextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{TemplateBinding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ controls|ForegroundIcon#PART_Trash">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^ /template/ Button#PART_Frame:pointerover controls|ForegroundIcon#PART_Trash, ^ /template/ Button#PART_Frame:focus-visible controls|ForegroundIcon#PART_Trash">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^ /template/ Button#PART_Frame:pointerover controls|ForegroundIcon#PART_StateIcon, ^ /template/ Button#PART_Frame:focus-visible controls|ForegroundIcon#PART_StateIcon">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:removed /template/ Button#PART_Frame">
            <Setter Property="Opacity" Value="{DynamicResource DungeonRemovedRowOpacity}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="^:removed /template/ TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
