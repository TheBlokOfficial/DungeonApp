<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Wskaźnik postępu (ProgressBar), tylko poziomy. Szablon wycięty z ProgressBar.xaml Fluenta
        (Avalonia 12.0.5, MIT): zostały tor i PART_Indicator (szerokość ustawia sam ProgressBar po
        wartości); wypadły napis z procentem (ShowProgressText - wartość pokazuje ten, kto układa
        widok), szablon pionowy i animacje nieokreślonego stanu ze stylu (zastępuje je
        controls:ProgressSweep - ruch w kodzie, który wyłączone animacje w systemie zatrzymują).
        Orientation="Vertical" dostaje ten sam poziomy szablon - pierwszy konsument dopisze pionowy.
        Wymiar: grubość DungeonProgressBarThickness, szerokość z kontenera; zaokrąglenie
        DungeonProgressBarCornerRadius na obu końcach toru i wypełnienia (jak tor suwaka), tor
        przycina wypełnienie do swojego obrysu.
        Tor Background (DungeonBorderBrush), wypełnienie Foreground - domyślnie akcent; układający
        widok może podać inny kolor (np. pasek PZ). Bez fokusu, kursor strzałka, bez przejść.
        Stany - nic więcej:
          określony    - wypełnienie od lewej, szerokość według Value w zakresie Minimum..Maximum;
          nieokreślony - odcinek 40 % toru w kolorze Foreground przesuwa się w pętli
                         (DungeonProgressSweepDuration); przy wyłączonych animacjach w systemie
                         spokojny: cały tor w przygaszonym akcencie (DungeonAccentDimBrush), bez ruchu;
          wyłączony    - DungeonDisabledOpacity (najwyższa wyłączona), wypełnienie traci akcent:
                         tekst przygaszony (TextMuted), neutralne - jak część toru suwaka przed
                         uchwytem; nieokreślony wyłączony stoi (cały tor w TextMuted).
    -->
    <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonProgressBarCornerRadius}" />
        <Setter Property="Height" Value="{DynamicResource DungeonProgressBarThickness}" />
        <Setter Property="MinHeight" Value="{DynamicResource DungeonProgressBarThickness}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Panel>
                        <Border Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsVisible="{TemplateBinding IsIndeterminate, Converter={x:Static BoolConverters.Not}}" />
                        <controls:ProgressSweep Name="PART_Sweep"
                                                Fill="{TemplateBinding Foreground}"
                                                CalmFill="{DynamicResource DungeonAccentDimBrush}"
                                                IsVisible="{TemplateBinding IsIndeterminate}" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ controls|ProgressSweep#PART_Sweep">
            <Setter Property="CalmFill" Value="{DynamicResource DungeonTextMutedBrush}" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
