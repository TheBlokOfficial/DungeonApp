<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Progress indicator (ProgressBar), horizontal only. Template based on Fluent ProgressBar.xaml
        (Avalonia 12.0.5, MIT): track and PART_Indicator (ProgressBar itself sets width from
        the value); no percentage text (ShowProgressText - the view displays the value),
        vertical template or style-based indeterminate animations (handled by
        controls:ProgressSweep - code-based motion stopped when system animations are disabled).
        Orientation="Vertical" receives the same horizontal template.
        Dimensions: DungeonProgressBarThickness, width from container; DungeonProgressBarCornerRadius
        at both ends of track and fill (like the slider track), track
        clips fill to its outline.
        Track Background (DungeonBorderBrush), fill Foreground - accent by default; the view
        can supply another colour (e.g. a "PW" bar). No focus, arrow cursor, no transitions.
        States - no others:
          determinate   - fill from the left, width according to Value in Minimum..Maximum;
          indeterminate - segment of 40 % of the track in Foreground moves in a loop
                          (DungeonProgressSweepDuration); with system animations disabled,
                          static: entire track in dim accent (DungeonAccentDimBrush), no motion;
          disabled      - DungeonDisabledOpacity (outermost disabled), fill loses accent:
                          muted text (TextMuted), neutral - like the slider track before
                          the thumb; disabled indeterminate stays still (entire track in TextMuted).
    -->
    <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonProgressBarCornerRadius}" />
        <Setter Property="Height" Value="{DynamicResource DungeonProgressBarThickness}" />
        <Setter Property="MinHeight" Value="{DynamicResource DungeonProgressBarThickness}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Panel>
                        <Border Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsVisible="{TemplateBinding IsIndeterminate, Converter={x:Static BoolConverters.Not}}" />
                        <controls:ProgressSweep Name="PART_Sweep"
                                                Fill="{TemplateBinding Foreground}"
                                                CalmFill="{DynamicResource DungeonAccentDimBrush}"
                                                IsVisible="{TemplateBinding IsIndeterminate}" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ controls|ProgressSweep#PART_Sweep">
            <Setter Property="CalmFill" Value="{DynamicResource DungeonTextMutedBrush}" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
