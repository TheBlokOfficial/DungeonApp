<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Command list row (controls:ListRow - Button with IsSelected and optional selection
        stripe): for ItemsControl lists where a view-model command handles selection, opening or
        navigation. Appearance and states exactly match ListBoxItem (ListBox.axaml) - same brushes,
        font, padding, radius and highlight gap (DungeonListRowHighlightInset); background extends under
        the scrollbar, content ends before its zone (DungeonScrollBarZone), text is single-line
        and trimmed with an ellipsis.
        DungeonListRowHeight set explicitly - belongs to the row, not content; the view's list
        style can supply another height.
        Selection stripe (ShowsSelectionStripe, off by default): left gutter of width
        DungeonListRowStripeGutter, row background starts after it and ends before an equal gutter
        on the right (background equally inset from both list edges; scrollbar overlays its right
        end, content ends before the scrollbar zone measured from the row edge); at the gutter's left edge,
        accent stripe of thickness DungeonListRowStripeWidth, rounded, inset at top and bottom by
        DungeonListRowStripeInset - visible only when IsSelected. Gutter stays within row bounds (no
        negative margin), so a scrolling list does not clip it. The list's resources provide
        gutter width and inset.
        States:
          resting   - transparent background;
          hover     - BackstageRowHover background, including over the row action (DungeonRowAction);
          selected  - AccentDim background, also on hover (style follows hover), visible stripe;
          pressed   - no separate appearance: hovered (unselected) or selected appearance;
          disabled  - DungeonDisabledOpacity, transparent background, no pointer response.
        No focus appearance (empty FocusAdorner), arrow cursor, no animation or movement
        when pressed.
    -->
    <ControlTheme x:Key="{x:Type controls:ListRow}" TargetType="controls:ListRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonListRowHighlightCornerRadius}" />
        <Setter Property="Height" Value="{DynamicResource DungeonListRowHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource DungeonPaddingMdHorizontal}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- The outer grid's transparent background catches the pointer in the highlight gap and
                     stripe gutter too - hover does not disappear between rows. -->
                <Grid Name="PART_Root" Background="Transparent" ColumnDefinitions="Auto,*,Auto">
                    <Panel Name="PART_StripeGutter"
                           Width="{DynamicResource DungeonListRowStripeGutter}"
                           IsVisible="{TemplateBinding ShowsSelectionStripe}">
                        <Border Name="PART_Stripe"
                                Width="{DynamicResource DungeonListRowStripeWidth}"
                                HorizontalAlignment="Left"
                                Margin="{DynamicResource DungeonListRowStripeInset}"
                                CornerRadius="{DynamicResource DungeonListRowStripeCornerRadius}"
                                Background="{DynamicResource DungeonAccentBrush}"
                                IsVisible="{TemplateBinding IsSelected}" />
                    </Panel>
                    <!-- Right gutter has the same width as the stripe gutter: row background ends at the
                         same distance from the right edge as it starts from the left. -->
                    <Panel Name="PART_EndGutter"
                           Grid.Column="2"
                           Width="{DynamicResource DungeonListRowStripeGutter}"
                           IsVisible="{TemplateBinding ShowsSelectionStripe}" />
                    <Border Name="PART_Highlight"
                            Grid.Column="1"
                            Margin="{DynamicResource DungeonListRowHighlightInset}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                    <!-- Content overlays the background and right gutter: ends before the scrollbar zone measured from
                         the row's right edge (DungeonScrollBarZone), independent of the right gutter. -->
                    <Border Name="PART_ContentZone"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="{DynamicResource DungeonListRowHighlightInset}"
                            Padding="{DynamicResource DungeonScrollBarZone}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          TextBlock.TextTrimming="CharacterEllipsis"
                                          TextBlock.TextWrapping="NoWrap" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover, ^:pressed">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowHoverBrush}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentDimBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
