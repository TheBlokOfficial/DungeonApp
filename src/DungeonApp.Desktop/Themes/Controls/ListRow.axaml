<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Wiersz listy, który jest poleceniem (controls:ListRow - Button z IsSelected i opcjonalną kreską
        zaznaczenia): do list zbudowanych jako ItemsControl, gdzie wybór, otwarcie albo nawigację niesie
        polecenie modelu widoku. Wygląd i stany dokładnie jak wiersz ListBoxItem (ListBox.axaml) - te same pędzle,
        pismo, wcięcia, zaokrąglenie i odstęp podświetlenia (DungeonListRowHighlightInset); tło sięga pod
        pasek przewijania, treść kończy się przed jego strefą (DungeonScrollBarZone), tekst w jednej
        linii przycięty wielokropkiem.
        Wysokość DungeonListRowHeight ustawiona jawnie - należy do wiersza, nie do zawartości; inną
        podaje układający stylem listy w widoku.
        Kreska zaznaczenia (ShowsSelectionStripe, domyślnie wyłączona): pas wcięcia po lewej szerokości
        DungeonListRowStripeGutter, tło wiersza zaczyna się za nim i kończy przed takim samym pasem
        po prawej (tło w równym odstępie od obu krawędzi listy; pasek przewijania leży nad prawym
        końcem tła, treść kończy się przed strefą paska liczoną od krawędzi wiersza); w pasie, przy jego lewej krawędzi,
        kreska akcentu grubości DungeonListRowStripeWidth, zaokrąglona, wcięta z góry i z dołu o
        DungeonListRowStripeInset - widoczna tylko przy IsSelected. Pas leży w granicach wiersza (nie
        ujemny margines), więc lista z przewijaniem go nie przycina. Szerokość pasa i wcięcie podaje
        układający listy zasobami na poziomie listy.
        Stany:
          spoczynek   - tło przezroczyste;
          najechanie  - tło BackstageRowHover, także nad akcją wiersza (DungeonRowAction);
          wybrany     - tło AccentDim, także pod myszą (styl stoi po najechaniu), kreska widoczna;
          wciśnięcie  - bez własnego wyglądu: jak najechanie (niewybrany) albo jak wybrany;
          wyłączenie  - DungeonDisabledOpacity, tło przezroczyste, bez reakcji na mysz.
        Fokus bez wyglądu (FocusAdorner pusty), kursor strzałka, bez animacji i bez przesunięcia
        przy wciśnięciu.
    -->
    <ControlTheme x:Key="{x:Type controls:ListRow}" TargetType="controls:ListRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonListRowHighlightCornerRadius}" />
        <Setter Property="Height" Value="{DynamicResource DungeonListRowHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource DungeonPaddingMdHorizontal}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Przezroczyste tło zewnętrznej siatki łapie mysz także w odstępie podświetlenia i w
                     pasie kreski - najechanie nie gaśnie między wierszami. -->
                <Grid Name="PART_Root" Background="Transparent" ColumnDefinitions="Auto,*,Auto">
                    <Panel Name="PART_StripeGutter"
                           Width="{DynamicResource DungeonListRowStripeGutter}"
                           IsVisible="{TemplateBinding ShowsSelectionStripe}">
                        <Border Name="PART_Stripe"
                                Width="{DynamicResource DungeonListRowStripeWidth}"
                                HorizontalAlignment="Left"
                                Margin="{DynamicResource DungeonListRowStripeInset}"
                                CornerRadius="{DynamicResource DungeonListRowStripeCornerRadius}"
                                Background="{DynamicResource DungeonAccentBrush}"
                                IsVisible="{TemplateBinding IsSelected}" />
                    </Panel>
                    <!-- Pas po prawej tej samej szerokości co pas kreski: tło wiersza kończy się w tym
                         samym odstępie od prawej krawędzi, w jakim zaczyna się od lewej. -->
                    <Panel Name="PART_EndGutter"
                           Grid.Column="2"
                           Width="{DynamicResource DungeonListRowStripeGutter}"
                           IsVisible="{TemplateBinding ShowsSelectionStripe}" />
                    <Border Name="PART_Highlight"
                            Grid.Column="1"
                            Margin="{DynamicResource DungeonListRowHighlightInset}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                    <!-- Treść leży nad tłem i prawym pasem: kończy się przed strefą paska liczoną od
                         prawej krawędzi wiersza (DungeonScrollBarZone), niezależnie od prawego pasa. -->
                    <Border Name="PART_ContentZone"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="{DynamicResource DungeonListRowHighlightInset}"
                            Padding="{DynamicResource DungeonScrollBarZone}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          TextBlock.TextTrimming="CharacterEllipsis"
                                          TextBlock.TextWrapping="NoWrap" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover, ^:pressed">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowHoverBrush}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentDimBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
