<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Picture frame (controls:ImageFrame): a field for one picture, with no size of its own - size
        and proportions (square, portrait) come from the layout it stands in. Surface background
        (DungeonSurfaceBrush, so an empty field reads as a place for a picture on any background), the
        theme line, the card corner; content clipped to the corner.
        The line is drawn last, over the picture: a picture that filled the frame under it would hide
        the frame's edge, and its corners would cut into the rounded line.
        Three states, from what the frame was given: :picture - the picture fills the frame
        (UniformToFill: cropped to the frame's proportions, never distorted), centered; no picture -
        the placeholder icon, DungeonImageFrameIconSize, centered, in the muted text color; :error -
        the same icon with the message under it (caption role, danger text color - the one thing that
        is wrong) and the detail under that (caption, muted - secondary to the message; wraps even
        inside a path without spaces, at most three lines, then an ellipsis), centered.
        :mask - a picture that is a one-colour icon (SourceIsMask): its shape, whole (Uniform),
        centered inside the frame's padding, in the secondary text color - the icon accompanies the
        name beside it, it does not replace it - whatever color the file itself has.
        No interaction states: takes no focus, ignores the pointer (the cursor is whatever it lies
        on), its text does not select.
    -->
    <ControlTheme x:Key="{x:Type controls:ImageFrame}" TargetType="controls:ImageFrame">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Background" Value="{DynamicResource DungeonSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonCardCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonPaddingSm}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Panel>
                            <Image Name="PART_Picture"
                                   Source="{TemplateBinding Source}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="False" />
                            <!-- The one-colour icon: a fill in the icon colour, cut to the picture's
                                 shape by its opacity mask (set by the frame itself). -->
                            <Border Name="PART_Mask"
                                    Margin="{TemplateBinding Padding}"
                                    Background="{DynamicResource DungeonTextRegularBrush}"
                                    IsVisible="False" />
                            <StackPanel Name="PART_Placeholder"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Spacing="{DynamicResource DungeonSpacingSm}">
                                <controls:ForegroundIcon Name="PART_Icon"
                                                         Width="{DynamicResource DungeonImageFrameIconSize}"
                                                         Height="{DynamicResource DungeonImageFrameIconSize}"
                                                         HorizontalAlignment="Center"
                                                         Source="{TemplateBinding Icon}"
                                                         Foreground="{TemplateBinding Foreground}" />
                                <!-- Message and path with no gap between them: one note on two lines. -->
                                <StackPanel Name="PART_Error"
                                            IsVisible="False">
                                    <TextBlock Name="PART_Message"
                                               Classes="caption"
                                               Text="{TemplateBinding Message}"
                                               Foreground="{DynamicResource DungeonDangerTextBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <TextBlock Name="PART_Detail"
                                               Classes="caption"
                                               Text="{TemplateBinding Detail}"
                                               Foreground="{DynamicResource DungeonTextMutedBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxLines="3"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{TemplateBinding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </StackPanel>
                        </Panel>
                    </Border>
                    <Border Name="PART_Line"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:picture /template/ Image#PART_Picture">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:picture /template/ StackPanel#PART_Placeholder">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:error /template/ StackPanel#PART_Error">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:mask /template/ Image#PART_Picture">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:mask /template/ Border#PART_Mask">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
