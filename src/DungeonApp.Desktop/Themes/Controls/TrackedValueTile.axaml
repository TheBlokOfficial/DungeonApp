<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Tracked value (controls:TrackedValueTile): the current hit points and the like - a StatTile
        column whose number takes a change. Top to bottom, left-aligned like StatTile:
          label - DungeonStatTileIconSize icon and caption, muted;
          value line - the current number, an editable text (controls:EditableText, its own look) in
            the stat-value-lg font, at least three digits wide, one line; beside it a smaller muted
            "/ 13" (stat-value) on the same baseline (the control aligns them); the blot
            (controls:ChangeBlot) behind the number while it is uncommitted. While typing, an entry
            longer than the number's room spills over "/ 13", which hides meanwhile - nothing moves;
          note line - muted caption, always reserved; while the field holds a change it shows the
            preview (regular text) on one line over the note's place, cut with an ellipsis.
        Enter confirms, Escape or a click elsewhere drops the entry (Themes/EditFocusRelease.cs and
        the control). No transitions.
    -->
    <ControlTheme x:Key="{x:Type controls:TrackedValueTile}" TargetType="controls:TrackedValueTile">
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <!-- The frame, the overflow and the blot are drawn past the tile's edges. -->
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource DungeonSpacingXs}">
                        <controls:ForegroundIcon Width="{DynamicResource DungeonStatTileIconSize}"
                                                 Height="{DynamicResource DungeonStatTileIconSize}"
                                                 VerticalAlignment="Center"
                                                 Source="{TemplateBinding Icon}"
                                                 Foreground="{DynamicResource DungeonTextMutedBrush}"
                                                 IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <SelectableTextBlock Name="PART_Label"
                                             Grid.Column="1"
                                             Classes="caption"
                                             Text="{TemplateBinding Label}"
                                             Foreground="{DynamicResource DungeonTextMutedBrush}"
                                             VerticalAlignment="Center"
                                             TextWrapping="Wrap" />
                    </Grid>

                    <StackPanel Name="PART_ValueRow"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Spacing="{DynamicResource DungeonTrackedValueMaximumGap}">
                        <Panel VerticalAlignment="Top">
                            <!-- PART_Digits only carries the number's font (the stat-value-lg class
                                 styles text blocks, not text boxes) and the width of three digits, the
                                 number's least room; it is never seen. -->
                            <TextBlock Name="PART_Digits" Classes="stat-value-lg" Text="000"
                                       Opacity="0" IsHitTestVisible="False"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <controls:ChangeBlot IsShown="{TemplateBinding IsUncommitted}"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top">
                                <controls:EditableText Name="PART_Field"
                                                       FontFamily="{Binding #PART_Digits.FontFamily}"
                                                       FontSize="{Binding #PART_Digits.FontSize}"
                                                       FontWeight="{Binding #PART_Digits.FontWeight}"
                                                       FontFeatures="{Binding #PART_Digits.FontFeatures}"
                                                       LineHeight="{Binding #PART_Digits.LineHeight}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       TextWrapping="NoWrap"
                                                       AcceptsReturn="False"
                                                       SelectAllOnEntry="True"
                                                       SpillsOverWhileEditing="True" />
                            </controls:ChangeBlot>
                        </Panel>
                        <TextBlock Name="PART_Maximum"
                                   Classes="stat-value"
                                   VerticalAlignment="Top"
                                   Foreground="{DynamicResource DungeonTextMutedBrush}" />
                    </StackPanel>

                    <Panel>
                        <TextBlock Classes="caption" Text=" " Width="0" IsHitTestVisible="False" />
                        <Panel Name="PART_NoteHost">
                            <SelectableTextBlock Name="PART_Note"
                                                 Classes="caption"
                                                 Text="{TemplateBinding Note}"
                                                 Foreground="{DynamicResource DungeonTextMutedBrush}"
                                                 TextWrapping="Wrap"
                                                 IsVisible="{TemplateBinding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </Panel>
                        <TextBlock Name="PART_Message"
                                   Classes="caption"
                                   Text="{TemplateBinding Message}"
                                   Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Top"
                                   IsVisible="False" />
                    </Panel>
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:overflowing /template/ TextBlock#PART_Maximum">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- The note keeps its room while the preview stands over it. -->
        <Style Selector="^:preview /template/ Panel#PART_NoteHost">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:preview /template/ TextBlock#PART_Message">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
