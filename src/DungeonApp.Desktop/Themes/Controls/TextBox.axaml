<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Text field: one theme, variants as classes. Template based on Fluent TextBox.xaml
        (Avalonia 12.0.5, MIT): text presenter, scrolling, placeholder and slots for
        left (InnerLeftContent) and right (InnerRightContent) content; no DataValidationErrors
        (the application has no validation), floating placeholder or password buttons.
        States: resting, hover (:pointerover), editing (:focus - field focused), disabled
        (:disabled). No others.
          resting  - InputBackground fill, InputBorder;
          hover    - InputHoverBorder;
          editing  - InputHoverBorder (same as hover, neutral, no accent) throughout
                     editing, even when the pointer leaves. Caret indicates typing; this is not
                     a keyboard focus indicator;
          disabled - DungeonDisabledOpacity like buttons, no pointer response.
        Border is always 1 px, so state changes do not shift layout. Placeholder
        (InputPlaceholder) is unchanged in every state. A field with leading icon (pencil, magnifier)
        and clear button is a separate shell control - controls:IconField (IconField.axaml): icon
        and button are outside the text box. Keyboard focus has no separate
        appearance (empty FocusAdorner). Clicking outside or Escape removes field focus - shell,
        Themes/EditFocusRelease.cs.
        Single-line field has DungeonControlHeight; long text scrolls inside,
        without expanding the field. Text and placeholder vertically centred with equal padding;
        placeholder has the field text's font, size and weight (Regular) - template bindings ensure
        no view TextBlock style changes them - and differs only in colour.
        Context menu (cut/copy/paste) - DungeonTextBoxContextFlyout
        (TextContextFlyouts.axaml).
        Variants:
          (none)        - single-line;
          AcceptsReturn - multiline: wraps lines, minimum height
                          DungeonMultilineInputMinHeight, text at top, vertical scrollbar
                          only when needed; shell overlay scrollbar at the field edge, while text
                          padding on that side increases by the scrollbar zone, so it wraps
                          before the bar, not beneath it.
    -->
    <!--
        Field glyph button (clear x): beside the text area, without button appearance.
        Glyph only - no background, border or pressed appearance; hovered (and pressed) glyph
        lightens from muted to regular. Hit area spans the field's full inner height
        and padding to its edge (transparent background). Does not accept focus - focus stays in the field;
        arrow cursor. The entire field handles disabling (field's DungeonDisabledOpacity).
    -->
    <ControlTheme x:Key="DungeonFieldGlyphButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="4,0,12,0" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover, ^:pressed">
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{DynamicResource DungeonControlHeight}" />
        <Setter Property="MinWidth" Value="{DynamicResource DungeonInputMinWidth}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonPaddingMdHorizontal}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource DungeonTextSelectionBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource DungeonInputPlaceholderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="False" />
        <Setter Property="ContextFlyout" Value="{StaticResource DungeonTextBoxContextFlyout}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                    <Grid Margin="{TemplateBinding BorderThickness}" ColumnDefinitions="Auto,*,Auto">
                        <ContentPresenter Name="PART_InnerLeftContent"
                                          Grid.Column="0"
                                          VerticalAlignment="Stretch"
                                          VerticalContentAlignment="Center"
                                          Content="{TemplateBinding InnerLeftContent}"
                                          IsVisible="{TemplateBinding InnerLeftContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ScrollViewer Name="PART_ScrollViewer"
                                      Grid.Column="1"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                      VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                      IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                                      BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                            <Panel Name="PART_ContentInset">
                                <TextBlock Name="PART_Placeholder"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           FontStyle="{TemplateBinding FontStyle}"
                                           Foreground="{TemplateBinding PlaceholderForeground}"
                                           Text="{TemplateBinding PlaceholderText}"
                                           TextAlignment="{TemplateBinding TextAlignment}"
                                           TextWrapping="{TemplateBinding TextWrapping}"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                                <TextPresenter Name="PART_TextPresenter"
                                               Text="{TemplateBinding Text, Mode=TwoWay}"
                                               CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                               CaretIndex="{TemplateBinding CaretIndex}"
                                               SelectionStart="{TemplateBinding SelectionStart}"
                                               SelectionEnd="{TemplateBinding SelectionEnd}"
                                               TextAlignment="{TemplateBinding TextAlignment}"
                                               TextWrapping="{TemplateBinding TextWrapping}"
                                               LineHeight="{TemplateBinding LineHeight}"
                                               LetterSpacing="{TemplateBinding LetterSpacing}"
                                               PasswordChar="{TemplateBinding PasswordChar}"
                                               RevealPassword="{TemplateBinding RevealPassword}"
                                               SelectionBrush="{TemplateBinding SelectionBrush}"
                                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                               CaretBrush="{TemplateBinding CaretBrush}"
                                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Panel>
                        </ScrollViewer>
                        <ContentPresenter Name="PART_InnerRightContent"
                                          Grid.Column="2"
                                          VerticalAlignment="Stretch"
                                          Content="{TemplateBinding InnerRightContent}"
                                          IsVisible="{TemplateBinding InnerRightContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Grid>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- Hover and editing: same border; editing keeps it even without the pointer over the field. -->
        <Style Selector="^:pointerover /template/ Border#PART_BorderElement,
                       ^:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputHoverBorderBrush}" />
        </Style>

        <!-- Multiline. Text padding belongs to scrollable content (PART_ContentInset), not the
             scroll area: scrollbar sits at the field edge, text ends before its zone
             (DungeonMultilineInputContentPadding - field padding with DungeonScrollBarZone added on the right).
             Field Padding has no effect in this variant. -->
        <Style Selector="^[AcceptsReturn=True]">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="{DynamicResource DungeonMultilineInputMinHeight}" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style Selector="^[AcceptsReturn=True] /template/ ScrollViewer#PART_ScrollViewer">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^[AcceptsReturn=True] /template/ Panel#PART_ContentInset">
            <Setter Property="Margin" Value="{DynamicResource DungeonMultilineInputContentPadding}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
