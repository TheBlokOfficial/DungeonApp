<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Scroll area (ScrollViewer) and scrollbar (ScrollBar). Templates based on Fluent
        ScrollViewer.xaml and ScrollBar.xaml (Avalonia 12.0.5, MIT): content presenter
        with scrolling gesture (PART_ContentPresenter), scrollbars (PART_HorizontalScrollBar,
        PART_VerticalScrollBar) and track with thumb (Track, PART_PageUpButton/PART_PageDownButton -
        clicking the strip outside the thumb scrolls by a page); no step buttons, track background,
        scrollbar separator or expansion animations.
        Scrollbar overlays content: takes no space, so appearing or disappearing
        does not change layout. Always visible when content overflows (vertical Auto,
        horizontal Disabled by default), invisible when it fits; absent for Disabled and Hidden.
        Does not auto-hide (AllowAutoHide off). Sits by the area's edge with equal gaps
        from it and both ends (DungeonScrollBarInset); two visible bars do not overlap
        (vertical ends above the horizontal row). Accepts clicks only in its strip - the scrollbar
        layer has no background, so outside the bar the pointer hits content beneath.
        Content stays outside the scrollbar, row backgrounds extend beneath: rows span full width, content
        padding on the scrollbar side increases by its zone (DungeonScrollBarZone = thickness + gap).
        The scrollable content container supplies this (list-row theme, menu item, multiline field,
        view with custom rows), not the scroll area.
        Bar thickness DungeonScrollBarSize, transparent background (no track); thumb only,
        rounded (DungeonScrollThumbCornerRadius), at the strip's outer edge (vertical -
        right, horizontal - bottom): drawn thumb is exactly DungeonScrollBarInset
        from the area's edge, as from both ends. Hit area is the entire strip (wider than
        the drawing).
        States:
          resting  - DungeonScrollThumbSize thumb, DungeonScrollThumbBrush colour (strong border);
          hover    - pointer over the strip (not just the thumb): DungeonScrollThumbHoverSize thumb,
                     DungeonScrollThumbHoverBrush colour; widens within the strip towards
                     content (edge gap unchanged), so layout does not jump;
          dragging - same as hover, even when the pointer leaves the strip (Thumb:pressed);
          disabled - DungeonDisabledOpacity.
        Scrollbar does not accept focus (empty FocusAdorner, track buttons Focusable=False); arrow
        cursor.
    -->
    <ControlTheme x:Key="{x:Type ScrollViewer}" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="AllowAutoHide" Value="False" />
        <!-- Mouse wheel does not bubble to the parent scroll area: scrolling stops at the end. -->
        <Setter Property="IsScrollChainingEnabled" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ScrollContentPresenter Name="PART_ContentPresenter"
                                            Background="{TemplateBinding Background}"
                                            HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                            VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
                                            HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                            VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
                                            Padding="{TemplateBinding Padding}"
                                            ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}">
                        <ScrollContentPresenter.GestureRecognizers>
                            <ScrollGestureRecognizer CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                                     CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}"
                                                     IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_ContentPresenter}" />
                        </ScrollContentPresenter.GestureRecognizers>
                    </ScrollContentPresenter>
                    <!-- Scrollbar layer above content, no background: pointer hits only the bar itself. Auto column
                         and row have the bar's size plus gaps when visible, and zero
                         when hidden - the other bar then reaches the area's end. -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
                        <ScrollBar Name="PART_HorizontalScrollBar"
                                   Grid.Row="1"
                                   Margin="{DynamicResource DungeonScrollBarInset}"
                                   Orientation="Horizontal" />
                        <ScrollBar Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   Margin="{DynamicResource DungeonScrollBarInset}"
                                   Orientation="Vertical" />
                    </Grid>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="DungeonScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource DungeonScrollThumbBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonScrollThumbCornerRadius}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="DungeonScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />

        <Style Selector="^:vertical">
            <Setter Property="Width" Value="{DynamicResource DungeonScrollBarSize}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Track Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton"
                                              Classes="largeIncrease"
                                              Theme="{StaticResource DungeonScrollBarPageButton}" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton"
                                              Classes="largeIncrease"
                                              Theme="{StaticResource DungeonScrollBarPageButton}" />
                            </Track.IncreaseButton>
                            <Thumb Theme="{StaticResource DungeonScrollBarThumb}"
                                   HorizontalAlignment="Right"
                                   MinHeight="{DynamicResource DungeonScrollThumbMinLength}" />
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="^:vertical /template/ Thumb">
            <Setter Property="Width" Value="{DynamicResource DungeonScrollThumbSize}" />
        </Style>
        <Style Selector="^:vertical:pointerover /template/ Thumb,
                       ^:vertical /template/ Thumb:pressed">
            <Setter Property="Width" Value="{DynamicResource DungeonScrollThumbHoverSize}" />
        </Style>

        <Style Selector="^:horizontal">
            <Setter Property="Height" Value="{DynamicResource DungeonScrollBarSize}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Track Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton"
                                              Classes="largeIncrease"
                                              Theme="{StaticResource DungeonScrollBarPageButton}" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton"
                                              Classes="largeIncrease"
                                              Theme="{StaticResource DungeonScrollBarPageButton}" />
                            </Track.IncreaseButton>
                            <Thumb Theme="{StaticResource DungeonScrollBarThumb}"
                                   VerticalAlignment="Bottom"
                                   MinWidth="{DynamicResource DungeonScrollThumbMinLength}" />
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="^:horizontal /template/ Thumb">
            <Setter Property="Height" Value="{DynamicResource DungeonScrollThumbSize}" />
        </Style>
        <Style Selector="^:horizontal:pointerover /template/ Thumb,
                       ^:horizontal /template/ Thumb:pressed">
            <Setter Property="Height" Value="{DynamicResource DungeonScrollThumbHoverSize}" />
        </Style>

        <Style Selector="^:pointerover /template/ Thumb,
                       ^ /template/ Thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource DungeonScrollThumbHoverBrush}" />
        </Style>

        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
