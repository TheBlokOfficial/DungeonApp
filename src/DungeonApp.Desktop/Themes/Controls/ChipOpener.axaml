<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls"
                    xmlns:themes="using:DungeonApp.Desktop.Themes">

    <!--
        Chip with a choice list: Button with a flyout (Button.Flyout) and
        Theme="{StaticResource DungeonChipOpener}" - a filter whose value is selected from a list.
        Filter chip appearance (DungeonChip): DungeonChipHeight (28, explicit),
        DungeonControlCornerRadius, DungeonChipPadding, UI font 12 Medium, border
        always 1 px. The arrow after the label matches dropdowns (ComboBox, DropDownPicker) in
        shape and size, using the chip's text colour: right when closed, pointing towards
        the popup when open (down or up - .opens-up from Themes/PopupOpenMotion.cs), animated rotation
        (DungeonMotionDuration, easing out; disabled by ReducedMotion.axaml). Single-line text,
        trimmed with an ellipsis and tooltip when too long. The view sets popup Placement;
        list flyouts use FlyoutPresenterClasses="list-host".
        States:
          resting          - BackstageRow background, Border border, TextRegular text;
          hover            - BorderStrong border, TextPrimary text (:pointerover:not(.hover-suppressed));
                             pressed - same as hover;
          open             - same as hover (:flyout-open); clicking itself closed restores rest
                             until the pointer leaves (Themes/OpenerHoverRest.cs);
          active (.active - filter narrows the list) - AccentDim background, AccentEdge border, text and arrow
                             AccentOnDim; hover, pressed and open stay unchanged (as with an enabled DungeonChip);
          disabled         - DungeonDisabledOpacity, resting appearance; active disabled loses its accent
                             (SurfaceActive background, Border border).
        No visible focus indicator (empty FocusAdorner), arrow cursor.
    -->
    <ControlTheme x:Key="DungeonChipOpener" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{DynamicResource DungeonChipHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource DungeonChipPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonHelperFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource DungeonSpacingXs}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextBlock.TextTrimming="CharacterEllipsis"
                                          TextBlock.TextWrapping="NoWrap"
                                          RecognizesAccessKey="True"
                                          themes:TrimmedLabelToolTip.IsEnabled="True" />
                        <controls:ForegroundIcon Name="PART_DropDownGlyph"
                                                 Grid.Column="1"
                                                 Width="{DynamicResource DungeonActionIconSize}"
                                                 Height="{DynamicResource DungeonActionIconSize}"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False"
                                                 Foreground="{TemplateBinding Foreground}"
                                                 Source="{DynamicResource DungeonIconChevronDown}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover:not(.hover-suppressed), ^:pressed, ^:flyout-open">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderStrongBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        </Style>
        <!-- Active: identical across pointer and open states - explicit, independent of style order. -->
        <Style Selector="^.active, ^.active:pointerover, ^.active:pressed, ^.active:flyout-open">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentDimBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonAccentEdgeBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonAccentOnDimBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
        </Style>
        <Style Selector="^.active:disabled">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceActiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextRegularBrush}" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
        <!-- Arrow: right when closed, down or up when open; animated rotation. -->
        <Style Selector="^ /template/ controls|ForegroundIcon#PART_DropDownGlyph">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="{StaticResource DungeonMotionDuration}"
                                                   Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:flyout-open /template/ controls|ForegroundIcon#PART_DropDownGlyph">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="^:flyout-open.opens-up /template/ controls|ForegroundIcon#PART_DropDownGlyph">
            <Setter Property="RenderTransform" Value="rotate(-180deg)" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
