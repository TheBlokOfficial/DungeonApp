<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls"
                    xmlns:converters="using:Avalonia.Controls.Converters">

    <!-- Menu-item keyboard shortcut formatted using platform conventions (Ctrl+S). -->
    <converters:PlatformKeyGestureConverter x:Key="DungeonKeyGestureConverter" />

    <!--
        Button dropdown menu (MenuFlyout -> MenuFlyoutPresenter) and context menu
        (ContextMenu) with items (MenuItem) and separator. Menu bar (Menu) has no shell theme -
        the shell navigates through a sidebar. Part names from Fluent MenuFlyoutPresenter.xaml,
        ContextMenu.xaml and MenuItem.xaml (Avalonia 12.0.5, MIT): PART_ItemsPresenter,
        PART_Popup, PART_HeaderPresenter, PART_InputGestureText.
        Surface (menu and submenu): like a flyout (FlyoutPresenter) - InputBackground fill,
        1 px InputBorder, DungeonFlyoutCornerRadius, DungeonFlyoutPadding,
        DungeonFlyoutShadow, DungeonFlyoutMaxHeight maximum height with internal scrolling
        (shell overlay scrollbar - only when needed). Width from the longest item, from DungeonMenuMinWidth to
        DungeonMenuMaxWidth.
        Placement: button menu like a flyout (view sets MenuFlyout Placement=
        "BottomEdgeAlignedLeft" - MenuFlyout is not a control and has no theme; margin
        DungeonFlyoutMargin, flips above the button if space is limited); context menu at
        the pointer (library behaviour); submenu to the right, beside the menu edge with a flyout gap
        (DungeonSubmenuHorizontalOffset - no menu overlap), top row aligned with the item
        (DungeonSubmenuVerticalOffset), to the left if space is limited. Animated opening
        (Themes/PopupOpenMotion.cs): button menu from the button's side, context menu and submenu
        fade only; immediate closing.
        Item: DungeonListRowHeight, list-row highlight (BackstageRowHover brush,
        DungeonListRowHighlightInset, DungeonListRowHighlightCornerRadius)
        extends under the scrollbar; text padding 12, increased on the right
        by the remaining scrollbar zone measured from the scroll area's edge (DungeonScrollBarZoneInFlyout
        - item is inset by menu padding from that edge). Columns shared across the menu
        (SharedSizeGroup): [icon 16 / checkmark] [label] [shortcut or submenu arrow - one column at
        right padding, submenu items have no shortcut]; icon column has
        width only when an item has an icon or can be checked. Label 13,
        TextPrimary, single line with ellipsis, not selectable. Shortcut (InputGesture) or short
        item text (controls:MenuItemTrailing.Text, e.g. sort direction) aligned right,
        12, TextMuted, DungeonMenuGestureMargin gap. Icon and checkmark use item text colour.
        Item states:
          resting   - no background;
          hover     - highlight; keyboard-selected (:selected) and pressed - same as hover;
          open submenu (:open) - same as hover while the submenu is open;
          disabled  - DungeonDisabledOpacity, no highlight;
          .danger   - DangerText label and icon, neutral highlight; disabled loses red.
        No separate focus appearance (empty FocusAdorner); arrow cursor.
    -->
    <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonFlyoutCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonFlyoutPadding}" />
        <Setter Property="Margin" Value="{DynamicResource DungeonFlyoutMargin}" />
        <Setter Property="MinWidth" Value="{DynamicResource DungeonMenuMinWidth}" />
        <Setter Property="MaxWidth" Value="{DynamicResource DungeonMenuMaxWidth}" />
        <Setter Property="MaxHeight" Value="{DynamicResource DungeonFlyoutMaxHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="LayoutRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource DungeonFlyoutShadow}"
                        ClipToBounds="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        Margin="{TemplateBinding Padding}"
                                        KeyboardNavigation.TabNavigation="Continue"
                                        Grid.IsSharedSizeScope="True" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonFlyoutCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonFlyoutPadding}" />
        <Setter Property="MinWidth" Value="{DynamicResource DungeonMenuMinWidth}" />
        <Setter Property="MaxWidth" Value="{DynamicResource DungeonMenuMaxWidth}" />
        <Setter Property="MaxHeight" Value="{DynamicResource DungeonFlyoutMaxHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="WindowManagerAddShadowHint" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource DungeonFlyoutShadow}"
                        ClipToBounds="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        Margin="{TemplateBinding Padding}"
                                        KeyboardNavigation.TabNavigation="Continue"
                                        Grid.IsSharedSizeScope="True" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DungeonBaseFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Height" Value="{DynamicResource DungeonListRowHeight}" />
        <Setter Property="Padding" Value="{DynamicResource DungeonPaddingMdHorizontal}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonListRowHighlightCornerRadius}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- The outer border's transparent background catches the pointer in the gap between
                         highlights too - hover does not disappear between items. -->
                    <Border Background="Transparent">
                        <Border Name="PART_LayoutRoot"
                                Margin="{DynamicResource DungeonListRowHighlightInset}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <!-- Highlight under the menu scrollbar, content before its zone
                                 (measured from the scroll area's edge - DungeonScrollBarZoneInFlyout). -->
                            <Grid Name="ItemContent" Margin="{DynamicResource DungeonScrollBarZoneInFlyout}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DungeonMenuItemIcon" />
                                    <ColumnDefinition Width="*" />
                                    <!-- Shortcut and submenu arrow share one column at the right padding
                                         (submenu items have no shortcut) - both end on the same line. -->
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DungeonMenuItemTrailing" />
                                </Grid.ColumnDefinitions>
                                <Panel Name="PART_IconColumn"
                                       Width="{DynamicResource DungeonActionIconSize}"
                                       Height="{DynamicResource DungeonActionIconSize}"
                                       Margin="{DynamicResource DungeonMenuIconMargin}"
                                       VerticalAlignment="Center"
                                       IsVisible="False">
                                    <ContentPresenter Name="PART_IconPresenter"
                                                      Content="{TemplateBinding Icon}"
                                                      HorizontalContentAlignment="Stretch"
                                                      VerticalContentAlignment="Stretch" />
                                    <controls:ForegroundIcon Name="PART_ToggleIcon"
                                                             IsVisible="False"
                                                             Foreground="{TemplateBinding Foreground}"
                                                             Source="{DynamicResource DungeonIconCheck}" />
                                </Panel>
                                <ContentPresenter Name="PART_HeaderPresenter"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  TextBlock.TextTrimming="CharacterEllipsis"
                                                  TextBlock.TextWrapping="NoWrap"
                                                  RecognizesAccessKey="True" />
                                <TextBlock Name="PART_InputGestureText"
                                           Grid.Column="2"
                                           Margin="{DynamicResource DungeonMenuGestureMargin}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource DungeonHelperFontSize}"
                                           Foreground="{DynamicResource DungeonTextMutedBrush}"
                                           TextWrapping="NoWrap"
                                           IsVisible="{TemplateBinding InputGesture, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Text="{TemplateBinding InputGesture, Converter={StaticResource DungeonKeyGestureConverter}}" />
                                <!-- Text in the shortcut column (controls:MenuItemTrailing.Text, e.g. sort
                                     direction) - shortcut appearance; an item never has both. -->
                                <TextBlock Name="PART_TrailingText"
                                           Grid.Column="2"
                                           Margin="{DynamicResource DungeonMenuGestureMargin}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource DungeonHelperFontSize}"
                                           Foreground="{DynamicResource DungeonTextMutedBrush}"
                                           TextWrapping="NoWrap"
                                           IsVisible="{TemplateBinding (controls:MenuItemTrailing.Text), Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Text="{TemplateBinding (controls:MenuItemTrailing.Text)}" />
                                <controls:ForegroundIcon Name="PART_Chevron"
                                                         Grid.Column="2"
                                                         HorizontalAlignment="Right"
                                                         Width="{DynamicResource DungeonActionIconSize}"
                                                         Height="{DynamicResource DungeonActionIconSize}"
                                                         Margin="{DynamicResource DungeonMenuChevronMargin}"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource DungeonTextMutedBrush}"
                                                         Source="{DynamicResource DungeonIconChevronRight}" />
                            </Grid>
                        </Border>
                    </Border>
                    <Popup Name="PART_Popup"
                           WindowManagerAddShadowHint="False"
                           Placement="RightEdgeAlignedTop"
                           HorizontalOffset="{DynamicResource DungeonSubmenuHorizontalOffset}"
                           VerticalOffset="{DynamicResource DungeonSubmenuVerticalOffset}"
                           IsLightDismissEnabled="False"
                           IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
                        <Border Name="PART_SubmenuSurface"
                                MinWidth="{DynamicResource DungeonMenuMinWidth}"
                                MaxWidth="{DynamicResource DungeonMenuMaxWidth}"
                                MaxHeight="{DynamicResource DungeonFlyoutMaxHeight}"
                                Background="{DynamicResource DungeonInputBackgroundBrush}"
                                BorderBrush="{DynamicResource DungeonInputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource DungeonFlyoutCornerRadius}"
                                BoxShadow="{DynamicResource DungeonFlyoutShadow}"
                                ClipToBounds="True">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                                Margin="{DynamicResource DungeonFlyoutPadding}"
                                                Grid.IsSharedSizeScope="True" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:icon /template/ Panel#PART_IconColumn,
                         ^:toggle /template/ Panel#PART_IconColumn,
                         ^:radio /template/ Panel#PART_IconColumn">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:toggle:checked /template/ controls|ForegroundIcon#PART_ToggleIcon,
                         ^:radio:checked /template/ controls|ForegroundIcon#PART_ToggleIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:radio /template/ controls|ForegroundIcon#PART_ToggleIcon">
            <Setter Property="Source" Value="{DynamicResource DungeonIconRadioDot}" />
        </Style>
        <Style Selector="^:empty /template/ controls|ForegroundIcon#PART_Chevron">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:pointerover:not(.hover-suppressed), ^:selected, ^:pressed, ^:open">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowHoverBrush}" />
        </Style>
        <Style Selector="^.danger">
            <Setter Property="Foreground" Value="{DynamicResource DungeonDangerTextBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
