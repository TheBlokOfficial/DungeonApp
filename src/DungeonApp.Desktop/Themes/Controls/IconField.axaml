<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Icon field (controls:IconField): field frame with a leading icon and the view's text box
        inside. The icon is outside the text box - the text box starts after it and fills the remaining
        frame at full inner height, without its own border or background ("controls|IconField >
        TextBox" style in BuiltInControls.axaml - ControlTheme does not allow a descendant selector). Clicking
        the icon, beside it or on the frame border does not hit the text box: it does not place the caret
        or start selection.
        Text-box appearance: the same background, border, radius and height resources
        (DungeonControlHeight). DungeonActionIconSize icon, DungeonSpacingMd on both sides,
        muted text colour, no pointer response (not a hit-test target - the frame's arrow
        cursor). Field text starts just after the icon spacing (DungeonInputTextAfterIconMargin),
        as does the placeholder.
        Clear button (IsClearable): glyph only (DungeonFieldGlyphButton) at the end of the frame, outside
        the text box, at full inner height; visible only when the field is non-empty (CanClear).
        Does not accept focus, so clearing keeps focus in the field; clicking it or the icon
        does not end editing (Themes/EditFocusRelease.cs treats the icon field frame as a field).
        States:
          resting  - InputBackground fill, InputBorder border;
          hover    - pointer over the frame (including icon and button): InputHoverBorder border;
          editing  - focus in the field (:focus-within): InputHoverBorder throughout editing;
          disabled - DungeonDisabledOpacity once, on the frame (outermost disabled); the inner text box
                     does not dim again.
        Variants:
          .search  - search field: magnifier and clear button.
    -->
    <ControlTheme x:Key="{x:Type controls:IconField}" TargetType="controls:IconField">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Height" Value="{DynamicResource DungeonControlHeight}" />
        <!-- Content determines minimum width: the inner text box is at least
             DungeonInputMinWidth (like a regular field), so the total adds the icon
             and clear-button areas to that value. -->
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DungeonInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputBorderBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_BorderElement"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <controls:ForegroundIcon Name="PART_Icon"
                                                 Width="{DynamicResource DungeonActionIconSize}"
                                                 Height="{DynamicResource DungeonActionIconSize}"
                                                 Margin="{DynamicResource DungeonPaddingMdHorizontal}"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False"
                                                 Foreground="{DynamicResource DungeonTextMutedBrush}"
                                                 Source="{TemplateBinding Icon}" />
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Button Name="PART_ClearButton"
                                Grid.Column="2"
                                Theme="{StaticResource DungeonFieldGlyphButton}"
                                IsVisible="{TemplateBinding CanClear}">
                            <controls:ForegroundIcon Width="{DynamicResource DungeonActionIconSize}"
                                                     Height="{DynamicResource DungeonActionIconSize}"
                                                     Source="{DynamicResource DungeonIconClear}" />
                        </Button>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.search">
            <Setter Property="Icon" Value="{DynamicResource DungeonIconSearch}" />
            <Setter Property="IsClearable" Value="True" />
        </Style>

        <!-- Hover and editing: same border as the text box; editing keeps it without the pointer. -->
        <Style Selector="^:pointerover, ^:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonInputHoverBorderBrush}" />
        </Style>
        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
