<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Keyboard focus ring: the one appearance of focus for every control that takes focus with Tab or
        the arrow keys (the library shows a FocusAdorner only for keyboard focus, never for a click).
        A ring of DungeonFocusRingBrush, DungeonFocusRingThickness wide, standing outside the control's
        edge (DungeonFocusRingOffset), over the neighbours, so it moves nothing.
        An adorner cannot read the control's own CornerRadius, so there is one template per shape; the ring's
        radius is the control's radius plus the gap and the thickness:
          Control - buttons, fields, chips, tabs, toggles (DungeonControlCornerRadius family);
          Row     - list rows, segments (DungeonListRowHighlightCornerRadius family).
        The library clips an adorner to the adorned control's own bounds when that control clips to bounds,
        so every theme that takes a ring also sets ClipToBounds False, or the ring would be cut off entirely.
        A control theme takes one with <Setter Property="FocusAdorner" Value="{StaticResource ...}" />.
        Controls with no ring say why next to their FocusAdorner (menus: the highlight is the focus; a
        container: the item inside it shows focus; a field: the border and caret do).
    -->
    <FocusAdornerTemplate x:Key="DungeonFocusAdornerControl">
        <Border Margin="{DynamicResource DungeonFocusRingOffset}"
                BorderBrush="{DynamicResource DungeonFocusRingBrush}"
                BorderThickness="{DynamicResource DungeonFocusRingThickness}"
                CornerRadius="{DynamicResource DungeonFocusRingControlCornerRadius}"
                IsHitTestVisible="False" />
    </FocusAdornerTemplate>
    <FocusAdornerTemplate x:Key="DungeonFocusAdornerRow">
        <Border Margin="{DynamicResource DungeonFocusRingOffset}"
                BorderBrush="{DynamicResource DungeonFocusRingBrush}"
                BorderThickness="{DynamicResource DungeonFocusRingThickness}"
                CornerRadius="{DynamicResource DungeonFocusRingRowCornerRadius}"
                IsHitTestVisible="False" />
    </FocusAdornerTemplate>
</ResourceDictionary>
