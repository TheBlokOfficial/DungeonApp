<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Header value (controls:StatTile): "KP", "PW", speed in the card header. No background, border
        or padding - just a text column on the card; several sit side by side in equal-width
        columns, with spacing supplied by the view. Without a border the number leads the eye, so top to bottom:
          label - DungeonStatTileIconSize icon and caption text, both muted (TextMuted);
          value - stat-value-lg (same font and weight as ability-table numbers, larger size),
            regular text;
          note - muted caption; its line always exists, even when empty (empty, zero-width
            " " in the same style), so values in one row have equal height
            and bottom alignment, with or without a note.
        Each text wraps within its column.
        No states: no pointer response or focus; text is selectable (SelectableTextBlock).
        Disabled - DungeonDisabledOpacity unless an ancestor already dims it.
    -->
    <ControlTheme x:Key="{x:Type controls:StatTile}" TargetType="controls:StatTile">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource DungeonSpacingXs}">
                        <controls:ForegroundIcon Width="{DynamicResource DungeonStatTileIconSize}"
                                                 Height="{DynamicResource DungeonStatTileIconSize}"
                                                 VerticalAlignment="Center"
                                                 Source="{TemplateBinding Icon}"
                                                 Foreground="{DynamicResource DungeonTextMutedBrush}"
                                                 IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <SelectableTextBlock Name="PART_Label"
                                             Grid.Column="1"
                                             Classes="caption"
                                             Text="{TemplateBinding Label}"
                                             Foreground="{DynamicResource DungeonTextMutedBrush}"
                                             VerticalAlignment="Center"
                                             TextWrapping="Wrap" />
                    </Grid>
                    <SelectableTextBlock Name="PART_Value"
                                         Classes="stat-value-lg"
                                         Text="{TemplateBinding Value}"
                                         Foreground="{TemplateBinding Foreground}"
                                         TextWrapping="Wrap" />
                    <Panel>
                        <TextBlock Classes="caption" Text=" " Width="0" IsHitTestVisible="False" />
                        <SelectableTextBlock Name="PART_Note"
                                             Classes="caption"
                                             Text="{TemplateBinding Note}"
                                             Foreground="{DynamicResource DungeonTextMutedBrush}"
                                             TextWrapping="Wrap"
                                             IsVisible="{TemplateBinding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </Panel>
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:disabled:not(:disabled :disabled)">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
