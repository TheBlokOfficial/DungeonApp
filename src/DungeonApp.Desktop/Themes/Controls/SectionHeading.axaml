<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DungeonApp.Desktop.Controls">

    <!--
        Section heading (controls:SectionHeading): start of a card text section. One row, vertically
        centred: accent bar (Accent - section starts here; DungeonSectionHeadingBarWidth
        x DungeonSectionHeadingBarHeight, square ends) and display-md title (decorative font 20,
        SemiBold), regular text. No icon: title identifies the section, while an image at
        every heading only adds noise. DungeonSpacingSm between parts. Bar sits
        at the left edge - aligned with section content below the heading.
        No states: does not collapse anything, respond to the pointer or accept focus; title is selectable.
    -->
    <ControlTheme x:Key="{x:Type controls:SectionHeading}" TargetType="controls:SectionHeading">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingSm}">
                    <Border Name="PART_Bar"
                            Width="{DynamicResource DungeonSectionHeadingBarWidth}"
                            Height="{DynamicResource DungeonSectionHeadingBarHeight}"
                            VerticalAlignment="Center"
                            Background="{DynamicResource DungeonAccentBrush}" />
                    <SelectableTextBlock Name="PART_Text"
                                         Classes="display-md"
                                         Text="{TemplateBinding Text}"
                                         Foreground="{TemplateBinding Foreground}"
                                         VerticalAlignment="Center" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
