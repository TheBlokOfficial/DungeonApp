<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DungeonApp.Desktop.Controls"
        xmlns:themes="using:DungeonApp.Desktop.Themes">
    <!--
        Disabled system animations disable application animations. SystemMotion includes these styles at
        startup only when Windows animations are off; styles override control themes,
        removing their transitions - state changes immediately, without motion. Every shell-theme transition
        (DungeonMotionDuration) has an entry here.
    -->
    <Style Selector="ToggleSwitch">
        <Setter Property="KnobTransitions" Value="{x:Null}" />
    </Style>
    <Style Selector="ToggleSwitch /template/ Border#PART_Track">
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="ComboBox /template/ controls|ForegroundIcon#PART_DropDownGlyph,
                     controls|DropDownPicker /template/ controls|ForegroundIcon#PART_DropDownGlyph,
                     Button /template/ controls|ForegroundIcon#PART_DropDownGlyph,
                     Expander /template/ ToggleButton#ExpanderHeader /template/ controls|ForegroundIcon#PART_Chevron">
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <!-- Flyout, dropdown and menu opening without motion (Themes/PopupOpenMotion.cs). -->
    <Style Selector="FlyoutPresenter, MenuFlyoutPresenter, ContextMenu, MenuItem /template/ Border#PART_SubmenuSurface">
        <Setter Property="themes:PopupOpenMotion.IsEnabled" Value="False" />
    </Style>
</Styles>
