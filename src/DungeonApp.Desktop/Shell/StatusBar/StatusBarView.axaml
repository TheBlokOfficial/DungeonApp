<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DungeonApp.Desktop.Shell.StatusBar"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="24"
             x:Class="DungeonApp.Desktop.Shell.StatusBar.StatusBarView"
             x:DataType="vm:StatusBarViewModel">
    <Border Background="{DynamicResource DungeonSurfaceBrush}"
            BorderBrush="{DynamicResource DungeonBorderBrush}"
            BorderThickness="0,1,0,0">
        <Grid Margin="12,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource DungeonSidebarWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Image Width="12" Height="12" Source="{StaticResource DungeonIconDatabase}" />
                <TextBlock FontSize="{DynamicResource DungeonStatusFontSize}" Foreground="{DynamicResource DungeonTextMutedBrush}" Text="Dane lokalne" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource DungeonStatusFontSize}"
                       Foreground="{DynamicResource DungeonTextMutedBrush}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Message}" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource DungeonStatusFontSize}"
                       Foreground="{DynamicResource DungeonTextMutedBrush}"
                       Text="Ctrl+K · polecenia" />
        </Grid>
    </Border>
</UserControl>
