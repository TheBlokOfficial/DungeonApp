<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DungeonApp.Desktop.Shell.Sidebars"
             xmlns:navigation="using:DungeonApp.Desktop.Shell.Navigation"
             xmlns:settings="using:DungeonApp.Desktop.Settings"
             mc:Ignorable="d"
             d:DesignWidth="216"
             d:DesignHeight="728"
             x:Class="DungeonApp.Desktop.Shell.Sidebars.GlobalSidebarView"
             x:DataType="vm:GlobalSidebarViewModel">
    <UserControl.Resources>
        <navigation:ResourceKeyToImageConverter x:Key="IconResourceConverter" />
        <DataTemplate x:Key="NavigationItemTemplate" x:DataType="vm:NavigationItemViewModel">
            <Grid Height="{DynamicResource DungeonNavigationRowHeight}" ColumnDefinitions="24,*" ColumnSpacing="8">
                <Image Width="{DynamicResource DungeonActionIconSize}"
                       Height="{DynamicResource DungeonActionIconSize}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Source="{Binding IconResourceKey, Converter={StaticResource IconResourceConverter}}" />
                <TextBlock Grid.Column="1"
                           Classes="nav-label"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Label}"
                           Text="{Binding Label}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- In the compact variant only icons + tooltips remain; see docs/ui/information-architecture.md -->
        <Style Selector="Border.compact TextBlock.nav-label">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.nav-button">
            <Setter Property="Height" Value="{DynamicResource DungeonNavigationRowHeight}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.nav-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHoverBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource DungeonSurfaceBrush}"
            BorderBrush="{DynamicResource DungeonBorderBrush}"
            BorderThickness="0,0,1,0"
            Classes.compact="{Binding IsCompact}">
        <Grid Margin="8,16,8,8" RowDefinitions="24,Auto,*,40,40">
            <TextBlock Margin="8,0"
                       Classes="eyebrow nav-label"
                       Foreground="{DynamicResource DungeonTextMutedBrush}"
                       LetterSpacing="1"
                       VerticalAlignment="Center"
                       Text="BIBLIOTEKA" />

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding LibraryItems}"
                     SelectedIndex="0"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemTemplate="{StaticResource NavigationItemTemplate}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Height" Value="{DynamicResource DungeonNavigationRowHeight}" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="4,1,1,1" />
                        <Setter Property="FontSize" Value="{DynamicResource DungeonNavigationFontSize}" />
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="Stretch"
                                                      VerticalContentAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHoverBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DungeonSurfaceHoverBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{DynamicResource DungeonSurfaceActiveBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DungeonAccentBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected:pointerover">
                        <Setter Property="Background" Value="{DynamicResource DungeonSurfaceActiveBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DungeonAccentBrush}" />
                    </Style>
                </ListBox.Styles>
            </ListBox>

            <Button Grid.Row="3"
                    Classes="nav-button"
                    Content="{Binding SettingsItem}"
                    ContentTemplate="{StaticResource NavigationItemTemplate}">
                <Button.Flyout>
                    <Flyout Placement="RightEdgeAlignedTop">
                        <StackPanel DataContext="{Binding QuickSettings}"
                                    x:DataType="settings:QuickSettingsViewModel"
                                    Width="200"
                                    Spacing="8">
                            <TextBlock Classes="eyebrow" Text="WIELKOŚĆ INTERFEJSU" />
                            <Button Classes.primary="{Binding IsSmallSelected}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding SelectSmallCommand}"
                                    Content="Mały" />
                            <Button Classes.primary="{Binding IsMediumSelected}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding SelectMediumCommand}"
                                    Content="Średni" />
                            <Button Classes.primary="{Binding IsLargeSelected}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding SelectLargeCommand}"
                                    Content="Duży" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button Grid.Row="4"
                    Classes="nav-button"
                    Command="{Binding ToggleSidebarVariantCommand}"
                    ToolTip.Tip="{Binding ToggleActionLabel}">
                <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                    <Image Width="{DynamicResource DungeonActionIconSize}"
                           Height="{DynamicResource DungeonActionIconSize}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Source="{StaticResource DungeonIconChevronRight}" />
                    <TextBlock Grid.Column="1"
                               Classes="nav-label"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding ToggleActionLabel}" />
                </Grid>
            </Button>
        </Grid>
    </Border>
</UserControl>
