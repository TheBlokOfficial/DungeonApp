<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DungeonApp.Desktop.Shell.Sidebars"
             xmlns:controls="using:DungeonApp.Desktop.Controls"
             xmlns:easings="clr-namespace:Avalonia.Animation.Easings;assembly=Avalonia.Base"
             mc:Ignorable="d"
             d:DesignWidth="216"
             d:DesignHeight="728"
             x:Class="DungeonApp.Desktop.Shell.Sidebars.GlobalSidebarView"
             x:DataType="vm:GlobalSidebarViewModel">
    <UserControl.Resources>
        <controls:ResourceKeyToImageConverter x:Key="IconResourceConverter" />
        <!-- Shared by every row in every category - the campaign position, a Campaign-category tab,
             a System-category tab, and "Zmień system" alike - so a row's category never shows in its
             own visual shape, only in which group on the page it sits in. -->
        <DataTemplate x:Key="NavigationItemTemplate" x:DataType="vm:NavigationItemViewModel">
            <Button Classes="nav-button"
                    Classes.active="{Binding IsActive}"
                    Command="{Binding SelectCommand}"
                    IsEnabled="{Binding IsEnabled}"
                    RenderTransform="{x:Null}"
                    Transitions="{x:Null}">
                <Grid Classes="nav-content" ColumnDefinitions="64,*">
                    <Image Width="{DynamicResource DungeonActionIconSize}"
                           Height="{DynamicResource DungeonActionIconSize}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Source="{Binding IconResourceKey, Converter={StaticResource IconResourceConverter}}" />
                    <TextBlock Grid.Column="1"
                               Classes="nav-label"
                               Classes.locked="{Binding IsLocked}"
                               Margin="-8,0,12,0"
                               Opacity="{Binding LabelOpacity}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Label}">
                        <TextBlock.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                            </Transitions>
                        </TextBlock.Transitions>
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="{Binding LabelOffset}">
                                <TranslateTransform.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="X" Duration="0:0:0.18" />
                                    </Transitions>
                                </TranslateTransform.Transitions>
                            </TranslateTransform>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Fully custom and transition-free: navigation feedback changes immediately. Explicit
             transparent black also prevents a future brush transition from interpolating through
             Avalonia's named Transparent color, whose RGB channels are white. -->
        <Style Selector="Button.nav-button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource DungeonNavigationCornerRadius}" />
            <Setter Property="Background" Value="#00000000" />
            <Setter Property="BorderBrush" Value="#00000000" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="{DynamicResource DungeonNavigationFontSize}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Pasek akcentu jest nakładką o stałej szerokości, nie wcięciem
                         przez BorderThickness: BorderThickness zmniejsza obszar wypełnienia
                         tła, więc obramowanie przezroczyste (hover) i nieprzezroczyste
                         (aktywny) pokrywałyby różne szerokości. Wypełnienie zawsze na pełnych
                         granicach, a pasek warstwą na wierzchu — dzięki temu hover i stan
                         aktywny są identyczne co do piksela poza samym paskiem. -->
                    <Grid>
                        <Border Margin="8,0"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border Width="4"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Left"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{TemplateBinding BorderBrush}" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.nav-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonFrameHoverBrush}" />
        </Style>
        <!-- .active is hit-test-disabled (see the Button in NavigationItemTemplate), so it never
             receives pointer events and needs no :pointerover/:pressed override of its own. -->
        <Style Selector="Button.nav-button.active">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceActiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonAccentBrush}" />
        </Style>
        <!-- A locked Campaign-category tab: greyed out and inert (docs/tasks.md, etap 1: "wyszarzone,
             z kłódką zamiast ikony, nieklikalne"). IsEnabled="False" on the button already drops
             pointer feedback; this only has to dim it. -->
        <Style Selector="Button.nav-button:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="TextBlock.nav-label.locked">
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        </Style>
        <Style Selector="Button.sidebar-toggle">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource DungeonNavigationCornerRadius}" />
        </Style>
        <Style Selector="Button.sidebar-toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonFrameHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <!-- The hairline that separates Kampania from System, and System from Aplikacja - same
             1px-literal divider as the sidebar's own right-hand edge below, not a token: a rule
             this thin has no size token of its own in DungeonApp.Desktop/Themes/Tokens.axaml. -->
        <Style Selector="Border.nav-separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="{DynamicResource DungeonPaddingSm}" />
            <Setter Property="Background" Value="{DynamicResource DungeonBorderBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Chrome deliberately differs from the flat backstage canvas. The campaign grid remains
         exclusive to an open campaign; the contrast here gives static screens depth without it. -->
    <Border Background="{DynamicResource DungeonFrameBrush}"
            ClipToBounds="True">
        <Grid>
        <Grid RowDefinitions="Auto,*">
            <!-- The brand belongs with global navigation, so static backstage pages do not spend
                 a second horizontal strip repeating application chrome. -->
            <Border BorderBrush="{DynamicResource DungeonBorderStrongBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Height="52">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="64,*">
                        <Border Width="64"
                                Height="40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="{Binding CollapsibleTextOpacity}">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                </Transitions>
                            </Border.Transitions>
                            <Border.RenderTransform>
                                <TranslateTransform X="{Binding CollapsibleTextOffset}">
                                    <TranslateTransform.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="X" Duration="0:0:0.18">
                                                <DoubleTransition.Easing>
                                                    <easings:CubicEaseInOut />
                                                </DoubleTransition.Easing>
                                            </DoubleTransition>
                                        </Transitions>
                                    </TranslateTransform.Transitions>
                                </TranslateTransform>
                            </Border.RenderTransform>
                            <Border Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource DungeonBorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource DungeonControlCornerRadius}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource DungeonDisplayFont}"
                                           FontSize="{DynamicResource DungeonBrandMarkFontSize}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                                           Text="D" />
                            </Border>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Margin="-8,0,12,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource DungeonDisplayFont}"
                                   FontSize="{DynamicResource DungeonBrandNameFontSize}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                                   Opacity="{Binding CollapsibleTextOpacity}"
                                   Text="DungeonApp">
                            <TextBlock.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                </Transitions>
                            </TextBlock.Transitions>
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="{Binding CollapsibleTextOffset}">
                                    <TranslateTransform.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="X" Duration="0:0:0.18" />
                                        </Transitions>
                                    </TranslateTransform.Transitions>
                                </TranslateTransform>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>

                    <!-- One persistent toggle follows the sidebar's right-hand 64px rail. As the
                         panel narrows, that rail naturally lands on the navigation icon axis and
                         replaces the fading brand mark without changing containers or rows. -->
                    <Grid Width="64"
                          HorizontalAlignment="Right">
                        <Button Classes="sidebar-toggle"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding ToggleCollapsedCommand}">
                            <Image Width="{DynamicResource DungeonActionIconSize}"
                                   Height="{DynamicResource DungeonActionIconSize}"
                                   Source="{StaticResource DungeonIconMenu}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Three categories, top to bottom: Kampania (campaign position + the chosen system's
                 campaign tabs), System (the chosen system's own tabs), Aplikacja ("Zmień system") -
                 separated by hairlines, without headings of their own (docs/tasks.md, etap 1:
                 "rozdzielone separatorem, bez nagłówków"). -->
            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                <ContentPresenter Content="{Binding CampaignPositionItem}" ContentTemplate="{StaticResource NavigationItemTemplate}" />
                <ItemsControl ItemsSource="{Binding CampaignTabItems}" ItemTemplate="{StaticResource NavigationItemTemplate}" />

                <Border Classes="nav-separator" />
                <ItemsControl ItemsSource="{Binding SystemTabItems}" ItemTemplate="{StaticResource NavigationItemTemplate}" />

                <Border Classes="nav-separator" />
                <ContentPresenter Content="{Binding ChangeSystemItem}" ContentTemplate="{StaticResource NavigationItemTemplate}" />
            </StackPanel>
        </Grid>
        <Border Width="1"
                HorizontalAlignment="Right"
                Background="{DynamicResource DungeonBorderStrongBrush}"
                IsHitTestVisible="False" />
        </Grid>
    </Border>
</UserControl>
