<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DungeonApp.Desktop.Shell.Sidebars"
             xmlns:controls="using:DungeonApp.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="216"
             d:DesignHeight="728"
             x:Class="DungeonApp.Desktop.Shell.Sidebars.GlobalSidebarView"
             x:DataType="vm:GlobalSidebarViewModel">
    <UserControl.Resources>
        <controls:ResourceKeyToImageConverter x:Key="IconResourceConverter" />
        <DataTemplate x:Key="NavigationItemTemplate" x:DataType="vm:NavigationItemViewModel">
            <Button Classes="nav-button"
                    Classes.active="{Binding IsActive}"
                    Command="{Binding SelectCommand}"
                    IsHitTestVisible="{Binding !IsActive}"
                    RenderTransform="{x:Null}"
                    Transitions="{x:Null}">
                <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                    <Image Width="{DynamicResource DungeonActionIconSize}"
                           Height="{DynamicResource DungeonActionIconSize}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Source="{Binding IconResourceKey, Converter={StaticResource IconResourceConverter}}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Label}"
                               Text="{Binding Label}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Fully custom template: the FluentTheme default Button template reacts to :pointerover
             and :pressed in ways we don't fully control from the outside (a hover border tint, a
             press-darken effect) even when its own property values are overridden. Owning the
             whole visual here means only the states below can ever affect its look. -->
        <Style Selector="Button.nav-button">
            <Setter Property="Height" Value="{DynamicResource DungeonNavigationRowHeight}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="4,1,1,1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="{DynamicResource DungeonNavigationFontSize}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.nav-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceHoverBrush}" />
        </Style>
        <!-- .active is hit-test-disabled (see the Button in NavigationItemTemplate), so it never
             receives pointer events and needs no :pointerover/:pressed override of its own. -->
        <Style Selector="Button.nav-button.active">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceActiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource DungeonSurfaceBrush}"
            BorderBrush="{DynamicResource DungeonBorderBrush}"
            BorderThickness="0,0,1,0">
        <Grid Margin="8,16,8,8" RowDefinitions="24,Auto,*,24,Auto">
            <TextBlock Margin="8,0"
                       Classes="eyebrow"
                       Foreground="{DynamicResource DungeonTextMutedBrush}"
                       LetterSpacing="1"
                       VerticalAlignment="Center"
                       Text="BIBLIOTEKA" />

            <ItemsControl Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding LibraryItems}"
                          ItemTemplate="{StaticResource NavigationItemTemplate}" />

            <TextBlock Grid.Row="3"
                       Margin="8,0"
                       Classes="eyebrow"
                       Foreground="{DynamicResource DungeonTextMutedBrush}"
                       LetterSpacing="1"
                       VerticalAlignment="Center"
                       Text="SYSTEM" />

            <ItemsControl Grid.Row="4"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding SystemItems}"
                          ItemTemplate="{StaticResource NavigationItemTemplate}" />
        </Grid>
    </Border>
</UserControl>
