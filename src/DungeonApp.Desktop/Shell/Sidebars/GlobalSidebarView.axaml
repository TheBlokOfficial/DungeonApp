<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DungeonApp.Desktop.Shell.Sidebars"
             xmlns:controls="using:DungeonApp.Desktop.Controls"
             xmlns:easings="clr-namespace:Avalonia.Animation.Easings;assembly=Avalonia.Base"
             mc:Ignorable="d"
             d:DesignWidth="216"
             d:DesignHeight="728"
             x:Class="DungeonApp.Desktop.Shell.Sidebars.GlobalSidebarView"
             x:DataType="vm:GlobalSidebarViewModel">
    <UserControl.Resources>
        <controls:ResourceKeyToImageConverter x:Key="IconResourceConverter" />

        <!-- Pas kreski zaznaczenia wierszy nawigacji (ListRow): odstęp kreski od tła wiersza 12,
             wcięcie z góry i z dołu 6 (mockup .sidebar-item.active::before: left -12, top/bottom 6).
             Pasek nie ma przewijania: wiersz nie zostawia strefy paska (DungeonScrollBarZone 0). -->
        <x:Double x:Key="DungeonListRowStripeGutter">12</x:Double>
        <Thickness x:Key="DungeonListRowStripeInset">0,6</Thickness>
        <Thickness x:Key="DungeonScrollBarZone">0</Thickness>
        <!-- Shared by every row in every category - the campaign position, a Campaign-category tab,
             a System-category tab, and "Zmień system" alike - so a row's category never shows in its
             own visual shape, only in which group on the page it sits in. -->
        <DataTemplate x:Key="NavigationItemTemplate" x:DataType="vm:NavigationItemViewModel">
            <!-- Wiersz ramy (ListRow) z kreską; aktywna pozycja = wybrana. Ikona na środku kolumny 40
                 za pasem kreski (12) - na środku zwiniętego paska (64), tło wiersza kwadratem 40. -->
            <controls:ListRow ShowsSelectionStripe="True"
                              IsSelected="{Binding IsActive}"
                              Command="{Binding SelectCommand}"
                              IsEnabled="{Binding IsEnabled}">
                <Grid Classes="nav-content" ColumnDefinitions="40,*">
                    <Image Width="{DynamicResource DungeonActionIconSize}"
                           Height="{DynamicResource DungeonActionIconSize}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Source="{Binding IconResourceKey, Converter={StaticResource IconResourceConverter}}" />
                    <TextBlock Grid.Column="1"
                               Classes="nav-label"
                               Classes.locked="{Binding IsLocked}"
                               Margin="4,0,4,0"
                               Opacity="{Binding LabelOpacity}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Label}">
                        <TextBlock.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                            </Transitions>
                        </TextBlock.Transitions>
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="{Binding LabelOffset}">
                                <TranslateTransform.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="X" Duration="0:0:0.18" />
                                    </Transitions>
                                </TranslateTransform.Transitions>
                            </TranslateTransform>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </controls:ListRow>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Wymiary wierszy nawigacji (styl listy): wysokość 40 zamiast wysokości wiersza listy ramy,
             bez wcięcia treści (kolumny siatki wiersza dają położenie ikony i etykiety), prawy odstęp
             12 - tło wiersza stoi symetrycznie między pasem kreski a krawędzią paska. -->
        <Style Selector="controls|ListRow">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style Selector="TextBlock.nav-label.locked">
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Chrome deliberately differs from the flat backstage canvas. The campaign grid remains
         exclusive to an open campaign; the contrast here gives static screens depth without it. -->
    <Border Background="{DynamicResource DungeonFrameBrush}"
            ClipToBounds="True">
        <Grid>
        <!-- Third row: the Aplikacja category, pinned to the sidebar's own bottom edge (docs/
             architecture.md, "Pasek boczny: trzy kategorie" - this row's own screen label is
             "SYSTEM", not "Aplikacja"; see the heading TextBlock below). Because the middle row is
             "*" and this one is "Auto", this row's bottom edge is always the Grid's own bottom edge,
             whatever its Auto height is - which is exactly what makes its items' Y position collapse-
             invariant: collapsing only shrinks this row's own heading (HeadingHeight, animated, same
             as every other heading), and since the row's total height shrinks by exactly that amount
             while its bottom edge stays fixed, the items immediately below the heading end up at the
             same absolute Y either way. -->
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- The brand belongs with global navigation, so static backstage pages do not spend
                 a second horizontal strip repeating application chrome. -->
            <Border BorderBrush="{DynamicResource DungeonBorderStrongBrush}"
                    BorderThickness="0,0,0,1">
                <!-- Height shared with the top bar (DungeonTopBarHeight, Themes/Tokens.axaml) so this
                     border's own bottom edge and the top bar's continue as one line. -->
                <Grid Height="{DynamicResource DungeonTopBarHeight}">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="64,*">
                        <Border Width="64"
                                Height="40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="{Binding CollapsibleTextOpacity}">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                </Transitions>
                            </Border.Transitions>
                            <Border.RenderTransform>
                                <TranslateTransform X="{Binding CollapsibleTextOffset}">
                                    <TranslateTransform.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="X" Duration="0:0:0.18">
                                                <DoubleTransition.Easing>
                                                    <easings:CubicEaseInOut />
                                                </DoubleTransition.Easing>
                                            </DoubleTransition>
                                        </Transitions>
                                    </TranslateTransform.Transitions>
                                </TranslateTransform>
                            </Border.RenderTransform>
                            <Border Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource DungeonBorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource DungeonControlCornerRadius}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource DungeonDisplayFont}"
                                           FontSize="{DynamicResource DungeonBrandMarkFontSize}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                                           Text="D" />
                            </Border>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Margin="-8,0,12,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource DungeonDisplayFont}"
                                   FontSize="{DynamicResource DungeonBrandNameFontSize}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                                   Opacity="{Binding CollapsibleTextOpacity}"
                                   Text="DungeonApp">
                            <TextBlock.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                </Transitions>
                            </TextBlock.Transitions>
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="{Binding CollapsibleTextOffset}">
                                    <TranslateTransform.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="X" Duration="0:0:0.18" />
                                        </Transitions>
                                    </TranslateTransform.Transitions>
                                </TranslateTransform>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>

                    <!-- One persistent toggle follows the sidebar's right-hand 64px rail. As the
                         panel narrows, that rail naturally lands on the navigation icon axis and
                         replaces the fading brand mark without changing containers or rows. -->
                    <Grid Width="64"
                          HorizontalAlignment="Right">
                        <Button Classes="subtle icon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding ToggleCollapsedCommand}">
                            <controls:ForegroundIcon Width="{DynamicResource DungeonActionIconSize}"
                                                     Height="{DynamicResource DungeonActionIconSize}"
                                                     Source="{StaticResource DungeonIconMenu}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Two groups here, top to bottom: Kampania (campaign position + the chosen system's
                 campaign tabs) and System (the chosen system's own tabs, shown on screen as
                 "BIBLIOTEKA" - see that heading's Text below). The third category, Aplikacja, is its
                 own sibling at Grid.Row="2" below, pinned to the sidebar's bottom edge - see the
                 comment on the outer Grid's RowDefinitions.
                 Each heading fades and slides the same way 555802f's single "BIBLIOTEKA KAMPANII"
                 heading did (CollapsibleTextOpacity/Offset, unchanged). Etap 1 had replaced this with
                 an unheaded separator (docs/tasks.md); the author vetoed that, and still does - no
                 separator was added for the gap between these two groups either, only spacing.

                 Collapsing no longer slides the item list under a still-reserved heading row
                 (NavigationItemsOffset, the etap-1 restore's approach): a translate by one heading's
                 height only ever closed the gap within its own group, leaving every later group's
                 still full-height heading row as a dead gap below it. Instead each heading's own
                 Border animates its Height between 44 (unchanged literal, the row height this sidebar
                 already used) and 0, same 0.18s CubicEaseInOut as before; the surrounding Grid's Auto
                 row then reflows every row beneath it every frame, so both groups close in one
                 continuous motion with no reserved space left behind.

                 DungeonSpacingLg between the two groups - not the heading-collapse mechanics alone -
                 is what keeps a deliberate, designed gap between Kampania and Biblioteka once
                 collapsed (the author's own call: the two must stay visibly separate groups, not
                 read as one continuous list the way every other adjacent pair of rows does). -->
            <StackPanel Grid.Row="1" Spacing="{DynamicResource DungeonSpacingLg}">
                <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0"
                            Height="{Binding HeadingHeight}"
                            ClipToBounds="True">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Height" Duration="0:0:0.18">
                                    <DoubleTransition.Easing>
                                        <easings:CubicEaseInOut />
                                    </DoubleTransition.Easing>
                                </DoubleTransition>
                            </Transitions>
                        </Border.Transitions>
                        <TextBlock Margin="16,0,64,3"
                                   Classes="sidebar-section-heading eyebrow"
                                   Foreground="{DynamicResource DungeonTextMutedBrush}"
                                   Opacity="{Binding CollapsibleTextOpacity}"
                                   LetterSpacing="0.7"
                                   VerticalAlignment="Bottom"
                                   Text="KAMPANIA">
                            <TextBlock.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                </Transitions>
                            </TextBlock.Transitions>
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="{Binding CollapsibleTextOffset}">
                                    <TranslateTransform.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="X" Duration="0:0:0.18" />
                                        </Transitions>
                                    </TranslateTransform.Transitions>
                                </TranslateTransform>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="{DynamicResource DungeonSpacingXs}">
                        <ItemsControl ItemsSource="{Binding CampaignItems}" ItemTemplate="{StaticResource NavigationItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{DynamicResource DungeonSpacingXs}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0"
                            Height="{Binding HeadingHeight}"
                            ClipToBounds="True">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Height" Duration="0:0:0.18">
                                    <DoubleTransition.Easing>
                                        <easings:CubicEaseInOut />
                                    </DoubleTransition.Easing>
                                </DoubleTransition>
                            </Transitions>
                        </Border.Transitions>
                        <!-- Screen label "BIBLIOTEKA" - the SystemTabItems binding and every C#
                             identifier around it keep naming this the System category (docs/
                             collaboration.md: labels on screen change, code vocabulary does not). -->
                        <TextBlock Margin="16,0,64,3"
                                   Classes="sidebar-section-heading eyebrow"
                                   Foreground="{DynamicResource DungeonTextMutedBrush}"
                                   Opacity="{Binding CollapsibleTextOpacity}"
                                   LetterSpacing="0.7"
                                   VerticalAlignment="Bottom"
                                   Text="BIBLIOTEKA">
                            <TextBlock.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                </Transitions>
                            </TextBlock.Transitions>
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="{Binding CollapsibleTextOffset}">
                                    <TranslateTransform.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="X" Duration="0:0:0.18" />
                                        </Transitions>
                                    </TranslateTransform.Transitions>
                                </TranslateTransform>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding SystemTabItems}" ItemTemplate="{StaticResource NavigationItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{DynamicResource DungeonSpacingXs}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </StackPanel>

            <!-- Aplikacja, pinned to the bottom (see the outer Grid's RowDefinitions comment) -
                 screen label "SYSTEM", today just "Ustawienia" (a frame-owned, always-empty
                 position). Margin retained verbatim from 555802f's single trailing group margin,
                 relocated here since this is now the actual last visible group. -->
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
                <Border Grid.Row="0"
                        Height="{Binding HeadingHeight}"
                        ClipToBounds="True">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Height" Duration="0:0:0.18">
                                <DoubleTransition.Easing>
                                    <easings:CubicEaseInOut />
                                </DoubleTransition.Easing>
                            </DoubleTransition>
                        </Transitions>
                    </Border.Transitions>
                    <TextBlock Margin="16,0,64,3"
                               Classes="sidebar-section-heading eyebrow"
                               Foreground="{DynamicResource DungeonTextMutedBrush}"
                               Opacity="{Binding CollapsibleTextOpacity}"
                               LetterSpacing="0.7"
                               VerticalAlignment="Bottom"
                               Text="SYSTEM">
                        <TextBlock.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                            </Transitions>
                        </TextBlock.Transitions>
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="{Binding CollapsibleTextOffset}">
                                <TranslateTransform.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="X" Duration="0:0:0.18" />
                                    </Transitions>
                                </TranslateTransform.Transitions>
                            </TranslateTransform>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Border>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding ApplicationItems}" ItemTemplate="{StaticResource NavigationItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{DynamicResource DungeonSpacingXs}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Grid>
        <Border Width="1"
                HorizontalAlignment="Right"
                Background="{DynamicResource DungeonBorderStrongBrush}"
                IsHitTestVisible="False" />
        </Grid>
    </Border>
</UserControl>
