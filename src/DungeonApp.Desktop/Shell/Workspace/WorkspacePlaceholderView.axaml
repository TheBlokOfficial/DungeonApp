<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workspace="using:DungeonApp.Desktop.Shell.Workspace"
             x:Class="DungeonApp.Desktop.Shell.Workspace.WorkspacePlaceholderView"
             x:DataType="workspace:WorkspacePlaceholderViewModel">

    <!-- The shell owns the persistent backstage surface. Keeping this root transparent means a
         page transition fades only the changing content and never exposes the window underneath. -->
    <Grid>
        <TextBlock Text="{Binding Title}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource DungeonWorkspaceTitleFontSize}"
                   Foreground="{DynamicResource DungeonTextMutedBrush}" />
    </Grid>
</UserControl>
