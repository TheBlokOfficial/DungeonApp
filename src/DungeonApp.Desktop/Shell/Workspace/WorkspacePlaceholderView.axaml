<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workspace="using:DungeonApp.Desktop.Shell.Workspace"
             x:Class="DungeonApp.Desktop.Shell.Workspace.WorkspacePlaceholderView"
             x:DataType="workspace:WorkspacePlaceholderViewModel">

    <!--
        Backstage: a flat surface in the tone of the application frame. Both the recess and the grid
        belong to a live session alone, so a static configuration screen shows neither - see
        docs/ui/visual-direction.md, "Zaplecze i stol".
    -->
    <Grid Background="{DynamicResource DungeonSurfaceBrush}">
        <TextBlock Text="{Binding Title}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource DungeonWorkspaceTitleFontSize}"
                   Foreground="{DynamicResource DungeonTextMutedBrush}" />
    </Grid>
</UserControl>
