<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Desktop.Shell.Gallery.Sections.TextFieldsSection">
    <!-- Every TextBox variant from the frame's ControlTheme (Themes/Controls/TextBox.axaml), live: one
         row per kind of field in its states - empty with placeholder, with text, with text longer than
         the field, disabled. Every field has the same fixed width, so the long text shows it scrolls
         inside instead of widening the field. Nothing here restyles a field - the only local value is
         that width. The edit state cannot be shown statically: the caption says to click. -->
    <UserControl.Styles>
        <Style Selector="StackPanel.field-row">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="{DynamicResource DungeonSpacingMd}" />
        </Style>
        <!-- Pole z ikoną (IconField) dostaje tę samą szerokość co pole tekstowe - bez niej, w poziomym
             StackPanel, mierzyło się do zawartości i puste ściskało się do samej ikony. -->
        <Style Selector="StackPanel.field-row > TextBox, StackPanel.field-row > controls|IconField">
            <Setter Property="Width" Value="200" />
        </Style>
        <Style Selector="TextBlock.row-label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="{DynamicResource DungeonSpacingLg}">
        <TextBlock Classes="display-md" Text="Pola tekstowe" />
        <TextBlock Classes="caption muted" Text="Najedź, żeby zobaczyć najechanie; kliknij, żeby zobaczyć stan edycji. Kliknięcie obok albo Escape kończy edycję." />

        <Grid ColumnDefinitions="140,Auto"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="{DynamicResource DungeonSpacingLg}"
              RowSpacing="{DynamicResource DungeonSpacingLg}">
            <!-- Jednowierszowe -->
            <TextBlock Grid.Row="0" Classes="caption muted row-label" Text="Jednowierszowe" />
            <StackPanel Grid.Row="0" Grid.Column="1" Classes="field-row">
                <TextBox PlaceholderText="Nazwa kampanii" />
                <TextBox Text="Kopalnia Phandelver" />
                <TextBox Text="Zaginiona kopalnia Phandelver i Klątwa Strahda w jednej kampanii" />
                <TextBox Text="Wyłączone" IsEnabled="False" />
            </StackPanel>

            <!-- Z ikoną na początku -->
            <TextBlock Grid.Row="1" Classes="caption muted row-label" Text="Z ikoną" />
            <StackPanel Grid.Row="1" Grid.Column="1" Classes="field-row">
                <controls:IconField Icon="{StaticResource DungeonIconPencil}">
                    <TextBox PlaceholderText="Nazwa nowej kampanii" />
                </controls:IconField>
                <controls:IconField Icon="{StaticResource DungeonIconPencil}">
                    <TextBox Text="Kopalnia Phandelver" />
                </controls:IconField>
                <controls:IconField Icon="{StaticResource DungeonIconPencil}">
                    <TextBox Text="Zaginiona kopalnia Phandelver i Klątwa Strahda w jednej kampanii" />
                </controls:IconField>
                <controls:IconField Icon="{StaticResource DungeonIconPencil}" IsEnabled="False">
                    <TextBox Text="Wyłączone" />
                </controls:IconField>
            </StackPanel>

            <!-- Wyszukiwania -->
            <TextBlock Grid.Row="2" Classes="caption muted row-label" Text="Wyszukiwania" />
            <StackPanel Grid.Row="2" Grid.Column="1" Classes="field-row">
                <controls:IconField Classes="search">
                    <TextBox PlaceholderText="Szukaj po nazwie…" />
                </controls:IconField>
                <controls:IconField Classes="search">
                    <TextBox Text="goblin" />
                </controls:IconField>
                <controls:IconField Classes="search">
                    <TextBox Text="smok czerwony dorosły z legowiskiem w górach" />
                </controls:IconField>
                <controls:IconField Classes="search" IsEnabled="False">
                    <TextBox Text="Wyłączone" />
                </controls:IconField>
            </StackPanel>

            <!-- Wielowierszowe -->
            <TextBlock Grid.Row="3" Classes="caption muted row-label" VerticalAlignment="Top" Text="Wielowierszowe" />
            <StackPanel Grid.Row="3" Grid.Column="1" Classes="field-row">
                <TextBox AcceptsReturn="True" PlaceholderText="Notatka Mistrza Gry" />
                <TextBox AcceptsReturn="True" Text="Drużyna dotarła do Phandalin o zmierzchu." />
                <TextBox AcceptsReturn="True" Height="96" Text="Drużyna dotarła do Phandalin o zmierzchu. W gospodzie Pod Kamiennym Wzgórzem czekał na nich Toblen, który opowiedział o Czerwonych Znakach, o zaginionym Gundrenie i o goblinach na trakcie Triboar, a potem jeszcze o kopalni, której nikt nie widział od stu lat." />
                <TextBox AcceptsReturn="True" Text="Wyłączone" IsEnabled="False" />
            </StackPanel>

            <!-- Liczbowe -->
            <TextBlock Grid.Row="4" Classes="caption muted row-label" Text="Liczbowe" />
            <StackPanel Grid.Row="4" Grid.Column="1" Classes="field-row">
                <NumericUpDown PlaceholderText="PW" Minimum="0" />
                <NumericUpDown Value="27" Minimum="0" />
                <NumericUpDown Value="1234567" Minimum="0" />
                <NumericUpDown Value="12" IsEnabled="False" />
            </StackPanel>

            <!-- Tekst do zaznaczenia -->
            <TextBlock Grid.Row="5" Classes="caption muted row-label" VerticalAlignment="Top" Text="Tekst do zaznaczenia" />
            <SelectableTextBlock Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" MaxWidth="560" TextWrapping="Wrap"
                                 Text="Zaznacz fragment myszą i skopiuj Ctrl+C. Kliknięcie obok zdejmuje zaznaczenie. Tak zachowuje się dłuższa treść kart - opisy, akcje, cechy - i komunikaty błędów." />

            <!-- Zakreślenie -->
            <TextBlock Grid.Row="6" Classes="caption muted row-label" Text="Zakreślenie" VerticalAlignment="Top" />
            <SelectableTextBlock Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" MaxWidth="560" TextWrapping="Wrap">
                <Run Text="Goblin ma wyzwanie " /><Run Classes="highlight" Text="1/4" /><Run Text=", a szukany " /><Run Classes="search-match" Text="gob" /><Run Text="lin stoi na liście jako trafienie wyszukiwania. Zaznacz zdanie, żeby porównać oba z zaznaczeniem." />
            </SelectableTextBlock>
        </Grid>
    </StackPanel>
</UserControl>
