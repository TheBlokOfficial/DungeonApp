<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DungeonApp.Desktop.Controls"
             xmlns:sections="using:DungeonApp.Desktop.Shell.Gallery.Sections"
             x:Class="DungeonApp.Desktop.Shell.Gallery.Sections.DropDownsSection">
    <!-- The frame's FlyoutPresenter theme (Themes/Controls/FlyoutPresenter.axaml), live: one flyout with short
         content and one with a list longer than the flyout's highest height (it scrolls inside with
         the frame's bar). Closing by a click beside it or Escape is Flyout's own behavior. Nothing
         here restyles a control - the only local values are sizes. -->
    <StackPanel Spacing="{DynamicResource DungeonSpacingLg}">
        <TextBlock Classes="display-md" Text="Okienka i listy rozwijane" />

        <TextBlock Classes="overline-sm muted" Text="OKIENKO WYSUWANE" />
        <TextBlock Classes="caption muted" Text="Kliknij przycisk, żeby otworzyć okienko; zamyka je kliknięcie obok albo Escape. Dłuższa treść przewija się w środku." />
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingMd}">
            <Button Content="Krótki tekst">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <TextBlock Text="Okienko wysuwane z krótkim tekstem." />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <!-- List in a .list-host flyout: only the list scrolls, not the flyout - one scrollbar. -->
            <Button Content="Długa lista">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="list-host">
                        <ListBox x:Name="LongFlyoutList" Width="200" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <TextBlock Classes="overline-sm muted" Text="CHIP Z LISTĄ WYBORU" />
        <TextBlock Classes="caption muted" Text="Button z okienkiem i motywem DungeonChipOpener. Najedź, żeby zobaczyć najechanie; kliknij, żeby otworzyć - otwarty wygląda jak pod myszą, strzałka obraca się z prawej w dół. Aktywny filtr ma przygaszony akcent." />
        <WrapPanel>
            <!-- Chip label: the selected value, or the filter name when nothing is selected. -->
            <Button Theme="{StaticResource DungeonChipOpener}" Margin="0,0,6,6"
                    Content="{Binding #ChipRestList.SelectedItem, TargetNullValue=Kolor, FallbackValue=Kolor}">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="list-host">
                        <ListBox x:Name="ChipRestList" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Theme="{StaticResource DungeonChipOpener}" Classes="active" Margin="0,0,6,6"
                    Content="{Binding #ChipActiveList.SelectedItem, TargetNullValue=Kolor, FallbackValue=Kolor}">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="list-host">
                        <ListBox x:Name="ChipActiveList" SelectedIndex="1" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Theme="{StaticResource DungeonChipOpener}" Content="Wyłączony" IsEnabled="False" Margin="0,0,6,6">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="list-host">
                        <ListBox />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Theme="{StaticResource DungeonChipOpener}" Classes="active" Content="Aktywny wyłączony" IsEnabled="False" Margin="0,0,6,6">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="list-host">
                        <ListBox />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Theme="{StaticResource DungeonChipOpener}" MaxWidth="160" Margin="0,0,6,6"
                    Content="Bardzo długi napis chipa, który się nie mieści">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="list-host">
                        <ListBox x:Name="ChipLongList" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </WrapPanel>

        <TextBlock Classes="overline-sm muted" Text="CHIP Z LISTĄ (DROPDOWNPICKER W STROJU CHIPA)" />
        <TextBlock Classes="caption muted" Text="DropDownPicker z motywem DungeonChipPicker. Nic nie wybrane - nazwa filtra; jedna wartość - ta wartość i przygaszony akcent z ramką akcentu; kilka (lista wielokrotna) - pierwsza wybrana w kolejności listy i odznaka +N, a podpowiedź wymienia wszystkie. Chip rośnie z napisem do 240; dłuższy przycina się z podpowiedzią. Wiersze z polem wyboru: stan niesie pole, wybrany wiersz nie ma tła akcentu." />
        <TextBlock Classes="caption muted" Text="Wielokrotna: nic, jedna, kilka, wyłączony, wyłączony z wyborem, długa wartość." />
        <WrapPanel ItemSpacing="{DynamicResource DungeonSpacingXs}"
                   LineSpacing="{DynamicResource DungeonSpacingXs}">
            <controls:DropDownPicker x:Name="ChipPickerNone" Theme="{StaticResource DungeonChipPicker}"
                                     PlaceholderText="Rzadkość" />
            <controls:DropDownPicker x:Name="ChipPickerOne" Theme="{StaticResource DungeonChipPicker}"
                                     PlaceholderText="Rzadkość" />
            <controls:DropDownPicker x:Name="ChipPickerSeveral" Theme="{StaticResource DungeonChipPicker}"
                                     PlaceholderText="Rzadkość" />
            <controls:DropDownPicker x:Name="ChipPickerDisabled" Theme="{StaticResource DungeonChipPicker}"
                                     PlaceholderText="Kolor" IsEnabled="False" />
            <controls:DropDownPicker x:Name="ChipPickerDisabledSelected" Theme="{StaticResource DungeonChipPicker}"
                                     PlaceholderText="Kolor" IsEnabled="False" />
            <controls:DropDownPicker x:Name="ChipPickerLong" Theme="{StaticResource DungeonChipPicker}"
                                     PlaceholderText="Opis" />
        </WrapPanel>
        <TextBlock Classes="caption muted" Text="Pojedyncza: nic, jedna." />
        <WrapPanel ItemSpacing="{DynamicResource DungeonSpacingXs}"
                   LineSpacing="{DynamicResource DungeonSpacingXs}">
            <controls:DropDownPicker x:Name="ChipSingleNone" Theme="{StaticResource DungeonChipPicker}"
                                     SelectionMode="Single" PlaceholderText="Rozmiar" />
            <controls:DropDownPicker x:Name="ChipSingleOne" Theme="{StaticResource DungeonChipPicker}"
                                     SelectionMode="Single" PlaceholderText="Rozmiar" />
        </WrapPanel>
        <TextBlock Classes="caption muted" Text="Rząd filtrów: chipy obok siebie, ta sama wysokość z wyborem i bez; wartości to obiekty z nazwą z wiązania." />
        <WrapPanel ItemSpacing="{DynamicResource DungeonSpacingXs}"
                   LineSpacing="{DynamicResource DungeonSpacingXs}">
            <controls:DropDownPicker x:Name="FilterType" Theme="{StaticResource DungeonChipPicker}"
                                     PlaceholderText="Typ" IsSearchEnabled="True" />
            <controls:DropDownPicker x:Name="FilterSize" Theme="{StaticResource DungeonChipPicker}"
                                     PlaceholderText="Rozmiar" />
            <controls:DropDownPicker x:Name="FilterSource" Theme="{StaticResource DungeonChipPicker}"
                                     PlaceholderText="Źródło"
                                     DisplayMemberBinding="{Binding Name, DataType=sections:GalleryOption}" />
            <controls:DropDownPicker x:Name="FilterValues" Theme="{StaticResource DungeonChipPicker}"
                                     PlaceholderText="Wartości" />
        </WrapPanel>
        <TextBlock Classes="caption muted" Text="Lista z polami wyboru (ListBox z motywem DungeonCheckList, przełączanie): ten sam wygląd wierszy co w liście rozwijanej wielokrotnej." />
        <ListBox x:Name="CheckListSample" Theme="{StaticResource DungeonCheckList}"
                 SelectionMode="Multiple,Toggle" Width="200" HorizontalAlignment="Left">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="sections:GalleryOption">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingSm}">
                        <CheckBox Margin="0,-2,0,-2"
                                  IsChecked="{Binding $parent[ListBoxItem].IsSelected, Mode=OneWay}"
                                  IsHitTestVisible="False"
                                  Focusable="False" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Classes="caption muted" Text="Lista rozwijana wielokrotna na obiektach: nazwa pozycji z wiązania (DisplayMemberBinding), nie z ToString()." />
        <controls:DropDownPicker x:Name="ObjectPicker" Width="200" HorizontalAlignment="Left"
                                 PlaceholderText="Wybierz wartości"
                                 DisplayMemberBinding="{Binding Name, DataType=sections:GalleryOption}" />

        <TextBlock Classes="overline-sm muted" Text="LISTA ROZWIJANA POJEDYNCZA" />
        <TextBlock Classes="caption muted" Text="Zamknięta wygląda jak pole; otwarta ma krawędź najechania, a chevron obraca się z prawej w dół. Wybór zamyka listę." />
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingMd}">
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}" Width="200">
                <TextBlock Classes="caption muted" Text="Pusta" />
                <ComboBox PlaceholderText="Wybierz rozmiar">
                    <ComboBoxItem Content="Mały" />
                    <ComboBoxItem Content="Średni" />
                    <ComboBoxItem Content="Duży" />
                </ComboBox>
            </StackPanel>
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}" Width="200">
                <TextBlock Classes="caption muted" Text="Z wybraną pozycją" />
                <ComboBox SelectedIndex="1">
                    <ComboBoxItem Content="Mały" />
                    <ComboBoxItem Content="Średni" />
                    <ComboBoxItem Content="Duży" />
                </ComboBox>
            </StackPanel>
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}" Width="200">
                <TextBlock Classes="caption muted" Text="Długi tekst" />
                <ComboBox SelectedIndex="0">
                    <ComboBoxItem Content="Zaginiona kopalnia Phandelver i Klątwa Strahda" />
                    <ComboBoxItem Content="Krótka" />
                </ComboBox>
            </StackPanel>
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}" Width="200">
                <TextBlock Classes="caption muted" Text="Wyłączona" />
                <ComboBox SelectedIndex="0" IsEnabled="False">
                    <ComboBoxItem Content="Średni" />
                </ComboBox>
            </StackPanel>
        </StackPanel>
        <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
            <TextBlock Classes="caption muted" Text="Lista dłuższa niż rozwinięcie, w rzędzie z polem i przyciskiem" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingSm}">
                <TextBox Width="200" PlaceholderText="Nazwa spotkania" />
                <ComboBox x:Name="LongComboBox" Width="200" PlaceholderText="Wybierz potwora" />
                <Button Content="Dodaj" />
            </StackPanel>
        </StackPanel>

        <TextBlock Classes="overline-sm muted" Text="LISTA ROZWIJANA WIELOKROTNA" />
        <TextBlock Classes="caption muted" Text="Kliknięcie wiersza przełącza pozycję, lista zostaje otwarta; zamyka ją kliknięcie obok albo Escape." />
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingMd}">
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}" Width="200">
                <TextBlock Classes="caption muted" Text="Nic nie wybrane" />
                <controls:DropDownPicker x:Name="MultiNone" PlaceholderText="Typ potwora" />
            </StackPanel>
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}" Width="200">
                <TextBlock Classes="caption muted" Text="Jedna" />
                <controls:DropDownPicker x:Name="MultiOne" PlaceholderText="Typ potwora" />
            </StackPanel>
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}" Width="200">
                <TextBlock Classes="caption muted" Text="Kilka" />
                <controls:DropDownPicker x:Name="MultiSeveral" PlaceholderText="Typ potwora" />
            </StackPanel>
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}" Width="200">
                <TextBlock Classes="caption muted" Text="Wyłączona" />
                <controls:DropDownPicker x:Name="MultiDisabled" PlaceholderText="Typ potwora" IsEnabled="False" />
            </StackPanel>
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}" Width="200">
                <TextBlock Classes="caption muted" Text="Dłuższa niż rozwinięcie" />
                <controls:DropDownPicker x:Name="MultiLong" PlaceholderText="Wybierz potwory" />
            </StackPanel>
        </StackPanel>

        <TextBlock Classes="overline-sm muted" Text="LISTA ROZWIJANA Z WYSZUKIWANIEM" />
        <TextBlock Classes="caption muted" Text="Po otwarciu kursor stoi w polu wyszukiwania; wpisywanie zawęża pozycje, zamknięcie czyści wyszukiwanie." />
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingMd}">
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}" Width="200">
                <TextBlock Classes="caption muted" Text="Pojedyncza" />
                <controls:DropDownPicker x:Name="SearchSingle" SelectionMode="Single" IsSearchEnabled="True"
                                         PlaceholderText="Wybierz potwora" />
            </StackPanel>
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}" Width="200">
                <TextBlock Classes="caption muted" Text="Wielokrotna" />
                <controls:DropDownPicker x:Name="SearchMultiple" IsSearchEnabled="True"
                                         PlaceholderText="Wybierz potwory" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
