<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="using:DungeonApp.Desktop.Shell.Gallery.Sections"
             x:Class="DungeonApp.Desktop.Shell.Gallery.Sections.SurfacesSection">
    <!-- The surface and line colors of Themes/Tokens.axaml with their values and meanings, every text
         color on every background text stands on with its computed contrast, the three surface
         classes of Themes/Surfaces.axaml (each also with long text and empty), and the three Separator
         variants of Themes/DungeonControls.axaml. Every sample has a fixed width, so long text shows
         whether it trims or wraps instead of widening the sample. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.wrap">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="{DynamicResource DungeonSpacingLg}">
        <TextBlock Classes="display-md" Text="Powierzchnie i linie" />

        <!-- DRABINA KOLORÓW =================================================== -->
        <TextBlock Classes="overline-sm muted" Text="DRABINA KOLORÓW" />
        <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
            <sections:ColorSample Title="Background" Swatch="{DynamicResource DungeonBackgroundBrush}"
                                  Meaning="tło: najgłębszy poziom, pod całą resztą" />
            <sections:ColorSample Title="Surface" Swatch="{DynamicResource DungeonSurfaceBrush}"
                                  Meaning="powierzchnia: poziom nad tłem" />
            <sections:ColorSample Title="SurfaceHeader" Swatch="{DynamicResource DungeonSurfaceHeaderBrush}"
                                  Meaning="powierzchnia: poziom nad tłem (nagłówek powierzchni)" />
            <sections:ColorSample Title="Frame" Swatch="{DynamicResource DungeonFrameBrush}"
                                  Meaning="rama: stałe otoczenie treści (pasek boczny, pasek górny)" />
            <sections:ColorSample Title="FrameHover" Swatch="{DynamicResource DungeonFrameHoverBrush}"
                                  Meaning="najechanie na ramie: ten element ramy reaguje na mysz" />
            <sections:ColorSample Title="Backstage" Swatch="{DynamicResource DungeonBackstageBrush}"
                                  Meaning="zaplecze: tło treści poza kampanią (biblioteka, półka, galeria)" />
            <sections:ColorSample Title="BackstageWide" Swatch="{DynamicResource DungeonBackstageWideBrush}"
                                  Meaning="zaplecze w szerokich widokach (gradient rozpięty na cały widok - w próbce widać jego początek)" />
            <!-- BackstageEdge has no brush of its own: it exists only as the gradient's last stop. -->
            <sections:ColorSample Title="BackstageEdge"
                                  Meaning="zaplecze przy dalekiej krawędzi szerokiego widoku (koniec gradientu BackstageWide)">
                <sections:ColorSample.Swatch>
                    <SolidColorBrush Color="{DynamicResource DungeonBackstageEdgeColor}" />
                </sections:ColorSample.Swatch>
            </sections:ColorSample>
            <sections:ColorSample Title="Desk" Swatch="{DynamicResource DungeonDeskBrush}"
                                  Meaning="biurko: tło treści otwartej kampanii" />
            <sections:ColorSample Title="BackstageCard" Swatch="{DynamicResource DungeonBackstageCardBrush}"
                                  Meaning="karta: rzecz wyodrębniona z tła, czytana jako całość" />
            <sections:ColorSample Title="BackstageRow" Swatch="{DynamicResource DungeonBackstageRowBrush}"
                                  Meaning="wiersz: pozycja, którą można wskazać" />
            <sections:ColorSample Title="BackstageRowHover" Swatch="{DynamicResource DungeonBackstageRowHoverBrush}"
                                  Meaning="najechanie: to reaguje na mysz" />
            <sections:ColorSample Title="SurfaceHover" Swatch="{DynamicResource DungeonSurfaceHoverBrush}"
                                  Meaning="najechanie: to reaguje na mysz" />
            <sections:ColorSample Title="SurfaceActive" Swatch="{DynamicResource DungeonSurfaceActiveBrush}"
                                  Meaning="aktywne: wybrane albo wciśnięte teraz" />
            <sections:ColorSample Title="Border" Swatch="{DynamicResource DungeonBorderBrush}"
                                  Meaning="linia: dzieli, nie wyróżnia; krawędź powierzchni i separator" />
            <sections:ColorSample Title="BorderStrong" Swatch="{DynamicResource DungeonBorderStrongBrush}"
                                  Meaning="obramowanie wyraźne: kontrolka pod myszą, aktywne okno, krawędź ramy" />
            <sections:ColorSample Title="PanelWindowBackground" Swatch="{DynamicResource DungeonPanelWindowBackgroundBrush}"
                                  Meaning="okno biurka: tło okna" />
            <sections:ColorSample Title="PanelWindowHeader" Swatch="{DynamicResource DungeonPanelWindowHeaderBrush}"
                                  Meaning="okno biurka: nagłówek okna" />
            <sections:ColorSample Title="PanelWindowBorder" Swatch="{DynamicResource DungeonPanelWindowBorderBrush}"
                                  Meaning="okno biurka: krawędź okna" />
            <sections:ColorSample Title="PanelWindowActiveBorder" Swatch="{DynamicResource DungeonPanelWindowActiveBorderBrush}"
                                  Meaning="okno biurka: krawędź aktywnego okna" />
        </StackPanel>

        <!-- KOLORY TEKSTU ===================================================== -->
        <TextBlock Classes="overline-sm muted" Text="KOLORY TEKSTU" />
        <TextBlock Classes="caption muted"
                   Text="kontrast WCAG liczony z bieżących zasobów; wymóg co najmniej 4,5 - poniżej liczba w kolorze niebezpieczeństwa" />
        <sections:TextContrastTable />

        <!-- POWIERZCHNIE ====================================================== -->
        <TextBlock Classes="overline-sm muted" Text="POWIERZCHNIE NA TLE ZAPLECZA" />
        <Border Background="{DynamicResource DungeonBackstageBrush}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingXxl}">
                <!-- surface-card -->
                <StackPanel Width="280" Spacing="{DynamicResource DungeonSpacingSm}">
                    <TextBlock Classes="caption muted" Text="surface-card" />
                    <Border Classes="surface-card">
                        <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                            <TextBlock Classes="display-md" Text="Goblin" />
                            <TextBlock Classes="body wrap" Text="Mały, złośliwy humanoid. KP 15, 7 punktów wytrzymałości." />
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="caption muted" Text="surface-card · długi tekst" />
                    <Border Classes="surface-card">
                        <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                            <TextBlock Classes="display-md" Text="Goblin wódz plemienia Zębatej Paszczy z Doliny Mgieł" />
                            <TextBlock Classes="body wrap" Text="Mały, złośliwy humanoid, który dowodzi bandą z jaskini nad rzeką. Nagłówek przycina się do szerokości karty, akapit zawija się w kolejne linie - karta rośnie w dół, nigdy wszerz." />
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="caption muted" Text="surface-card · pusta" />
                    <Border Classes="surface-card" />
                </StackPanel>

                <!-- surface-section -->
                <StackPanel Width="240" Spacing="{DynamicResource DungeonSpacingSm}">
                    <TextBlock Classes="caption muted" Text="surface-section" />
                    <Border Classes="surface-section">
                        <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                            <TextBlock Classes="label" Text="Siła 8" />
                            <TextBlock Classes="label" Text="Zręczność 14" />
                            <TextBlock Classes="label" Text="Kondycja 10" />
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="caption muted" Text="surface-section · długi tekst" />
                    <Border Classes="surface-section">
                        <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                            <TextBlock Classes="label" Text="Ukrywanie się w cieniu i skradanie się między namiotami" />
                            <TextBlock Classes="label" Text="Zręczność 14" />
                            <TextBlock Classes="label" Text="Percepcja bierna w ciemności, bez źródła światła" />
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="caption muted" Text="surface-section · pusta" />
                    <Border Classes="surface-section" />
                </StackPanel>

                <!-- surface-panel -->
                <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                    <TextBlock Classes="caption muted" Text="surface-panel · zwykły, długi tekst, pusty" />
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingLg}">
                        <Border Classes="surface-panel" Width="120" Height="200">
                            <StackPanel Margin="{DynamicResource DungeonPaddingMd}" Spacing="{DynamicResource DungeonSpacingSm}">
                                <TextBlock Classes="label" Text="Kampanie" />
                                <TextBlock Classes="label" Text="Galeria" />
                            </StackPanel>
                        </Border>
                        <Border Classes="surface-panel" Width="120" Height="200">
                            <StackPanel Margin="{DynamicResource DungeonPaddingMd}" Spacing="{DynamicResource DungeonSpacingSm}">
                                <TextBlock Classes="label" Text="Kampanie w przygotowaniu" />
                                <TextBlock Classes="label" Text="Galeria kontrolek ramy" />
                            </StackPanel>
                        </Border>
                        <Border Classes="surface-panel" Width="120" Height="200" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- LINIE ============================================================= -->
        <TextBlock Classes="overline-sm muted" Text="LINIE" />
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingXxl}">
            <StackPanel Width="280" Spacing="{DynamicResource DungeonSpacingSm}">
                <TextBlock Classes="caption muted" Text="Separator · domyślny (lista)" />
                <Border Classes="surface-card">
                    <StackPanel>
                        <TextBlock Classes="label" Padding="{DynamicResource DungeonPaddingSm}" Text="Goblin" />
                        <Separator />
                        <TextBlock Classes="label" Padding="{DynamicResource DungeonPaddingSm}" Text="Hobgoblin" />
                        <Separator />
                        <TextBlock Classes="label" Padding="{DynamicResource DungeonPaddingSm}" Text="Niedźwieżuk" />
                        <Separator />
                        <TextBlock Classes="label" Padding="{DynamicResource DungeonPaddingSm}" Text="Szef bandy goblinów z Doliny Mgieł" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Width="280" Spacing="{DynamicResource DungeonSpacingSm}">
                <TextBlock Classes="caption muted" Text="Separator · section (sekcje karty)" />
                <Border Classes="surface-card">
                    <StackPanel>
                        <TextBlock Classes="body wrap" Text="Mały, złośliwy humanoid. Zwykle trzyma się w bandach i atakuje z zasadzki." />
                        <Separator Classes="section" />
                        <TextBlock Classes="body wrap" Text="Zwinny unik: w swojej turze może się odsunąć albo schować jako akcję dodatkową." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Width="280" Spacing="{DynamicResource DungeonSpacingSm}">
                <TextBlock Classes="caption muted" Text="Separator · vertical (kolumny)" />
                <Border Classes="surface-card">
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="{DynamicResource DungeonSpacingMd}">
                        <TextBlock Grid.Column="0" Classes="body wrap" Text="Lewa kolumna: KP 15, 7 PW, szybkość 9 m." />
                        <Separator Grid.Column="1" Classes="vertical" />
                        <TextBlock Grid.Column="2" Classes="body wrap" Text="Prawa kolumna: sejmitar, krótki łuk." />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
