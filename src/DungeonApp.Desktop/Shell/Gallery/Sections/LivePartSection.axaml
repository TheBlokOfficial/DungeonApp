<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Desktop.Shell.Gallery.Sections.LivePartSection">
    <!-- The controls the live part of an entity's card is built from, each in every state it is
         designed for. Two of them have two forms - text to read and a field in the same place - and
         take a click; the rest only show. Sample values in LivePartSection.axaml.cs. The render tool
         saves this section at twice its size and poses the pointer and keyboard states
         (tools/render/Program.cs, RenderLivePart). Nothing here restyles a control. -->
    <StackPanel Spacing="{DynamicResource DungeonSpacingLg}">
        <TextBlock Classes="display-md" Text="Część żywa" />
        <TextBlock Classes="caption muted" Text="Bieżąca wartość i notatka reagują na mysz i klawiaturę; reszta tylko pokazuje." />

        <!-- Tracked value: the current number with its change field, and the blot -->

        <!-- Note -->

        <!-- Gauge and values against their base -->

        <!-- Rows of conditions and effects -->
        <StackPanel Name="MarkerRows" Width="560" HorizontalAlignment="Left" Spacing="{DynamicResource DungeonSpacingSm}">
            <controls:SectionHeading Text="Stany" />
            <controls:FramedIconRow Name="ConditionRow"
                                    Icon="{StaticResource DungeonIconInfo}"
                                    Title="Zatruty"
                                    Detail="3 rundy · KON ST 13 kończy" />
            <controls:FramedIconRow Name="ConditionBareRow"
                                    Icon="{StaticResource DungeonIconInfo}"
                                    Title="Powalony" />
            <controls:FramedIconRow Name="ConditionRemovedRow"
                                    Icon="{StaticResource DungeonIconInfo}"
                                    Title="Oślepiony"
                                    Detail="1 runda"
                                    IsRemoved="True" />
            <Button Classes="subtle" HorizontalAlignment="Left" Content="Dodaj stan" />

            <controls:SectionHeading Text="Efekty" Margin="0,12,0,0" />
            <controls:FramedIconRow Name="EffectRow"
                                    Icon="{StaticResource DungeonIconInfo}"
                                    Title="Tarcza wiary"
                                    Detail="KP +2" />
            <controls:FramedIconRow Name="EffectTwoRow"
                                    Icon="{StaticResource DungeonIconInfo}"
                                    Title="Przyspieszenie"
                                    Detail="KP +2 · Szybkość +9 m" />
            <controls:FramedIconRow Name="EffectLongRow"
                                    Icon="{StaticResource DungeonIconInfo}"
                                    Title="Błogosławieństwo opiekuna starożytnego lasu, które trwa dłużej niż jedna rozmowa przy ognisku"
                                    Detail="ZRĘ +2 · MĄD +1" />
            <Button Classes="subtle" HorizontalAlignment="Left" Content="Dodaj efekt" />
        </StackPanel>
    </StackPanel>
</UserControl>
