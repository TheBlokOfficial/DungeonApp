<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DungeonApp.Desktop.Controls"
             xmlns:entries="using:DungeonApp.Desktop.Entries.Controls"
             x:Class="DungeonApp.Desktop.Shell.Gallery.Sections.LivePartSection">
    <!-- The controls the live part of an entity's card is built from, each in every state it is
         designed for. Two of them have two forms - text to read and a field in the same place - and
         take a click; the rest only show. Sample values in LivePartSection.axaml.cs. The render tool
         saves this section at twice its size and poses the pointer and keyboard states
         (tools/render/Program.cs, RenderLivePart). Nothing here restyles a control. -->
    <StackPanel Spacing="{DynamicResource DungeonSpacingLg}">
        <TextBlock Classes="display-md" Text="Część żywa" />
        <TextBlock Classes="caption muted" Text="Bieżąca wartość i notatka reagują na mysz i klawiaturę; reszta tylko pokazuje." />

        <!-- Tracked value: the current number with its change field, and the blot -->

        <!-- Note -->
        <TextBlock Classes="overline-sm muted" Text="NOTATKA (560): PUSTA, JEDNA LINIA, KILKA LINII, WYŁĄCZONA" />
        <!-- The padding leaves room for the frame that the note draws outside its own bounds. -->
        <Border x:Name="NoteSamples" HorizontalAlignment="Left" Padding="{DynamicResource DungeonPaddingSm}">
            <StackPanel Width="560" Spacing="{DynamicResource DungeonSpacingXxl}">
                <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                    <controls:SectionHeading Text="Notatka" />
                    <controls:NoteField x:Name="NoteEmpty" />
                </StackPanel>
                <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                    <controls:SectionHeading Text="Notatka" />
                    <controls:NoteField x:Name="NoteOneLine" />
                </StackPanel>
                <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                    <controls:SectionHeading Text="Notatka" />
                    <controls:NoteField x:Name="NoteLines" />
                    <TextBlock x:Name="NoteCommitted" Classes="caption muted" Text="Wyjście z pola zatwierdza notatkę." />
                </StackPanel>
                <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                    <controls:SectionHeading Text="Notatka" />
                    <controls:NoteField x:Name="NoteDisabled" IsEnabled="False" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Gauge and values against their base -->
        <TextBlock Classes="overline-sm muted" Text="PASEK WARTOŚCI (394): 9/13, 13/13, 1/13, 0/13, 20/13 (NADWYŻKA ZA KRESKĄ MAKSIMUM), 0/0" />
        <StackPanel Width="394" HorizontalAlignment="Left" Spacing="{DynamicResource DungeonSpacingSm}">
            <controls:TrackGauge Value="9" Maximum="13" />
            <controls:TrackGauge Value="13" Maximum="13" />
            <controls:TrackGauge Value="1" Maximum="13" />
            <controls:TrackGauge Value="0" Maximum="13" />
            <controls:TrackGauge Value="20" Maximum="13" />
            <controls:TrackGauge Value="0" Maximum="0" />
        </StackPanel>

        <TextBlock Classes="overline-sm muted" Text="WARTOŚĆ WZGLĘDEM BAZY: POWYŻEJ (ZIELONA), PONIŻEJ (CZERWONA), RÓWNA" />
        <Grid Width="394" HorizontalAlignment="Left"
              ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource DungeonDetailColumnGap}">
            <controls:StatTile Label="KP" Icon="{DynamicResource DungeonIconShield}" Value="19" Note="zbroja płytowa" Deviation="Above" />
            <controls:StatTile Grid.Column="1" Label="Szybkość" Icon="{DynamicResource DungeonIconFootprints}" Value="6 m" Note="wspinaczka 6 m" Deviation="Below" />
            <controls:StatTile Grid.Column="2" Label="PW maks." Icon="{DynamicResource DungeonIconHeart}" Value="52" Note="8k8+16" />
        </Grid>

        <TextBlock Classes="overline-sm muted" Text="TABELA CECH: ZRĘ PONIŻEJ BAZY, MODYFIKATOR DALEJ NA ZIELONYM; CHA POWYŻEJ" />
        <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto,Auto"
              ColumnSpacing="{DynamicResource DungeonDetailColumnGap}">
            <entries:AbilityTableView x:Name="BaseLeftTable" />
            <entries:AbilityTableView x:Name="BaseRightTable" Grid.Column="1" />
        </Grid>

        <!-- Rows of conditions and effects -->
        <StackPanel Name="MarkerRows" Width="560" HorizontalAlignment="Left" Spacing="{DynamicResource DungeonSpacingSm}">
            <controls:SectionHeading Text="Stany" />
            <controls:FramedIconRow Name="ConditionRow"
                                    Icon="{StaticResource DungeonIconInfo}"
                                    Title="Zatruty"
                                    Detail="3 rundy · KON ST 13 kończy" />
            <controls:FramedIconRow Name="ConditionBareRow"
                                    Icon="{StaticResource DungeonIconInfo}"
                                    Title="Powalony" />
            <controls:FramedIconRow Name="ConditionRemovedRow"
                                    Icon="{StaticResource DungeonIconInfo}"
                                    Title="Oślepiony"
                                    Detail="1 runda"
                                    IsRemoved="True" />
            <Button Classes="subtle" HorizontalAlignment="Left" Content="Dodaj stan" />

            <controls:SectionHeading Text="Efekty" Margin="0,12,0,0" />
            <controls:FramedIconRow Name="EffectRow"
                                    Icon="{StaticResource DungeonIconInfo}"
                                    Title="Tarcza wiary"
                                    Detail="KP +2" />
            <controls:FramedIconRow Name="EffectTwoRow"
                                    Icon="{StaticResource DungeonIconInfo}"
                                    Title="Przyspieszenie"
                                    Detail="KP +2 · Szybkość +9 m" />
            <controls:FramedIconRow Name="EffectLongRow"
                                    Icon="{StaticResource DungeonIconInfo}"
                                    Title="Błogosławieństwo opiekuna starożytnego lasu, które trwa dłużej niż jedna rozmowa przy ognisku"
                                    Detail="ZRĘ +2 · MDR +1" />
            <Button Classes="subtle" HorizontalAlignment="Left" Content="Dodaj efekt" />
        </StackPanel>
    </StackPanel>
</UserControl>
