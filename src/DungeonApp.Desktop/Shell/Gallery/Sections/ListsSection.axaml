<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Desktop.Shell.Gallery.Sections.ListsSection">
    <!-- The frame's ListBox and ListBoxItem themes (Themes/DungeonControls.axaml), live: one list with
         a row in every static state (rest, selected, disabled) and a row whose text is longer than the
         list, and one list longer than its area (it scrolls with the frame's bar). Hover is checked
         with the mouse. Nothing here restyles a list - the only local values are the lists' size and inset, and
         the card they lie on. Below: the empty list (controls:EmptyState) with a message alone and
         with a message and a hint, each in a list-sized area so its place at the top shows. -->
    <!-- The bar zone is counted from the scroll area's edge: the lists here are inset by
         DungeonPaddingXs (6) inside it, so a row adds the rest of the bar lane, 16 - 6. -->
    <UserControl.Resources>
        <Thickness x:Key="DungeonScrollBarZone">0,0,10,0</Thickness>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- The card has no padding of its own: the inset belongs to what it holds - the list's
             Padding (inside the scrolled content) and the empty state's Margin - so the scroll bar
             (an overlay) stands at the card's edge, row backgrounds reach under it and row text ends
             before its zone (the row theme's DungeonScrollBarZone). -->
        <Style Selector="Border.list-sample">
            <Setter Property="Width" Value="240" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageCardBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.list-sample > ListBox">
            <Setter Property="Padding" Value="{DynamicResource DungeonPaddingXs}" />
        </Style>
        <Style Selector="Border.list-sample > StackPanel.row-list">
            <Setter Property="Margin" Value="{DynamicResource DungeonPaddingXs}" />
        </Style>
        <Style Selector="Border.list-sample > controls|EmptyState">
            <Setter Property="Margin" Value="{DynamicResource DungeonPaddingXs}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="{DynamicResource DungeonSpacingLg}">
        <TextBlock Classes="display-md" Text="Listy" />
        <TextBlock Classes="caption muted" Text="Najedź na wiersz, żeby zobaczyć najechanie; kliknij, żeby go wybrać. Wiersz ma najmniejszą wysokość, długi tekst przycina się wielokropkiem." />

        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingXxl}">
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                <TextBlock Classes="caption muted" Text="Stany wiersza" />
                <Border Classes="list-sample">
                    <ListBox SelectedIndex="1">
                        <ListBoxItem Content="Spoczynek" />
                        <ListBoxItem Content="Wybrany" />
                        <ListBoxItem Content="Wyłączony" IsEnabled="False" />
                        <ListBoxItem Content="Zaginiona kopalnia Phandelver i Klątwa Strahda w jednej kampanii" />
                        <ListBoxItem>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Z akcją w wierszu" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Theme="{StaticResource DungeonRowAction}">
                                    <controls:ForegroundIcon Width="16" Height="16" Source="{StaticResource DungeonIconTrash}" />
                                </Button>
                            </Grid>
                        </ListBoxItem>
                    </ListBox>
                </Border>
            </StackPanel>
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                <TextBlock Classes="caption muted" Text="Lista dłuższa niż obszar" />
                <Border Classes="list-sample" Height="160">
                    <ListBox>
                        <ListBoxItem Content="Goblin" />
                        <ListBoxItem Content="Hobgoblin" />
                        <ListBoxItem Content="Bugbear" />
                        <ListBoxItem Content="Kobold" />
                        <ListBoxItem Content="Ork" />
                        <ListBoxItem Content="Ogr" />
                        <ListBoxItem Content="Troll" />
                        <ListBoxItem Content="Szkielet" />
                        <ListBoxItem Content="Zombie" />
                        <ListBoxItem Content="Ghul" />
                    </ListBox>
                </Border>
            </StackPanel>
        </StackPanel>

        <TextBlock Classes="overline-sm muted" Text="WIERSZ-POLECENIE (LISTROW)" />
        <TextBlock Classes="caption muted" Text="Wiersz listy zbudowanej jako ItemsControl: wybór niesie model widoku, nie lista. Stany jak wiersz listy; najedź na wiersz, żeby zobaczyć najechanie (wybrany pod myszą się nie zmienia). Kreska zaznaczenia stoi w pasie wcięcia obok tła wiersza." />
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingXxl}">
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                <TextBlock Classes="caption muted" Text="Z kreską zaznaczenia" />
                <Border Classes="list-sample">
                    <StackPanel Classes="row-list">
                        <controls:ListRow ShowsSelectionStripe="True" Content="Spoczynek" />
                        <controls:ListRow ShowsSelectionStripe="True" Content="Wybrany" IsSelected="True" />
                        <controls:ListRow ShowsSelectionStripe="True" Content="Wyłączony" IsEnabled="False" />
                        <controls:ListRow ShowsSelectionStripe="True" Content="Zaginiona kopalnia Phandelver i Klątwa Strahda w jednej kampanii" />
                        <controls:ListRow ShowsSelectionStripe="True">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Z akcją w wierszu" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Theme="{StaticResource DungeonRowAction}">
                                    <controls:ForegroundIcon Width="16" Height="16" Source="{StaticResource DungeonIconTrash}" />
                                </Button>
                            </Grid>
                        </controls:ListRow>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                <TextBlock Classes="caption muted" Text="Bez kreski" />
                <Border Classes="list-sample">
                    <StackPanel Classes="row-list">
                        <controls:ListRow Content="Spoczynek" />
                        <controls:ListRow Content="Wybrany" IsSelected="True" />
                        <controls:ListRow Content="Wyłączony" IsEnabled="False" />
                        <controls:ListRow Content="Zaginiona kopalnia Phandelver i Klątwa Strahda w jednej kampanii" />
                        <controls:ListRow>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Z akcją w wierszu" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Theme="{StaticResource DungeonRowAction}">
                                    <controls:ForegroundIcon Width="16" Height="16" Source="{StaticResource DungeonIconTrash}" />
                                </Button>
                            </Grid>
                        </controls:ListRow>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <TextBlock Classes="overline-sm muted" Text="PUSTA LISTA" />
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DungeonSpacingXxl}">
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                <TextBlock Classes="caption muted" Text="Sam komunikat" />
                <Border Classes="list-sample" Height="160">
                    <controls:EmptyState Message="Nie ma jeszcze żadnej kampanii." />
                </Border>
            </StackPanel>
            <StackPanel Spacing="{DynamicResource DungeonSpacingSm}">
                <TextBlock Classes="caption muted" Text="Komunikat z podpowiedzią" />
                <Border Classes="list-sample" Height="160">
                    <controls:EmptyState Message="Nic nie pasuje do filtrów i wyszukiwania."
                                         Hint="Wyczyść filtry albo zmień wyszukiwanie." />
                </Border>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
