<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DungeonApp.Desktop.Shell.TopBar"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="48"
             x:Class="DungeonApp.Desktop.Shell.TopBar.TopBarView"
             x:DataType="vm:TopBarViewModel">
    <UserControl.Styles>
        <Style Selector="Border.header-action-cell">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="0,1,1,1" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Button.frame-action">
            <Setter Property="Height" Value="{DynamicResource DungeonTopBarActionSize}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.frame-action.frame-icon">
            <Setter Property="Width" Value="{DynamicResource DungeonTopBarActionSize}" />
        </Style>
        <Style Selector="Button.frame-action.frame-text">
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style Selector="Button.frame-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonFrameHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.frame-action:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource DungeonFrameBrush}"
            BorderBrush="{DynamicResource DungeonBorderStrongBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <!-- Column 0 must stay bound to DungeonSidebarWidth (same resource AppShellView's
                 sidebar column and StatusBarView use) so the brand slot lines up with the
                 sidebar below, including when its variant (full/compact) changes. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource DungeonSidebarWidth}" />
                <ColumnDefinition Width="*" />
                <!-- Auto: collapses to nothing while no campaign is open, so the two icon cells
                     keep their position and the strip does not shift on open/close. -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{DynamicResource DungeonTopBarHeight}" />
                <ColumnDefinition Width="{DynamicResource DungeonTopBarHeight}" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{DynamicResource DungeonBorderStrongBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12,0" ColumnDefinitions="32,*" ColumnSpacing="8">
                    <Border Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderBrush="{DynamicResource DungeonAccentBrush}"
                            BorderThickness="1">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource DungeonDisplayFont}"
                                   FontSize="{DynamicResource DungeonBrandMarkFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DungeonAccentBrightBrush}"
                                   Text="D" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                               Text="DungeonApp" />
                </Grid>
            </Border>

            <TextBlock Grid.Column="1"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                       Text="{Binding ContextTitle}" />

            <Border Grid.Column="2"
                    Classes="header-action-cell"
                    IsVisible="{Binding IsCampaignOpen}">
                <!-- A word rather than a glyph: leaving a campaign is rare, deliberate and worth
                     spelling out, and it needs no addition to the curated icon subset. -->
                <Button Classes="frame-action frame-text"
                        Content="Zamknij kampanię"
                        Command="{Binding CloseCampaignCommand}" />
            </Border>

            <Border Grid.Column="3" Classes="header-action-cell">
                <Button Classes="frame-action frame-icon"
                         ToolTip.Tip="Szukaj">
                    <Image Width="{DynamicResource DungeonActionIconSize}" Height="{DynamicResource DungeonActionIconSize}" Source="{StaticResource DungeonIconSearch}" />
                </Button>
            </Border>
            <Border Grid.Column="4" Classes="header-action-cell">
                <Button Classes="frame-action frame-icon"
                         ToolTip.Tip="Paleta poleceń">
                    <Image Width="{DynamicResource DungeonActionIconSize}" Height="{DynamicResource DungeonActionIconSize}" Source="{StaticResource DungeonIconCommand}" />
                </Button>
            </Border>
        </Grid>
    </Border>
</UserControl>
