<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DungeonApp.Desktop.Shell.TopBar"
             mc:Ignorable="d"
             d:DesignWidth="1056"
             d:DesignHeight="52"
             x:Class="DungeonApp.Desktop.Shell.TopBar.TopBarView"
             x:DataType="vm:TopBarViewModel">
    <UserControl.Styles>
        <!-- Square, icon-only, one visual state: hover. No pressed, selected or focus look of its
             own - the button either sits at rest or is being pointed at, nothing else.

             Left and bottom edge lines share the same border token (color and thickness) as the
             bar's own bottom edge (the Border below, BorderThickness="0,0,0,1"). They are drawn by
             an outer element that carries no fill of its own; the hover background lives on a
             separate element nested inside it, so it sits geometrically inside the lines and can
             never paint over them, regardless of how the outer border itself is positioned. -->
        <Style Selector="Button.frame-action">
            <Setter Property="Width" Value="{DynamicResource DungeonTopBarHeight}" />
            <Setter Property="Height" Value="{DynamicResource DungeonTopBarHeight}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.frame-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonFrameHoverBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Height shared with the sidebar header (DungeonTopBarHeight, Themes/Tokens.axaml) so this
         Border's own bottom edge and the header's continue as one line. -->
    <Border Height="{DynamicResource DungeonTopBarHeight}"
            Background="{DynamicResource DungeonFrameBrush}"
            BorderBrush="{DynamicResource DungeonBorderStrongBrush}"
            BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
            <!-- System, then (only with a campaign open) a chevron and the campaign's own name. -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="{DynamicResource DungeonPaddingLg}"
                        Spacing="{DynamicResource DungeonSpacingSm}"
                        VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                           Text="{Binding ActiveSystemName}" />
                <Image Width="{DynamicResource DungeonActionIconSize}"
                       Height="{DynamicResource DungeonActionIconSize}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasCampaign}"
                       Source="{StaticResource DungeonIconChevronRight}" />
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                           IsVisible="{Binding HasCampaign}"
                           Text="{Binding CampaignName}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="frame-action"
                    Command="{Binding ChangeSystemCommand}"
                    AutomationProperties.Name="Zmień system"
                    ToolTip.Tip="Zmień system">
                <Image Width="{DynamicResource DungeonActionIconSize}"
                       Height="{DynamicResource DungeonActionIconSize}"
                       Source="{StaticResource DungeonIconExitDoor}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
