<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:DungeonApp.Desktop.Shell"
             xmlns:topBar="using:DungeonApp.Desktop.Shell.TopBar"
             xmlns:sidebars="using:DungeonApp.Desktop.Shell.Sidebars"
             xmlns:statusBar="using:DungeonApp.Desktop.Shell.StatusBar"
             xmlns:library="using:DungeonApp.Desktop.Features.CampaignLibrary"
             x:Class="DungeonApp.Desktop.Shell.AppShellView"
             x:DataType="shell:AppShellViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{DynamicResource DungeonTopBarHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{DynamicResource DungeonStatusBarHeight}" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{DynamicResource DungeonSidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <topBar:TopBarView Grid.ColumnSpan="2"
                           DataContext="{Binding TopBar}" />

        <sidebars:GlobalSidebarView Grid.Row="1"
                                    Grid.Column="0"
                                    DataContext="{Binding Sidebar}" />

        <library:CampaignLibraryView Grid.Row="1"
                                     Grid.Column="1"
                                     DataContext="{Binding CampaignLibrary}" />

        <statusBar:StatusBarView Grid.Row="2"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 DataContext="{Binding StatusBar}" />
    </Grid>
</UserControl>