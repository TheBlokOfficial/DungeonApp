<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:DungeonApp.Desktop.Shell"
             xmlns:sidebars="using:DungeonApp.Desktop.Shell.Sidebars"
             xmlns:statusBar="using:DungeonApp.Desktop.Shell.StatusBar"
             xmlns:topBar="using:DungeonApp.Desktop.Shell.TopBar"
             xmlns:settings="using:DungeonApp.Desktop.Shell.Settings"
             xmlns:gallery="using:DungeonApp.Desktop.Shell.Gallery"
             xmlns:selection="using:DungeonApp.Desktop.Shell.SystemSelection"
             xmlns:campaignLibrary="using:DungeonApp.Desktop.Features.CampaignLibrary"
             xmlns:animation="clr-namespace:Avalonia.Animation;assembly=Avalonia.Base"
             xmlns:easings="clr-namespace:Avalonia.Animation.Easings;assembly=Avalonia.Base"
             x:Class="DungeonApp.Desktop.Shell.AppShellView"
             x:DataType="shell:AppShellViewModel"
             Loaded="OnLoaded">
    <UserControl.DataTemplates>
        <DataTemplate DataType="selection:SystemSelectionViewModel">
            <selection:SystemSelectionView />
        </DataTemplate>
        <DataTemplate DataType="campaignLibrary:CampaignLibraryViewModel">
            <campaignLibrary:CampaignLibraryView />
        </DataTemplate>
        <DataTemplate DataType="gallery:GalleryViewModel">
            <gallery:GalleryView />
        </DataTemplate>
        <DataTemplate DataType="settings:SettingsViewModel">
            <settings:SettingsView />
        </DataTemplate>
        <!-- A fresh GlobalSidebarView per DataTemplate build - not a persistent element rebound by
             DataContext - is what keeps the sidebar from animating into its state on "Zmień system"
             too, not only on the very first system choice: a control Avalonia has never rendered
             before has no earlier frame for its Width/heading/label transitions to play across
             (DungeonApp.Desktop.RenderingTests.GlobalSidebarRenderingTests, whose
             DataContext-swap-on-an-already-shown-instance probe fails without this). -->
        <DataTemplate DataType="sidebars:GlobalSidebarViewModel">
            <sidebars:GlobalSidebarView Width="{Binding SidebarWidth}">
                <sidebars:GlobalSidebarView.Transitions>
                    <animation:Transitions>
                        <animation:DoubleTransition Property="Width" Duration="0:0:0.18">
                            <animation:DoubleTransition.Easing>
                                <easings:CubicEaseInOut />
                            </animation:DoubleTransition.Easing>
                        </animation:DoubleTransition>
                    </animation:Transitions>
                </sidebars:GlobalSidebarView.Transitions>
            </sidebars:GlobalSidebarView>
        </DataTemplate>
        <!-- A system tab's or a campaign tab's content arrives as an already-finished Control
             (ITabContent.Content), never a view model - so it needs no template here. Avalonia hosts
             a Control assigned directly as Content as-is, the same trick a panel's own body already
             uses. -->
    </UserControl.DataTemplates>

    <Grid IsHitTestVisible="{Binding IsReady}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="{DynamicResource DungeonStatusBarHeight}" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <!-- System selection: full screen, without a sidebar. -->
            <ContentControl Content="{Binding SystemSelection}" IsVisible="{Binding !IsSystemChosen}" />

            <!-- Sidebar + (top bar above content), only after system selection. Sidebar
                 docked first occupies the full height of this DockPanel; top bar and content
                 share the remainder in a nested DockPanel starting at the same
                 height as the sidebar header - shared DungeonTopBarHeight therefore gives them
                 one continuous border line (TopBarView.axaml, GlobalSidebarView.axaml). -->
            <DockPanel LastChildFill="True" IsVisible="{Binding IsSystemChosen}">
                <ContentControl DockPanel.Dock="Left" Content="{Binding Sidebar}" />

                <DockPanel LastChildFill="True">
                    <topBar:TopBarView DockPanel.Dock="Top" DataContext="{Binding TopBar}" />

                    <Border Background="{DynamicResource DungeonBackstageBrush}"
                            BoxShadow="inset 0 0 8 0 #24000000">
                        <TransitioningContentControl Content="{Binding CurrentWorkspaceContent}">
                            <TransitioningContentControl.PageTransition>
                                <CrossFade Duration="0:0:0.14" />
                            </TransitioningContentControl.PageTransition>
                        </TransitioningContentControl>
                    </Border>
                </DockPanel>
            </DockPanel>

            <!-- Invisible warmup host - used for system content and campaign-tab warmup with
                 the first shelf campaign, so it lives outside both
                 branches above. -->
            <ContentControl Name="WarmupHost" ZIndex="99" IsHitTestVisible="False" />
        </Grid>

        <statusBar:StatusBarView Grid.Row="1" DataContext="{Binding StatusBar}" />
    </Grid>
</UserControl>
