<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:DungeonApp.Desktop.Shell"
             xmlns:topBar="using:DungeonApp.Desktop.Shell.TopBar"
             xmlns:sidebars="using:DungeonApp.Desktop.Shell.Sidebars"
             xmlns:statusBar="using:DungeonApp.Desktop.Shell.StatusBar"
             xmlns:workspace="using:DungeonApp.Desktop.Shell.Workspace"
             xmlns:campaignWorkspace="using:DungeonApp.Desktop.Features.CampaignWorkspace"
             xmlns:campaignLibrary="using:DungeonApp.Desktop.Features.CampaignLibrary"
             x:Class="DungeonApp.Desktop.Shell.AppShellView"
             x:DataType="shell:AppShellViewModel"
             Loaded="OnLoaded">

    <UserControl.DataTemplates>
        <DataTemplate DataType="workspace:WorkspacePlaceholderViewModel">
            <workspace:WorkspacePlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="campaignWorkspace:CampaignWorkspaceViewModel">
            <campaignWorkspace:CampaignWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="campaignLibrary:CampaignLibraryViewModel">
            <campaignLibrary:CampaignLibraryView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid IsHitTestVisible="{Binding IsReady}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{DynamicResource DungeonTopBarHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{DynamicResource DungeonStatusBarHeight}" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{DynamicResource DungeonSidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <topBar:TopBarView Grid.ColumnSpan="2"
                           DataContext="{Binding TopBar}" />

        <sidebars:GlobalSidebarView Grid.Row="1"
                                    Grid.Column="0"
                                    DataContext="{Binding Sidebar}" />

        <!--
            The workspace surface is persistent while pages change. Static pages have transparent
            roots, so CrossFade affects their content without fading an identical full-size fill and
            exposing the window underneath. The live campaign desk deliberately paints over this
            layer with its darker grid surface, making backstage <-> desk a meaningful transition.

            This shallow inset is the middle depth level. The campaign desk owns a stronger inset
            and a grid; the outer frame owns neither.
        -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Background="{DynamicResource DungeonBackstageBrush}"
                BoxShadow="inset 0 0 8 0 #24000000">
            <TransitioningContentControl Content="{Binding CurrentWorkspaceContent}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.14" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Border>

        <statusBar:StatusBarView Grid.Row="2"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 DataContext="{Binding StatusBar}" />

        <!--
            Startup is a readiness gate, not a splash screen: the real frame is already visible and
            rendered, while storage and the cold campaign visual path are prepared. Navigation is
            enabled only when the promise behind IsReady is true.
        -->
        <Border Grid.Row="1"
                Grid.Column="1"
                ZIndex="100"
                IsVisible="{Binding IsStarting}"
                Background="{DynamicResource DungeonBackstageBrush}">
            <Border Width="400"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource DungeonBackstageCardBrush}"
                    BorderBrush="{DynamicResource DungeonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource DungeonCornerRadius}"
                    BoxShadow="0 4 12 0 #30000000">
                <StackPanel Spacing="14">
                    <TextBlock FontFamily="{DynamicResource DungeonDisplayFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DungeonTextPrimaryBrush}"
                               Text="Przygotowywanie aplikacji" />
                    <TextBlock Foreground="{DynamicResource DungeonTextRegularBrush}"
                               Text="{Binding StartupMessage}"
                               TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" Height="4" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Attached only long enough to apply real workspace templates and complete one layout. -->
        <ContentControl Name="WarmupHost"
                        Grid.Row="1"
                        Grid.Column="1"
                        ZIndex="99"
                        IsHitTestVisible="False" />
    </Grid>
</UserControl>
