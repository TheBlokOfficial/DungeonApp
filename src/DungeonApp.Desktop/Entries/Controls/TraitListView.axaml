<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:content="using:DungeonApp.Desktop.Entries.Controls"
             xmlns:dc="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Desktop.Entries.Controls.TraitListView"
             x:DataType="content:TraitListView">

    <!-- The row template is shared by both layouts below (non-compact and compact) so the two
         never drift apart - same label/value/secondary rendering either way, only the panel that
         arranges the rows differs. -->
    <UserControl.Resources>
        <DataTemplate x:Key="TraitRowTemplate" x:DataType="content:TraitRow">
            <Grid ColumnSpacing="{DynamicResource DungeonSpacingSm}" Classes.highlighted="{Binding IsHighlighted}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="TraitLabel" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- The label, after its icon when the row has one (KP's shield): the icon in the
                     label's muted color, as in a headline value's caption. -->
                <Grid ColumnDefinitions="Auto,*"
                      Classes.with-icon="{Binding HasIcon}"
                      Width="{Binding $parent[content:TraitListView].LabelWidth}">
                    <dc:ForegroundIcon Width="{DynamicResource DungeonStatTileIconSize}"
                                       Height="{DynamicResource DungeonStatTileIconSize}"
                                       VerticalAlignment="Center"
                                       Source="{Binding Icon}"
                                       Foreground="{DynamicResource DungeonTextMutedBrush}"
                                       IsVisible="{Binding HasIcon}" />
                    <SelectableTextBlock Grid.Column="1"
                                         Classes="muted trait-label"
                                         Text="{Binding Label}"
                                         TextWrapping="Wrap" />
                </Grid>
                <!-- Value and secondary value as one wrapping text: a long value wraps within its
                     column instead of running past the card's edge. -->
                <SelectableTextBlock Grid.Column="1" TextWrapping="Wrap" IsVisible="{Binding IsPlain}">
                    <Run Text="{Binding Value}" /><Run Text="{Binding SecondaryDisplay}"
                                                       Foreground="{DynamicResource DungeonTextMutedBrush}" />
                </SelectableTextBlock>
                <dc:Badge Grid.Column="1" Classes="accent" IsVisible="{Binding IsHighlighted}">
                    <SelectableTextBlock Text="{Binding BadgeText}" />
                </dc:Badge>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- A row is as tall as its text line, the badge's row too: the badge gives up its fixed
             height and its border (transparent in the accent variant, yet 2 px of height) and takes
             the line's height from the label beside it, so a highlighted row keeps the list's pitch. -->
        <!-- The gap between a label's icon and its text opens only with an icon: a label without
             one starts on the list's edge. -->
        <Style Selector="Grid.with-icon">
            <Setter Property="ColumnSpacing" Value="{DynamicResource DungeonSpacingXs}" />
        </Style>
        <Style Selector="Grid.highlighted > dc|Badge">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <!-- No Margin on this root, ever: spacing between card controls belongs to the card view that
         lays them out, not to the control itself. -->
    <!-- The shared size scope starts here, at one control, and deliberately not higher: the label
         column is shared by the rows of THIS trait list, so a long label widens its own block and
         leaves the neighbouring one alone. Without a scope every row measures its own Auto column
         and the values come out ragged - six three-letter labels only look like a column by
         accident. Both layouts below sit inside this one scope, so switching between them keeps a
         single shared label column either way. -->
    <StackPanel Grid.IsSharedSizeScope="True" Spacing="{DynamicResource DungeonSpacingXs}">
        <SelectableTextBlock Classes="eyebrow" IsVisible="{Binding HasTitle}" Text="{Binding Title}" />

        <!-- Non-compact: one pair per row. -->
        <ItemsControl ItemsSource="{Binding Rows}"
                      IsVisible="{Binding !Compact}"
                      ItemTemplate="{StaticResource TraitRowTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="{DynamicResource DungeonSpacingXs}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Compact: three columns, filled row-major in list order - the card designer's own
             layout choice for rows whose values are short and meant to be scanned, set once here,
             never something a pack asks for. -->
        <ItemsControl ItemsSource="{Binding Rows}"
                      IsVisible="{Binding Compact}"
                      ItemTemplate="{StaticResource TraitRowTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3"
                                 RowSpacing="{DynamicResource DungeonSpacingXs}"
                                 ColumnSpacing="{DynamicResource DungeonSpacingSm}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</UserControl>
