<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:content="using:DungeonApp.Desktop.Entries.Controls"
             x:Class="DungeonApp.Desktop.Entries.Controls.AbilityGridView"
             x:DataType="content:AbilityGridView">

    <UserControl.Styles>
        <Style Selector="Border.ability-box">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource DungeonControlCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource DungeonPaddingSm}" />
        </Style>
    </UserControl.Styles>

    <!-- A three-column grid of bordered boxes, each with a label on the left and a score plus its
         own modifier on the right - the card designer's own fixed layout, not something
         rows-count-driven: a card is composed from controls, not picked from a catalog of layouts.
         No Margin on this root, ever - spacing between card controls belongs to the card view that
         lays them out. -->
    <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="3" RowSpacing="{DynamicResource DungeonSpacingXs}" ColumnSpacing="{DynamicResource DungeonSpacingSm}" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="content:AbilityRow">
                <Border Classes="ability-box">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Classes="muted" Text="{Binding Label}" VerticalAlignment="Bottom" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="{DynamicResource DungeonSpacingXs}"
                                    VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Score}" FontWeight="SemiBold" />
                            <TextBlock Classes="muted" Text="{Binding Modifier}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
