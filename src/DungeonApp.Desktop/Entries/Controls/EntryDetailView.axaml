<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ct="using:DungeonApp.Desktop.Entries.ContentTab"
             xmlns:conv="using:DungeonApp.Desktop.Entries.Converters"
             xmlns:dc="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Desktop.Entries.Controls.EntryDetailView"
             x:DataType="ct:ContentDetailViewModel"
             Width="560"
             HorizontalAlignment="Left">

    <!-- An entry's detail block: the entry's header with the system's card under it, 560 wide. No
         background, border, scrolling or outer spacing - the host gives those (the content tab today,
         a preview window in the campaign later). The whole block is one text selection area: a drag
         started beside a card's text selects it; the title and tags select like the card's text.
         DataContext: ContentDetailViewModel. -->
    <UserControl.Resources>
        <conv:UpperCaseConverter x:Key="UpperCase" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- The gap opens only when a card lends the header a visual: without one, the title column
             starts at the left edge, as for every card that lends nothing. -->
        <Style Selector="Grid.with-visual">
            <Setter Property="ColumnSpacing" Value="{DynamicResource DungeonDetailColumnGap}" />
        </Style>
        <!-- Likewise the gap before the title's end: without one, the title wraps at the column's edge. -->
        <Style Selector="Grid.with-title-end">
            <Setter Property="ColumnSpacing" Value="{DynamicResource DungeonSpacingMd}" />
        </Style>
        <!-- The title (a RevealingTextBlock, styled as a SelectableTextBlock) wraps, unless the card
             keeps it to one line. -->
        <Style Selector="SelectableTextBlock.title">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="SelectableTextBlock.title.one-line">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="ct:ValidContentDetailViewModel" x:DataType="ct:ValidContentDetailViewModel">
            <StackPanel Spacing="{DynamicResource DungeonSpacingXl}">
                <!-- The path stands apart from what it names: as much room under it as the host's
                     padding gives over it (DungeonPaddingXxl in the content tab), so it reads as the
                     block's own line, not as a caption stuck to the visual and the title. -->
                <StackPanel Spacing="{DynamicResource DungeonSpacingXxl}">
                    <!-- The "{Typ} › {Kategoria} › {Nazwa}" path - a frame control (controls:Breadcrumbs
                         theme): the trail dimmed, the current segment emphasized; too narrow - the
                         trail shortens. Full width, over the visual too. -->
                    <dc:Breadcrumbs Segments="{Binding Breadcrumbs}" />

                    <!-- The card's visual (IEntryCardHeader) on the left; the title column beside it:
                         name and tags (the card's tags start before them), the card's title end against
                         the right edge beside both, and at the column's foot the card's block - pushed
                         down by the star row to the visual's bottom edge while the column is shorter
                         than the visual. -->
                    <Grid ColumnDefinitions="Auto,*" Classes.with-visual="{Binding HasHeaderVisual}">
                        <ContentControl Content="{Binding HeaderVisual}"
                                        IsVisible="{Binding HasHeaderVisual}"
                                        VerticalAlignment="Top" />
                        <Grid Grid.Column="1"
                              RowDefinitions="Auto,*,Auto"
                              RowSpacing="{DynamicResource DungeonSpacingXs}">
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="{DynamicResource DungeonSpacingXs}"
                                  Classes.with-title-end="{Binding HasHeaderTitleEnd}">
                                <!-- The title wraps, or - when the card keeps it to one line - ends
                                     in an ellipsis and opens whole in place under the pointer. -->
                                <dc:RevealingTextBlock x:Name="Title"
                                                       Classes="display-xl title"
                                                       Classes.one-line="{Binding IsTitleOnOneLine}"
                                                       Text="{Binding Name}"
                                                       Foreground="{DynamicResource DungeonTextPrimaryBrush}" />
                                <!-- The title's end, centred on the title's first line: an empty,
                                     zero-wide line of the title's own style gives the cell exactly one
                                     line's height, however many lines the title wraps to. It spans the
                                     tags' row too, so an end taller than one line (a value with a note
                                     under it) runs down beside the tags, which wrap before it, instead
                                     of pushing them down. -->
                                <Panel Grid.Column="1"
                                       Grid.RowSpan="2"
                                       VerticalAlignment="Top"
                                       IsVisible="{Binding HasHeaderTitleEnd}">
                                    <TextBlock Classes="display-xl" Text=" " Width="0" IsHitTestVisible="False" />
                                    <ContentControl Content="{Binding HeaderTitleEnd}" VerticalAlignment="Center" />
                                </Panel>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding TagRow}" IsVisible="{Binding HasTagRow}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="{DynamicResource DungeonSpacingXs}"
                                                       LineSpacing="{DynamicResource DungeonSpacingXs}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <!-- A tag is a string drawn as a word tag; the card's tags start is a
                                         control and shows as itself. -->
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <dc:WordTag>
                                                <SelectableTextBlock Text="{Binding}" />
                                            </dc:WordTag>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <ContentControl Grid.Row="2"
                                            Content="{Binding HeaderBlock}"
                                            IsVisible="{Binding HasHeaderBlock}" />
                        </Grid>
                    </Grid>
                </StackPanel>

                <ContentControl Content="{Binding Card}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="ct:BrokenContentDetailViewModel" x:DataType="ct:BrokenContentDetailViewModel">
            <!-- The same shape as an entry: the header (6 between its parts), 20 to where the card
                 would stand, which holds the reason and the file path. -->
            <StackPanel Spacing="{DynamicResource DungeonSpacingXl}">
                <StackPanel Spacing="{DynamicResource DungeonSpacingXs}">
                    <TextBlock Classes="overline-sm"
                               Text="{Binding Overline, Converter={StaticResource UpperCase}}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DungeonDangerTextBrush}" />
                    <TextBlock Classes="display-xl"
                               Text="{Binding Name}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DungeonDangerTextBrush}" />
                </StackPanel>
                <StackPanel Spacing="{DynamicResource DungeonSpacingXs}">
                    <SelectableTextBlock Classes="body"
                                         Text="{Binding Reason}"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource DungeonTextRegularBrush}" />
                    <SelectableTextBlock Classes="caption"
                                         IsVisible="{Binding HasPath}"
                                         Text="{Binding Path}"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource DungeonTextMutedBrush}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <dc:TextSelectionArea>
        <ContentControl Content="{Binding}" />
    </dc:TextSelectionArea>
</UserControl>
