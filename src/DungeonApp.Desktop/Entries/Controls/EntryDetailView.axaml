<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ct="using:DungeonApp.Desktop.Entries.ContentTab"
             xmlns:conv="using:DungeonApp.Desktop.Entries.Converters"
             xmlns:dc="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Desktop.Entries.Controls.EntryDetailView"
             x:DataType="ct:ContentDetailViewModel"
             Width="560"
             HorizontalAlignment="Left">

    <!-- Klocek szczegółu wpisu: nagłówek wpisu i karta systemu pod nim, szerokość
         560. Bez tła, obramowania (ramy), przewijania i zewnętrznych odstępów - te daje host (zakładka
         treści dziś, okienko podglądu w kampanii później). DataContext: ContentDetailViewModel. -->
    <UserControl.Resources>
        <conv:UpperCaseConverter x:Key="UpperCase" />
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <DataTemplate DataType="ct:ValidContentDetailViewModel" x:DataType="ct:ValidContentDetailViewModel">
            <StackPanel Spacing="{DynamicResource DungeonSpacingXl}">
                <StackPanel Spacing="{DynamicResource DungeonSpacingXs}">
                    <!-- Ścieżka "{Typ} › {Kategoria} › {Nazwa}" - kontrolka ramy (motyw controls:Breadcrumbs):
                         ślad przygaszony, bieżący odcinek wyróżniony; za wąsko - ślad się skraca. -->
                    <dc:Breadcrumbs Segments="{Binding Breadcrumbs}" />
                    <TextBlock Classes="display-xl"
                               Text="{Binding Name}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DungeonTextPrimaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="{DynamicResource DungeonSpacingXs}"
                                           LineSpacing="{DynamicResource DungeonSpacingXs}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <dc:WordTag Content="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ContentControl Content="{Binding Card}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="ct:BrokenContentDetailViewModel" x:DataType="ct:BrokenContentDetailViewModel">
            <!-- Ten sam kształt co wpis: nagłówek (6 między elementami), 20 do miejsca karty, w którym
                 stoi powód i ścieżka pliku. -->
            <StackPanel Spacing="{DynamicResource DungeonSpacingXl}">
                <StackPanel Spacing="{DynamicResource DungeonSpacingXs}">
                    <TextBlock Classes="overline-sm"
                               Text="{Binding Overline, Converter={StaticResource UpperCase}}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DungeonDangerTextBrush}" />
                    <TextBlock Classes="display-xl"
                               Text="{Binding Name}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DungeonDangerTextBrush}" />
                </StackPanel>
                <StackPanel Spacing="{DynamicResource DungeonSpacingXs}">
                    <SelectableTextBlock Classes="body"
                                         Text="{Binding Reason}"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource DungeonTextRegularBrush}" />
                    <SelectableTextBlock Classes="caption"
                                         IsVisible="{Binding HasPath}"
                                         Text="{Binding Path}"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource DungeonTextMutedBrush}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ContentControl Content="{Binding}" />
</UserControl>
