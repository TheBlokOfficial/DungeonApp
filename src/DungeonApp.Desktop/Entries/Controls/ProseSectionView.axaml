<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:content="using:DungeonApp.Desktop.Entries.Controls"
             xmlns:dc="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Desktop.Entries.Controls.ProseSectionView"
             x:DataType="content:ProseSectionView">

    <!-- A section of a card's text, open until the heading is clicked (state not remembered): the heading (controls:SectionHeading), then - flush
         with the heading's left edge, never indented - an optional introduction and the named items.
         Without a title there is no heading: the items are then the card's own text, not a section of it.
         Rhythm: DungeonSpacingSm from the heading to its content, DungeonSpacingMd between the
         introduction and each item. An item's name stands on its own line in the strong role with its
         note muted after it and the closing period in the name's style at the line's end; its text under it in the secondary color, the author's **…** runs
         emphasized. Every text selectable. No Margin on this root - the card view spaces sections.
         The content unrolls and rolls up under the heading (controls:SectionReveal); the gap under the
         heading is part of it, so a folded section is only its heading. -->
    <StackPanel>
        <dc:SectionHeading x:Name="Heading"
                           Text="{Binding Title}"
                           IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <dc:SectionReveal x:Name="Body" IsOpen="{Binding #Heading.IsExpanded}">
            <StackPanel>
                <Border Height="{DynamicResource DungeonSpacingSm}"
                        IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel Spacing="{DynamicResource DungeonSpacingMd}">
                    <dc:ProseText x:Name="IntroText"
                                  Text="{Binding Intro}"
                                  IsVisible="{Binding Intro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{DynamicResource DungeonSpacingMd}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="content:ProseItem">
                                <StackPanel>
                                    <SelectableTextBlock Classes="body" TextWrapping="Wrap">
                                        <Run Text="{Binding Name}"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource DungeonTextPrimaryBrush}" /><Run Text="{Binding NoteDisplay}"
                                             Foreground="{DynamicResource DungeonTextMutedBrush}" /><Run Text="{Binding Period}"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource DungeonTextPrimaryBrush}" />
                                    </SelectableTextBlock>
                                    <dc:ProseText Text="{Binding Text}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </dc:SectionReveal>
    </StackPanel>
</UserControl>
