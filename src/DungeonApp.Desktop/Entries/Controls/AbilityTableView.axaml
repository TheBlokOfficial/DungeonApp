<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Desktop.Entries.Controls.AbilityTableView"
             HorizontalAlignment="Left"
             VerticalAlignment="Top">

    <!-- One column per ability. The labels stand above the grid, not in it - no line, no fill, each
         centered over its column and sitting on the grid's top line. Under them two rows of square
         cells, score then modifier, lines between every cell and sharp corners (the frame's Table
         with column lines). The cell side is DungeonAbilityCellSize, so a three-ability table is as
         wide as the header picture. Label muted, score and modifier in the numbers' face; the
         modifier cell tinted by its ValueTone. Every text selectable. No Margin on this root -
         spacing between card controls belongs to the card view. -->
    <UserControl.Styles>
        <Style Selector="SelectableTextBlock.ability-label">
            <Setter Property="Width" Value="{DynamicResource DungeonAbilityCellSize}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="dc|TableCell">
            <Setter Property="Width" Value="{DynamicResource DungeonAbilityCellSize}" />
            <Setter Property="Height" Value="{DynamicResource DungeonAbilityCellSize}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="dc|TableCell.positive">
            <Setter Property="Background" Value="{DynamicResource DungeonPositiveSubtleBrush}" />
        </Style>
        <Style Selector="dc|TableCell.negative">
            <Setter Property="Background" Value="{DynamicResource DungeonNegativeSubtleBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource DungeonSpacingXs}">
        <Grid x:Name="Labels" />
        <dc:Table x:Name="Cells" Grid.Row="1" ShowColumnLines="True" RowDefinitions="Auto,Auto" />
    </Grid>
</UserControl>
