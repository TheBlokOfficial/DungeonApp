<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:content="using:DungeonApp.Desktop.Entries.Controls"
             x:Class="DungeonApp.Desktop.Entries.Controls.ProseBlockView"
             x:DataType="content:ProseBlockView">

    <!-- No Margin on this root, ever: spacing between card controls belongs to the card view that
         lays them out, not to the control itself. The prose is text to select - a card's longer
         text is what the GM copies out. -->
    <StackPanel Spacing="{DynamicResource DungeonSpacingXs}">
        <SelectableTextBlock Classes="eyebrow" IsVisible="{Binding HasTitle}" Text="{Binding Title}" />
        <SelectableTextBlock Classes="body" Text="{Binding Text}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
