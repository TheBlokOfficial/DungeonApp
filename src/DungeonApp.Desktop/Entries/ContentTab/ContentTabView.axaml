<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ct="using:DungeonApp.Desktop.Entries.ContentTab"
             xmlns:conv="using:DungeonApp.Desktop.Entries.Converters"
             xmlns:ctl="using:DungeonApp.Desktop.Entries.Controls"
             xmlns:dc="using:DungeonApp.Desktop.Controls"
             x:Class="DungeonApp.Desktop.Entries.ContentTab.ContentTabView"
             x:DataType="ct:ContentTabViewModel">

    <!-- Content-tab skeleton: full-width tab header, below the line
         a fixed-width list panel and detail area with EntryDetailView. Dimensions from the
         theme scale, fonts from gallery roles (Typography.axaml). -->
    <UserControl.Resources>
        <conv:DimBrushConverter x:Key="DimBrush" />
        <conv:UpperCaseConverter x:Key="UpperCase" />

        <!-- List panel width. -->
        <GridLength x:Key="ContentListColumnWidth">320</GridLength>

        <!-- Tab header: 20 at top, 24 at sides, 16 above the line. -->
        <Thickness x:Key="ContentTabHeaderMargin">24,20,24,16</Thickness>

        <!-- Detail area: 32 at top, left and bottom; right scrollbar zone
             (DungeonScrollBarZone) set as Padding on the same element. -->
        <Thickness x:Key="ContentDetailMargin">32,32,0,32</Thickness>

        <!-- Section heading: left-aligned with row text (stripe gutter
             DungeonListRowStripeGutter 10 + row padding DungeonPaddingMdHorizontal 12); 12 above
             every heading, including the first, 6 below. -->
        <Thickness x:Key="ContentSectionHeaderMargin">22,12,16,6</Thickness>

        <DataTemplate x:Key="ContentRowTemplate" x:DataType="ct:ContentRowViewModel">
            <dc:ListRow ShowsSelectionStripe="True"
                        IsSelected="{Binding IsSelected}"
                        Command="{Binding SelectCommand}"
                        ToolTip.Tip="{Binding Name}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource DungeonSpacingSm}">
                    <!-- The entry's own one-colour icon before the name, muted like the row's metadata,
                         when the tab's types show one; the place stays when an entry has none, so the
                         names stand in one column. Without the place there is no gap either
                         (Grid.row-picture), and the name starts where it always does. -->
                    <Grid Grid.Column="0" Classes="row-picture" Classes.with-picture="{Binding HasPictureSlot}"
                          ColumnDefinitions="Auto,*">
                        <dc:ForegroundIcon IsVisible="{Binding HasPictureSlot}"
                                           Width="{DynamicResource DungeonListRowIconSize}"
                                           Height="{DynamicResource DungeonListRowIconSize}"
                                           VerticalAlignment="Center"
                                           Source="{Binding Picture}"
                                           Foreground="{DynamicResource DungeonTextMutedBrush}" />
                        <TextBlock Grid.Column="1" Classes="body row-name"
                                   Text="{Binding Name}"
                                   IsVisible="{Binding !IsBroken}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource DungeonTextRegularBrush}" />
                        <TextBlock Grid.Column="1" Classes="body row-name"
                                   Text="{Binding Name}"
                                   IsVisible="{Binding IsBroken}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource DungeonDangerTextBrush}" />
                    </Grid>

                    <!-- Uncoloured badge (challenge): plain muted text in the numeric font. -->
                    <TextBlock Grid.Column="1" Classes="mono muted"
                               Text="{Binding BadgeText}"
                               IsVisible="{Binding HasPlainBadge}"
                               VerticalAlignment="Center" />
                    <!-- System-coloured badge (rarity): custom WordTag - coloured text,
                         same dim background; dimensions, font and position from the theme. -->
                    <dc:WordTag Grid.Column="1" Classes="custom"
                                IsVisible="{Binding HasColoredBadge}"
                                Content="{Binding BadgeText}"
                                Background="{Binding BadgeBrush, Converter={StaticResource DimBrush}}"
                                Foreground="{Binding BadgeBrush}" />
                    <!-- Broken item: warning in unloaded-content colour replaces the badge. -->
                    <dc:ForegroundIcon Grid.Column="1"
                                       IsVisible="{Binding IsBroken}"
                                       Width="{DynamicResource DungeonActionIconSize}"
                                       Height="{DynamicResource DungeonActionIconSize}"
                                       VerticalAlignment="Center"
                                       Source="{DynamicResource DungeonIconWarningTriangle}"
                                       Foreground="{DynamicResource DungeonDangerTextBrush}" />
                </Grid>
            </dc:ListRow>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- List sets row height, not content: library constant DungeonListRowHeight (32). -->
        <Style Selector="ItemsControl.content-rows dc|ListRow">
            <Setter Property="Height" Value="{DynamicResource DungeonListRowHeight}" />
        </Style>
        <Style Selector="dc|ListRow:selected TextBlock.row-name">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Grid.row-picture.with-picture">
            <Setter Property="ColumnSpacing" Value="{DynamicResource DungeonSpacingSm}" />
        </Style>
        <!-- Disabled filter label dims with the field (same disabled opacity). -->
        <Style Selector="TextBlock.filter-label:disabled">
            <Setter Property="Opacity" Value="{DynamicResource DungeonDisabledOpacity}" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource DungeonBackstageBrush}" RowDefinitions="Auto,Auto,*" MinHeight="0">

        <!-- ===== Tab header: name and counter on one baseline (one TextBlock). Counter:
             numbers in numeric font, words ("z", "wpisy") in UI font - same size and colour.
             No whitespace between counter elements: parts carry their own spaces. ===== -->
        <TextBlock Grid.Row="0"
                   Margin="{StaticResource ContentTabHeaderMargin}"
                   Classes="display-lg"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource DungeonTextPrimaryBrush}">
            <Run Text="{Binding Title}" />
            <Run Text="  "
                 FontFamily="{DynamicResource DungeonMonoFont}"
                 FontSize="{DynamicResource DungeonHelperFontSize}" />
            <Run Text="{Binding CountShownPart}"
                 FontFamily="{DynamicResource DungeonMonoFont}"
                 FontSize="{DynamicResource DungeonHelperFontSize}"
                 FontWeight="Normal"
                 Foreground="{DynamicResource DungeonTextMutedBrush}"
            /><Run Text="{Binding CountOfPart}"
                 FontFamily="{DynamicResource DungeonUiFont}"
                 FontSize="{DynamicResource DungeonHelperFontSize}"
                 FontWeight="Normal"
                 Foreground="{DynamicResource DungeonTextMutedBrush}"
            /><Run Text="{Binding CountTotalPart}"
                 FontFamily="{DynamicResource DungeonMonoFont}"
                 FontSize="{DynamicResource DungeonHelperFontSize}"
                 FontWeight="Normal"
                 Foreground="{DynamicResource DungeonTextMutedBrush}"
            /><Run Text="{Binding CountNounPart}"
                 FontFamily="{DynamicResource DungeonUiFont}"
                 FontSize="{DynamicResource DungeonHelperFontSize}"
                 FontWeight="Normal"
                 Foreground="{DynamicResource DungeonTextMutedBrush}" />
        </TextBlock>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource DungeonBorderBrush}"
                BorderThickness="0,0,0,1" />

        <!-- ===== Body: list panel (fixed width) + detail area. ===== -->
        <Grid Grid.Row="2" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource ContentListColumnWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== List panel ===== -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource DungeonBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*" MinHeight="0">

                    <StackPanel Grid.Row="0" Margin="{DynamicResource DungeonPaddingLg}" Spacing="{DynamicResource DungeonSpacingSm}">
                        <dc:IconField Classes="search">
                            <TextBox Text="{Binding Search, Mode=TwoWay}"
                                     PlaceholderText="Szukaj po nazwie…" />
                        </dc:IconField>

                        <!-- Filters as labelled fields: category, system filters, "Paczka".
                             Row = left label (label role, secondary colour) and multiple-selection dropdown
                             in the default theme filling the remaining width. Label column shared
                             across rows (SharedSizeGroup), width from longest label; 12 between
                             label and field, 8 between rows. Nothing selected = no filtering
                             ("Wszystkie" placeholder); selection held by value text
                             (SelectedValues). Filter without options - disabled field, label dims with it. -->
                        <ItemsControl ItemsSource="{Binding Filters}" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{DynamicResource DungeonSpacingSm}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ct:ContentFilterChipViewModel">
                                    <Grid ColumnSpacing="{DynamicResource DungeonSpacingMd}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ContentFilterLabel" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Classes="label secondary filter-label"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Label}"
                                                   IsEnabled="{Binding IsAvailable}" />
                                        <dc:DropDownPicker Grid.Column="1"
                                                           SelectionMode="Multiple"
                                                           PlaceholderText="Wszystkie"
                                                           ItemsSource="{Binding Options}"
                                                           SelectedItems="{Binding SelectedValues, Mode=OneWay}"
                                                           IsEnabled="{Binding IsAvailable}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnDefinitions="*,Auto">
                            <dc:SortPicker Grid.Column="0"
                                           Options="{Binding SortOptions}"
                                           SelectedOption="{Binding SelectedSort, Mode=TwoWay}"
                                           NumericOptions="{Binding NumericSortOptions}"
                                           IsDescending="{Binding SortDescending, Mode=TwoWay}"
                                           CanReverse="True" />
                            <Button Grid.Column="1" Classes="link" HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Command="{Binding ClearFiltersCommand}"
                                    Content="Wyczyść filtry" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource DungeonBorderBrush}" BorderThickness="0,0,0,1" />

                    <!-- One scrolling layer: ScrollViewer around ItemsControl (no scrolling of its own).
                         Scrollbar zone belongs to the row (ListRow theme), row background extends under the bar. -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,24">
                            <!-- Empty state: no pack has entries of this type. Tab does not know the pack-directory
                                 path, so the hint refers to it generically. -->
                            <dc:EmptyState IsVisible="{Binding HasNoEntries}"
                                           Margin="{DynamicResource DungeonPaddingLg}"
                                           Message="{Binding EmptyText}"
                                           Hint="Paczki treści leżą w katalogu paczek aplikacji." />

                            <!-- Empty state: nothing matches (pattern: gallery, "Kompozycje"). -->
                            <StackPanel IsVisible="{Binding HasNoMatches}"
                                        Margin="{DynamicResource DungeonPaddingLg}"
                                        Spacing="{DynamicResource DungeonSpacingSm}">
                                <dc:EmptyState Message="Nic nie pasuje do wyszukiwania i filtrów." />
                                <Button Classes="link" HorizontalAlignment="Center"
                                        Command="{Binding ClearFiltersCommand}"
                                        Content="Wyczyść filtry" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ct:ContentSectionViewModel">
                                        <StackPanel>
                                            <!-- Regular pack heading: name and section entry count. -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{DynamicResource DungeonSpacingXs}"
                                                        Margin="{StaticResource ContentSectionHeaderMargin}"
                                                        IsVisible="{Binding !IsRejectedPack}">
                                                <TextBlock Classes="overline-sm muted" VerticalAlignment="Center"
                                                           Text="{Binding Header, Converter={StaticResource UpperCase}}" />
                                                <TextBlock Classes="mono muted" VerticalAlignment="Center"
                                                           Text="{Binding Count, StringFormat={}{0}}" />
                                            </StackPanel>

                                            <!-- Rejected pack heading: unloaded-content colour and warning. -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{DynamicResource DungeonSpacingXs}"
                                                        Margin="{StaticResource ContentSectionHeaderMargin}"
                                                        IsVisible="{Binding IsRejectedPack}">
                                                <dc:ForegroundIcon Width="{DynamicResource DungeonActionIconSize}"
                                                                   Height="{DynamicResource DungeonActionIconSize}"
                                                                   VerticalAlignment="Center"
                                                                   Source="{DynamicResource DungeonIconWarningTriangle}"
                                                                   Foreground="{DynamicResource DungeonDangerTextBrush}" />
                                                <TextBlock Classes="overline-sm" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource DungeonDangerTextBrush}"
                                                           Text="{Binding Header, Converter={StaticResource UpperCase}}" />
                                            </StackPanel>

                                            <ItemsControl Classes="content-rows"
                                                          ItemsSource="{Binding Rows}"
                                                          ItemTemplate="{StaticResource ContentRowTemplate}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== Detail area: the only scrolling layer on this side. 560-wide block beside
                 the list (left-aligned); wider screens leave an empty strip on the right. ===== -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                <Border Margin="{StaticResource ContentDetailMargin}"
                        Padding="{DynamicResource DungeonScrollBarZone}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <Panel>
                        <TextBlock Classes="body muted"
                                   IsVisible="{Binding ShowSelectionPrompt}"
                                   Text="Wybierz wpis z listy." />
                        <!-- Detail frame belongs to the host, not the block: background, line
                             and shell-card corner (surface-card, like the card in gallery "Kompozycje"),
                             padding 24 on all sides. Width from block 560 + 2 x 24 (+ line),
                             height from content; also shown for broken items. -->
                        <Border Classes="surface-card"
                                Padding="{DynamicResource DungeonPaddingXxl}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsVisible="{Binding HasDetail}">
                            <ctl:EntryDetailView DataContext="{Binding Detail}" />
                        </Border>
                    </Panel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
