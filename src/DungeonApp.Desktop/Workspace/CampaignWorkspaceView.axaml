<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:deck="using:DungeonApp.Desktop.Workspace.Deck"
             xmlns:leaf="using:DungeonApp.Desktop.Workspace.Leaf"
             xmlns:surface="using:DungeonApp.Desktop.Workspace.Controls"
             xmlns:workspace="using:DungeonApp.Desktop.Workspace"
             xmlns:world="using:DungeonApp.Desktop.Workspace.World"
             x:Class="DungeonApp.Desktop.Workspace.CampaignWorkspaceView"
             x:DataType="workspace:CampaignWorkspaceViewModel">

    <!-- The desk's own two ControlThemes (WorkspaceSurface, PanelWindow) live in the library, not
         the frame: the frame must never name a library type, not even in a resource include.
         Merged here, on the library's own
         top-level view, rather than in the frame's Application.Resources: PanelWindow instances are
         generated inside Surface below, so they sit in this control's logical tree and resolve their
         implicit theme from these merged resources the same way they would from an application-wide
         dictionary. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DungeonApp.Desktop/Workspace/WorkspaceControls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <surface:WorkspaceSurface Name="Surface" ItemsSource="{Binding Panels}">
            <!-- The catalog lies on the desk under every window, so a window passing over it hides it. -->
            <surface:WorkspaceSurface.Underlay>
                <world:WorldCatalogView Name="CatalogView" />
            </surface:WorkspaceSurface.Underlay>
        </surface:WorkspaceSurface>

        <!-- After the surface in document order, so the cards lie on top of the desk. A panel can
             never be lost under them: the clamp keeps every panel fully inside the surface. -->
        <deck:PanelDeckView HorizontalAlignment="Left"
                            VerticalAlignment="Bottom" />

        <!-- Last, so it lies above every window: the strip belongs to the frame, not the desk's
             stacking, and windows may pass under it. -->
        <leaf:DeskLeafView DataContext="{Binding Leaf}" />
    </Grid>
</UserControl>
