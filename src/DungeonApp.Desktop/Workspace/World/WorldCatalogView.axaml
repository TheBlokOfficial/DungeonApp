<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="using:DungeonApp.Desktop.Controls"
             xmlns:themes="using:DungeonApp.Desktop.Themes"
             xmlns:world="using:DungeonApp.Desktop.Workspace.World"
             x:Class="DungeonApp.Desktop.Workspace.World.WorldCatalogView"
             x:DataType="world:WorldCatalogViewModel"
             Focusable="True"
             HorizontalAlignment="Left"
             VerticalAlignment="Stretch"
             Margin="{Binding Margin}"
             Width="{Binding Width}">

    <!-- Keyboard focus has no ring here: the arrow keys move the selection, so the selected row (AccentDim) is
         the focused one. -->
    <!-- The catalog lies on the desk: the desk's own colour, no frame and no shadow, so the grid lines
         do not cut through the letters. It reaches from its top edge to the desk's bottom; the
         one scrolling layer is the ScrollViewer. -->
    <UserControl.Resources>

        <ControlTheme x:Key="WorldRowButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <DataTemplate x:Key="WorldRowTemplate" x:DataType="world:WorldRowViewModel">
            <Border Classes="world-row"
                    Classes.selected="{Binding IsSelected}"
                    Classes.expanded="{Binding IsExpanded}"
                    Classes.root="{Binding IsRoot}"
                    Classes.source="{Binding IsDragSource}">
                <Border Padding="{DynamicResource DungeonScrollBarZone}">
                  <Panel>
                    <!-- The drop target's frame lies over the row and takes no room, so showing it moves nothing. -->
                    <Border Classes="world-drop-frame"
                            IsVisible="{Binding IsDropTarget}"
                            IsHitTestVisible="False" />
                    <Grid ColumnDefinitions="16,16,*,Auto"
                          Margin="{Binding Indent}">
                        <!-- Chevron: turns instead of swapping, so the fold reads as one movement. -->
                        <Button Grid.Column="0"
                                Theme="{StaticResource WorldRowButtonTheme}"
                                Tag="toggle"
                                Width="16" Height="16"
                                IsVisible="{Binding IsFolderLike}">
                            <dc:ForegroundIcon Classes="world-chevron"
                                               Width="14" Height="14"
                                               Source="{DynamicResource DungeonIconChevronDown}" />
                        </Button>

                        <!-- Folder icon, the entity's type icon, or the warning of an entity whose
                             entry is gone; the place stays when a type has no icon. -->
                        <dc:ForegroundIcon Grid.Column="1"
                                           Width="14" Height="14"
                                           HorizontalAlignment="Center"
                                           IsVisible="{Binding IsFolderLike}"
                                           Source="{DynamicResource DungeonIconFolder}"
                                           Foreground="{DynamicResource DungeonTextMutedBrush}" />
                        <dc:ForegroundIcon Grid.Column="1"
                                           Width="14" Height="14"
                                           HorizontalAlignment="Center"
                                           IsVisible="{Binding ShowsTypeIcon}"
                                           Source="{Binding Icon}"
                                           Foreground="{DynamicResource DungeonTextMutedBrush}" />
                        <dc:ForegroundIcon Grid.Column="1"
                                           Width="14" Height="14"
                                           HorizontalAlignment="Center"
                                           IsVisible="{Binding IsUnresolved}"
                                           Source="{DynamicResource DungeonIconWarningTriangle}"
                                           Foreground="{DynamicResource DungeonDangerTextBrush}" />

                        <TextBlock Grid.Column="2"
                                   Classes="world-name"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   themes:TrimmedLabelToolTip.IsEnabled="True"
                                   Text="{Binding Name}"
                                   IsVisible="{Binding !IsEditing}" />

                        <!-- Rename in place: the field starts at the name's cell and its border and padding (1 + 5 px)
                             equal the name's left margin, so the letters stay where they were and no neighbour moves.
                             It is as wide as the typed text, at least 80 px and at most the cell, before the number;
                             longer text scrolls inside. The vertical padding keeps the selection off the border
                             within the row's height. -->
                        <TextBox Grid.Column="2"
                                 Classes="world-rename"
                                 Classes.error="{Binding HasRenameError}"
                                 HorizontalAlignment="Left"
                                 Padding="5,2"
                                 CornerRadius="0"
                                 MinWidth="80"
                                 Height="NaN"
                                 VerticalAlignment="Center"
                                 FontSize="{DynamicResource DungeonHelperFontSize}"
                                 Text="{Binding EditText, Mode=TwoWay}"
                                 IsVisible="{Binding IsEditing}"
                                 ToolTip.Tip="{Binding RenameError}"
                                 ToolTip.IsOpen="{Binding HasRenameError}"
                                 ToolTip.Placement="Bottom" />

                        <TextBlock Grid.Column="3"
                                   Classes="world-number"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding NumberText}" />
                    </Grid>
                  </Panel>
                </Border>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.world-row">
            <!-- Transparent, not null: only a painted background takes the pointer. -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="{DynamicResource DungeonWorldRowHeight}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Border.world-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource DungeonBackstageRowHoverBrush}" />
        </Style>
        <Style Selector="Border.world-row.selected">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentDimBrush}" />
        </Style>
        <!-- The folder a dragged selection would land in: a frame, not a fill, so it never reads as the
             hover or the selection under it. -->
        <Style Selector="Border.world-drop-frame">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonDropTargetBrush}" />
        </Style>
        <!-- Rows carried by a drag stay where they were, faded, until the drop moves them. -->
        <Style Selector="Border.world-row.source">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <!-- The copy of the dragged row under the pointer: a surface lifted above the desk, so the rows it
             passes over do not show through its letters, tinted like the selected row it copies. -->
        <Style Selector="Border.world-drag-ghost">
            <Setter Property="Background" Value="{DynamicResource DungeonSurfaceBrush}" />
            <Setter Property="Opacity" Value="0.9" />
            <Setter Property="Height" Value="{DynamicResource DungeonWorldRowHeight}" />
        </Style>
        <Style Selector="Border.world-drag-ghost > Border">
            <Setter Property="Background" Value="{DynamicResource DungeonAccentDimBrush}" />
            <Setter Property="Padding" Value="6,0,8,0" />
        </Style>
        <Style Selector="TextBox.world-rename.error /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource DungeonDangerBrush}" />
        </Style>
        <Style Selector="TextBlock.world-name, TextBlock.world-number">
            <Setter Property="FontFamily" Value="{DynamicResource DungeonUiFont}" />
            <Setter Property="FontSize" Value="{DynamicResource DungeonHelperFontSize}" />
        </Style>
        <Style Selector="TextBlock.world-name">
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        </Style>
        <Style Selector="Border.world-row.root TextBlock.world-name">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="dc|ForegroundIcon.world-chevron">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="{StaticResource DungeonMotionDuration}"
                                                   Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.world-row.expanded dc|ForegroundIcon.world-chevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <!-- The chevron has no background of its own; it brightens under the pointer. -->
        <Style Selector="dc|ForegroundIcon.world-chevron">
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        </Style>
        <Style Selector="Button:pointerover dc|ForegroundIcon.world-chevron">
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextPrimaryBrush}" />
        </Style>
        <!-- The number is one column for the whole tree: the right edge of the rows, digits aligned right. -->
        <Style Selector="TextBlock.world-number">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFeatures" Value="tnum" />
            <Setter Property="Foreground" Value="{DynamicResource DungeonTextMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <ScrollViewer Name="Tree"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}"
                          ItemTemplate="{StaticResource WorldRowTemplate}" />
        </ScrollViewer>

        <!-- The right edge: a thin strip that takes the pointer, to widen or narrow the catalog. -->
        <Border Name="ResizeGrip"
                Width="5"
                HorizontalAlignment="Right"
                Background="Transparent"
                Cursor="SizeWestEast" />

        <!-- The dragged row under the pointer: its icon and name, and "+2" when it carries more. It takes no
             hits, so the row under the pointer is the one a drop lands on. Placed by the code-behind. -->
        <Border Name="DragGhost"
                Classes="world-drag-ghost"
                x:DataType="world:WorldRowViewModel"
                IsVisible="False"
                IsHitTestVisible="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                MaxWidth="240">
          <Border>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Panel Width="14" Height="14" VerticalAlignment="Center">
                    <dc:ForegroundIcon IsVisible="{Binding IsFolderLike}"
                                       Source="{DynamicResource DungeonIconFolder}"
                                       Foreground="{DynamicResource DungeonTextMutedBrush}" />
                    <dc:ForegroundIcon IsVisible="{Binding ShowsTypeIcon}"
                                       Source="{Binding Icon}"
                                       Foreground="{DynamicResource DungeonTextMutedBrush}" />
                    <dc:ForegroundIcon IsVisible="{Binding IsUnresolved}"
                                       Source="{DynamicResource DungeonIconWarningTriangle}"
                                       Foreground="{DynamicResource DungeonDangerTextBrush}" />
                </Panel>
                <TextBlock Classes="world-name"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Name}" />
                <TextBlock Name="DragGhostCount"
                           Classes="world-number"
                           VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Border>
    </Grid>
</UserControl>
