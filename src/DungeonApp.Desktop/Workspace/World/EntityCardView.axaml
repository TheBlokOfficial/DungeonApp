<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:DungeonApp.Desktop.Entries.Controls"
             xmlns:world="using:DungeonApp.Desktop.Workspace.World"
             x:Class="DungeonApp.Desktop.Workspace.World.EntityCardView"
             x:DataType="world:EntityCardViewModel">

    <!-- The body of the preview and of a pinned window: the library's detail block (path, name,
         tags, the system's card) around an entity. One scrolling layer. The card stands 32 from
         both sides of the window, so it reads centred whether the scrollbar shows or not; the bar
         (an overlay, DungeonScrollBarSize at the window's edge) lies inside the right margin with a
         clear gap before the card, and its coming and going moves nothing (EntityCardView.axaml.cs
         sizes the window). An empty preview says what to do, dimmed, in the middle. -->
    <Panel>
        <TextBlock Classes="body muted"
                   Text="{x:Static world:EntityCardViewModel.EmptyText}"
                   IsVisible="{Binding IsEmpty}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsEmpty}">
            <Border Margin="32,24,32,24"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <ctl:EntryDetailView DataContext="{Binding Detail}" />
            </Border>
        </ScrollViewer>
    </Panel>
</UserControl>
