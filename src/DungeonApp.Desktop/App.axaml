<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DungeonApp.Desktop.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DungeonApp.Desktop/Themes/Tokens.axaml" />
                <ResourceInclude Source="avares://DungeonApp.Desktop/Themes/Icons.axaml" />
                <!-- Control themes are resources, not styles, so this belongs here and not in
                     Application.Styles below. Must come after Tokens and Icons, which it uses. -->
                <ResourceInclude Source="avares://DungeonApp.Desktop/Themes/DungeonControls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://DungeonApp.Desktop/Themes/BuiltInControls.axaml" />
    </Application.Styles>
</Application>
