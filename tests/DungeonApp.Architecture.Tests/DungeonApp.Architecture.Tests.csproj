<!--
  This project sees every layer at once - Core, Desktop, and every DungeonApp.Content.* system - on
  purpose. A test that must see all layers together cannot live inside the layer it partly
  constrains: putting it in DungeonApp.Core.Tests or DungeonApp.Desktop.Tests would force that layer
  to depend upward on a system just to assert that it doesn't, which is the boundary being guarded
  breaking on the way to being tested.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DungeonApp.Core\DungeonApp.Core.csproj" />
    <ProjectReference Include="..\..\src\DungeonApp.Desktop\DungeonApp.Desktop.csproj" />
    <ProjectReference Include="..\..\src\DungeonApp.Content.Dnd5e\DungeonApp.Content.Dnd5e.csproj" />
    <ProjectReference Include="..\DungeonApp.Testing\DungeonApp.Testing.csproj" />
  </ItemGroup>

</Project>
