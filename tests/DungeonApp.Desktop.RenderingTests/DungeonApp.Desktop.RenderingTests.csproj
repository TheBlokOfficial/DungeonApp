<Project Sdk="Microsoft.NET.Sdk">

    <!-- Separate project because Avalonia.Headless.XUnit requires xUnit v3, while the other tests use v2. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DungeonApp.Desktop\DungeonApp.Desktop.csproj" />
    <!-- A system's cards are views too, and only this project builds views in a window. -->
    <ProjectReference Include="..\..\src\DungeonApp.Content.Dnd5e\DungeonApp.Content.Dnd5e.csproj" />
    <ProjectReference Include="..\DungeonApp.Testing\DungeonApp.Testing.csproj" />
  </ItemGroup>

</Project>
