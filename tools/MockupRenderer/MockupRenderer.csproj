<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>MockupRenderer</RootNamespace>
    <AssemblyName>MockupRenderer</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Headless" Version="12.0.5" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Narzędzie żyje poza DungeonApp.sln (patrz README.md), ale wciąż potrzebuje
      dostępu do stylów, ikon i tokenów motywu z warstwy desktopowej, żeby
      renderowany mockup wyglądał tak jak w prawdziwej aplikacji.
    -->
    <ProjectReference Include="..\..\src\DungeonApp.Desktop\DungeonApp.Desktop.csproj" />
  </ItemGroup>
</Project>
